<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – GentleCare Reporting</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ── CSS Variables — GentleCare palette ── */
        :root {
            --main: #082F49;
            --main-dark: #082F49;
            --accent: #0369A1;
            --bg: #F1F5F9;
            --card: #FFFFFF;
            --soft: #F1F5F9;
            --text: #0F172A;
            --muted: #64748B;
            --border: #E2E8F0;
            --shadow: 0 10px 24px rgba(7, 81, 104, 0.08);

            --gc-main: #082F49;
            --gc-main-dark: #082F49;
            --gc-accent: #0369A1;
            --gc-bg: #F1F5F9;
            --gc-card: #FFFFFF;
            --gc-soft: #F1F5F9;
            --gc-text: #0F172A;
            --gc-muted: #64748B;
            --gc-border: #E2E8F0;
            --gc-shadow: 0 2px 8px rgba(8, 47, 73, 0.1);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            min-height: 100%;
            background: var(--bg);
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            color: var(--text);
        }

        a {
            text-decoration: none;
        }

        /* ── WRAPPER ── */
        #wrapper {
            display: flex;
            min-height: 100vh;
            min-width: 0;
        }

        /* ── SIDEBAR ── */
        #sidebar {
            background: var(--gc-main);
            color: #ffffff;
            min-width: 230px;
            max-height: 100vh;
            padding: 24px 12px;
            flex-shrink: 0;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            overflow-y: auto;
            box-shadow: 2px 0 8px rgba(0, 0, 0, 0.15);
        }

            #sidebar .sidebar-header {
                margin-bottom: 32px;
                text-align: center;
            }

            #sidebar .sidebar-icon {
                color: #E74C3C;
                font-size: 28px;
            }

            #sidebar .sidebar-title {
                font-weight: 700;
                font-size: 16px;
                margin-top: 8px;
                color: #ffffff;
            }

            #sidebar .sidebar-subtitle {
                color: #A0A0A0;
                font-size: 12px;
                margin-top: 2px;
            }

            #sidebar .nav {
                gap: 8px;
            }

            #sidebar .nav-link {
                color: #ffffff;
                padding: 8px 12px;
                border-radius: 6px;
                transition: background 0.15s;
                font-weight: 500;
                font-size: 0.92rem;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                #sidebar .nav-link:hover {
                    background: rgba(255, 255, 255, 0.1);
                    color: #ffffff;
                }

                #sidebar .nav-link.active {
                    background: var(--gc-accent);
                    color: #ffffff;
                }

                #sidebar .nav-link i {
                    margin-right: 0;
                    width: 18px;
                    text-align: center;
                    flex-shrink: 0;
                }

            #sidebar .sidebar-footer {
                margin-top: auto;
                padding-top: 16px;
                border-top: 1px solid #495057;
            }

            #sidebar .user-info {
                color: #A0A0A0;
                font-size: 12px;
                margin-bottom: 12px;
                display: block;
            }

            #sidebar .btn-logout {
                width: 100%;
                background: transparent;
                border: 1px solid #DC2626;
                color: #DC2626;
                padding: 8px 12px;
                border-radius: 6px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
            }

                #sidebar .btn-logout:hover {
                    background: #DC2626;
                    color: #ffffff;
                }

        /* Mobile toggle */
        .sidebar-toggle-btn {
            display: none;
            border: none;
            background: rgba(8, 47, 73, 0.10);
            color: var(--gc-main);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            font-size: 20px;
            cursor: pointer;
            align-items: center;
            justify-content: center;
        }

        /* ── MAIN CONTENT ── */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
            margin-left: 230px;
            overflow-x: hidden;
        }

        .content-body {
            flex: 1;
            padding: 28px;
            padding-top: 18px;
        }

        /* ── FOOTER ── */
        .gc-footer {
            background: var(--main);
            color: rgba(255,255,255,0.70);
            text-align: center;
            font-size: 13px;
            font-weight: 600;
            padding: 14px 20px;
        }

        /* ── PAGE HEADER ── */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
        }

            .page-header h1 {
                margin: 0;
                font-size: 28px;
                font-weight: 900;
                color: var(--text);
            }

            .page-header p {
                margin: 5px 0 0;
                color: var(--muted);
                font-size: 14px;
            }

        /* ── PAGE HEADER (MVC card-head look) ── */
        .page-header-card {
            background: #ffffff;
            border: 1px solid var(--gc-border);
            border-radius: 18px;
            box-shadow: 0 8px 20px rgba(8, 47, 73, 0.06);
            margin: 18px 28px 0;
            padding: 22px;
        }

        .page-header-card .card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: nowrap;
            margin: 0;
        }

        .page-header-title {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
            flex: 1;
        }

        .page-header-card .card-head h2 {
            margin: 0;
            color: var(--gc-text);
            font-size: 20px;
            font-weight: 900;
        }

        .page-header-card .status-pill {
            background: var(--gc-soft);
            border: 1px solid var(--gc-border);
            border-radius: 999px;
            padding: 5px 14px;
            font-size: 13px;
            font-weight: 700;
            color: var(--gc-main);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        /* ── BUTTONS ── */
        .primary-btn, .cm-main-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: none;
            border-radius: 999px;
            padding: 10px 20px;
            font-weight: 900;
            font-size: 14px;
            cursor: pointer;
            background: var(--main);
            color: #ffffff;
            text-decoration: none;
            transition: background 0.15s;
        }

            .primary-btn:hover, .cm-main-btn:hover {
                background: var(--accent);
                color: #ffffff;
            }

        .secondary-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: none;
            border-radius: 999px;
            padding: 10px 20px;
            font-weight: 900;
            font-size: 14px;
            cursor: pointer;
            background: #E7EEF0;
            color: var(--main);
            text-decoration: none;
            transition: background 0.15s;
        }

            .secondary-btn:hover {
                background: #DDE8EA;
                color: var(--main);
            }

        /* ── CARDS ── */
        .section-card, .dashboard-card, .cm-panel {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 22px;
            box-shadow: var(--shadow);
            margin-bottom: 24px;
        }

        /* ── STAT BOXES ── */
        .status-grid, .dashboard-grid, .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 14px;
        }

        .status-box, .details-item {
            background: var(--soft);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 16px;
        }

            .status-box span, .details-item span {
                display: block;
                color: var(--muted);
                font-size: 13px;
                font-weight: 800;
            }

            .status-box strong, .details-item strong {
                display: block;
                margin-top: 5px;
                font-size: 22px;
                font-weight: 900;
                color: var(--text);
            }

        /* ── TABLES ── */
        .cm-table-wrap {
            overflow-x: auto;
        }

        .cm-table, .data-table, .clean-table {
            width: 100%;
            border-collapse: collapse;
        }

            .cm-table th, .cm-table td,
            .data-table th, .data-table td,
            .clean-table th, .clean-table td {
                padding: 13px 12px;
                border-bottom: 1px solid var(--border);
                text-align: left;
                vertical-align: middle;
                font-size: 13px;
            }

            .cm-table th, .data-table th, .clean-table th {
                background: var(--soft);
                font-weight: 900;
                color: var(--text);
            }

        /* ── PILLS ── */
        .cm-pill, .status-pill, .tag-pill {
            display: inline-block;
            border-radius: 999px;
            padding: 5px 12px;
            background: rgba(0,119,155,0.12);
            color: var(--main);
            font-size: 12px;
            font-weight: 900;
        }

        /* ── ALERTS ── */
        .alert {
            padding: 12px 14px;
            border-radius: 12px;
            margin-bottom: 16px;
            font-weight: 800;
        }

        .alert-success {
            background: rgba(0,119,155,0.12);
            color: var(--main);
            border: none;
        }

        .alert-danger {
            background: rgba(180,50,50,0.10);
            color: #A33A3A;
            border: none;
        }

        .text-danger {
            color: #A33A3A !important;
            font-size: 13px;
            font-weight: 700;
        }

        /* ── FORMS ── */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 14px;
        }

            .form-group label {
                font-weight: 900;
                color: var(--text);
                font-size: 14px;
            }

            .form-group input,
            .form-group select,
            .form-group textarea {
                width: 100%;
                padding: 11px 12px;
                border-radius: 12px;
                border: 1px solid var(--border);
                outline: none;
                background: #ffffff;
                font-family: inherit;
                font-size: 14px;
                color: var(--text);
            }

                .form-group input:focus,
                .form-group select:focus,
                .form-group textarea:focus {
                    border-color: var(--accent);
                    box-shadow: 0 0 0 3px rgba(0,119,155,0.14);
                }

        /* ── LINKS ── */
        .btn-link, .table-link {
            color: var(--main);
            font-weight: 800;
            margin-right: 8px;
            text-decoration: none;
        }

            .btn-link:hover, .table-link:hover {
                color: var(--accent);
                text-decoration: underline;
            }

        /* ── MOBILE ── */
        @@media (max-width: 900px) {
            #sidebar {
                position: fixed;
                left: -260px;
                top: 0;
                z-index: 1050;
                transition: left 0.25s;
            }

                #sidebar.open {
                    left: 0;
                }

            .main-content {
                margin-left: 0;
            }

            .sidebar-toggle-btn {
                display: flex;
            }

            .content-body {
                padding: 18px;
            }

            .page-header h1 {
                font-size: 22px;
            }
        }
    </style>
</head>

<body>

    @{
        var isLoggedIn = Context.Session.GetString("jwt_token") != null;
        var userName = Context.Session.GetString("user_name") ?? "Manager";

        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        string NavActive(string controller, string action)
        => currentController == controller && currentAction == action ? "active" : "";
        string NavActiveByAction(string action)
        => currentAction == action ? "active" : "";
    }

    @if (isLoggedIn)
    {
        <div id="wrapper">

            <!-- ── SIDEBAR ──────────────────────────────────────── -->
            <nav id="sidebar">
                <div class="sidebar-header">
                    <i class="bi bi-heart-pulse-fill sidebar-icon"></i>
                    <div class="sidebar-title">GentleCare</div>
                    <small class="sidebar-subtitle">Clinic Reports</small>
                </div>

                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a asp-controller="Dashboard" asp-action="Index"
                           class="nav-link @NavActive("Dashboard", "Index")">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Reports" asp-action="Appointments"
                           class="nav-link @NavActiveByAction("Appointments")">
                            <i class="bi bi-calendar-check"></i> Appointments
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Reports" asp-action="DoctorWorkload"
                           class="nav-link @NavActiveByAction("DoctorWorkload")">
                            <i class="bi bi-person-badge"></i> Doctor Workload
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Reports" asp-action="Patients"
                           class="nav-link @NavActiveByAction("Patients")">
                            <i class="bi bi-people"></i> Patients
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Reports" asp-action="Prescriptions"
                           class="nav-link @NavActiveByAction("Prescriptions")">
                            <i class="bi bi-capsule"></i> Prescriptions
                        </a>
                    </li>
                </ul>

                <div class="sidebar-footer">
                    <small class="user-info"><i class="bi bi-person-circle me-1"></i>@userName</small>
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout">
                            <i class="bi bi-box-arrow-left me-1"></i> Logout
                        </button>
                    </form>
                </div>
            </nav>
            <!-- ── END SIDEBAR ──────────────────────────────────── -->

            <!-- ── MAIN CONTENT ─────────────────────────────────── -->
            <div class="main-content">

                <!-- Page header -->
                <div class="page-header-card">
                    <div class="card-head">
                        <div class="page-header-title">
                            <button class="sidebar-toggle-btn" id="sidebarToggle">
                                <i class="bi bi-list"></i>
                            </button>
                            <h2>@(ViewData["Title"] ?? "Dashboard")</h2>
                        </div>
                        <span class="status-pill">
                            <i class="bi bi-person-circle"></i>
                            @userName
                        </span>
                    </div>
                </div>

                <!-- Page body -->
                <div class="content-body">
                    @RenderBody()
                </div>

                <!-- Footer -->
                <footer class="gc-footer">
                    &copy; @DateTime.Now.Year GentleCare — Clinic Reporting
                </footer>

            </div>
            <!-- ── END MAIN CONTENT ──────────────────────────────── -->

        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Mobile sidebar toggle
        const toggleBtn = document.getElementById("sidebarToggle");
        const sidebar   = document.getElementById("sidebar");
        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener("click", () => {
                sidebar.classList.toggle("open");
            });
            // Close on outside click
            document.addEventListener("click", (e) => {
                if (!sidebar.contains(e.target) && !toggleBtn.contains(e.target)) {
                    sidebar.classList.remove("open");
                }
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
