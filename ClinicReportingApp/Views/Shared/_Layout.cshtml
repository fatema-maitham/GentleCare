<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Clinic Reporting</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@{
    var isLoggedIn = Context.Session.GetString("jwt_token") != null;
    var userName   = Context.Session.GetString("user_name") ?? "Manager";
}

@if (isLoggedIn)
{
    <!-- Sidebar + Top Nav Layout -->
    <div class="d-flex" id="wrapper">

        <!-- ── Sidebar ──────────────────────────────────────────────────── -->
        <nav id="sidebar" class="bg-dark text-white d-flex flex-column p-3" style="min-width:230px; min-height:100vh;">
            <div class="mb-4 text-center">
                <i class="bi bi-heart-pulse-fill text-danger fs-2"></i>
                <div class="fw-bold mt-1" style="font-size:1.05rem;">Clinic Reports</div>
                <small class="text-secondary">Manager Dashboard</small>
            </div>

            <ul class="nav flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active bg-primary rounded" : "")"
                       asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["action"]?.ToString() == "Appointments" ? "active bg-primary rounded" : "")"
                       asp-controller="Reports" asp-action="Appointments">
                        <i class="bi bi-calendar-check me-2"></i> Appointments
                    </a>
                </li>
                <li class="nav-item">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["action"]?.ToString() == "DoctorWorkload" ? "active bg-primary rounded" : "")"
                           asp-controller="Reports" asp-action="DoctorWorkload">
                            <i class="bi bi-person-badge me-2"></i> Doctor Workload
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["action"]?.ToString() == "Patients" ? "active bg-primary rounded" : "")"
                       asp-controller="Reports" asp-action="Patients">
                        <i class="bi bi-people me-2"></i> Patients
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["action"]?.ToString() == "Prescriptions" ? "active bg-primary rounded" : "")"
                       asp-controller="Reports" asp-action="Prescriptions">
                        <i class="bi bi-capsule me-2"></i> Prescriptions
                    </a>
                </li>
            </ul>

            <div class="mt-auto pt-3 border-top border-secondary">
                <small class="text-secondary d-block mb-2"><i class="bi bi-person-circle me-1"></i>@userName</small>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                        <i class="bi bi-box-arrow-left me-1"></i> Logout
                    </button>
                </form>
            </div>
        </nav>

        <!-- ── Main Content ─────────────────────────────────────────────── -->
        <div class="flex-grow-1 d-flex flex-column">
            <div class="p-4 flex-grow-1">
                @RenderBody()
            </div>
            <footer class="text-center text-muted py-2 small border-top">
                &copy; @DateTime.Now.Year Clinic Reporting Application
            </footer>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
