@model ClinicReportingApp.ViewModels.PatientReportViewModel
@{
    ViewData["Title"] = "Patient Activity";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Patient Activity Report</h4>
</div>

<!-- ── Date Filter ────────────────────────────────────────────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label text-muted small">From</label>
                <input type="date" name="from" value="@Model.Filter.FromStr" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small">To</label>
                <input type="date" name="to" value="@Model.Filter.ToStr" class="form-control" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i>Apply Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ── KPI Cards ─────────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-people text-primary fs-2"></i>
                <h3 class="fw-bold my-2">@Model.PatientActivity.TotalPatients</h3>
                <small class="text-muted">Total Patients</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-person-check text-success fs-2"></i>
                <h3 class="fw-bold my-2">@Model.PatientActivity.ActivePatients</h3>
                <small class="text-muted">Active This Period</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-person-plus text-info fs-2"></i>
                <h3 class="fw-bold my-2">@Model.PatientActivity.NewPatients</h3>
                <small class="text-muted">New Patients</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-graph-up text-warning fs-2"></i>
                <h3 class="fw-bold my-2">@Model.PatientActivity.AvgAppointmentsPerPatient</h3>
                <small class="text-muted">Avg Appointments / Patient</small>
            </div>
        </div>
    </div>
</div>

<!-- ── Activity Breakdown ─────────────────────────────────────────────────── -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent fw-semibold border-bottom">
                <i class="bi bi-pie-chart me-2 text-primary"></i>Patient Status Distribution
            </div>
            <div class="card-body d-flex justify-content-center">
                <canvas id="patientChart" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent fw-semibold border-bottom">
                <i class="bi bi-info-circle me-2 text-primary"></i>Summary
            </div>
            <div class="card-body">
                @{
                    var inactive = Model.PatientActivity.TotalPatients - Model.PatientActivity.ActivePatients;
                    var activeRate = Model.PatientActivity.TotalPatients > 0
                    ? Math.Round((double)Model.PatientActivity.ActivePatients / Model.PatientActivity.TotalPatients * 100, 1)
                        : 0;
                }
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Active patient rate</span>
                        <span class="fw-semibold text-success">@activeRate%</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Inactive patients</span>
                        <span class="fw-semibold">@inactive</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">New patient rate</span>
                        <span class="fw-semibold text-info">
                            @(Model.PatientActivity.TotalPatients > 0
                                                        ? Math.Round((double)Model.PatientActivity.NewPatients / Model.PatientActivity.TotalPatients * 100, 1)
                                : 0)%
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Avg visits per patient</span>
                        <span class="fw-semibold">@Model.PatientActivity.AvgAppointmentsPerPatient</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    new Chart(document.getElementById('patientChart'), {
        type: 'doughnut',
        data: {
            labels: ['Active', 'New', 'Inactive'],
            datasets: [{
                data: [
                        @(Model.PatientActivity.ActivePatients - Model.PatientActivity.NewPatients),
                    @Model.PatientActivity.NewPatients,
                    @(Model.PatientActivity.TotalPatients - Model.PatientActivity.ActivePatients)
                ],
                backgroundColor: ['#3b82f6', '#22c55e', '#94a3b8']
            }]
        },
        options: { responsive: true, cutout: '60%' }
    });
</script>
}
