@model ClinicReportingApp.ViewModels.PatientReportViewModel

@{
    ViewData["Title"] = "Patient Activity";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">
        <i class="bi bi-people me-2 text-primary"></i>
        Patient Activity Report
    </h4>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label text-muted small">From</label>
                <input type="date" name="from" value="@Model.Filter.FromStr" class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label text-muted small">To</label>
                <input type="date" name="to" value="@Model.Filter.ToStr" class="form-control" />
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i>
                    Apply Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-people text-primary fs-2"></i>
                <h3 class="fw-bold my-2">@Model.TotalPatients</h3>
                <small class="text-muted">Total Patients</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-person-check text-success fs-2"></i>
                <h3 class="fw-bold my-2">@Model.ActivePatients</h3>
                <small class="text-muted">Active This Period</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-person-plus text-info fs-2"></i>
                <h3 class="fw-bold my-2">@Model.NewPatients</h3>
                <small class="text-muted">New Patients</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-graph-up text-warning fs-2"></i>
                <h3 class="fw-bold my-2">@Math.Round(Model.AvgAppointmentsPerPatient, 1)</h3>
                <small class="text-muted">Avg Appointments / Patient</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent fw-semibold border-bottom">
                <i class="bi bi-info-circle me-2 text-primary"></i>
                Summary
            </div>

            <div class="card-body">
                @{
                    var inactive = Model.TotalPatients - Model.ActivePatients;

                    var activeRate = Model.TotalPatients > 0
                    ? Math.Round((double)Model.ActivePatients / Model.TotalPatients * 100, 1)
                    : 0;

                    var newRate = Model.TotalPatients > 0
                    ? Math.Round((double)Model.NewPatients / Model.TotalPatients * 100, 1)
                    : 0;
                }

                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Active patient rate</span>
                        <span class="fw-semibold text-success">@activeRate%</span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Inactive patients</span>
                        <span class="fw-semibold">@inactive</span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">New patient rate</span>
                        <span class="fw-semibold text-info">@newRate%</span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Avg visits per patient</span>
                        <span class="fw-semibold">@Math.Round(Model.AvgAppointmentsPerPatient, 1)</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent fw-semibold border-bottom">
                <i class="bi bi-bar-chart-line me-2 text-primary"></i>
                Top Active Patients
            </div>

            <div class="card-body">
                <canvas id="topPatientsChart" height="130"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent fw-semibold border-bottom">
        <i class="bi bi-table me-2 text-primary"></i>
        Patient Appointment Details
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Patient</th>
                        <th class="text-center">Total</th>
                        <th class="text-center">Completed</th>
                        <th class="text-center">Cancelled</th>
                        <th class="text-center">Missed</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in Model.PatientActivity.OrderByDescending(x => x.TotalAppointments))
                    {
                        <tr>
                            <td class="fw-semibold">@p.PatientName</td>
                            <td class="text-center">@p.TotalAppointments</td>
                            <td class="text-center text-success fw-semibold">@p.CompletedAppointments</td>
                            <td class="text-center text-warning fw-semibold">@p.CancelledAppointments</td>
                            <td class="text-center text-danger fw-semibold">@p.MissedAppointments</td>
                            <td class="text-center">
                                @if (p.IsNewPatient)
                                {
                                    <span class="badge bg-info">New</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Existing</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const patientNames = [
            @Html.Raw(string.Join(",",
                Model.PatientActivity
                        .OrderByDescending(p => p.TotalAppointments)
                        .Take(5)
                        .Select(p => $"'{p.PatientName}'")))
    ];

    const patientTotals = [
        @string.Join(",",
                        Model.PatientActivity
                                .OrderByDescending(p => p.TotalAppointments)
                                .Take(5)
                                .Select(p => p.TotalAppointments))
    ];

    new Chart(document.getElementById('topPatientsChart'), {
        type: 'bar',
        data: {
            labels: patientNames,
            datasets: [{
                label: 'Appointments',
                data: patientTotals,
                backgroundColor: '#082F49'
            }]
        },
        options: {
            responsive: true,
            indexAxis: 'y',
            plugins: {
                legend: {
                    display: false
                }
            },
            scales: {
                x: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
</script>
}