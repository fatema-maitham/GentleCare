@using ClinicReportingApp.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Good day, @Model.ManagerName</h4>
        <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>Period: @Model.PeriodLabel</small>
    </div>
    <span class="badge bg-primary px-3 py-2"><i class="bi bi-clock me-1"></i>Last 30 Days</span>
</div>

<!-- ── KPI Cards ─────────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Total Appointments</p>
                        <h3 class="fw-bold mb-0">@Model.AppointmentStats.TotalAppointments</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded p-2">
                        <i class="bi bi-calendar-check text-primary fs-4"></i>
                    </div>
                </div>
                <small class="text-success"><i class="bi bi-check-circle me-1"></i>@Model.AppointmentStats.CompletionRate% completion rate</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Total Patients</p>
                        <h3 class="fw-bold mb-0">@Model.PatientActivity.TotalPatients</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 rounded p-2">
                        <i class="bi bi-people text-success fs-4"></i>
                    </div>
                </div>
                <small class="text-primary"><i class="bi bi-person-plus me-1"></i>@Model.PatientActivity.NewPatients new this period</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Cancellation Rate</p>
                        <h3 class="fw-bold mb-0">@Model.AppointmentStats.CancellationRate%</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 rounded p-2">
                        <i class="bi bi-x-circle text-warning fs-4"></i>
                    </div>
                </div>
                <small class="text-muted">@Model.AppointmentStats.Cancelled cancelled appointments</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Prescriptions Issued</p>
                        <h3 class="fw-bold mb-0">@Model.PrescriptionStats.TotalPrescriptions</h3>
                    </div>
                    <div class="bg-info bg-opacity-10 rounded p-2">
                        <i class="bi bi-capsule text-info fs-4"></i>
                    </div>
                </div>
                <small class="text-muted">Top: @Model.PrescriptionStats.MostPrescribedMedication</small>
            </div>
        </div>
    </div>
</div>

<!-- ── Charts Row ─────────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-bottom fw-semibold">
                <i class="bi bi-bar-chart me-2 text-primary"></i>Appointment Status Breakdown
            </div>
            <div class="card-body">
                <canvas id="statusChart" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-bottom fw-semibold">
                <i class="bi bi-pie-chart me-2 text-success"></i>Appointment Outcomes
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="outcomeChart" height="180"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ── Doctor Workload Table ───────────────────────────────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-person-badge me-2 text-primary"></i>Doctor Workload</span>
        <a asp-controller="Reports" asp-action="DoctorWorkload" class="btn btn-sm btn-outline-primary">View Full Report</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Doctor</th>
                        <th>Specialization(s)</th>
                        <th class="text-center">Total</th>
                        <th class="text-center">Completed</th>
                        <th class="text-center">Workload</th>
                        <th>Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DoctorWorkload)
                    {
                        var color = d.WorkloadRate >= 70 ? "success" : d.WorkloadRate >= 50 ? "warning" : "danger";
                        <tr>
                            <td class="fw-semibold">@d.DoctorName</td>
                            <td><small class="text-muted">@string.Join(", ", d.Specializations)</small></td>
                            <td class="text-center">@d.TotalAppointments</td>
                            <td class="text-center">@d.CompletedAppointments</td>
                            <td class="text-center">
                                <span class="badge bg-@color">@d.WorkloadRate%</span>
                            </td>
                            <td style="min-width:120px;">
                                <div class="progress" style="height:6px;">
                                    <div class="progress-bar bg-@color" style="width:@d.WorkloadRate%"></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Status Bar Chart
    new Chart(document.getElementById('statusChart'), {
        type: 'bar',
        data: {
            labels: ['Completed', 'Cancelled', 'Missed', 'Pending', 'In Progress'],
            datasets: [{
                label: 'Appointments',
                data: [
                    @Model.AppointmentStats.Completed,
                    @Model.AppointmentStats.Cancelled,
                    @Model.AppointmentStats.Missed,
                    @Model.AppointmentStats.Pending,
                    @Model.AppointmentStats.InProgress
                ],
                backgroundColor: ['#22c55e','#ef4444','#f97316','#3b82f6','#a855f7']
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
    });

    // Outcome Doughnut
    new Chart(document.getElementById('outcomeChart'), {
        type: 'doughnut',
        data: {
            labels: ['Completed', 'Cancelled', 'Missed', 'Pending'],
            datasets: [{
                data: [
                    @Model.AppointmentStats.Completed,
                    @Model.AppointmentStats.Cancelled,
                    @Model.AppointmentStats.Missed,
                    @Model.AppointmentStats.Pending
                    
                        
                ],
                backgroundColor: ['#22c55e','#ef4444','#f97316','#3b82f6']
            }]
        },
        options: { responsive: true, cutout: '65%' }
    });
</script>
}
