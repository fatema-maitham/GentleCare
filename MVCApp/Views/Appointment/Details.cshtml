@model MVCApp.ViewModels.Appointment.DoctorAppointmentDetailsViewModel
@{
    ViewData["Title"] = "Appointment Details";
}

<div class="container mt-4">
    <h2 class="mb-3">Appointment Details</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Patient:</strong> @Model.PatientName</p>
                    <p><strong>Doctor:</strong> @Model.DoctorName</p>
                    <p><strong>Date:</strong> @Model.AppointmentDate.ToString("yyyy-MM-dd")</p>
                    <p><strong>Time:</strong> @Model.StartTime - @Model.EndTime</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Status:</strong> @Model.Status</p>
                    <p><strong>Notes:</strong> @(string.IsNullOrWhiteSpace(Model.Notes) ? "None" : Model.Notes)</p>
                    <p><strong>Cancellation Reason:</strong> @(string.IsNullOrWhiteSpace(Model.CancellationReason) ? "N/A" : Model.CancellationReason)</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.AllowedNextStatuses.Any())
    {
        <div class="card mb-4">
            <div class="card-header">Update Status</div>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="AppointmentId" value="@Model.Id" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Next Status</label>
                            <select name="Status" class="form-select">
                                @foreach (var status in Model.AllowedNextStatuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Cancellation Reason (if cancelling)</label>
                            <input name="CancellationReason" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">Update</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Visit Record</span>
            @if (Model.Status == "Completed" && Model.VisitRecordId == null)
            {
                <a asp-action="CreateVisitRecord" asp-route-id="@Model.Id" class="btn btn-sm btn-success">Create Visit Record</a>
            }
            else if (Model.VisitRecordId != null)
            {
                <a asp-action="AddPrescription" asp-route-visitRecordId="@Model.VisitRecordId" class="btn btn-sm btn-primary">Add Prescription</a>
            }
        </div>
        <div class="card-body">
            @if (Model.VisitRecordId == null)
            {
                <p class="mb-0">No visit record created yet.</p>
            }
            else
            {
                <p><strong>Doctor Notes:</strong> @Model.DoctorNotes</p>
                <p><strong>Diagnosis:</strong> @Model.Diagnosis</p>
                <p class="mb-0"><strong>Treatment:</strong> @(string.IsNullOrWhiteSpace(Model.Treatment) ? "None" : Model.Treatment)</p>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header">Prescriptions</div>
        <div class="card-body">
            @if (!Model.Prescriptions.Any())
            {
                <p class="mb-0">No prescriptions added yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead>
                            <tr>
                                <th>Medication</th>
                                <th>Dosage</th>
                                <th>Frequency</th>
                                <th>Days</th>
                                <th>Instructions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Prescriptions)
                            {
                                <tr>
                                    <td>@p.MedicationName</td>
                                    <td>@p.Dosage</td>
                                    <td>@p.Frequency</td>
                                    <td>@p.DurationDays</td>
                                    <td>@p.Instructions</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>