@model MVCApp.ViewModels.Appointment.CreatePrescriptionViewModel
@{
    ViewData["Title"] = "Add Prescription";
}

<div class="container mt-4">
    <h2 class="mb-3">Add Prescription</h2>

    <div class="card mb-3">
        <div class="card-body">
            <p class="mb-0"><strong>Patient:</strong> @Model.PatientName</p>
        </div>
    </div>

    <form asp-action="AddPrescription" method="post">
        <input type="hidden" asp-for="VisitRecordId" />
        <input type="hidden" asp-for="AppointmentId" />
        <input type="hidden" asp-for="PatientName" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="MedicationName" class="form-label"></label>
            <input asp-for="MedicationName" class="form-control" />
            <span asp-validation-for="MedicationName" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Dosage" class="form-label"></label>
                <input asp-for="Dosage" class="form-control" />
                <span asp-validation-for="Dosage" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Frequency" class="form-label"></label>
                <input asp-for="Frequency" class="form-control" />
                <span asp-validation-for="Frequency" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="DurationDays" class="form-label"></label>
                <input asp-for="DurationDays" class="form-control" />
                <span asp-validation-for="DurationDays" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Instructions" class="form-label"></label>
            <textarea asp-for="Instructions" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Instructions" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save Prescription</button>
        <a asp-action="Details" asp-route-id="@Model.AppointmentId" class="btn btn-secondary">Back</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}