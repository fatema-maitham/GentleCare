@model IEnumerable<WebAPI.Models.Appointment>
@{
    ViewData["Title"] = "Patient History";
    var patientName = Model.FirstOrDefault()?.Patient?.User?.FullName ?? "Patient";
}

<div class="container mt-4">
    <h2 class="mb-3">Patient History - @patientName</h2>

    <div class="accordion" id="historyAccordion">
        @for (int i = 0; i < Model.Count(); i++)
        {
            var item = Model.ElementAt(i);
            <div class="accordion-item mb-2">
                <h2 class="accordion-header" id="heading-@item.Id">
                    <button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.Id">
                        @item.AppointmentDate.ToString("yyyy-MM-dd") - @item.Status.Name - Dr. @item.Doctor.User.FullName
                    </button>
                </h2>
                <div id="collapse-@item.Id" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#historyAccordion">
                    <div class="accordion-body">
                        <p><strong>Notes:</strong> @(string.IsNullOrWhiteSpace(item.Notes) ? "None" : item.Notes)</p>

                        @if (item.VisitRecord == null)
                        {
                            <p class="mb-0">No visit record for this appointment.</p>
                        }
                        else
                        {
                            <p><strong>Doctor Notes:</strong> @item.VisitRecord.DoctorNotes</p>
                            <p><strong>Diagnosis:</strong> @item.VisitRecord.Diagnosis</p>
                            <p><strong>Treatment:</strong> @(string.IsNullOrWhiteSpace(item.VisitRecord.Treatment) ? "None" : item.VisitRecord.Treatment)</p>

                            <h6 class="mt-3">Prescriptions</h6>
                            @if (item.VisitRecord.Prescriptions.Any())
                            {
                                <ul class="mb-0">
                                    @foreach (var prescription in item.VisitRecord.Prescriptions)
                                    {
                                        <li>
                                            @prescription.MedicationName - @prescription.Dosage - @prescription.Frequency for @prescription.DurationDays days
                                            @if (!string.IsNullOrWhiteSpace(prescription.Instructions))
                                            {
                                                <span>(@prescription.Instructions)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="mb-0">No prescriptions recorded.</p>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>