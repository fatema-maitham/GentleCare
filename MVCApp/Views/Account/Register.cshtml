@model MVCApp.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<style>
    .auth-page-clean {
        max-width: 820px;
        margin: 0 auto;
        padding: 45px 0 70px;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .auth-top {
        margin-bottom: 28px;
    }

        .auth-top h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 900;
            color: #12262F;
        }

        .auth-top p {
            margin: 7px 0 0;
            color: #687A80;
            font-weight: 600;
        }

    .auth-form {
        display: grid;
        gap: 24px;
    }

    .auth-field {
        display: grid;
        grid-template-columns: 190px 1fr;
        gap: 18px;
        align-items: start;
    }

        .auth-field label {
            padding-top: 13px;
            color: #12262F;
            font-weight: 900;
        }

    .auth-input-wrap input {
        width: 100%;
        height: 50px;
        border: 1px solid #D6DDDE;
        border-radius: 14px;
        padding: 0 15px;
        outline: none;
        background: #ffffff;
        color: #12262F;
        font-weight: 650;
    }

        .auth-input-wrap input:focus {
            border-color: #00779B;
            box-shadow: 0 0 0 3px rgba(0, 119, 155, 0.14);
        }

    .auth-actions {
        display: flex;
        justify-content: center;
        margin-top: 4px;
    }

    .auth-btn {
        width: 414px;
        max-width: 100%;
        height: 50px;
        border: none;
        border-radius: 14px;
        background: #075168;
        color: #ffffff;
        font-weight: 900;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .auth-btn:hover {
            background: #00779B;
            transform: translateY(-2px);
        }

    .auth-links {
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-top: 18px;
        padding-left: 0;
    }

        .auth-links a {
            color: #075168;
            font-weight: 850;
            text-decoration: none;
        }

            .auth-links a:hover {
                text-decoration: underline;
            }

    @@media (max-width: 700px) {
        .auth-page-clean {
            padding: 35px 0 55px;
        }

        .auth-field {
            grid-template-columns: 1fr;
            gap: 7px;
        }

            .auth-field label {
                padding-top: 0;
            }

        .auth-btn {
            width: 100%;
        }

        .auth-links {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

<div class="auth-page-clean">
    <div class="auth-top">
        <h1>Create Patient Account</h1>
        <p>Register to access your patient account and appointments.</p>
    </div>

    <form asp-action="Register" method="post" class="auth-form">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="auth-field">
            <label asp-for="FullName"></label>
            <div class="auth-input-wrap">
                <input asp-for="FullName" placeholder="Enter full name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
        </div>

        <div class="auth-field">
            <label asp-for="Username"></label>
            <div class="auth-input-wrap">
                <input asp-for="Username" placeholder="Enter username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
        </div>

        <div class="auth-field">
            <label asp-for="Email"></label>
            <div class="auth-input-wrap">
                <input asp-for="Email" placeholder="Enter email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="auth-field">
            <label asp-for="Password"></label>
            <div class="auth-input-wrap">
                <input asp-for="Password" placeholder="Enter password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <div class="auth-field">
            <label asp-for="ConfirmPassword"></label>
            <div class="auth-input-wrap">
                <input asp-for="ConfirmPassword" placeholder="Confirm password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="auth-field">
            <label asp-for="CPRNumber"></label>
            <div class="auth-input-wrap">
                <input asp-for="CPRNumber" placeholder="Enter CPR number" />
                <span asp-validation-for="CPRNumber" class="text-danger"></span>
            </div>
        </div>

        <div class="auth-field">
            <label asp-for="DateOfBirth"></label>
            <div class="auth-input-wrap">
                <input asp-for="DateOfBirth" type="date" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>
        </div>

        <div class="auth-actions">
            <button type="submit" class="auth-btn">Register</button>
        </div>

        <div class="auth-links">
            <a asp-controller="Account" asp-action="Login">Already have an account? Login</a>
            <a asp-controller="Public" asp-action="Lookup">Back to Public Lookup</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}