@model MVCApp.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<section class="auth-page">

    <div class="auth-card">
        <div class="auth-header">
            <h1>Create Patient Account</h1>
        </div>

        <form asp-action="Register" method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger auth-validation"></div>

            <div class="auth-grid">
                <div class="auth-field">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" placeholder="Enter full name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Username"></label>
                    <input asp-for="Username" placeholder="Enter username" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" placeholder="Enter email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="CPRNumber"></label>
                    <input asp-for="CPRNumber" placeholder="Enter CPR number" />
                    <span asp-validation-for="CPRNumber" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="DateOfBirth"></label>
                    <input asp-for="DateOfBirth" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" placeholder="Enter password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="auth-field full">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" placeholder="Confirm password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="auth-btn">
                Register
            </button>

            <div class="auth-links">
                <a asp-controller="Account" asp-action="Login">Already have an account? Login</a>
                <a asp-controller="Public" asp-action="Lookup">Public Lookup</a>
            </div>
        </form>
    </div>

</section>

<style>
    body {
        background: #f1efed;
    }

    .auth-page {
        min-height: calc(100vh - 90px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 18px;
    }

    .auth-card {
        width: 100%;
        max-width: 820px;
        background: #ffffff;
        border: 1px solid #d6ddde;
        border-radius: 24px;
        overflow: hidden;
    }

    .auth-header {
        padding: 24px 28px;
        border-bottom: 1px solid #e9eeee;
    }

        .auth-header h1 {
            margin: 0;
            color: #075168;
            font-size: 30px;
            font-weight: 900;
        }

    .auth-form {
        padding: 28px;
        display: grid;
        gap: 20px;
    }

    .auth-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .auth-field {
        display: grid;
        gap: 8px;
    }

        .auth-field.full {
            grid-column: 1 / -1;
        }

        .auth-field label {
            color: #12262f;
            font-weight: 900;
        }

        .auth-field input {
            width: 100%;
            height: 50px;
            border: 1px solid #d6ddde;
            border-radius: 14px;
            padding: 0 15px;
            color: #12262f;
            font-weight: 700;
            outline: none;
        }

            .auth-field input:focus {
                border-color: #075168;
                box-shadow: 0 0 0 3px rgba(7, 81, 104, 0.13);
            }

    .auth-btn {
        width: 100%;
        max-width: 420px;
        height: 52px;
        margin: 0 auto;
        border: none;
        border-radius: 14px;
        background: #075168;
        color: #ffffff;
        font-weight: 900;
        font-size: 16px;
    }

        .auth-btn:hover {
            background: #00779b;
        }

    .auth-links {
        display: flex;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
    }

        .auth-links a {
            color: #075168;
            font-weight: 900;
            text-decoration: none;
        }

            .auth-links a:hover {
                text-decoration: underline;
            }

    .auth-validation {
        font-weight: 800;
    }

    @@media (max-width: 700px) {
        .auth-grid

    {
        grid-template-columns: 1fr;
    }

    .auth-card {
        border-radius: 20px;
    }

    .auth-header,
    .auth-form {
        padding: 22px;
    }

    .auth-btn {
        max-width: 100%;
    }

    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}