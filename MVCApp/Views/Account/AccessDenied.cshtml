@{
    ViewData["Title"] = "Access Denied";
}

<style>
    .access-page {
        max-width: 760px;
        margin: 0 auto;
        padding: 55px 0;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .access-title {
        font-size: 34px;
        font-weight: 900;
        color: #12262F;
        margin: 0 0 10px;
    }

    .access-text {
        color: #687A80;
        font-size: 16px;
        font-weight: 650;
        margin-bottom: 24px;
    }

    .access-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 18px;
        border-radius: 14px;
        background: #075168;
        color: #ffffff;
        font-weight: 900;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .access-btn:hover {
            background: #00779B;
            color: #ffffff;
            transform: translateY(-2px);
        }
</style>

<div class="access-page">
    <h1 class="access-title">Access Denied</h1>
    <p class="access-text">You do not have permission to access this page.</p>

    <a asp-controller="Public" asp-action="Lookup" class="access-btn">
        Back to Public Lookup
    </a>
</div>