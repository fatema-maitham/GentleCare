@model MVCApp.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<section class="auth-page">

    <div class="auth-card">
        <div class="auth-header">
            <h1>Login</h1>
        </div>

        <form asp-action="Login" method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="text-danger auth-validation"></div>

            <div class="auth-field">
                <label asp-for="UsernameOrEmail"></label>
                <input asp-for="UsernameOrEmail" placeholder="Enter username or email" />
                <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" placeholder="Enter password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="auth-check">
                <input asp-for="RememberMe" />
                <label asp-for="RememberMe"></label>
            </div>

            <button type="submit" class="auth-btn">
                Login
            </button>

            <div class="auth-links">
                <a asp-controller="Account" asp-action="Register">Create Patient Account</a>
                <a asp-controller="Public" asp-action="Lookup">Public Lookup</a>
            </div>
        </form>
    </div>

</section>

<style>
    body {
        background: #f1efed;
    }

    .auth-page {
        min-height: calc(100vh - 90px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 18px;
    }

    .auth-card {
        width: 100%;
        max-width: 560px;
        background: #ffffff;
        border: 1px solid #d6ddde;
        border-radius: 24px;
        overflow: hidden;
    }

    .auth-header {
        padding: 24px 28px;
        border-bottom: 1px solid #e9eeee;
    }

        .auth-header h1 {
            margin: 0;
            color: #075168;
            font-size: 30px;
            font-weight: 900;
        }

    .auth-form {
        padding: 28px;
        display: grid;
        gap: 18px;
    }

    .auth-field {
        display: grid;
        gap: 8px;
    }

        .auth-field label {
            color: #12262f;
            font-weight: 900;
        }

        .auth-field input {
            width: 100%;
            height: 50px;
            border: 1px solid #d6ddde;
            border-radius: 14px;
            padding: 0 15px;
            color: #12262f;
            font-weight: 700;
            outline: none;
        }

            .auth-field input:focus {
                border-color: #075168;
                box-shadow: 0 0 0 3px rgba(7, 81, 104, 0.13);
            }

    .auth-check {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #12262f;
        font-weight: 800;
    }

        .auth-check input {
            width: 18px;
            height: 18px;
        }

    .auth-btn {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 14px;
        background: #075168;
        color: #ffffff;
        font-weight: 900;
        font-size: 16px;
    }

        .auth-btn:hover {
            background: #00779b;
        }

    .auth-links {
        display: flex;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

        .auth-links a {
            color: #075168;
            font-weight: 900;
            text-decoration: none;
        }

            .auth-links a:hover {
                text-decoration: underline;
            }

    .auth-validation {
        font-weight: 800;
    }

    @@media (max-width: 600px) {
        .auth-card

    {
        border-radius: 20px;
    }

    .auth-header,
    .auth-form {
        padding: 22px;
    }

    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}