@model MVCApp.ViewModels.ClinicManager.ClinicManagerDoctorsViewModel

@{
    ViewData["Title"] = "Manage Doctors";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">Manage Doctors</h2>
            <p class="text-muted mb-0">Doctor profiles, access, and quick actions</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="ClinicManager" asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
            <a asp-controller="ClinicManager" asp-action="CreateDoctor" class="btn btn-primary">Create Doctor</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="ClinicManager" asp-action="Doctors" method="get" class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Search" class="form-label">Search</label>
                    <input asp-for="Search" class="form-control" placeholder="Search by name, email, or license number" />
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a asp-controller="ClinicManager" asp-action="Doctors" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Doctors</h5>
            <span class="badge bg-primary">@Model.Doctors.Count</span>
        </div>

        <div class="card-body p-0">
            @if (Model.Doctors == null || !Model.Doctors.Any())
            {
                <div class="p-4 text-center text-muted">No doctors found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Doctor</th>
                                <th>License</th>
                                <th>Specializations</th>
                                <th>Status</th>
                                <th>Upcoming Appointments</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doctor in Model.Doctors)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@doctor.FullName</div>
                                        <div class="small text-muted">@doctor.Email</div>
                                    </td>
                                    <td>@doctor.LicenseNumber</td>
                                    <td>
                                        @if (doctor.Specializations == null || !doctor.Specializations.Any())
                                        {
                                            <span class="text-muted">No specializations</span>
                                        }
                                        else
                                        {
                                            @string.Join(", ", doctor.Specializations)
                                        }
                                    </td>
                                    <td>
                                        @if (doctor.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@doctor.UpcomingAppointmentsCount</td>
                                    <td class="text-end">
                                        <div class="d-flex flex-wrap justify-content-end gap-2">
                                            <a asp-action="DoctorDetails" asp-route-id="@doctor.DoctorId" class="btn btn-sm btn-outline-primary">Details</a>
                                            <a asp-action="EditDoctor" asp-route-id="@doctor.DoctorId" class="btn btn-sm btn-outline-warning">Edit</a>
                                            <a asp-action="ManageSpecializations" asp-route-doctorId="@doctor.DoctorId" class="btn btn-sm btn-outline-info">Specializations</a>
                                            <a asp-action="ManageSchedule" asp-route-doctorId="@doctor.DoctorId" class="btn btn-sm btn-outline-success">Schedule</a>
                                            <a asp-action="ManageLeaves" asp-route-doctorId="@doctor.DoctorId" class="btn btn-sm btn-outline-danger">Leaves</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
