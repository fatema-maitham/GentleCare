@model MVCApp.ViewModels.ClinicManager.ClinicManagerDoctorListViewModel

@{
    ViewData["Title"] = "Doctors";

    string StatusClass(string status) => status?.ToLower().Replace(" ", "") switch
    {
        "available" => "status-completed",
        "active" => "status-completed",   
        "inactive" => "status-cancelled",   
        "onleave" => "status-inprogress",  
        "requested" => "status-requested",
        "confirmed" => "status-confirmed",
        "inprogress" => "status-inprogress",
        "checkedin" => "status-checkedin",
        "completed" => "status-completed",
        "cancelled" => "status-cancelled",
        "missed" => "status-missed",
        _ => "status-default"
    };

}

<div class="manager-page">
    <div class="manager-card">
        <div class="card-head">
            <h2>@(ViewData["Title"] ?? "Clinic Manager")</h2>
        </div>
    </div>

    <div class="manager-top">
        <a asp-controller="ClinicManager" asp-action="CreateDoctor" class="btn-main">Add Doctor</a>
    </div>


    <div class="manager-grid">
        <div class="manager-stat"><span>Total Doctors</span><strong>@Model.TotalDoctors</strong></div>
        <div class="manager-stat"><span>Active</span><strong>@Model.ActiveDoctors</strong></div>
        <div class="manager-stat"><span>On Leave Today</span><strong>@Model.DoctorsOnLeaveToday</strong></div>
        <div class="manager-stat"><span>With Appointments</span><strong>@Model.DoctorsWithAppointmentsToday</strong></div>
    </div>

    <div class="manager-card">
        <form asp-controller="ClinicManager" asp-action="Doctors" method="get" class="filter-form">
            <div class="form-group">
                <label for="searchTerm">Search</label>
                <input id="searchTerm" name="searchTerm" value="@Model.SearchTerm" placeholder="Doctor name, email, license" />
            </div>

            <div class="form-group">
                <label for="isActive">Status</label>
                <select id="isActive" name="isActive">
                    <option value="">All Doctors</option>
                    <option value="true" selected="@(Model.IsActive == true)">Active Only</option>
                    <option value="false" selected="@(Model.IsActive == false)">Inactive Only</option>
                </select>
            </div>

            <button type="submit" class="btn-main">Filter</button>
            <a asp-controller="ClinicManager" asp-action="Doctors" class="btn-light">Clear</a>
        </form>
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>Doctor List</h2>
        </div>

        @if (Model.HasDoctors)
        {
            <div class="manager-table-wrap">
                <table class="manager-table">
                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Specializations</th>
                            <th>Status</th>
                            <th>Today</th>
                            <th>Upcoming</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doctor in Model.Doctors)
                        {
                            <tr>
                                <td>
                                    <strong>Dr. @doctor.FullName</strong><br />
                                    <span class="muted">@doctor.Email</span>
                                </td>
                                <td>@doctor.SpecializationsText</td>
                                <td>
                                    <span class="status-pill @StatusClass(doctor.StatusText)">@doctor.StatusText</span>
                                    <span class="status-pill @StatusClass(doctor.LeaveStatusText)">@doctor.LeaveStatusText</span>
                                </td>
                                <td>@doctor.TodayAppointmentsCount</td>
                                <td>@doctor.UpcomingAppointmentsCount</td>
                                <td>
                                    <a asp-controller="ClinicManager" asp-action="DoctorDetails" asp-route-id="@doctor.DoctorId" class="table-link">Details</a>
                                    <a asp-controller="ClinicManager" asp-action="EditDoctor" asp-route-id="@doctor.DoctorId" class="table-link">Edit</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">@Model.EmptyMessage</div>
        }
    </div>
</div>
