@model MVCApp.ViewModels.ClinicManager.ClinicManagerAppointmentsViewModel

@{
    ViewData["Title"] = "Clinic Appointments";
}

<div class="page-header">
    <div>
        <h1>Clinic Appointments</h1>
        <p>View and filter all clinic appointments.</p>
    </div>

    <a asp-controller="ClinicManager"
       asp-action="Dashboard"
       class="secondary-btn">
        Back to Dashboard
    </a>
</div>

@if (TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="dashboard-grid">
    <div class="dashboard-card">
        <span class="card-label">Total</span>
        <h2>@Model.TotalAppointments</h2>
        <p>Appointments found</p>
    </div>

    <div class="dashboard-card">
        <span class="card-label">Requested</span>
        <h2>@Model.RequestedAppointments</h2>
        <p>Waiting approval</p>
    </div>

    <div class="dashboard-card">
        <span class="card-label">Confirmed</span>
        <h2>@Model.ConfirmedAppointments</h2>
        <p>Confirmed appointments</p>
    </div>

    <div class="dashboard-card">
        <span class="card-label">Completed</span>
        <h2>@Model.CompletedAppointments</h2>
        <p>Finished visits</p>
    </div>

    <div class="dashboard-card warning-card">
        <span class="card-label">Cancelled</span>
        <h2>@Model.CancelledAppointments</h2>
        <p>Cancelled appointments</p>
    </div>

    <div class="dashboard-card danger-card">
        <span class="card-label">Missed</span>
        <h2>@Model.MissedAppointments</h2>
        <p>Missed appointments</p>
    </div>
</div>

<div class="section-card">
    <div class="section-header">
        <h2>Filters</h2>

        @if (Model.HasFilters)
        {
        <a asp-controller="ClinicManager"
           asp-action="Appointments"
           class="btn-link">
            Clear filters
        </a>
        }
    </div>

    <form asp-controller="ClinicManager" asp-action="Appointments" method="get" class="filter-form">
        <div class="form-group">
            <label for="doctorId">Doctor</label>
            <select id="doctorId" name="doctorId" asp-items="Model.DoctorOptions">
                <option value="">All doctors</option>
            </select>
        </div>

        <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status" asp-items="Model.StatusOptions">
                <option value="">All statuses</option>
            </select>
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input type="date"
                   id="date"
                   name="date"
                   value="@(Model.SelectedDate.HasValue ? Model.SelectedDate.Value.ToString("yyyy-MM-dd") : "")" />
        </div>

        <div class="form-group">
            <label for="searchTerm">Search</label>
            <input type="text"
                   id="searchTerm"
                   name="searchTerm"
                   value="@Model.SearchTerm"
                   placeholder="Patient, doctor, CPR, reference number" />
        </div>

        <button type="submit" class="primary-btn">Search</button>
    </form>
</div>

<div class="section-card">
    <div class="section-header">
        <h2>Appointment List</h2>
        <span class="muted-text">@Model.TotalAppointments appointments</span>
    </div>

    @if (Model.HasAppointments)
    {
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Status</th>
                    <th>Reference</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var appointment in Model.Appointments)
                    {
                <tr>
                    <td>@appointment.DateText</td>
                    <td>@appointment.TimeText</td>
                    <td>@appointment.PatientName</td>
                    <td>Dr. @appointment.DoctorName</td>
                    <td>
                        <span class="status-pill">@appointment.StatusName</span>
                    </td>
                    <td>@appointment.PatientReferenceNumber</td>
                    <td>
                        <a asp-controller="ClinicManager"
                           asp-action="AppointmentDetails"
                           asp-route-id="@appointment.AppointmentId"
                           class="table-link">
                            Details
                        </a>

                        @if (appointment.CanUpdateStatus)
                                {
                        <a asp-controller="ClinicManager"
                           asp-action="UpdateAppointmentStatus"
                           asp-route-id="@appointment.AppointmentId"
                           class="table-link">
                            Update Status
                        </a>
                                }
                    </td>
                </tr>
                    }
            </tbody>
        </table>
    </div>
    }
    else
    {
    <p class="empty-text">No appointments found.</p>
    }
</div>