@model MVCApp.ViewModels.ClinicManager.ClinicManagerAppointmentsViewModel

@{
    ViewData["Title"] = "All Appointments";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">All Appointments</h2>
            <p class="text-muted mb-0">Clinic-wide appointment overview</p>
        </div>
        <a asp-controller="ClinicManager" asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="ClinicManager" asp-action="Appointments" method="get" class="row g-3">
                <div class="col-md-4">
                    <label asp-for="SelectedDoctorId" class="form-label">Doctor</label>
                    <select asp-for="SelectedDoctorId" asp-items="Model.DoctorOptions" class="form-select">
                        <option value="">All Doctors</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="SelectedStatus" class="form-label">Status</label>
                    <select asp-for="SelectedStatus" asp-items="Model.StatusOptions" class="form-select">
                        <option value="">All Statuses</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="SelectedDate" class="form-label">Date</label>
                    <input asp-for="SelectedDate" class="form-control" type="date" />
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Apply Filter</button>
                    <a asp-controller="ClinicManager" asp-action="Appointments" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Appointments</h5>
            <span class="badge bg-primary">@Model.Appointments.Count</span>
        </div>

        <div class="card-body p-0">
            @if (Model.Appointments == null || !Model.Appointments.Any())
            {
                <div class="p-4 text-center text-muted">No appointments found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th>Impact</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Appointments)
                            {
                                <tr>
                                    <td>@item.AppointmentDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                                    <td>@item.PatientName</td>
                                    <td>@item.DoctorName</td>
                                    <td>@item.StatusName</td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <span class="text-muted">No notes</span>
                                        }
                                        else
                                        {
                                            @item.Notes
                                        }
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(item.ImpactReason))
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@item.ImpactReason</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
