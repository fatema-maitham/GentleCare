@model MVCApp.ViewModels.ClinicManager.ClinicManagerAppointmentsViewModel

@{
    ViewData["Title"] = "Clinic Appointments";
    var selectedDateValue = Model.SelectedDate?.ToString("yyyy-MM-dd");

    string StatusClass(string status) => status?.ToLower().Replace(" ", "") switch
    {
        "requested" => "status-requested",
        "confirmed" => "status-confirmed",
        "inprogress" => "status-inprogress",
        "checkedin" => "status-checkedin",
        "completed" => "status-completed",
        "cancelled" => "status-cancelled",
        "missed" => "status-missed",
        _ => "status-default"
    };
}

<div class="manager-page">
    
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}


    <div class="manager-grid">
        <div class="manager-stat"><span>Total</span><strong>@Model.TotalAppointments</strong></div>
        <div class="manager-stat"><span>Requested</span><strong>@Model.RequestedAppointments</strong></div>
        <div class="manager-stat"><span>Confirmed</span><strong>@Model.ConfirmedAppointments</strong></div>
        <div class="manager-stat"><span>Completed</span><strong>@Model.CompletedAppointments</strong></div>
    </div>

    <div class="manager-card">
        <form asp-controller="ClinicManager" asp-action="Appointments" method="get" class="filter-form">
            <div class="form-group">
                <label for="searchTerm">Search</label>
                <input id="searchTerm" name="searchTerm" value="@Model.SearchTerm" placeholder="Patient, doctor, reference" />
            </div>

            <div class="form-group">
                <label for="doctorId">Doctor</label>
                <select id="doctorId" name="doctorId" asp-items="Model.DoctorOptions">
                    <option value="">All Doctors</option>
                </select>
            </div>

            <div class="form-group">
                <label for="status">Status</label>
                <select id="status" name="status" asp-items="Model.StatusOptions">
                    <option value="">All Statuses</option>
                </select>
            </div>

            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" value="@selectedDateValue" />
            </div>

            <button type="submit" class="btn-main">Filter</button>
            <a asp-controller="ClinicManager" asp-action="Appointments" class="btn-light">Clear</a>
        </form>
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>Appointments</h2>
        </div>

        @if (Model.HasAppointments)
        {
            <div class="manager-table-wrap">
                <table class="manager-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appointment in Model.Appointments)
                        {
                            <tr>
                                <td>@appointment.DateText</td>
                                <td>@appointment.TimeText</td>
                                <td>
                                    <strong>@appointment.PatientName</strong><br />
                                    <span class="muted">@appointment.PatientReferenceNumber</span>
                                </td>
                                <td>Dr. @appointment.DoctorName</td>
                                <td>@appointment.SpecializationName</td>
                                <td><span class="status-pill @StatusClass(appointment.StatusName)">@appointment.StatusName</span></td>
                                <td>
                                    <a asp-controller="ClinicManager" asp-action="AppointmentDetails" asp-route-id="@appointment.AppointmentId" class="table-link">Details</a>
                                    @if (appointment.CanUpdateStatus)
                                    {
                                        <a asp-controller="ClinicManager" asp-action="UpdateAppointmentStatus" asp-route-id="@appointment.AppointmentId" class="table-link">Update</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">No appointments found.</div>
        }
    </div>
</div>
