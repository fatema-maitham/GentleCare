@model MVCApp.ViewModels.ClinicManager.ClinicManagerAppointmentsViewModel

@{
    ViewData["Title"] = "Clinic Appointments";
    var selectedDateValue = Model.SelectedDate?.ToString("yyyy-MM-dd");
}


<style>
    :root {
        --gc-main: #075168;
        --gc-main-dark: #043C4D;
        --gc-text: #12262F;
        --gc-muted: #687A80;
        --gc-border: #D6DDDE;
        --gc-soft: #F7FAFA;
        --gc-bg: #F1EFED;
        --gc-danger: #B42318;
        --gc-success: #157347;
    }

    .manager-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 22px 0 56px;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .manager-top {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

    .manager-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 18px;
    }

    .manager-stat,
    .manager-card {
        background: #fff;
        border: 1px solid var(--gc-border);
        border-radius: 18px;
        box-shadow: 0 8px 20px rgba(7, 81, 104, 0.06);
    }

    .manager-stat {
        padding: 18px;
    }

    .manager-stat span {
        display: block;
        color: var(--gc-muted);
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .manager-stat strong {
        display: block;
        color: var(--gc-main);
        font-size: 30px;
        font-weight: 900;
        line-height: 1;
    }

    .manager-card {
        padding: 22px;
        margin-bottom: 18px;
    }

    .card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

    .card-head h2 {
        margin: 0;
        color: var(--gc-text);
        font-size: 20px;
        font-weight: 900;
    }

    .muted {
        color: var(--gc-muted);
        font-weight: 700;
        font-size: 14px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .info-box {
        background: var(--gc-soft);
        border: 1px solid #E2E8EA;
        border-radius: 14px;
        padding: 14px;
    }

    .info-box span {
        display: block;
        color: var(--gc-muted);
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .info-box strong {
        display: block;
        color: var(--gc-text);
        font-size: 15px;
        font-weight: 900;
        word-break: break-word;
    }

    .manager-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .manager-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
    }

    .manager-table th {
        text-align: left;
        padding: 13px 12px;
        color: var(--gc-muted);
        font-size: 13px;
        font-weight: 900;
        border-bottom: 1px solid #E5ECEE;
        background: #FAFCFC;
        white-space: nowrap;
    }

    .manager-table td {
        padding: 14px 12px;
        color: var(--gc-text);
        font-size: 14px;
        font-weight: 650;
        border-bottom: 1px solid #EEF2F3;
        vertical-align: top;
    }

    .manager-table tr:last-child td {
        border-bottom: none;
    }

    .filter-form,
    .manager-form {
        display: grid;
        gap: 16px;
    }

    .filter-form {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        align-items: end;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .form-group.full {
        grid-column: 1 / -1;
    }

    .form-group label {
        color: var(--gc-text);
        font-size: 14px;
        font-weight: 900;
    }

    .form-control,
    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        min-height: 44px;
        border: 1px solid #B9CBD0;
        border-radius: 12px;
        padding: 10px 12px;
        color: var(--gc-text);
        background: #fff;
        font-size: 15px;
        font-weight: 650;
        outline: none;
    }

    .form-group textarea {
        min-height: 120px;
        resize: vertical;
    }

    .form-control:focus,
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        border-color: var(--gc-main);
        box-shadow: 0 0 0 3px rgba(7, 81, 104, 0.12);
    }

    .check-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .check-item {
        border: 1px solid #E2E8EA;
        background: #FAFCFC;
        border-radius: 14px;
        padding: 12px;
        display: flex;
        gap: 10px;
        align-items: flex-start;
        font-weight: 800;
        color: var(--gc-text);
    }

    .check-item small {
        display: block;
        color: var(--gc-muted);
        font-weight: 650;
        margin-top: 3px;
    }

    .actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-main,
    .btn-light,
    .btn-danger,
    .table-link {
        border: 0;
        border-radius: 12px;
        padding: 10px 14px;
        font-weight: 900;
        font-size: 14px;
        text-decoration: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
    }

    .btn-main {
        background: var(--gc-main);
        color: #fff;
    }

    .btn-main:hover {
        background: var(--gc-main-dark);
        color: #fff;
    }

    .btn-light {
        background: #F1EFED;
        color: var(--gc-text);
        border: 1px solid var(--gc-border);
    }

    .btn-danger {
        background: #FFF1F0;
        color: var(--gc-danger);
        border: 1px solid #F3B8B2;
    }

    .table-link {
        background: #EEF6F8;
        color: var(--gc-main);
        padding: 7px 10px;
        min-height: 32px;
        margin: 2px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 6px 10px;
        background: #EAF4F6;
        color: var(--gc-main);
        font-size: 12px;
        font-weight: 900;
        white-space: nowrap;
    }

    .empty-box {
        background: #FAFCFC;
        border: 1px dashed #B9CBD0;
        border-radius: 16px;
        padding: 22px;
        color: var(--gc-muted);
        font-weight: 800;
        text-align: center;
    }

    .alert {
        border-radius: 14px;
        padding: 13px 15px;
        margin-bottom: 16px;
        font-weight: 800;
        border: 1px solid transparent;
    }

    .alert-success {
        background: #ECFDF3;
        color: var(--gc-success);
        border-color: #B7E4C7;
    }

    .alert-danger {
        background: #FFF1F0;
        color: var(--gc-danger);
        border-color: #F3B8B2;
    }

    .text-danger {
        color: var(--gc-danger);
        font-size: 13px;
        font-weight: 800;
    }

    .profile-page {
        max-width: 760px;
        margin: 40px auto;
        padding: 20px;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .profile-card {
        background: #fff;
        border: 1px solid var(--gc-border);
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 8px 20px rgba(7, 81, 104, 0.06);
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-bottom: 22px;
        border-bottom: 1px solid #E5ECEE;
    }

    .profile-image-wrapper {
        position: relative;
        width: 96px;
        height: 96px;
        flex-shrink: 0;
    }

    .profile-img {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #D9E2E4;
    }

    .camera-btn {
        position: absolute;
        right: -2px;
        bottom: 2px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--gc-main);
        color: #fff;
        border: 3px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 15px;
    }

    .profile-header h2 {
        margin: 0;
        color: var(--gc-text);
        font-weight: 900;
    }

    .profile-info {
        margin-top: 24px;
        display: grid;
        gap: 14px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        padding: 14px 0;
        border-bottom: 1px solid #EEF2F3;
    }

    .info-row span {
        color: var(--gc-muted);
        font-weight: 800;
    }

    .info-row strong {
        color: var(--gc-text);
        text-align: right;
        font-weight: 900;
    }

    .profile-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
        flex-wrap: wrap;
    }

    .d-none {
        display: none;
    }

    @@media (max-width: 900px) {
        .manager-grid,
        .info-grid,
        .form-grid,
        .filter-form,
        .check-list {
            grid-template-columns: 1fr;
        }

        .manager-page {
            padding-left: 12px;
            padding-right: 12px;
        }

        .profile-header {
            align-items: flex-start;
        }
    }
</style>


<div class="manager-page">
    
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}


    <div class="manager-grid">
        <div class="manager-stat"><span>Total</span><strong>@Model.TotalAppointments</strong></div>
        <div class="manager-stat"><span>Requested</span><strong>@Model.RequestedAppointments</strong></div>
        <div class="manager-stat"><span>Confirmed</span><strong>@Model.ConfirmedAppointments</strong></div>
        <div class="manager-stat"><span>Completed</span><strong>@Model.CompletedAppointments</strong></div>
    </div>

    <div class="manager-card">
        <form asp-controller="ClinicManager" asp-action="Appointments" method="get" class="filter-form">
            <div class="form-group">
                <label for="searchTerm">Search</label>
                <input id="searchTerm" name="searchTerm" value="@Model.SearchTerm" placeholder="Patient, doctor, reference" />
            </div>

            <div class="form-group">
                <label for="doctorId">Doctor</label>
                <select id="doctorId" name="doctorId" asp-items="Model.DoctorOptions">
                    <option value="">All Doctors</option>
                </select>
            </div>

            <div class="form-group">
                <label for="status">Status</label>
                <select id="status" name="status" asp-items="Model.StatusOptions">
                    <option value="">All Statuses</option>
                </select>
            </div>

            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" value="@selectedDateValue" />
            </div>

            <button type="submit" class="btn-main">Filter</button>
            <a asp-controller="ClinicManager" asp-action="Appointments" class="btn-light">Clear</a>
        </form>
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>Appointments</h2>
        </div>

        @if (Model.HasAppointments)
        {
            <div class="manager-table-wrap">
                <table class="manager-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appointment in Model.Appointments)
                        {
                            <tr>
                                <td>@appointment.DateText</td>
                                <td>@appointment.TimeText</td>
                                <td>
                                    <strong>@appointment.PatientName</strong><br />
                                    <span class="muted">@appointment.PatientReferenceNumber</span>
                                </td>
                                <td>Dr. @appointment.DoctorName</td>
                                <td>@appointment.SpecializationName</td>
                                <td><span class="status-pill">@appointment.StatusName</span></td>
                                <td>
                                    <a asp-controller="ClinicManager" asp-action="AppointmentDetails" asp-route-id="@appointment.AppointmentId" class="table-link">Details</a>
                                    @if (appointment.CanUpdateStatus)
                                    {
                                        <a asp-controller="ClinicManager" asp-action="UpdateAppointmentStatus" asp-route-id="@appointment.AppointmentId" class="table-link">Update</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">No appointments found.</div>
        }
    </div>
</div>
