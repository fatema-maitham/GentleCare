@model MVCApp.ViewModels.ClinicManager.DoctorLeaveFormViewModel

@{
    ViewData["Title"] = "Edit Doctor Leave";
}

<div class="manager-page">
    <div class="manager-card">
        <div class="card-head">
            <h2>@(ViewData["Title"] ?? "Clinic Manager")</h2>
        </div>
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>@Model.PageTitle</h2>
            <span class="status-pill">Dr. @Model.DoctorName</span>
        </div>

        <form asp-controller="ClinicManager" asp-action="EditDoctorLeave" method="post" class="manager-form">
            @Html.AntiForgeryToken()

            <input asp-for="DoctorLeaveId" type="hidden" />
            <input asp-for="DoctorId" type="hidden" />
            <input asp-for="DoctorName" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="LeaveStartDate"></label>
                    <input asp-for="LeaveStartDate" type="date" />
                    <span asp-validation-for="LeaveStartDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LeaveEndDate"></label>
                    <input asp-for="LeaveEndDate" type="date" />
                    <span asp-validation-for="LeaveEndDate" class="text-danger"></span>
                </div>

                <div class="form-group full">
                    <label asp-for="LeaveReason"></label>
                    <textarea asp-for="LeaveReason" placeholder="Reason for leave"></textarea>
                    <span asp-validation-for="LeaveReason" class="text-danger"></span>
                </div>
            </div>

            <div class="actions">
                <button type="submit" class="btn-main">Save Leave</button>
                <a asp-controller="ClinicManager" asp-action="ManageDoctorLeaves" asp-route-doctorId="@Model.DoctorId" class="btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
