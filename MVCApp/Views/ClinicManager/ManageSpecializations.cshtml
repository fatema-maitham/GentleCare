@model MVCApp.ViewModels.ClinicManager.ManageDoctorSpecializationsViewModel

@{
    ViewData["Title"] = "Manage Specializations";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Manage Specializations</h2>
            <p class="text-muted mb-0">@Model.DoctorName</p>
        </div>

        <a asp-controller="ClinicManager"
           asp-action="DoctorDetails"
           asp-route-id="@Model.DoctorId"
           class="btn btn-outline-secondary">
            Back to Details
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-controller="ClinicManager"
                  asp-action="ManageSpecializations"
                  method="post">
                @Html.AntiForgeryToken()
                <input asp-for="DoctorId" type="hidden" />

                @if (Model.Specializations != null && Model.Specializations.Any())
                {
                    <div class="row g-3">
                        @for (int i = 0; i < Model.Specializations.Count; i++)
                        {
                            <div class="col-md-6">
                                <div class="border rounded p-3 h-100">
                                    <div class="form-check m-0">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="spec_@Model.Specializations[i].SpecializationId"
                                               name="SelectedSpecializationIds"
                                               value="@Model.Specializations[i].SpecializationId"
                                               @(Model.Specializations[i].IsSelected ? "checked" : null) />

                                        <label class="form-check-label fw-semibold ms-1"
                                               for="spec_@Model.Specializations[i].SpecializationId">
                                            @Model.Specializations[i].SpecializationName
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        No specializations found. Please add specialization data to the database first.
                    </div>
                }

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Save Specializations
                    </button>

                    <a asp-controller="ClinicManager"
                       asp-action="DoctorDetails"
                       asp-route-id="@Model.DoctorId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>