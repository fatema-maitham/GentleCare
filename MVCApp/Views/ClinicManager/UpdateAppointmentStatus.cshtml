@model MVCApp.ViewModels.ClinicManager.ClinicManagerAppointmentStatusViewModel

@{
    ViewData["Title"] = "Update Appointment Status";

    string StatusClass(string status) => status?.ToLower().Replace(" ", "") switch
    {
        "requested" => "status-requested",
        "confirmed" => "status-confirmed",
        "inprogress" => "status-inprogress",
        "checkedin" => "status-checkedin",
        "completed" => "status-completed",
        "cancelled" => "status-cancelled",
        "missed" => "status-missed",
        _ => "status-default"
    };
}

<div class="manager-page">


    <div class="manager-card">
        <div class="card-head">
            <h2>Appointment Summary</h2>
            <span class="status-pill @StatusClass(Model.CurrentStatusName)">@Model.CurrentStatusName</span>
        </div>

        <div class="info-grid">
            <div class="info-box"><span>Patient</span><strong>@Model.PatientName</strong></div>
            <div class="info-box"><span>Doctor</span><strong>Dr. @Model.DoctorName</strong></div>
            <div class="info-box"><span>Date</span><strong>@Model.DateText</strong></div>
            <div class="info-box"><span>Time</span><strong>@Model.TimeText</strong></div>
        </div>
    </div>

    <div class="manager-card">
        <form asp-controller="ClinicManager" asp-action="UpdateAppointmentStatus" method="post" class="manager-form">
            @Html.AntiForgeryToken()

            <input asp-for="AppointmentId" type="hidden" />
            <input asp-for="DoctorId" type="hidden" />
            <input asp-for="PatientId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="NewStatusName"></label>
                    <select asp-for="NewStatusName" asp-items="Model.StatusOptions">
                        <option value="">Select status</option>
                    </select>
                    <span asp-validation-for="NewStatusName" class="text-danger"></span>
                </div>

                <div class="form-group full">
                    <label asp-for="CancellationReason"></label>
                    <textarea asp-for="CancellationReason" placeholder="Required when cancelling the appointment"></textarea>
                    <span asp-validation-for="CancellationReason" class="text-danger"></span>
                </div>
            </div>

            <div class="actions">
                <button type="submit" class="btn-main">Save Status</button>
                <a asp-controller="ClinicManager" asp-action="AppointmentDetails" asp-route-id="@Model.AppointmentId" class="btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
