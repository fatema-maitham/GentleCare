@model MVCApp.ViewModels.ClinicManager.ClinicManagerUserAccountsViewModel

@{
    ViewData["Title"] = "User Accounts";
}

<div class="manager-page">
<div class="accounts-page">

    <div class="accounts-card">
        <div class="accounts-card-header">
            <h4>Search and Filter</h4>
        </div>

        <form asp-action="UserAccounts" method="get" class="accounts-filter">
            <div class="form-group">
                <label>Search</label>
                <input asp-for="SearchTerm" placeholder="Name, email, or role" />
            </div>

            <div class="form-group">
                <label>Role</label>
                <select asp-for="SelectedRole" asp-items="Model.RoleOptions"></select>
            </div>

            <div class="form-group">
                <label>Status</label>
                <select asp-for="IsActive" asp-items="Model.StatusOptions"></select>
            </div>

            <div class="filter-actions">
                <button type="submit" class="primary-btn">Apply</button>
                <a asp-action="UserAccounts" class="secondary-btn">Clear</a>
            </div>
        </form>
    </div>

    <div class="accounts-card">
        <div class="accounts-card-header accounts-header-row">
            <h4>Accounts</h4>
            <span>@Model.Users.Count account(s)</span>
        </div>

        @if (Model.Users.Any())
        {
            <div class="accounts-table-wrap">
                <table class="accounts-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="action-col">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <strong>@user.FullName</strong>
                                </td>
                                <td>@user.Email</td>
                                <td>@user.RoleName</td>
                                <td>
                                    <span class="status-badge @(user.IsActive ? "active" : "inactive")">
                                        @user.StatusText
                                    </span>
                                </td>
                                <td>@user.CreatedAtDisplay</td>
                                <td class="action-col">
                                    <form asp-action="ToggleUserStatus" method="post"
                                          onsubmit="return confirm('Are you sure you want to change this account status?');">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="userId" value="@user.UserId" />

                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="danger-btn">
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="success-btn">
                                                Activate
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">
                No user accounts found.
            </div>
        }
    </div>
</div>
</div>
