@model MVCApp.ViewModels.ClinicManager.ManageDoctorScheduleViewModel

@{
    ViewData["Title"] = "Manage Doctor Schedule";
}

<div class="manager-page">
    <div class="manager-card">
        <div class="card-head">
            <h2>@(ViewData["Title"] ?? "Clinic Manager")</h2>
        </div>
    </div>

    <div class="manager-top">
        <a asp-controller="ClinicManager" asp-action="CreateDoctorSchedule" asp-route-doctorId="@Model.DoctorId" class="btn-main">Add Schedule</a>
        <a asp-controller="ClinicManager" asp-action="AppointmentImpact" asp-route-doctorId="@Model.DoctorId" class="btn-light">Check Impact</a>
    </div>

    <div class="manager-card">
        <div class="card-head"><h2>Dr. @Model.DoctorName</h2></div>
        <div class="info-grid">
            <div class="info-box"><span>Email</span><strong>@Model.DoctorEmail</strong></div>
            <div class="info-box"><span>License</span><strong>@Model.LicenseNumber</strong></div>
            <div class="info-box"><span>Total Schedule Rows</span><strong>@Model.TotalSchedules</strong></div>
        </div>
    </div>

    <div class="manager-card">
        @if (Model.HasSchedules)
        {
            <div class="manager-table-wrap">
                <table class="manager-table">
                    <thead><tr><th>Day</th><th>Time</th><th>Slot Duration</th><th>Working Hours</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var schedule in Model.Schedules)
                        {
                            <tr>
                                <td>@schedule.DayName</td>
                                <td>@schedule.TimeRangeText</td>
                                <td>@schedule.SlotDurationMinutes min</td>
                                <td>@schedule.WorkingHours.ToString("0.##") h</td>
                                <td>
                                    <a asp-controller="ClinicManager" asp-action="EditDoctorSchedule" asp-route-id="@schedule.DoctorScheduleId" class="table-link">Edit</a>
                                    <form asp-controller="ClinicManager" asp-action="DeleteDoctorSchedule" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@schedule.DoctorScheduleId" />
                                        <input type="hidden" name="doctorId" value="@Model.DoctorId" />
                                        <button type="submit" class="table-link" onclick="return confirm('Delete this schedule?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">@Model.EmptyMessage</div>
        }
    </div>
</div>
