@model MVCApp.ViewModels.ClinicManager.ManageDoctorScheduleViewModel

@{
    ViewData["Title"] = "Manage Doctor Schedule";
}

<div class="page-header">
    <div>
        <h1>Manage Doctor Schedule</h1>
        <p>View and manage weekly working hours for Dr. @Model.DoctorName.</p>
    </div>

    <div class="header-actions">
        <a asp-controller="ClinicManager"
           asp-action="DoctorDetails"
           asp-route-id="@Model.DoctorId"
           class="secondary-btn">
            Back to Doctor
        </a>

        <a asp-controller="ClinicManager"
           asp-action="CreateDoctorSchedule"
           asp-route-doctorId="@Model.DoctorId"
           class="primary-btn">
            + Add Schedule
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="section-card">
    <div class="section-header">
        <h2>Doctor Information</h2>
    </div>

    <div class="details-grid">
        <div class="details-item">
            <span>Doctor Name</span>
            <strong>Dr. @Model.DoctorName</strong>
        </div>

        <div class="details-item">
            <span>Email</span>
            <strong>@Model.DoctorEmail</strong>
        </div>

        <div class="details-item">
            <span>License Number</span>
            <strong>@Model.LicenseNumber</strong>
        </div>

        <div class="details-item">
            <span>Total Schedule Rows</span>
            <strong>@Model.TotalSchedules</strong>
        </div>
    </div>
</div>

<div class="section-card">
    <div class="section-header">
        <h2>Weekly Schedule</h2>

        <a asp-controller="ClinicManager"
           asp-action="AppointmentImpact"
           asp-route-doctorId="@Model.DoctorId"
           class="btn-link">
            Review impacted appointments
        </a>
    </div>

    @if (Model.HasSchedules)
    {
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Slot Duration</th>
                    <th>Working Hours</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var schedule in Model.Schedules)
                    {
                <tr>
                    <td>@schedule.DayName</td>
                    <td>@schedule.StartTime.ToString("HH\\:mm")</td>
                    <td>@schedule.EndTime.ToString("HH\\:mm")</td>
                    <td>@schedule.SlotDurationMinutes minutes</td>
                    <td>@schedule.WorkingHours.ToString("0.##") hours</td>
                    <td>
                        <a asp-controller="ClinicManager"
                           asp-action="EditDoctorSchedule"
                           asp-route-id="@schedule.DoctorScheduleId"
                           class="table-link">
                            Edit
                        </a>

                        <form asp-controller="ClinicManager"
                              asp-action="DeleteDoctorSchedule"
                              asp-route-id="@schedule.DoctorScheduleId"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="table-link danger-button"
                                    onclick="return confirm('Are you sure you want to delete this schedule? You should review impacted appointments after deleting it.');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
                    }
            </tbody>
        </table>
    </div>
    }
    else
    {
    <p class="empty-text">@Model.EmptyMessage</p>
    }
</div>

<div class="form-actions">
    <a asp-controller="ClinicManager"
       asp-action="CreateDoctorSchedule"
       asp-route-doctorId="@Model.DoctorId"
       class="primary-btn">
        Add Schedule
    </a>

    <a asp-controller="ClinicManager"
       asp-action="DoctorDetails"
       asp-route-id="@Model.DoctorId"
       class="secondary-btn">
        Back to Doctor Details
    </a>
</div>