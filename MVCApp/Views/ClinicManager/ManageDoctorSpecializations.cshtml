@model MVCApp.ViewModels.ClinicManager.ManageDoctorSpecializationsViewModel

@{
    ViewData["Title"] = "Manage Doctor Specializations";
}

<div class="manager-page">
    


    <div class="manager-card">
        <div class="card-head">
            <h2>Dr. @Model.DoctorName</h2>
            <span class="status-pill">@Model.SelectedCount selected</span>
        </div>

        <div class="info-grid">
            <div class="info-box"><span>Email</span><strong>@Model.DoctorEmail</strong></div>
            <div class="info-box"><span>License</span><strong>@Model.LicenseNumber</strong></div>
            <div class="info-box"><span>Total Options</span><strong>@Model.TotalSpecializations</strong></div>
        </div>
    </div>

    <div class="manager-card">
        <form asp-controller="ClinicManager" asp-action="ManageDoctorSpecializations" method="post" class="manager-form">
            @Html.AntiForgeryToken()

            <input asp-for="DoctorId" type="hidden" />
            <input asp-for="DoctorName" type="hidden" />
            <input asp-for="DoctorEmail" type="hidden" />
            <input asp-for="LicenseNumber" type="hidden" />

            @if (Model.HasSpecializations)
            {
                <div class="check-list">
                    @for (var i = 0; i < Model.Specializations.Count; i++)
                    {
                        <label class="check-item">
                            <input type="checkbox"
                                   name="SelectedSpecializationIds"
                                   value="@Model.Specializations[i].SpecializationId"
                                   checked="@Model.Specializations[i].IsSelected" />
                            <span>
                                @Model.Specializations[i].SpecializationName
                                @if (!string.IsNullOrWhiteSpace(Model.Specializations[i].Description))
                                {
                                    <small>@Model.Specializations[i].Description</small>
                                }
                            </span>
                        </label>
                    }
                </div>
            }
            else
            {
                <div class="empty-box">@Model.EmptyMessage</div>
            }

            <div class="actions">
                <button type="submit" class="btn-main">Save Specializations</button>
                <a asp-controller="ClinicManager" asp-action="DoctorDetails" asp-route-id="@Model.DoctorId" class="btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>
