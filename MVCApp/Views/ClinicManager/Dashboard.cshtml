@model MVCApp.ViewModels.ClinicManager.ClinicManagerDashboardViewModel

@{
    ViewData["Title"] = "Clinic Manager Dashboard";
}

<div class="page-header clean-header">
    <div>
        <h1>Clinic Manager Dashboard</h1>
        <p>Quick overview of clinic activity today.</p>
    </div>
</div>

<!-- Main Summary Cards -->
<div class="clean-card-grid">
    <div class="clean-stat-card">
        <span>Total Doctors</span>
        <strong>@Model.TotalDoctors</strong>
    </div>

    <div class="clean-stat-card">
        <span>Active Doctors</span>
        <strong>@Model.ActiveDoctors</strong>
    </div>

    <div class="clean-stat-card">
        <span>Total Patients</span>
        <strong>@Model.TotalPatients</strong>
    </div>

    <div class="clean-stat-card">
        <span>Appointments Today</span>
        <strong>@Model.AppointmentsToday</strong>
    </div>

    <div class="clean-stat-card warning-card">
        <span>Doctors On Leave</span>
        <strong>@Model.DoctorsOnLeaveToday</strong>
    </div>

    <div class="clean-stat-card danger-card">
        <span>Impacted Appointments</span>
        <strong>@Model.ImpactedAppointmentsToday</strong>
    </div>
</div>

<!-- Appointment Status -->
<div class="clean-section">
    <div class="clean-section-header">
        <h2>Today Appointment Status</h2>

        <a asp-controller="ClinicManager"
           asp-action="Appointments"
           class="clean-link">
            View All
        </a>
    </div>

    <div class="mini-status-grid">
        <div>
            <span>Requested</span>
            <strong>@Model.RequestedAppointments</strong>
        </div>

        <div>
            <span>Confirmed</span>
            <strong>@Model.ConfirmedAppointments</strong>
        </div>

        <div>
            <span>Checked In</span>
            <strong>@Model.CheckedInAppointments</strong>
        </div>

        <div>
            <span>In Progress</span>
            <strong>@Model.InProgressAppointments</strong>
        </div>

        <div>
            <span>Completed</span>
            <strong>@Model.CompletedAppointmentsToday</strong>
        </div>

        <div>
            <span>Cancelled</span>
            <strong>@Model.CancelledAppointmentsToday</strong>
        </div>

        <div>
            <span>Missed</span>
            <strong>@Model.MissedAppointmentsToday</strong>
        </div>
    </div>
</div>

<!-- Today Appointments -->
<div class="clean-section">
    <div class="clean-section-header">
        <h2>Today Appointments</h2>

        <a asp-controller="ClinicManager"
           asp-action="Appointments"
           asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")"
           class="clean-link">
            Open
        </a>
    </div>

    @if (Model.HasAppointmentsToday)
    {
    <div class="table-responsive">
        <table class="clean-table">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var appointment in Model.TodayAppointments)
                    {
                <tr>
                    <td>@appointment.TimeText</td>
                    <td>@appointment.PatientName</td>
                    <td>Dr. @appointment.DoctorName</td>
                    <td>
                        <span class="clean-pill">@appointment.StatusName</span>
                    </td>
                    <td>
                        <a asp-controller="ClinicManager"
                           asp-action="AppointmentDetails"
                           asp-route-id="@appointment.AppointmentId"
                           class="clean-link">
                            Details
                        </a>
                    </td>
                </tr>
                    }
            </tbody>
        </table>
    </div>
    }
    else
    {
    <p class="clean-empty">No appointments scheduled for today.</p>
    }
</div>

<!-- Doctor Workload -->
<div class="clean-section">
    <div class="clean-section-header">
        <h2>Doctor Workload</h2>

        <a asp-controller="ClinicManager"
           asp-action="Doctors"
           class="clean-link">
            Manage
        </a>
    </div>

    @if (Model.HasDoctorWorkloads)
    {
    <div class="clean-list">
        @foreach (var doctor in Model.DoctorWorkloads)
            {
        <div class="clean-list-item">
            <div>
                <h3>Dr. @doctor.DoctorName</h3>
                <p>@doctor.TotalAppointmentsToday appointments today</p>
            </div>

            <div class="clean-list-numbers">
                <span>Completed: @doctor.CompletedAppointmentsToday</span>
                <span>Remaining: @doctor.RemainingAppointmentsToday</span>
            </div>

            <a asp-controller="ClinicManager"
               asp-action="DoctorDetails"
               asp-route-id="@doctor.DoctorId"
               class="clean-link">
                View
            </a>
        </div>
            }
    </div>
    }
    else
    {
    <p class="clean-empty">No doctor workload data available today.</p>
    }
</div>

<!-- Doctors On Leave -->
<div class="clean-section">
    <div class="clean-section-header">
        <h2>Doctors On Leave</h2>
    </div>

    @if (Model.HasDoctorsOnLeave)
    {
    <div class="clean-list">
        @foreach (var leave in Model.DoctorsOnLeave)
            {
        <div class="clean-list-item">
            <div>
                <h3>Dr. @leave.DoctorName</h3>
                <p>@leave.LeaveReason</p>
                <small>@leave.LeaveDateText</small>
            </div>

            <a asp-controller="ClinicManager"
               asp-action="AppointmentImpact"
               asp-route-doctorId="@leave.DoctorId"
               class="clean-link">
                Review Impact
            </a>
        </div>
            }
    </div>
    }
    else
    {
    <p class="clean-empty">No doctors are on leave today.</p>
    }
</div>