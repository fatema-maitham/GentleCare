@model MVCApp.ViewModels.ClinicManager.ClinicManagerDashboardViewModel

@{
    ViewData["Title"] = "Clinic Manager Dashboard";

    var today = DateTime.Today;
    var firstDay = new DateTime(today.Year, today.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(today.Year, today.Month);
    var startOffset = (int)firstDay.DayOfWeek;

    var remainingAppointments =
        Model.AppointmentsToday
        - Model.CompletedAppointmentsToday
        - Model.CancelledAppointmentsToday
        - Model.MissedAppointmentsToday;

    if (remainingAppointments < 0)
    {
        remainingAppointments = 0;
    }
}

<style>
    :root {
        --gc-blue: #0A4D8F;
        --gc-blue-dark: #083B70;
        --gc-green: #5FAF8F;
        --gc-green-dark: #4C9A7C;
        --gc-green-soft: #E8F5EF;
        --gc-text: #10233F;
        --gc-muted: #66758A;
        --gc-border: #DCE6F2;
        --gc-page: #F4F8FC;
        --gc-white: #FFFFFF;
    }

    body {
        background: var(--gc-page) !important;
        font-family: "Inter", "Segoe UI", Arial, sans-serif !important;
    }

    .manager-dashboard-page {
        max-width: 1140px;
        margin: 0 auto;
        padding: 24px 0 42px;
    }

    .dashboard-header {
        margin-bottom: 22px;
    }

        .dashboard-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 900;
            color: var(--gc-text);
        }

        .dashboard-header p {
            margin: 8px 0 0;
            color: var(--gc-muted);
            font-size: 15px;
        }

    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .dashboard-stat {
        background: var(--gc-white);
        border: 1px solid var(--gc-border);
        border-radius: 18px;
        padding: 22px;
        min-height: 115px;
        box-shadow: 0 10px 26px rgba(10, 77, 143, 0.07);
        position: relative;
        overflow: hidden;
    }

        .dashboard-stat::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 5px;
            background: var(--gc-green);
        }

    .dashboard-number {
        display: block;
        font-size: 38px;
        font-weight: 900;
        color: var(--gc-blue);
        margin-bottom: 12px;
        line-height: 1;
    }

    .dashboard-stat-title {
        margin: 0;
        font-size: 15px;
        font-weight: 900;
        color: var(--gc-text);
    }

    .dashboard-main-grid {
        display: grid;
        grid-template-columns: 410px 1fr;
        gap: 22px;
        align-items: start;
    }

    .dashboard-card {
        background: var(--gc-white);
        border: 1px solid var(--gc-border);
        border-radius: 20px;
        box-shadow: 0 10px 26px rgba(10, 77, 143, 0.07);
        overflow: hidden;
    }

    .calendar-wrap {
        padding-bottom: 18px;
    }

    .calendar-header {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 28px 22px 12px;
    }

    .calendar-month {
        text-align: center;
    }

        .calendar-month h2 {
            margin: 0;
            font-size: 34px;
            font-weight: 900;
            color: var(--gc-text);
            letter-spacing: 1px;
            text-transform: uppercase;
            line-height: 1;
        }

        .calendar-month small {
            display: block;
            margin-top: 7px;
            font-size: 15px;
            font-weight: 800;
            color: var(--gc-muted);
        }

    .calendar-weekdays,
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
        padding: 0 24px;
    }

    .calendar-weekdays {
        margin-top: 18px;
        margin-bottom: 10px;
    }

        .calendar-weekdays div {
            text-align: center;
            font-size: 13px;
            font-weight: 900;
            color: var(--gc-text);
            padding: 6px 0;
        }

    .calendar-grid {
        padding-bottom: 20px;
    }

    .calendar-day,
    .calendar-empty {
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gc-text);
        font-size: 15px;
        font-weight: 800;
        border-radius: 12px;
        position: relative;
    }

    .calendar-day-number {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .calendar-day.today .calendar-day-number {
        background: var(--gc-blue);
        color: var(--gc-white);
        box-shadow: 0 8px 18px rgba(10, 77, 143, 0.24);
    }

    .calendar-dot {
        position: absolute;
        bottom: 4px;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--gc-green);
    }

    .calendar-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        padding: 0 24px 6px;
    }

        .calendar-summary div {
            background: #F7FBFF;
            border: 1px solid var(--gc-border);
            border-radius: 14px;
            padding: 14px 10px;
            text-align: center;
        }

        .calendar-summary span {
            display: block;
            color: var(--gc-muted);
            font-size: 13px;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .calendar-summary strong {
            color: var(--gc-text);
            font-size: 22px;
            font-weight: 900;
        }

    .appointments-card {
        padding: 26px 28px;
    }

    .appointments-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        margin-bottom: 22px;
    }

        .appointments-header h2 {
            margin: 0;
            font-size: 24px;
            font-weight: 900;
            color: var(--gc-blue);
        }

        .appointments-header a {
            color: #0B5ED7;
            text-decoration: none;
            font-weight: 900;
        }

    .manager-table {
        width: 100%;
        border-collapse: collapse;
    }

        .manager-table th {
            text-align: left;
            padding: 13px 14px;
            background: #F7FBFF;
            border-bottom: 1px solid var(--gc-border);
            color: var(--gc-muted);
            font-size: 14px;
            font-weight: 900;
        }

        .manager-table td {
            padding: 16px 14px;
            border-bottom: 1px solid #EDF2F8;
            color: var(--gc-text);
            font-size: 15px;
        }

    .status-pill {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 999px;
        background: var(--gc-green-soft);
        color: #2F6E58;
        border: 1px solid #B7D9C8;
        font-size: 13px;
        font-weight: 900;
    }

    .details-link {
        color: #0B5ED7;
        text-decoration: none;
        font-weight: 900;
    }

    .empty-message {
        padding: 16px;
        border-radius: 14px;
        background: #F7FBFF;
        border: 1px solid var(--gc-border);
        color: var(--gc-muted);
        margin: 0;
    }

    @@media (max-width: 980px) {
        .dashboard-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-main-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .dashboard-stats {
            grid-template-columns: 1fr;
        }

        .appointments-card {
            padding: 20px;
        }

        .calendar-summary {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="manager-dashboard-page">

    <div class="dashboard-header">
        <h1>Clinic Manager Dashboard</h1>
        <p>Monitor doctors, patients, appointments, and today’s clinic activity.</p>
    </div>

    <div class="dashboard-stats">
        <div class="dashboard-stat">
            <strong class="dashboard-number">@Model.TotalDoctors</strong>
            <p class="dashboard-stat-title">Doctors</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number">@Model.TotalPatients</strong>
            <p class="dashboard-stat-title">Patients</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number">@Model.AppointmentsToday</strong>
            <p class="dashboard-stat-title">Appointments Today</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number">@Model.DoctorsOnLeaveToday</strong>
            <p class="dashboard-stat-title">Doctors On Leave</p>
        </div>
    </div>

    <div class="dashboard-main-grid">

        <div class="dashboard-card calendar-wrap">
            <div class="calendar-header">
                <div class="calendar-month">
                    <h2>@today.ToString("MMMM")</h2>
                    <small>@today.Year</small>
                </div>
            </div>

            <div class="calendar-weekdays">
                <div>S</div>
                <div>M</div>
                <div>T</div>
                <div>W</div>
                <div>T</div>
                <div>F</div>
                <div>S</div>
            </div>

            <div class="calendar-grid">
                @for (var i = 0; i < startOffset; i++)
                {
                <span class="calendar-empty"></span>
                }

                @for (var day = 1; day <= daysInMonth; day++)
                {
                    var isToday = day == today.Day;

                <span class="calendar-day @(isToday ? "today" : "")">
                    <span class="calendar-day-number">@day</span>

                    @if (isToday && Model.AppointmentsToday > 0)
                        {
                    <span class="calendar-dot"></span>
                        }
                </span>
                }
            </div>

            <div class="calendar-summary">
                <div>
                    <span>Today</span>
                    <strong>@Model.AppointmentsToday</strong>
                </div>

                <div>
                    <span>Completed</span>
                    <strong>@Model.CompletedAppointmentsToday</strong>
                </div>

                <div>
                    <span>Remaining</span>
                    <strong>@remainingAppointments</strong>
                </div>
            </div>
        </div>

        <div class="dashboard-card appointments-card">
            <div class="appointments-header">
                <h2>Today Appointments</h2>

                <a asp-controller="ClinicManager"
                   asp-action="Appointments"
                   asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")">
                    View All
                </a>
            </div>

            @if (Model.HasAppointmentsToday)
            {
            <table class="manager-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var appointment in Model.TodayAppointments.Take(5))
                        {
                    <tr>
                        <td>@appointment.TimeText</td>
                        <td>@appointment.PatientName</td>
                        <td>Dr. @appointment.DoctorName</td>
                        <td>
                            <span class="status-pill">@appointment.StatusName</span>
                        </td>
                        <td>
                            <a asp-controller="ClinicManager"
                               asp-action="AppointmentDetails"
                               asp-route-id="@appointment.AppointmentId"
                               class="details-link">
                                Details
                            </a>
                        </td>
                    </tr>
                        }
                </tbody>
            </table>
            }
            else
            {
            <p class="empty-message">No appointments scheduled for today.</p>
            }
        </div>

    </div>
</div>