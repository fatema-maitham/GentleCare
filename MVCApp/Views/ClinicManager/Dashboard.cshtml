@model MVCApp.ViewModels.ClinicManager.ClinicManagerDashboardViewModel

@{
    ViewData["Title"] = "Clinic Manager Dashboard";

    var today = DateTime.Today;
    var firstDay = new DateTime(today.Year, today.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(today.Year, today.Month);
    var startOffset = (int)firstDay.DayOfWeek;

    var remainingAppointments =
        Model.AppointmentsToday
        - Model.CompletedAppointmentsToday
        - Model.CancelledAppointmentsToday
        - Model.MissedAppointmentsToday;

    if (remainingAppointments < 0)
    {
        remainingAppointments = 0;
    }
}

<style>
    .manager-dashboard-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 18px 0 50px;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .dashboard-header {
        margin-bottom: 24px;
    }

        .dashboard-header h1 {
            margin: 0;
            font-size: 31px;
            font-weight: 900;
            color: #12262F;
        }

        .dashboard-header p {
            margin: 8px 0 0;
            color: #687A80;
            font-weight: 600;
        }

    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 22px;
        margin-bottom: 28px;
    }

    .dashboard-stat {
        background: linear-gradient(180deg, #ffffff 0%, #fbfdfd 100%);
        border: 1px solid #d8e1e3;
        border-radius: 22px;
        padding: 26px;
        min-height: 150px;
        box-shadow: 0 12px 28px rgba(7, 81, 104, 0.08);
        position: relative;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

        .dashboard-stat::before {
            content: "";
            position: absolute;
            top: 18px;
            right: 20px;
            width: 52px;
            height: 52px;
            background: rgba(0, 119, 155, 0.10);
            border-radius: 18px;
        }

        .dashboard-stat::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg, #075168, #00779B);
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        .dashboard-stat:hover {
            transform: translateY(-6px);
            border-color: #b9cdd2;
            box-shadow: 0 18px 36px rgba(7, 81, 104, 0.15);
        }

            .dashboard-stat:hover::after {
                opacity: 1;
            }

    .dashboard-number {
        display: block;
        font-size: 44px;
        font-weight: 900;
        line-height: 1;
        color: #075168;
        margin-bottom: 16px;
        letter-spacing: -1.5px;
        position: relative;
        z-index: 2;
    }

    .dashboard-stat-title {
        margin: 0;
        font-size: 15px;
        font-weight: 850;
        color: #12262F;
        line-height: 1.35;
        position: relative;
        z-index: 2;
    }

    .dashboard-main-grid {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 26px;
        align-items: start;
    }

    .dashboard-card {
        background: #ffffff;
        border: 1px solid #D6DDDE;
        border-radius: 24px;
        box-shadow: 0 12px 28px rgba(7, 81, 104, 0.08);
        overflow: hidden;
    }

    .calendar-wrap {
        padding-bottom: 22px;
    }

    .calendar-header {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 28px 24px 14px;
    }

    .calendar-month {
        text-align: center;
    }

        .calendar-month h2 {
            margin: 0;
            font-size: 34px;
            font-weight: 900;
            color: #12262F;
            letter-spacing: 1px;
            text-transform: uppercase;
            line-height: 1;
        }

        .calendar-month small {
            display: block;
            margin-top: 8px;
            font-size: 15px;
            font-weight: 800;
            color: #687A80;
        }

    .calendar-weekdays,
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
        padding: 0 24px;
    }

    .calendar-weekdays {
        margin-top: 18px;
        margin-bottom: 10px;
    }

        .calendar-weekdays div {
            text-align: center;
            font-size: 13px;
            font-weight: 900;
            color: #12262F;
            padding: 6px 0;
        }

    .calendar-grid {
        padding-bottom: 22px;
    }

    .calendar-day,
    .calendar-empty {
        min-height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #12262F;
        font-size: 15px;
        font-weight: 850;
        border-radius: 14px;
        position: relative;
    }

    .calendar-day-number {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .calendar-day.today .calendar-day-number {
        background: #075168;
        color: #ffffff;
        box-shadow: 0 8px 18px rgba(7, 81, 104, 0.24);
    }

    .calendar-dot {
        position: absolute;
        bottom: 4px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #00779B;
    }

    .calendar-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        padding: 0 24px 6px;
    }

        .calendar-summary div {
            background: #E7F1F3;
            border: 1px solid #C9DBDF;
            border-radius: 16px;
            padding: 14px 10px;
            text-align: center;
        }

        .calendar-summary span {
            display: block;
            color: #687A80;
            font-size: 13px;
            margin-bottom: 8px;
            font-weight: 800;
        }

        .calendar-summary strong {
            color: #12262F;
            font-size: 22px;
            font-weight: 900;
        }

    .appointments-card {
        padding: 0;
    }

    .appointments-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding: 22px 26px;
        border-bottom: 1px solid #E9EEEE;
    }

        .appointments-header h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 900;
            color: #075168;
        }

        .appointments-header a {
            color: #075168;
            text-decoration: none;
            font-weight: 900;
        }

            .appointments-header a:hover {
                color: #00779B;
                text-decoration: underline;
            }

    .manager-table-wrap {
        overflow-x: auto;
    }

    .manager-table {
        width: 100%;
        border-collapse: collapse;
    }

        .manager-table th {
            text-align: left;
            padding: 15px 18px;
            background: #F8FAFA;
            border-bottom: 1px solid #D6DDDE;
            color: #12262F;
            font-size: 13px;
            font-weight: 900;
            white-space: nowrap;
        }

        .manager-table td {
            padding: 17px 18px;
            border-bottom: 1px solid #EDF1F2;
            color: #12262F;
            font-size: 14px;
            font-weight: 600;
            vertical-align: middle;
        }

        .manager-table tbody tr:hover {
            background: #FAFCFC;
        }

    .status-pill {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 999px;
        background: #E7F1F3;
        color: #075168;
        border: 1px solid #C9DBDF;
        font-size: 12px;
        font-weight: 900;
        white-space: nowrap;
    }

    .details-link {
        color: #075168;
        text-decoration: none;
        font-weight: 900;
    }

        .details-link:hover {
            color: #00779B;
            text-decoration: underline;
        }

    .empty-message {
        margin: 24px;
        padding: 16px;
        border-radius: 16px;
        background: #E7F1F3;
        border: 1px solid #C9DBDF;
        color: #075168;
        font-weight: 800;
    }

    @@media (max-width: 980px) {
        .dashboard-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-main-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .dashboard-stats {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .dashboard-stat {
            min-height: 130px;
        }

        .calendar-summary {
            grid-template-columns: 1fr;
        }

        .appointments-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="manager-dashboard-page">

    <div class="dashboard-header">
        <h1>Clinic Manager Dashboard</h1>
        <p>Monitor doctors, patients, appointments, and today’s clinic activity.</p>
    </div>

    <div class="dashboard-stats">
        <div class="dashboard-stat">
            <strong class="dashboard-number">@Model.TotalDoctors</strong>
            <p class="dashboard-stat-title">Doctors</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number">@Model.TotalPatients</strong>
            <p class="dashboard-stat-title">Patients</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number">@Model.AppointmentsToday</strong>
            <p class="dashboard-stat-title">Appointments Today</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number">@Model.DoctorsOnLeaveToday</strong>
            <p class="dashboard-stat-title">Doctors On Leave</p>
        </div>
    </div>

    <div class="dashboard-main-grid">

        <div class="dashboard-card calendar-wrap">
            <div class="calendar-header">
                <div class="calendar-month">
                    <h2>@today.ToString("MMMM")</h2>
                    <small>@today.Year</small>
                </div>
            </div>

            <div class="calendar-weekdays">
                <div>S</div>
                <div>M</div>
                <div>T</div>
                <div>W</div>
                <div>T</div>
                <div>F</div>
                <div>S</div>
            </div>

            <div class="calendar-grid">
                @for (var i = 0; i < startOffset; i++)
                {
                    <span class="calendar-empty"></span>
                }

                @for (var day = 1; day <= daysInMonth; day++)
                {
                    var isToday = day == today.Day;

                    <span class="calendar-day @(isToday ? "today" : "")">
                        <span class="calendar-day-number">@day</span>

                        @if (isToday && Model.AppointmentsToday > 0)
                        {
                            <span class="calendar-dot"></span>
                        }
                    </span>
                }
            </div>

            <div class="calendar-summary">
                <div>
                    <span>Today</span>
                    <strong>@Model.AppointmentsToday</strong>
                </div>

                <div>
                    <span>Completed</span>
                    <strong>@Model.CompletedAppointmentsToday</strong>
                </div>

                <div>
                    <span>Remaining</span>
                    <strong>@remainingAppointments</strong>
                </div>
            </div>
        </div>

        <div class="dashboard-card appointments-card">
            <div class="appointments-header">
                <h2>Today Appointments</h2>

                <a asp-controller="ClinicManager"
                   asp-action="Appointments"
                   asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")">
                    View All
                </a>
            </div>

            @if (Model.HasAppointmentsToday)
            {
                <div class="manager-table-wrap">
                    <table class="manager-table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var appointment in Model.TodayAppointments.Take(5))
                            {
                                <tr>
                                    <td>@appointment.TimeText</td>
                                    <td>@appointment.PatientName</td>
                                    <td>Dr. @appointment.DoctorName</td>
                                    <td>
                                        <span class="status-pill">@appointment.StatusName</span>
                                    </td>
                                    <td>
                                        <a asp-controller="ClinicManager"
                                           asp-action="AppointmentDetails"
                                           asp-route-id="@appointment.AppointmentId"
                                           class="details-link">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="empty-message">No appointments scheduled for today.</p>
            }
        </div>

    </div>
</div>