@model MVCApp.ViewModels.ClinicManager.ClinicManagerDashboardViewModel

@{
    ViewData["Title"] = "Clinic Manager Dashboard";
}

<div class="page-header">
    <div>
        <h1>Clinic Manager Dashboard</h1>
        <p>Monitor doctors, appointments, workload, leaves, and clinic activity.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Summary Cards -->
<div class="dashboard-grid">
    <div class="dashboard-card">
        <span class="card-label">Total Doctors</span>
        <h2>@Model.TotalDoctors</h2>
        <p>@Model.ActiveDoctors active doctors</p>
    </div>

    <div class="dashboard-card">
        <span class="card-label">Total Patients</span>
        <h2>@Model.TotalPatients</h2>
        <p>Registered patients</p>
    </div>

    <div class="dashboard-card">
        <span class="card-label">Appointments Today</span>
        <h2>@Model.AppointmentsToday</h2>
        <p>@Model.CompletedAppointmentsToday completed today</p>
    </div>

    <div class="dashboard-card warning-card">
        <span class="card-label">Doctors On Leave</span>
        <h2>@Model.DoctorsOnLeaveToday</h2>
        <p>Today</p>
    </div>

    <div class="dashboard-card danger-card">
        <span class="card-label">Impacted Appointments</span>
        <h2>@Model.ImpactedAppointmentsToday</h2>
        <p>Need review today</p>
    </div>
</div>

<!-- Appointment Status Summary -->
<div class="section-card">
    <div class="section-header">
        <h2>Today Appointment Status</h2>
        <a asp-controller="ClinicManager" asp-action="Appointments" class="btn-link">View all appointments</a>
    </div>

    <div class="status-grid">
        <div class="status-box">
            <span>Requested</span>
            <strong>@Model.RequestedAppointments</strong>
        </div>

        <div class="status-box">
            <span>Confirmed</span>
            <strong>@Model.ConfirmedAppointments</strong>
        </div>

        <div class="status-box">
            <span>Checked In</span>
            <strong>@Model.CheckedInAppointments</strong>
        </div>

        <div class="status-box">
            <span>In Progress</span>
            <strong>@Model.InProgressAppointments</strong>
        </div>

        <div class="status-box">
            <span>Completed</span>
            <strong>@Model.CompletedAppointmentsToday</strong>
        </div>

        <div class="status-box">
            <span>Cancelled</span>
            <strong>@Model.CancelledAppointmentsToday</strong>
        </div>

        <div class="status-box">
            <span>Missed</span>
            <strong>@Model.MissedAppointmentsToday</strong>
        </div>
    </div>
</div>

<!-- Quick Rates -->
<div class="dashboard-grid small-grid">
    <div class="dashboard-card">
        <span class="card-label">Completion Rate</span>
        <h2>@Model.CompletionRateToday%</h2>
        <p>Completed appointments today</p>
    </div>

    <div class="dashboard-card">
        <span class="card-label">Cancellation Rate</span>
        <h2>@Model.CancellationRateToday%</h2>
        <p>Cancelled appointments today</p>
    </div>

    <div class="dashboard-card">
        <span class="card-label">Missed Rate</span>
        <h2>@Model.MissedRateToday%</h2>
        <p>Missed appointments today</p>
    </div>
</div>

<!-- Today Appointments -->
<div class="section-card">
    <div class="section-header">
        <h2>Today Appointments</h2>
        <a asp-controller="ClinicManager" asp-action="Appointments" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn-link">
            Open appointments
        </a>
    </div>

    @if (Model.HasAppointmentsToday)
    {
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Status</th>
                    <th>Notes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.TodayAppointments)
                    {
                <tr>
                    <td>@appointment.TimeText</td>
                    <td>@appointment.PatientName</td>
                    <td>Dr. @appointment.DoctorName</td>
                    <td>
                        <span class="status-pill">@appointment.StatusName</span>
                    </td>
                    <td>@appointment.Notes</td>
                    <td>
                        <a asp-controller="ClinicManager"
                           asp-action="AppointmentDetails"
                           asp-route-id="@appointment.AppointmentId"
                           class="table-link">
                            Details
                        </a>
                    </td>
                </tr>
                    }
            </tbody>
        </table>
    </div>
    }
    else
    {
    <p class="empty-text">No appointments scheduled for today.</p>
    }
</div>

<!-- Doctor Workload -->
<div class="section-card">
    <div class="section-header">
        <h2>Doctor Workload Today</h2>
        <a asp-controller="ClinicManager" asp-action="Doctors" class="btn-link">Manage doctors</a>
    </div>

    @if (Model.HasDoctorWorkloads)
    {
    <div class="workload-list">
        @foreach (var doctor in Model.DoctorWorkloads)
            {
        <div class="workload-item">
            <div>
                <h3>Dr. @doctor.DoctorName</h3>
                <p>@doctor.TotalAppointmentsToday appointments today</p>
            </div>

            <div class="workload-numbers">
                <span>Completed: @doctor.CompletedAppointmentsToday</span>
                <span>Remaining: @doctor.RemainingAppointmentsToday</span>
            </div>

            <a asp-controller="ClinicManager"
               asp-action="DoctorDetails"
               asp-route-id="@doctor.DoctorId"
               class="table-link">
                View
            </a>
        </div>
            }
    </div>
    }
    else
    {
    <p class="empty-text">No doctor workload data available today.</p>
    }
</div>

<!-- Doctors On Leave -->
<div class="section-card">
    <div class="section-header">
        <h2>Doctors On Leave Today</h2>
    </div>

    @if (Model.HasDoctorsOnLeave)
    {
    <div class="leave-list">
        @foreach (var leave in Model.DoctorsOnLeave)
            {
        <div class="leave-item">
            <div>
                <h3>Dr. @leave.DoctorName</h3>
                <p>@leave.LeaveReason</p>
                <small>@leave.LeaveDateText</small>
            </div>

            <a asp-controller="ClinicManager"
               asp-action="AppointmentImpact"
               asp-route-doctorId="@leave.DoctorId"
               class="btn-warning-small">
                Review impact
            </a>
        </div>
            }
    </div>
    }
    else
    {
    <p class="empty-text">No doctors are on leave today.</p>
    }
</div>