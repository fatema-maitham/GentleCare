@model MVCApp.ViewModels.ClinicManager.ClinicManagerDashboardViewModel


@{
    ViewData["Title"] = "Clinic Manager Dashboard";

    var remainingAppointments =
        Model.AppointmentsToday
        - Model.CompletedAppointmentsToday
        - Model.CancelledAppointmentsToday
        - Model.MissedAppointmentsToday;

    if (remainingAppointments < 0)
    {
        remainingAppointments = 0;
    }

    string StatusClass(string status) => status?.ToLower().Replace(" ", "") switch
    {
        "requested"  => "status-requested",
        "confirmed"  => "status-confirmed",
        "inprogress" => "status-inprogress",
        "checkedin"  => "status-checkedin",
        "completed"  => "status-completed",
        "cancelled"  => "status-cancelled",
        "missed"     => "status-missed",
        _            => "status-default"
    };
}

<div class="manager-page">
    <div class="manager-card">
        <div class="card-head">
            <h2>@(ViewData["Title"] ?? "Clinic Manager")</h2>
            <span class="status-pill">
                @DateTime.Today.ToString("dd MMM yyyy")
            </span>
        </div>
    </div>


    <div class="manager-grid">
        <div class="manager-stat"><span>Total Doctors</span><strong>@Model.TotalDoctors</strong></div>
        <div class="manager-stat"><span>Active Doctors</span><strong>@Model.ActiveDoctors</strong></div>
        <div class="manager-stat"><span>Total Patients</span><strong>@Model.TotalPatients</strong></div>
        <div class="manager-stat"><span>Today Appointments</span><strong>@Model.AppointmentsToday</strong></div>
    </div>

    <div class="manager-grid">
        <div class="manager-stat"><span>Requested</span><strong>@Model.RequestedAppointments</strong></div>
        <div class="manager-stat"><span>Confirmed</span><strong>@Model.ConfirmedAppointments</strong></div>
        <div class="manager-stat"><span>In Progress</span><strong>@Model.InProgressAppointments</strong></div>
        <div class="manager-stat"><span>Remaining</span><strong>@remainingAppointments</strong></div>
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>Today Appointments</h2>
            <a asp-controller="ClinicManager" asp-action="Appointments" class="btn-light">View All</a>
        </div>

        @if (Model.HasAppointmentsToday)
        {
            <div class="manager-table-wrap">
                <table class="manager-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appointment in Model.TodayAppointments)
                        {
                            <tr>
                                <td>@appointment.TimeText</td>
                                <td>@appointment.PatientName</td>
                                <td>Dr. @appointment.DoctorName</td>
                                <td><span class="status-pill @StatusClass(appointment.StatusName)">@appointment.StatusName</span></td>
                                <td>
                                    <a asp-controller="ClinicManager"
                                       asp-action="AppointmentDetails"
                                       asp-route-id="@appointment.AppointmentId"
                                       class="table-link">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">No appointments scheduled for today.</div>
        }
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>Doctor Workload</h2>
            <a asp-controller="ClinicManager" asp-action="Doctors" class="btn-light">Manage Doctors</a>
        </div>

        @if (Model.HasDoctorWorkloads)
        {
            <div class="manager-table-wrap">
                <table class="manager-table">
                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Total Today</th>
                            <th>Completed</th>
                            <th>Remaining</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doctor in Model.DoctorWorkloads)
                        {
                            <tr>
                                <td>Dr. @doctor.DoctorName</td>
                                <td>@doctor.TotalAppointmentsToday</td>
                                <td>@doctor.CompletedAppointmentsToday</td>
                                <td>@doctor.RemainingAppointmentsToday</td>
                                <td>
                                    <a asp-controller="ClinicManager"
                                       asp-action="DoctorDetails"
                                       asp-route-id="@doctor.DoctorId"
                                       class="table-link">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">No doctor workload data available.</div>
        }
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>Doctors On Leave</h2>
        </div>

        @if (Model.HasDoctorsOnLeave)
        {
            <div class="manager-table-wrap">
                <table class="manager-table">
                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Date</th>
                            <th>Reason</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var leave in Model.DoctorsOnLeave)
                        {
                            <tr>
                                <td>Dr. @leave.DoctorName</td>
                                <td>@leave.LeaveDateText</td>
                                <td>@leave.LeaveReason</td>
                                <td>
                                    <a asp-controller="ClinicManager"
                                       asp-action="ManageDoctorLeaves"
                                       asp-route-doctorId="@leave.DoctorId"
                                       class="table-link">Leaves</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">No doctors are on leave today.</div>
        }
    </div>
</div>
