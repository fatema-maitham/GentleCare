@model MVCApp.ViewModels.ClinicManager.ClinicManagerDashboardViewModel

@{
    ViewData["Title"] = "Clinic Manager Dashboard";

    var today = DateTime.Today;
    var firstDay = new DateTime(today.Year, today.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(today.Year, today.Month);
    var startOffset = (int)firstDay.DayOfWeek;

    var remainingAppointments =
        Model.AppointmentsToday
        - Model.CompletedAppointmentsToday
        - Model.CancelledAppointmentsToday
        - Model.MissedAppointmentsToday;

    if (remainingAppointments < 0)
    {
        remainingAppointments = 0;
    }
}

<div class="gc-dashboard">

    <!-- Top Cards -->
    <div class="gc-card-row">

        <div class="gc-stat-card">
            <span>Doctors</span>
            <strong>@Model.TotalDoctors</strong>
        </div>

        <div class="gc-stat-card">
            <span>Patients</span>
            <strong>@Model.TotalPatients</strong>
        </div>

        <div class="gc-stat-card">
            <span>Appointments Today</span>
            <strong>@Model.AppointmentsToday</strong>
        </div>

        <div class="gc-stat-card">
            <span>Doctors On Leave</span>
            <strong>@Model.DoctorsOnLeaveToday</strong>
        </div>

    </div>

    <!-- Main Dashboard -->
    <div class="gc-dashboard-grid">

        <!-- Calendar Panel -->
        <div class="gc-panel">
            <div class="gc-panel-header">
                <h2>Appointments Calendar</h2>
            </div>

            <div class="gc-calendar-header">
                <button type="button" disabled>&lt;</button>
                <h3>@today.ToString("MMMM yyyy")</h3>
                <button type="button" disabled>&gt;</button>
            </div>

            <div class="gc-calendar-weekdays">
                <span>Sun</span>
                <span>Mon</span>
                <span>Tue</span>
                <span>Wed</span>
                <span>Thu</span>
                <span>Fri</span>
                <span>Sat</span>
            </div>

            <div class="gc-calendar-days">
                @for (var i = 0; i < startOffset; i++)
                {
                <span class="gc-empty-day"></span>
                }

                @for (var day = 1; day <= daysInMonth; day++)
                {
                    var isToday = day == today.Day;

                <span class="@(isToday ? "gc-day active" : "gc-day")">
                    @day
                </span>
                }
            </div>

            <div class="gc-calendar-summary">
                <div>
                    <span>Today Appointments</span>
                    <strong>@Model.AppointmentsToday</strong>
                </div>

                <div>
                    <span>Completed</span>
                    <strong>@Model.CompletedAppointmentsToday</strong>
                </div>

                <div>
                    <span>Remaining</span>
                    <strong>@remainingAppointments</strong>
                </div>
            </div>
        </div>

        <!-- Today Appointments Panel -->
        <div class="gc-panel">
            <div class="gc-panel-header">
                <h2>Today Appointments</h2>

                <a asp-controller="ClinicManager"
                   asp-action="Appointments"
                   asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")">
                    View All
                </a>
            </div>

            @if (Model.HasAppointmentsToday)
            {
            <div class="gc-table-wrap">
                <table class="gc-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var appointment in Model.TodayAppointments.Take(5))
                            {
                        <tr>
                            <td>@appointment.TimeText</td>
                            <td>@appointment.PatientName</td>
                            <td>Dr. @appointment.DoctorName</td>
                            <td>
                                <span class="gc-status-pill">@appointment.StatusName</span>
                            </td>
                            <td>
                                <a asp-controller="ClinicManager"
                                   asp-action="AppointmentDetails"
                                   asp-route-id="@appointment.AppointmentId">
                                    Details
                                </a>
                            </td>
                        </tr>
                            }
                    </tbody>
                </table>
            </div>

            <div class="gc-table-footer">
                <a asp-controller="ClinicManager"
                   asp-action="Appointments"
                   asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")">
                    View all appointments
                </a>
            </div>
            }
            else
            {
            <p class="gc-empty">No appointments scheduled for today.</p>
            }
        </div>

    </div>

</div>