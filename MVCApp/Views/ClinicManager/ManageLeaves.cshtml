@model MVCApp.ViewModels.ClinicManager.ManageDoctorLeavesViewModel

@{
    ViewData["Title"] = "Manage Leaves";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">Manage Leaves</h2>
            <p class="text-muted mb-0">@Model.DoctorName</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="ClinicManager" asp-action="DoctorDetails" asp-route-id="@Model.DoctorId" class="btn btn-outline-secondary">Back to Details</a>
            <a asp-controller="ClinicManager" asp-action="AddLeave" asp-route-doctorId="@Model.DoctorId" class="btn btn-primary">Add Leave</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model.Leaves == null || !Model.Leaves.Any())
            {
                <div class="p-4 text-center text-muted">No leave records found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Reason</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Leaves)
                            {
                                <tr>
                                    <td>@item.LeaveStartDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.LeaveEndDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.LeaveReason</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-controller="ClinicManager" asp-action="EditLeave" asp-route-id="@item.DoctorLeaveId" class="btn btn-sm btn-outline-warning">Edit</a>
                                            <form asp-controller="ClinicManager" asp-action="DeleteLeave" asp-route-id="@item.DoctorLeaveId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this leave period?');">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
