@model MVCApp.ViewModels.ClinicManager.ManageDoctorLeavesViewModel

@{
    ViewData["Title"] = "Manage Doctor Leaves";
}

<div class="page-header">
    <div>
        <h1>Manage Doctor Leaves</h1>
        <p>View and manage leave periods for Dr. @Model.DoctorName.</p>
    </div>

    <div class="header-actions">
        <a asp-controller="ClinicManager"
           asp-action="DoctorDetails"
           asp-route-id="@Model.DoctorId"
           class="secondary-btn">
            Back to Doctor
        </a>

        <a asp-controller="ClinicManager"
           asp-action="CreateDoctorLeave"
           asp-route-doctorId="@Model.DoctorId"
           class="primary-btn">
            + Add Leave
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="section-card">
    <div class="section-header">
        <h2>Doctor Information</h2>
    </div>

    <div class="details-grid">
        <div class="details-item">
            <span>Doctor Name</span>
            <strong>Dr. @Model.DoctorName</strong>
        </div>

        <div class="details-item">
            <span>Email</span>
            <strong>@Model.DoctorEmail</strong>
        </div>

        <div class="details-item">
            <span>License Number</span>
            <strong>@Model.LicenseNumber</strong>
        </div>

        <div class="details-item">
            <span>Total Leaves</span>
            <strong>@Model.TotalLeaves</strong>
        </div>

        <div class="details-item">
            <span>Current Leaves</span>
            <strong>@Model.CurrentLeaves</strong>
        </div>

        <div class="details-item">
            <span>Upcoming Leaves</span>
            <strong>@Model.UpcomingLeaves</strong>
        </div>
    </div>
</div>

<div class="section-card">
    <div class="section-header">
        <h2>Leave Periods</h2>

        <a asp-controller="ClinicManager"
           asp-action="AppointmentImpact"
           asp-route-doctorId="@Model.DoctorId"
           class="btn-link">
            Review impacted appointments
        </a>
    </div>

    @if (Model.HasLeaves)
    {
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var leave in Model.Leaves)
                    {
                <tr>
                    <td>@leave.LeaveDateText</td>
                    <td>@leave.LeaveReason</td>
                    <td>
                        <span class="status-pill">@leave.LeaveStatusText</span>
                    </td>
                    <td>
                        <a asp-controller="ClinicManager"
                           asp-action="EditDoctorLeave"
                           asp-route-id="@leave.DoctorLeaveId"
                           class="table-link">
                            Edit
                        </a>

                        <form asp-controller="ClinicManager"
                              asp-action="DeleteDoctorLeave"
                              asp-route-id="@leave.DoctorLeaveId"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="table-link danger-button"
                                    onclick="return confirm('Are you sure you want to delete this leave period? You should review impacted appointments after deleting it.');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
                    }
            </tbody>
        </table>
    </div>
    }
    else
    {
    <p class="empty-text">@Model.EmptyMessage</p>
    }
</div>

<div class="form-actions">
    <a asp-controller="ClinicManager"
       asp-action="CreateDoctorLeave"
       asp-route-doctorId="@Model.DoctorId"
       class="primary-btn">
        Add Leave
    </a>

    <a asp-controller="ClinicManager"
       asp-action="DoctorDetails"
       asp-route-id="@Model.DoctorId"
       class="secondary-btn">
        Back to Doctor Details
    </a>
</div>