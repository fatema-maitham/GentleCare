@model MVCApp.ViewModels.ClinicManager.ManageDoctorLeavesViewModel

@{
    ViewData["Title"] = "Appointment Impact";

    string StatusClass(string status) => status?.ToLower().Replace(" ", "") switch
    {
        "available" => "status-completed",
        "active" => "status-completed",
        "inactive" => "status-cancelled",
        "onleave" => "status-inprogress",
        "requested" => "status-requested",
        "confirmed" => "status-confirmed",
        "inprogress" => "status-inprogress",
        "checkedin" => "status-checkedin",
        "completed" => "status-completed",
        "cancelled" => "status-cancelled",
        "missed" => "status-missed",
        _ => "status-default"
    };
}

<div class="manager-page">
    <div class="manager-top">
        <a asp-controller="ClinicManager" asp-action="CreateDoctorLeave" asp-route-doctorId="@Model.DoctorId" class="btn-main">Add Leave</a>
        <a asp-controller="ClinicManager" asp-action="AppointmentImpact" asp-route-doctorId="@Model.DoctorId" class="btn-light">Check Impact</a>
    </div>

    <div class="manager-card">
        <div class="card-head"><h2>Dr. @Model.DoctorName</h2></div>
        <div class="info-grid">
            <div class="info-box"><span>Email</span><strong>@Model.DoctorEmail</strong></div>
            <div class="info-box"><span>License</span><strong>@Model.LicenseNumber</strong></div>
            <div class="info-box"><span>Total Leaves</span><strong>@Model.TotalLeaves</strong></div>
            <div class="info-box"><span>Current</span><strong>@Model.CurrentLeaves</strong></div>
            <div class="info-box"><span>Upcoming</span><strong>@Model.UpcomingLeaves</strong></div>
        </div>
    </div>

    <div class="manager-card">
        @if (Model.HasLeaves)
        {
            <div class="manager-table-wrap">
                <table class="manager-table">
                    <thead><tr><th>Date</th><th>Reason</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var leave in Model.Leaves)
                        {
                            <tr>
                                <td>@leave.LeaveDateText</td>
                                <td>@leave.LeaveReason</td>
                                <td>
                                <td><span class="status-pill @StatusClass(leave.LeaveStatusText)">@leave.LeaveStatusText</span></td>
                                <td>
                                    <a asp-controller="ClinicManager" asp-action="EditDoctorLeave" asp-route-id="@leave.DoctorLeaveId" class="table-link">Edit</a>
                                    <form asp-controller="ClinicManager" asp-action="DeleteDoctorLeave" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@leave.DoctorLeaveId" />
                                        <input type="hidden" name="doctorId" value="@Model.DoctorId" />
                                        <button type="submit" class="table-link" onclick="return confirm('Delete this leave?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">@Model.EmptyMessage</div>
        }
    </div>
</div>
