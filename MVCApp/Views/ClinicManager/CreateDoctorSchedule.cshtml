@model MVCApp.ViewModels.ClinicManager.DoctorScheduleFormViewModel

@{
    ViewData["Title"] = "Create Doctor Schedule";
}

<div class="page-header">
    <div>
        <h1>Create Doctor Schedule</h1>
        <p>Add a weekly working schedule for Dr. @Model.DoctorName.</p>
    </div>

    <a asp-controller="ClinicManager"
       asp-action="ManageDoctorSchedule"
       asp-route-doctorId="@Model.DoctorId"
       class="secondary-btn">
        Back to Schedule
    </a>
</div>

@if (TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="section-card">
    <form asp-controller="ClinicManager" asp-action="CreateDoctorSchedule" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="DoctorId" type="hidden" />
        <input asp-for="DoctorName" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="details-grid">
            <div class="details-item">
                <span>Doctor</span>
                <strong>Dr. @Model.DoctorName</strong>
            </div>

            <div class="details-item">
                <span>Mode</span>
                <strong>Create New Schedule</strong>
            </div>
        </div>

        <hr />

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="DayOfWeek"></label>
                <select asp-for="DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()"></select>
                <span asp-validation-for="DayOfWeek" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StartTime"></label>
                <input asp-for="StartTime" type="time" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EndTime"></label>
                <input asp-for="EndTime" type="time" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SlotDurationMinutes"></label>
                <input asp-for="SlotDurationMinutes" type="number" min="5" max="240" step="5" />
                <span asp-validation-for="SlotDurationMinutes" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="primary-btn">Create Schedule</button>

            <a asp-controller="ClinicManager"
               asp-action="ManageDoctorSchedule"
               asp-route-doctorId="@Model.DoctorId"
               class="secondary-btn">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}