@model MVCApp.ViewModels.ClinicManager.DoctorScheduleFormViewModel

@{
    ViewData["Title"] = "Create Doctor Schedule";
}

<div class="manager-page">
    
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}


    <div class="manager-card">
        <div class="card-head">
            <h2>@Model.PageTitle</h2>
            <span class="status-pill">Dr. @Model.DoctorName</span>
        </div>

        <form asp-controller="ClinicManager" asp-action="CreateDoctorSchedule" method="post" class="manager-form">
            @Html.AntiForgeryToken()

            <input asp-for="DoctorScheduleId" type="hidden" />
            <input asp-for="DoctorId" type="hidden" />
            <input asp-for="DoctorName" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="DayOfWeek"></label>
                    <select asp-for="DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()"></select>
                    <span asp-validation-for="DayOfWeek" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SlotDurationMinutes"></label>
                    <input asp-for="SlotDurationMinutes" type="number" min="5" max="240" />
                    <span asp-validation-for="SlotDurationMinutes" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="StartTime"></label>
                    <input asp-for="StartTime" type="time" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EndTime"></label>
                    <input asp-for="EndTime" type="time" />
                    <span asp-validation-for="EndTime" class="text-danger"></span>
                </div>
            </div>

            <div class="actions">
                <button type="submit" class="btn-main">Save Schedule</button>
                <a asp-controller="ClinicManager" asp-action="ManageDoctorSchedule" asp-route-doctorId="@Model.DoctorId" class="btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
