@model MVCApp.ViewModels.ClinicManager.ClinicManagerDoctorDetailsViewModel

@{
    ViewData["Title"] = "Doctor Details";

    string StatusClass(string status) => status?.ToLower().Replace(" ", "") switch
    {
        "available" => "status-completed",
        "active" => "status-completed",
        "inactive" => "status-cancelled",
        "onleave" => "status-inprogress",
        "requested" => "status-requested",
        "confirmed" => "status-confirmed",
        "inprogress" => "status-inprogress",
        "checkedin" => "status-checkedin",
        "completed" => "status-completed",
        "cancelled" => "status-cancelled",
        "missed" => "status-missed",
        _ => "status-default"
    };
}

<div class="manager-page">
    <div class="manager-top">
        <a asp-controller="ClinicManager" asp-action="EditDoctor" asp-route-id="@Model.DoctorId" class="btn-main">Edit Doctor</a>
        <a asp-controller="ClinicManager" asp-action="ManageDoctorSpecializations" asp-route-doctorId="@Model.DoctorId" class="btn-light">Specializations</a>
        <a asp-controller="ClinicManager" asp-action="ManageDoctorSchedule" asp-route-doctorId="@Model.DoctorId" class="btn-light">Schedule</a>
        <a asp-controller="ClinicManager" asp-action="ManageDoctorLeaves" asp-route-doctorId="@Model.DoctorId" class="btn-light">Leaves</a>
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>Dr. @Model.FullName</h2>
            <div class="actions">
                <span class="status-pill @StatusClass(Model.StatusText)">@Model.StatusText</span>
                <span class="status-pill @StatusClass(Model.LeaveStatusText)">@Model.LeaveStatusText</span>
            </div>
        </div>

        <div class="info-grid">
            <div class="info-box"><span>Email</span><strong>@Model.Email</strong></div>
            <div class="info-box"><span>Phone</span><strong>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not added" : Model.PhoneNumber)</strong></div>
            <div class="info-box"><span>License</span><strong>@Model.LicenseNumber</strong></div>
            <div class="info-box"><span>Specializations</span><strong>@Model.SpecializationsText</strong></div>
            <div class="info-box"><span>Total Appointments</span><strong>@Model.TotalAppointments</strong></div>
            <div class="info-box"><span>Upcoming</span><strong>@Model.UpcomingAppointments</strong></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Bio))
        {
            <div class="info-box" style="margin-top:12px;">
                <span>Bio</span>
                <strong>@Model.Bio</strong>
            </div>
        }
    </div>

    <div class="manager-grid">
        <div class="manager-stat"><span>Today</span><strong>@Model.TodayAppointments</strong></div>
        <div class="manager-stat"><span>Completed</span><strong>@Model.CompletedAppointments</strong></div>
        <div class="manager-stat"><span>Cancelled</span><strong>@Model.CancelledAppointments</strong></div>
        <div class="manager-stat"><span>Missed</span><strong>@Model.MissedAppointments</strong></div>
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>Schedule</h2>
            <a asp-controller="ClinicManager" asp-action="ManageDoctorSchedule" asp-route-doctorId="@Model.DoctorId" class="btn-light">Manage</a>
        </div>

        @if (Model.HasSchedules)
        {
            <div class="manager-table-wrap">
                <table class="manager-table">
                    <thead><tr><th>Day</th><th>Time</th><th>Slot</th></tr></thead>
                    <tbody>
                        @foreach (var schedule in Model.Schedules)
                        {
                            <tr>
                                <td>@schedule.DayName</td>
                                <td>@schedule.TimeRangeText</td>
                                <td>@schedule.SlotDurationMinutes min</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">No schedule added.</div>
        }
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>Leave Periods</h2>
            <a asp-controller="ClinicManager" asp-action="ManageDoctorLeaves" asp-route-doctorId="@Model.DoctorId" class="btn-light">Manage</a>
        </div>

        @if (Model.HasLeaves)
        {
            <div class="manager-table-wrap">
                <table class="manager-table">
                    <thead><tr><th>Date</th><th>Reason</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var leave in Model.Leaves)
                        {
                            <tr>
                                <td>@leave.LeaveDateText</td>
                                <td>@leave.LeaveReason</td>
                                <td>
                                <td><span class="status-pill @StatusClass(leave.LeaveStatusText)">@leave.LeaveStatusText</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">No leave periods added.</div>
        }
    </div>
</div>
