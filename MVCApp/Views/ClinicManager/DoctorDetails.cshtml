@model MVCApp.ViewModels.ClinicManager.DoctorDetailsViewModel

@{
    ViewData["Title"] = "Doctor Details";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">Doctor Details</h2>
            <p class="text-muted mb-0">@Model.FullName</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="ClinicManager" asp-action="Doctors" class="btn btn-outline-secondary">Back to Doctors</a>
            <a asp-controller="ClinicManager" asp-action="EditDoctor" asp-route-id="@Model.DoctorId" class="btn btn-primary">Edit Doctor</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Profile</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Full Name</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">License</dt>
                        <dd class="col-sm-8">@Model.LicenseNumber</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Upcoming</dt>
                        <dd class="col-sm-8">@Model.UpcomingAppointmentsCount appointment(s)</dd>

                        <dt class="col-sm-4">Bio</dt>
                        <dd class="col-sm-8">
                            @if (string.IsNullOrWhiteSpace(Model.Bio))
                            {
                                <span class="text-muted">No bio available.</span>
                            }
                            else
                            {
                                @Model.Bio
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Specializations</h5>
                    <a asp-controller="ClinicManager" asp-action="ManageSpecializations" asp-route-doctorId="@Model.DoctorId" class="btn btn-sm btn-outline-primary">Manage</a>
                </div>
                <div class="card-body">
                    @if (Model.Specializations == null || !Model.Specializations.Any())
                    {
                        <p class="text-muted mb-0">No specializations assigned.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var item in Model.Specializations)
                            {
                                <span class="badge bg-primary">@item</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body d-flex flex-wrap gap-2">
                    <a asp-controller="ClinicManager" asp-action="ManageSchedule" asp-route-doctorId="@Model.DoctorId" class="btn btn-outline-success">Manage Schedule</a>
                    <a asp-controller="ClinicManager" asp-action="ManageLeaves" asp-route-doctorId="@Model.DoctorId" class="btn btn-outline-danger">Manage Leaves</a>
                    <a asp-controller="ClinicManager" asp-action="AppointmentImpact" asp-route-doctorId="@Model.DoctorId" class="btn btn-outline-warning">Appointment Impact</a>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Schedule</h5>
                    <a asp-controller="ClinicManager" asp-action="ManageSchedule" asp-route-doctorId="@Model.DoctorId" class="btn btn-sm btn-outline-success">Manage</a>
                </div>
                <div class="card-body">
                    @if (Model.Schedules == null || !Model.Schedules.Any())
                    {
                        <p class="text-muted mb-0">No schedules found.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Day</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Slot</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Schedules)
                                    {
                                        <tr>
                                            <td>@item.DayOfWeek</td>
                                            <td>@item.StartTime.ToString(@"hh\:mm")</td>
                                            <td>@item.EndTime.ToString(@"hh\:mm")</td>
                                            <td>@item.SlotDurationMinutes min</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Leaves</h5>
                    <a asp-controller="ClinicManager" asp-action="ManageLeaves" asp-route-doctorId="@Model.DoctorId" class="btn btn-sm btn-outline-danger">Manage</a>
                </div>
                <div class="card-body">
                    @if (Model.Leaves == null || !Model.Leaves.Any())
                    {
                        <p class="text-muted mb-0">No leaves found.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Leaves)
                                    {
                                        <tr>
                                            <td>@item.LeaveStartDate.ToString("dd MMM yyyy")</td>
                                            <td>@item.LeaveEndDate.ToString("dd MMM yyyy")</td>
                                            <td>@item.LeaveReason</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
