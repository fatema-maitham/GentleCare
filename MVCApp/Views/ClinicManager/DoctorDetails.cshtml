@model MVCApp.ViewModels.ClinicManager.ClinicManagerDoctorDetailsViewModel

@{
    ViewData["Title"] = "Doctor Details";
}

<div class="page-header">
    <div>
        <h1>Dr. @Model.FullName</h1>
        <p>Doctor profile, specializations, schedule, leave periods, and appointment summary.</p>
    </div>

    <div class="header-actions">
        <a asp-controller="ClinicManager"
           asp-action="Doctors"
           class="secondary-btn">
            Back to Doctors
        </a>

        <a asp-controller="ClinicManager"
           asp-action="EditDoctor"
           asp-route-id="@Model.DoctorId"
           class="primary-btn">
            Edit Doctor
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Doctor Profile -->
<div class="section-card">
    <div class="section-header">
        <h2>Doctor Profile</h2>

        <span class="status-pill @(Model.IsActive ? "status-active" : "status-inactive")">
            @Model.StatusText
        </span>
    </div>

    <div class="details-grid">
        <div class="details-item">
            <span>Full Name</span>
            <strong>Dr. @Model.FullName</strong>
        </div>

        <div class="details-item">
            <span>Email</span>
            <strong>@Model.Email</strong>
        </div>

        <div class="details-item">
            <span>Phone Number</span>
            <strong>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</strong>
        </div>

        <div class="details-item">
            <span>License Number</span>
            <strong>@Model.LicenseNumber</strong>
        </div>

        <div class="details-item">
            <span>Leave Status</span>
            <strong>@Model.LeaveStatusText</strong>
        </div>

        <div class="details-item">
            <span>Created At</span>
            <strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Bio))
    {
    <div class="profile-note">
        <span>Bio</span>
        <p>@Model.Bio</p>
    </div>
    }
</div>

<!-- Quick Actions -->
<div class="section-card">
    <div class="section-header">
        <h2>Quick Actions</h2>
    </div>

    <div class="quick-actions">
        <a asp-controller="ClinicManager"
           asp-action="ManageDoctorSchedule"
           asp-route-doctorId="@Model.DoctorId"
           class="action-card">
            Manage Schedule
        </a>

        <a asp-controller="ClinicManager"
           asp-action="ManageDoctorLeaves"
           asp-route-doctorId="@Model.DoctorId"
           class="action-card">
            Manage Leaves
        </a>

        <a asp-controller="ClinicManager"
           asp-action="ManageDoctorSpecializations"
           asp-route-doctorId="@Model.DoctorId"
           class="action-card">
            Manage Specializations
        </a>

        <a asp-controller="ClinicManager"
           asp-action="AppointmentImpact"
           asp-route-doctorId="@Model.DoctorId"
           class="action-card danger-action">
            Review Impacted Appointments
        </a>
    </div>
</div>

<!-- Specializations -->
<div class="section-card">
    <div class="section-header">
        <h2>Specializations</h2>

        <a asp-controller="ClinicManager"
           asp-action="ManageDoctorSpecializations"
           asp-route-doctorId="@Model.DoctorId"
           class="btn-link">
            Edit specializations
        </a>
    </div>

    @if (Model.HasSpecializations)
    {
    <div class="tag-list">
        @foreach (var specialization in Model.Specializations)
            {
        <span class="tag-pill">@specialization</span>
            }
    </div>
    }
    else
    {
    <p class="empty-text">No specializations assigned.</p>
    }
</div>

<!-- Appointment Summary -->
<div class="dashboard-grid">
    <div class="dashboard-card">
        <span class="card-label">Total Appointments</span>
        <h2>@Model.TotalAppointments</h2>
        <p>All time</p>
    </div>

    <div class="dashboard-card">
        <span class="card-label">Today</span>
        <h2>@Model.TodayAppointments</h2>
        <p>Appointments today</p>
    </div>

    <div class="dashboard-card">
        <span class="card-label">Upcoming</span>
        <h2>@Model.UpcomingAppointments</h2>
        <p>Future active appointments</p>
    </div>

    <div class="dashboard-card">
        <span class="card-label">Completed</span>
        <h2>@Model.CompletedAppointments</h2>
        <p>Completed visits</p>
    </div>

    <div class="dashboard-card warning-card">
        <span class="card-label">Cancelled</span>
        <h2>@Model.CancelledAppointments</h2>
        <p>Cancelled appointments</p>
    </div>

    <div class="dashboard-card danger-card">
        <span class="card-label">Missed</span>
        <h2>@Model.MissedAppointments</h2>
        <p>Missed appointments</p>
    </div>
</div>

<!-- Appointment Status Summary -->
<div class="section-card">
    <div class="section-header">
        <h2>Appointment Status Breakdown</h2>

        <a asp-controller="ClinicManager"
           asp-action="Appointments"
           asp-route-doctorId="@Model.DoctorId"
           class="btn-link">
            View doctor appointments
        </a>
    </div>

    <div class="status-grid">
        <div class="status-box">
            <span>Requested</span>
            <strong>@Model.RequestedAppointments</strong>
        </div>

        <div class="status-box">
            <span>Confirmed</span>
            <strong>@Model.ConfirmedAppointments</strong>
        </div>

        <div class="status-box">
            <span>Checked In</span>
            <strong>@Model.CheckedInAppointments</strong>
        </div>

        <div class="status-box">
            <span>In Progress</span>
            <strong>@Model.InProgressAppointments</strong>
        </div>

        <div class="status-box">
            <span>Completed</span>
            <strong>@Model.CompletedAppointments</strong>
        </div>

        <div class="status-box">
            <span>Cancelled</span>
            <strong>@Model.CancelledAppointments</strong>
        </div>

        <div class="status-box">
            <span>Missed</span>
            <strong>@Model.MissedAppointments</strong>
        </div>
    </div>
</div>

<!-- Weekly Schedule -->
<div class="section-card">
    <div class="section-header">
        <h2>Weekly Schedule</h2>

        <a asp-controller="ClinicManager"
           asp-action="ManageDoctorSchedule"
           asp-route-doctorId="@Model.DoctorId"
           class="btn-link">
            Manage schedule
        </a>
    </div>

    @if (Model.HasSchedules)
    {
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Time</th>
                    <th>Slot Duration</th>
                    <th>Working Hours</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var schedule in Model.Schedules)
                    {
                <tr>
                    <td>@schedule.DayName</td>
                    <td>@schedule.TimeRangeText</td>
                    <td>@schedule.SlotDurationMinutes minutes</td>
                    <td>@schedule.WorkingHours.ToString("0.##") hours</td>
                </tr>
                    }
            </tbody>
        </table>
    </div>
    }
    else
    {
    <p class="empty-text">No weekly schedule added for this doctor.</p>
    }
</div>

<!-- Leave Periods -->
<div class="section-card">
    <div class="section-header">
        <h2>Leave Periods</h2>

        <a asp-controller="ClinicManager"
           asp-action="ManageDoctorLeaves"
           asp-route-doctorId="@Model.DoctorId"
           class="btn-link">
            Manage leaves
        </a>
    </div>

    @if (Model.HasLeaves)
    {
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Reason</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var leave in Model.Leaves)
                    {
                <tr>
                    <td>@leave.LeaveDateText</td>
                    <td>@leave.LeaveReason</td>
                    <td>
                        <span class="status-pill">@leave.LeaveStatusText</span>
                    </td>
                </tr>
                    }
            </tbody>
        </table>
    </div>
    }
    else
    {
    <p class="empty-text">No leave periods added for this doctor.</p>
    }
</div>