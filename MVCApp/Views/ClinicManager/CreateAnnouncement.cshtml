@model MVCApp.ViewModels.ClinicManager.ClinicAnnouncementViewModel

@{
    ViewData["Title"] = "Create Announcement";
}

<div class="manager-page">
    <div class="manager-card">
        <div class="card-head">
            <h2>@(ViewData["Title"] ?? "Clinic Manager")</h2>
        </div>
    </div>

    <div class="announcement-page">

        @if (TempData["Error"] != null)
        {
            <div class="manager-alert manager-alert-danger">@TempData["Error"]</div>
        }

        <div class="manager-card">
            <div class="card-head">
                <h2>Create Announcement</h2>
            </div>

            <form asp-action="CreateAnnouncement" method="post" class="announcement-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="form-group">
                    <label asp-for="Title">Announcement Title</label>
                    <input asp-for="Title" placeholder="Enter announcement title" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SelectedAudience">Send To</label>
                    <select asp-for="SelectedAudience" asp-items="Model.AudienceOptions">
                        <option value="">Select audience</option>
                    </select>
                    <span asp-validation-for="SelectedAudience" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Message">Message</label>
                    <textarea asp-for="Message" placeholder="Write the announcement message"></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>

                <div class="announcement-actions">
                    <a asp-action="Notifications" class="btn-light">Cancel</a>
                    <button type="submit" class="btn-main">Send Announcement</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}