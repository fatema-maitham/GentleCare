@model MVCApp.ViewModels.ClinicManager.ClinicAnnouncementViewModel

@{
    ViewData["Title"] = "Create Announcement";
}

<style>
    .announcement-page {
        max-width: 880px;
        margin: 0 auto;
        padding: 20px 0 56px;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .announcement-header {
        margin-bottom: 22px;
    }

        .announcement-header h1 {
            margin: 0;
            color: #12262F;
            font-size: 31px;
            font-weight: 900;
        }

        .announcement-header p {
            margin: 8px 0 0;
            color: #687A80;
            font-weight: 650;
            line-height: 1.6;
        }

    .announcement-card {
        background: #ffffff;
        border: 1px solid #D6DDDE;
        border-radius: 20px;
        padding: 26px;
        box-shadow: 0 10px 24px rgba(7, 81, 104, 0.08);
    }

    .announcement-form {
        display: grid;
        gap: 18px;
    }

    .form-group {
        display: grid;
        gap: 7px;
    }

        .form-group label {
            color: #12262F;
            font-weight: 900;
            font-size: 14px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            border: 1px solid #D6DDDE;
            border-radius: 14px;
            padding: 13px 14px;
            color: #12262F;
            background: #ffffff;
            font-weight: 650;
            outline: none;
        }

        .form-group textarea {
            min-height: 170px;
            resize: vertical;
            line-height: 1.6;
        }

            .form-group input:focus,
            .form-group select:focus,
            .form-group textarea:focus {
                border-color: #00779B;
                box-shadow: 0 0 0 4px rgba(0, 119, 155, 0.14);
            }

    .validation-summary-errors {
        background: rgba(180, 35, 24, 0.08);
        color: #B42318;
        border: 1px solid rgba(180, 35, 24, 0.18);
        border-radius: 14px;
        padding: 14px 16px;
        font-weight: 750;
    }

    .text-danger {
        color: #B42318 !important;
        font-size: 13px;
        font-weight: 750;
    }

    .announcement-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        margin-top: 8px;
        flex-wrap: wrap;
    }

    .primary-action,
    .secondary-action {
        border: none;
        border-radius: 999px;
        padding: 11px 20px;
        font-weight: 900;
        text-decoration: none;
        cursor: pointer;
    }

    .primary-action {
        background: #075168;
        color: #ffffff;
    }

        .primary-action:hover {
            background: #00779B;
            color: #ffffff;
        }

    .secondary-action {
        background: #E7EEF0;
        color: #075168;
    }

        .secondary-action:hover {
            background: #DDE8EA;
            color: #075168;
        }

    @@media (max-width: 700px) {
        .announcement-card {
            padding: 20px;
        }

        .announcement-header h1 {
            font-size: 26px;
        }

        .announcement-actions {
            justify-content: stretch;
        }

        .primary-action,
        .secondary-action {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="announcement-page">
  

    <div class="announcement-card">
        <form asp-action="CreateAnnouncement" method="post" class="announcement-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-group">
                <label asp-for="Title">Announcement Title</label>
                <input asp-for="Title" placeholder="Enter announcement title" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SelectedAudience">Send To</label>
                <select asp-for="SelectedAudience" asp-items="Model.AudienceOptions">
                    <option value="">Select audience</option>
                </select>
                <span asp-validation-for="SelectedAudience" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Message">Message</label>
                <textarea asp-for="Message" placeholder="Write the announcement message"></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>

            <div class="announcement-actions">
                <a asp-action="Notifications" class="secondary-action">Cancel</a>
                <button type="submit" class="primary-action">Send Announcement</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}