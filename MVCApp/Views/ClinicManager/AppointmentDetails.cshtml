@model MVCApp.ViewModels.ClinicManager.ClinicManagerAppointmentDetailsViewModel

@{
    ViewData["Title"] = "Appointment Details";
}

<style>
    .details-page {
        max-width: 1050px;
        margin: 0 auto;
        padding: 30px 24px;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .top-bar h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            color: #102a43;
        }

        .top-bar p {
            margin: 6px 0 0;
            color: #607080;
            font-size: 14px;
        }

    .actions {
        display: flex;
        gap: 10px;
    }

    .btn-back,
    .btn-update {
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }

    .btn-back {
        background: #eef3f7;
        color: #39566f;
    }

    .btn-update {
        background: #607fa5;
        color: white;
    }

    .main-card {
        background: white;
        border: 1px solid #d9e2ec;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 18px;
    }

    .card-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

        .card-title h2 {
            margin: 0;
            font-size: 20px;
            color: #102a43;
        }

    .status {
        background: #e8f1f5;
        color: #37627a;
        padding: 6px 12px;
        border-radius: 50px;
        font-size: 13px;
        font-weight: 700;
    }

    .details-table {
        width: 100%;
        border-collapse: collapse;
    }

        .details-table tr {
            border-bottom: 1px solid #edf2f7;
        }

            .details-table tr:last-child {
                border-bottom: none;
            }

        .details-table th {
            text-align: left;
            width: 230px;
            padding: 14px 10px 14px 0;
            color: #607080;
            font-size: 14px;
            font-weight: 600;
        }

        .details-table td {
            padding: 14px 0;
            color: #102a43;
            font-size: 15px;
            font-weight: 600;
        }

    .two-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .note-box {
        margin-top: 16px;
        background: #f8fafc;
        border: 1px solid #d9e2ec;
        border-radius: 10px;
        padding: 14px;
    }

        .note-box strong {
            display: block;
            color: #607080;
            margin-bottom: 6px;
            font-size: 14px;
        }

        .note-box p {
            margin: 0;
            color: #102a43;
            line-height: 1.6;
        }

    .empty-text {
        margin: 0;
        color: #607080;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        padding: 16px;
        border-radius: 10px;
    }

    .alert {
        padding: 12px 14px;
        border-radius: 10px;
        margin-bottom: 16px;
        font-weight: 600;
    }

    .alert-success {
        background: #e8f8ef;
        color: #176b3a;
    }

    .alert-danger {
        background: #fff0f0;
        color: #a73535;
    }

    @@media (max-width: 800px) {
        .top-bar {
            flex-direction: column;
            align-items: flex-start;
            gap: 14px;
        }

        .two-columns {
            grid-template-columns: 1fr;
        }

        .details-table th,
        .details-table td {
            display: block;
            width: 100%;
            padding: 6px 0;
        }

        .details-table tr {
            padding: 10px 0;
            display: block;
        }
    }
</style>

<div class="details-page">

    <div class="top-bar">
        <div>
            <h1>Appointment Details</h1>
            <p>View appointment, patient, doctor, and visit record information.</p>
        </div>

        <div class="actions">
            <a asp-controller="ClinicManager"
               asp-action="Appointments"
               class="btn-back">
                Back
            </a>

            @if (Model.CanUpdateStatus)
            {
            <a asp-controller="ClinicManager"
               asp-action="UpdateAppointmentStatus"
               asp-route-id="@Model.AppointmentId"
               class="btn-update">
                Update Status
            </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="main-card">
        <div class="card-title">
            <h2>Appointment Information</h2>
            <span class="status">@Model.StatusName</span>
        </div>

        <table class="details-table">
            <tr>
                <th>Date</th>
                <td>@Model.DateText</td>
            </tr>
            <tr>
                <th>Time</th>
                <td>@Model.TimeText</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>@Model.StatusName</td>
            </tr>
            <tr>
                <th>Specialization</th>
                <td>@(string.IsNullOrWhiteSpace(Model.SpecializationName) ? "Not specified" : Model.SpecializationName)</td>
            </tr>
            <tr>
                <th>Created At</th>
                <td>@Model.CreatedAt.ToString("dd MMM yyyy")</td>
            </tr>
            <tr>
                <th>Updated At</th>
                <td>@(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd MMM yyyy") : "Not updated")</td>
            </tr>
        </table>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
        <div class="note-box">
            <strong>Notes</strong>
            <p>@Model.Notes</p>
        </div>
        }

        @if (Model.IsCancelled && !string.IsNullOrWhiteSpace(Model.CancellationReason))
        {
        <div class="note-box">
            <strong>Cancellation Reason</strong>
            <p>@Model.CancellationReason</p>
        </div>
        }
    </div>

    <div class="two-columns">

        <div class="main-card">
            <div class="card-title">
                <h2>Patient Information</h2>
            </div>

            <table class="details-table">
                <tr>
                    <th>Name</th>
                    <td>@Model.PatientName</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>@Model.PatientEmail</td>
                </tr>
                <tr>
                    <th>Phone</th>
                    <td>@(string.IsNullOrWhiteSpace(Model.PatientPhoneNumber) ? "Not provided" : Model.PatientPhoneNumber)</td>
                </tr>
                <tr>
                    <th>Reference No.</th>
                    <td>@Model.PatientReferenceNumber</td>
                </tr>
                <tr>
                    <th>CPR Number</th>
                    <td>@Model.PatientCprNumber</td>
                </tr>
            </table>
        </div>

        <div class="main-card">
            <div class="card-title">
                <h2>Doctor Information</h2>
            </div>

            <table class="details-table">
                <tr>
                    <th>Name</th>
                    <td>Dr. @Model.DoctorName</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>@Model.DoctorEmail</td>
                </tr>
                <tr>
                    <th>License No.</th>
                    <td>@Model.DoctorLicenseNumber</td>
                </tr>
            </table>
        </div>

    </div>

    <div class="main-card">
        <div class="card-title">
            <h2>Visit Record Summary</h2>
        </div>

        @if (Model.HasVisitRecord)
        {
        <table class="details-table">
            <tr>
                <th>Diagnosis</th>
                <td>@Model.Diagnosis</td>
            </tr>
            <tr>
                <th>Treatment</th>
                <td>@Model.Treatment</td>
            </tr>
            <tr>
                <th>Prescriptions</th>
                <td>@Model.PrescriptionCount</td>
            </tr>
        </table>

        if (!string.IsNullOrWhiteSpace(Model.DoctorNotes))
            {
        <div class="note-box">
            <strong>Doctor Notes</strong>
            <p>@Model.DoctorNotes</p>
        </div>
            }
        }
        else
        {
        <p class="empty-text">No visit record has been added for this appointment yet.</p>
        }
    </div>

</div>