@model MVCApp.ViewModels.ClinicManager.ClinicManagerAppointmentDetailsViewModel

@{
    ViewData["Title"] = "Appointment Details";

    string StatusClass(string status) => status?.ToLower().Replace(" ", "") switch
    {
        "requested" => "status-requested",
        "confirmed" => "status-confirmed",
        "inprogress" => "status-inprogress",
        "checkedin" => "status-checkedin",
        "completed" => "status-completed",
        "cancelled" => "status-cancelled",
        "missed" => "status-missed",
        _ => "status-default"
    };
}

<div class="manager-page">
    <div class="manager-top">
        @if (Model.CanUpdateStatus)
        {
            <a asp-controller="ClinicManager" asp-action="UpdateAppointmentStatus" asp-route-id="@Model.AppointmentId" class="btn-main">Update Status</a>
        }
        <a asp-controller="ClinicManager" asp-action="Appointments" class="btn-light">Appointments</a>
    </div>


    <div class="manager-card">
        <div class="card-head">
            <h2>Appointment #@Model.AppointmentId</h2>
            <span class="status-pill @StatusClass(Model.StatusName)">@Model.StatusName</span>
        </div>

        <div class="info-grid">
            <div class="info-box"><span>Date</span><strong>@Model.DateText</strong></div>
            <div class="info-box"><span>Time</span><strong>@Model.TimeText</strong></div>
            <div class="info-box"><span>Specialization</span><strong>@Model.SpecializationName</strong></div>
            <div class="info-box"><span>Created</span><strong>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</strong></div>
            <div class="info-box"><span>Updated</span><strong>@(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm") : "Not updated")</strong></div>
            <div class="info-box"><span>Prescription Count</span><strong>@Model.PrescriptionCount</strong></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="info-box" style="margin-top:12px;"><span>Notes</span><strong>@Model.Notes</strong></div>
        }

        @if (Model.IsCancelled && !string.IsNullOrWhiteSpace(Model.CancellationReason))
        {
            <div class="info-box" style="margin-top:12px;"><span>Cancellation Reason</span><strong>@Model.CancellationReason</strong></div>
        }
    </div>

    <div class="manager-card">
        <div class="card-head"><h2>Patient</h2></div>
        <div class="info-grid">
            <div class="info-box"><span>Name</span><strong>@Model.PatientName</strong></div>
            <div class="info-box"><span>Email</span><strong>@Model.PatientEmail</strong></div>
            <div class="info-box"><span>Phone</span><strong>@Model.PatientPhoneNumber</strong></div>
            <div class="info-box"><span>Reference No.</span><strong>@Model.PatientReferenceNumber</strong></div>
            <div class="info-box"><span>CPR</span><strong>@Model.PatientCprNumber</strong></div>
        </div>
    </div>

    <div class="manager-card">
        <div class="card-head"><h2>Doctor</h2></div>
        <div class="info-grid">
            <div class="info-box"><span>Name</span><strong>Dr. @Model.DoctorName</strong></div>
            <div class="info-box"><span>Email</span><strong>@Model.DoctorEmail</strong></div>
            <div class="info-box"><span>License</span><strong>@Model.DoctorLicenseNumber</strong></div>
        </div>
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>Visit Record</h2>
            @if (Model.HasVisitRecord)
            {
                <span class="status-pill status-completed">Available</span>
            }
        </div>

        @if (Model.HasVisitRecord)
        {
            <div class="info-grid">
                <div class="info-box"><span>Diagnosis</span><strong>@Model.Diagnosis</strong></div>
                <div class="info-box"><span>Treatment</span><strong>@Model.Treatment</strong></div>
                <div class="info-box"><span>Doctor Notes</span><strong>@Model.DoctorNotes</strong></div>
            </div>
        }
        else
        {
            <div class="empty-box">No visit record has been added for this appointment.</div>
        }
    </div>
</div>
