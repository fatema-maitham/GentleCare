@model MVCApp.ViewModels.ClinicManager.AppointmentImpactViewModel

@{
    ViewData["Title"] = "Appointment Impact";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">Appointment Impact</h2>
            <p class="text-muted mb-0">@Model.DoctorName</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="ClinicManager" asp-action="DoctorDetails" asp-route-id="@Model.DoctorId" class="btn btn-outline-secondary">Back to Details</a>
            <a asp-controller="ClinicManager" asp-action="Appointments" class="btn btn-outline-primary">All Appointments</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="ClinicManager" asp-action="AppointmentImpact" method="get" class="row g-3">
                <input type="hidden" name="doctorId" value="@Model.DoctorId" />

                <div class="col-md-4">
                    <label asp-for="FromDate" class="form-label">From Date</label>
                    <input asp-for="FromDate" class="form-control" type="date" />
                </div>

                <div class="col-md-4">
                    <label asp-for="ToDate" class="form-label">To Date</label>
                    <input asp-for="ToDate" class="form-control" type="date" />
                </div>

                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">Apply Filter</button>
                    <a asp-controller="ClinicManager" asp-action="AppointmentImpact" asp-route-doctorId="@Model.DoctorId" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Impacted Appointments</h5>
            <span class="badge bg-warning text-dark">@Model.ImpactedAppointments.Count</span>
        </div>
        <div class="card-body p-0">
            @if (Model.ImpactedAppointments == null || !Model.ImpactedAppointments.Any())
            {
                <div class="p-4 text-center text-muted">No impacted appointments found for the selected period.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th>Impact Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ImpactedAppointments)
                            {
                                <tr>
                                    <td>@item.AppointmentDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                                    <td>@item.PatientName</td>
                                    <td>@item.StatusName</td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <span class="text-muted">No notes</span>
                                        }
                                        else
                                        {
                                            @item.Notes
                                        }
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(item.ImpactReason))
                                        {
                                            <span class="text-muted">No issue</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@item.ImpactReason</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
