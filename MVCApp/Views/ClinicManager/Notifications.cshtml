@model MVCApp.ViewModels.ClinicManager.ClinicManagerNotificationViewModel

@{
    ViewData["Title"] = "Notifications";

    string StatusClass(string status) => status?.ToLower() switch
    {
        "read" => "status-completed",  // green
        "unread" => "status-requested",  // gray
        _ => "status-default"
    };
}

<div class="manager-page">
    <div class="manager-card">
        <div class="card-head">
            <h2>@(ViewData["Title"] ?? "Clinic Manager")</h2>
        </div>
    </div>

    <div class="manager-grid">
        <div class="manager-stat"><span>Total</span><strong>@Model.TotalNotifications</strong></div>
        <div class="manager-stat"><span>Unread</span><strong>@Model.UnreadNotifications</strong></div>
        <div class="manager-stat"><span>Read</span><strong>@Model.ReadNotifications</strong></div>
    </div>

    <div class="manager-card">
        <div class="card-head">
            <h2>Notifications</h2>
            @if (Model.HasUnreadNotifications)
            {
                <form asp-controller="ClinicManager" asp-action="MarkAllNotificationsAsRead" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-main">Mark All Read</button>
                </form>
            }
        </div>

        @if (Model.HasNotifications)
        {
            <div class="manager-table-wrap">
                <table class="manager-table">
                    <thead><tr><th>Title</th><th>Message</th><th>Type</th><th>Status</th><th>Date</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var notification in Model.Notifications)
                        {
                            <tr>
                                <td>@notification.Title</td>
                                <td>@notification.Message</td>
                                <td>@notification.NotificationTypeName</td>
                                <td><td><span class="status-pill @StatusClass(notification.StatusText)">@notification.StatusText</span></td>
                                <td>@notification.CreatedAtText</td>
                                <td>
                                    @if (!notification.IsRead)
                                    {
                                        <form asp-controller="ClinicManager" asp-action="MarkNotificationAsRead" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="notificationId" value="@notification.NotificationId" />
                                            <button type="submit" class="table-link">Mark Read</button>
                                        </form>
                                    }
                                    @if (notification.HasRelatedEntity && notification.RelatedEntityType == "Appointment")
                                    {
                                        <a asp-controller="ClinicManager" asp-action="AppointmentDetails" asp-route-id="@notification.RelatedEntityId" class="table-link">Open</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">@Model.EmptyMessage</div>
        }
    </div>
</div>
