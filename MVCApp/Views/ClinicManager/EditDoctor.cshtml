@model MVCApp.ViewModels.ClinicManager.DoctorEditViewModel

@{
    ViewData["Title"] = "Edit Doctor";
}

<div class="page-header">
    <div>
        <h1>Edit Doctor</h1>
        <p>Update doctor account, profile, status, password, and specializations.</p>
    </div>

    <a asp-controller="ClinicManager"
       asp-action="DoctorDetails"
       asp-route-id="@Model.DoctorId"
       class="secondary-btn">
        Back to Details
    </a>
</div>

@if (TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="section-card">
    <form asp-controller="ClinicManager" asp-action="EditDoctor" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="DoctorId" type="hidden" />
        <input asp-for="UserId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LicenseNumber"></label>
                <input asp-for="LicenseNumber" />
                <span asp-validation-for="LicenseNumber" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Bio"></label>
            <textarea asp-for="Bio" rows="4"></textarea>
            <span asp-validation-for="Bio" class="text-danger"></span>
        </div>

        <div class="form-group checkbox-row">
            <input asp-for="IsActive" />
            <label asp-for="IsActive"></label>
            <span asp-validation-for="IsActive" class="text-danger"></span>
        </div>

        <hr />

        <h2>Password Reset</h2>
        <p class="empty-text">Leave these fields empty if you do not want to change the doctor's password.</p>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmNewPassword"></label>
                <input asp-for="ConfirmNewPassword" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>
        </div>

        <hr />

        <div class="form-group">
            <label asp-for="SelectedSpecializationIds"></label>

            @if (Model.SpecializationOptions.Any())
            {
            <div class="checkbox-list">
                @foreach (var specialization in Model.SpecializationOptions)
                    {
                        var specializationId = int.Parse(specialization.Value);

                <label class="checkbox-item">
                    <input type="checkbox"
                           name="SelectedSpecializationIds"
                           value="@specialization.Value"
                           checked="@(Model.SelectedSpecializationIds.Contains(specializationId))" />
                    <span>@specialization.Text</span>
                </label>
                    }
            </div>
            }
            else
            {
            <p class="empty-text">No specializations are available.</p>
            }

            <span asp-validation-for="SelectedSpecializationIds" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="primary-btn">Save Changes</button>

            <a asp-controller="ClinicManager"
               asp-action="DoctorDetails"
               asp-route-id="@Model.DoctorId"
               class="secondary-btn">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}