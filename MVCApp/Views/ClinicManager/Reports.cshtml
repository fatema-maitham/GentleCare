@model MVCApp.ViewModels.ClinicManager.ClinicReportViewModel

@{
    ViewData["Title"] = "Clinic Reports";
}

<div class="reports-page">

    <div class="reports-header">
        <div>
            <h1>Clinic Reports</h1>
            <p>Operational reports for clinic performance, doctor workload, and appointment outcomes.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="report-card">
        <div class="report-card-header">
            <h2>Report Filter</h2>
            <span>@Model.DateRangeText</span>
        </div>

        <form asp-controller="ClinicManager" asp-action="Reports" method="get" class="filter-form">
            <div class="form-group">
                <label for="fromDate">From Date</label>
                <input type="date"
                       id="fromDate"
                       name="fromDate"
                       value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>

            <div class="form-group">
                <label for="toDate">To Date</label>
                <input type="date"
                       id="toDate"
                       name="toDate"
                       value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>

            <div class="filter-actions">
                <button type="submit" class="btn-main">Generate Report</button>
                <a asp-action="Reports" class="btn-light">Reset</a>
            </div>
        </form>
    </div>

    <div class="report-card">
        <div class="report-card-header">
            <h2>Monthly Clinic Performance Report</h2>
            <span>Clinic activity summary</span>
        </div>

        <div class="summary-grid">
            <div class="summary-box">
                <span>Total Appointments</span>
                <strong>@Model.TotalAppointments</strong>
            </div>

            <div class="summary-box">
                <span>Completed Visits</span>
                <strong>@Model.CompletedAppointments</strong>
            </div>

            <div class="summary-box">
                <span>Cancelled</span>
                <strong>@Model.CancelledAppointments</strong>
            </div>

            <div class="summary-box">
                <span>Missed</span>
                <strong>@Model.MissedAppointments</strong>
            </div>
        </div>

        <div class="rate-grid">
            <div class="rate-box">
                <span>Completion Rate</span>
                <strong>@Model.CompletionRate.ToString("0.##")%</strong>
            </div>

            <div class="rate-box">
                <span>Cancellation Rate</span>
                <strong>@Model.CancellationRate.ToString("0.##")%</strong>
            </div>

            <div class="rate-box">
                <span>Total Doctors</span>
                <strong>@Model.TotalDoctors</strong>
            </div>

            <div class="rate-box">
                <span>Active Doctors</span>
                <strong>@Model.ActiveDoctors</strong>
            </div>

            <div class="rate-box">
                <span>Doctors With Appointments</span>
                <strong>@Model.DoctorsWithAppointments</strong>
            </div>

            <div class="rate-box">
                <span>Doctors On Leave</span>
                <strong>@Model.DoctorsOnLeave</strong>
            </div>
        </div>
    </div>

    <div class="report-card">
        <div class="report-card-header">
            <h2>Doctor Utilization Report</h2>
            <span>Workload and performance</span>
        </div>

        @if (Model.HasDoctorReports)
        {
            <div class="table-wrap">
                <table class="reports-table">
                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Total</th>
                            <th>Completed</th>
                            <th>Cancelled</th>
                            <th>Missed</th>
                            <th>Remaining</th>
                            <th>Completion Rate</th>
                            <th>Workload</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.DoctorReports)
                        {
                            <tr>
                                <td>
                                    <strong>Dr. @item.DoctorName</strong>
                                    <small>@item.DoctorEmail</small>
                                </td>
                                <td>@item.TotalAppointments</td>
                                <td>@item.CompletedAppointments</td>
                                <td>@item.CancelledAppointments</td>
                                <td>@item.MissedAppointments</td>
                                <td>@item.RemainingAppointments</td>
                                <td>@item.CompletionRate.ToString("0.##")%</td>
                                <td>
                                    <span class="pill">@item.WorkloadLevel</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">No doctor utilization data found for this period.</div>
        }
    </div>

    <div class="report-card">
        <div class="report-card-header">
            <h2>Available Report Types</h2>
            <span>Manager reporting scope</span>
        </div>

        <div class="report-type-grid">
            <div class="report-type">
                <strong>Doctor Utilization Report</strong>
                <p>Displays doctor workload statistics, completed visits, cancellations, missed appointments, and utilization percentage.</p>
            </div>

            <div class="report-type">
                <strong>Monthly Clinic Performance Report</strong>
                <p>Summarizes total appointments, completion rate, cancellation rate, and overall clinic activity.</p>
            </div>

            <div class="report-type">
                <strong>Specialization Demand Report</strong>
                <p>Shows which medical specializations are most requested by patients for resource planning.</p>
            </div>

            <div class="report-type">
                <strong>Busiest Hours Report</strong>
                <p>Identifies the most crowded appointment time slots during the day to improve scheduling.</p>
            </div>

            <div class="report-type">
                <strong>Doctor Leave Impact Report</strong>
                <p>Displays appointments affected by doctor leave periods and operational schedule changes.</p>
            </div>

            <div class="report-type">
                <strong>Missed Appointment Risk Report</strong>
                <p>Highlights patients with repeated missed appointments to reduce no-shows.</p>
            </div>

            <div class="report-type">
                <strong>Cancellation Reason Analysis Report</strong>
                <p>Analyzes common cancellation reasons to identify appointment scheduling issues.</p>
            </div>

            <div class="report-type">
                <strong>Prescription Volume Report</strong>
                <p>Shows prescription activity by doctor or specialization to monitor treatment workload.</p>
            </div>
        </div>
    </div>

</div>

<style>
    .reports-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 30px 20px 60px;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .reports-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        margin-bottom: 24px;
    }

        .reports-header h1 {
            margin: 0;
            color: #12262F;
            font-size: 34px;
            font-weight: 900;
        }

        .reports-header p {
            margin: 8px 0 0;
            color: #687A80;
            font-weight: 700;
            line-height: 1.6;
        }

    .report-card {
        background: #ffffff;
        border: 1px solid #D6DDDE;
        border-radius: 22px;
        margin-bottom: 24px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(7, 81, 104, 0.05);
    }

    .report-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #E9EEEE;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

        .report-card-header h2 {
            margin: 0;
            color: #075168;
            font-size: 21px;
            font-weight: 900;
        }

        .report-card-header span {
            color: #687A80;
            font-size: 14px;
            font-weight: 800;
        }

    .filter-form {
        padding: 24px;
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 16px;
        align-items: end;
    }

    .form-group {
        display: grid;
        gap: 7px;
    }

        .form-group label {
            color: #12262F;
            font-size: 14px;
            font-weight: 900;
        }

        .form-group input {
            width: 100%;
            min-height: 44px;
            border: 1px solid #B9CBD0;
            border-radius: 13px;
            padding: 10px 12px;
            color: #12262F;
            background: #fff;
            font-size: 15px;
            font-weight: 700;
            outline: none;
        }

            .form-group input:focus {
                border-color: #075168;
                box-shadow: 0 0 0 3px rgba(7, 81, 104, 0.12);
            }

    .filter-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-main,
    .btn-light {
        border-radius: 13px;
        padding: 10px 16px;
        min-height: 44px;
        font-size: 14px;
        font-weight: 900;
        text-decoration: none;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        white-space: nowrap;
    }

    .btn-main {
        background: #075168;
        color: #ffffff;
    }

        .btn-main:hover {
            background: #043C4D;
            color: #ffffff;
        }

    .btn-light {
        background: #F1EFED;
        color: #12262F;
        border: 1px solid #D6DDDE;
    }

    .summary-grid {
        padding: 24px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .summary-box {
        background: #F7FAFA;
        border: 1px solid #E2E8EA;
        border-radius: 18px;
        padding: 18px;
    }

        .summary-box span,
        .rate-box span {
            display: block;
            color: #687A80;
            font-size: 13px;
            font-weight: 850;
            margin-bottom: 8px;
        }

        .summary-box strong {
            display: block;
            color: #075168;
            font-size: 31px;
            font-weight: 900;
            line-height: 1;
        }

    .rate-grid {
        padding: 0 24px 24px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .rate-box {
        background: #ffffff;
        border: 1px solid #E2E8EA;
        border-radius: 16px;
        padding: 15px;
    }

        .rate-box strong {
            color: #12262F;
            font-size: 17px;
            font-weight: 900;
        }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .reports-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

        .reports-table th {
            background: #F8FAFA;
            color: #687A80;
            text-align: left;
            padding: 14px 16px;
            font-size: 13px;
            font-weight: 900;
            border-bottom: 1px solid #D6DDDE;
            white-space: nowrap;
        }

        .reports-table td {
            color: #12262F;
            padding: 16px;
            font-size: 14px;
            font-weight: 700;
            border-bottom: 1px solid #EEF2F3;
            vertical-align: middle;
        }

            .reports-table td strong {
                display: block;
                color: #12262F;
                font-weight: 900;
            }

            .reports-table td small {
                display: block;
                color: #687A80;
                font-size: 12px;
                font-weight: 700;
                margin-top: 4px;
            }

    .pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 6px 11px;
        background: #EAF4F6;
        color: #075168;
        border: 1px solid #C9DBDF;
        font-size: 12px;
        font-weight: 900;
        white-space: nowrap;
    }

    .report-type-grid {
        padding: 24px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .report-type {
        background: #F7FAFA;
        border: 1px solid #E2E8EA;
        border-radius: 17px;
        padding: 16px;
    }

        .report-type strong {
            display: block;
            color: #12262F;
            font-size: 15px;
            font-weight: 900;
            margin-bottom: 6px;
        }

        .report-type p {
            margin: 0;
            color: #687A80;
            line-height: 1.55;
            font-size: 13px;
            font-weight: 700;
        }

    .empty-box {
        margin: 24px;
        padding: 18px;
        border-radius: 16px;
        background: #E7F1F3;
        color: #075168;
        font-weight: 850;
        text-align: center;
    }

    .alert {
        border-radius: 14px;
        padding: 13px 15px;
        margin-bottom: 16px;
        font-weight: 800;
        border: 1px solid transparent;
    }

    .alert-success {
        background: #ECFDF3;
        color: #157347;
        border-color: #B7E4C7;
    }

    .alert-danger {
        background: #FFF1F0;
        color: #B42318;
        border-color: #F3B8B2;
    }

    @@media (max-width: 950px) {
        .filter-form,
        .summary-grid,
        .rate-grid,
        .report-type-grid {
            grid-template-columns: 1fr;
        }

        .filter-actions {
            width: 100%;
        }

        .btn-main,
        .btn-light {
            width: 100%;
        }
    }
</style>