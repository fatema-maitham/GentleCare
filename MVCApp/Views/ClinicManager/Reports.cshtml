@model MVCApp.ViewModels.ClinicManager.ClinicReportViewModel

@{
    ViewData["Title"] = "Clinic Reports";
}

<div class="page-header">
    <div>
        <h1>Clinic Reports</h1>
        <p>Review appointment statistics, doctor workload, and clinic performance.</p>
    </div>

    <a asp-controller="ClinicManager"
       asp-action="Dashboard"
       class="secondary-btn">
        Back to Dashboard
    </a>
</div>

@if (TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="section-card">
    <div class="section-header">
        <h2>Report Filter</h2>
    </div>

    <form asp-controller="ClinicManager" asp-action="Reports" method="get" class="filter-form">
        <div class="form-group">
            <label for="fromDate">From Date</label>
            <input type="date"
                   id="fromDate"
                   name="fromDate"
                   value="@Model.FromDate.ToString("yyyy-MM-dd")" />
        </div>

        <div class="form-group">
            <label for="toDate">To Date</label>
            <input type="date"
                   id="toDate"
                   name="toDate"
                   value="@Model.ToDate.ToString("yyyy-MM-dd")" />
        </div>

        <button type="submit" class="primary-btn">Generate Report</button>
    </form>
</div>

<div class="section-card">
    <div class="section-header">
        <h2>Report Period</h2>
        <span class="muted-text">@Model.DateRangeText</span>
    </div>

    <div class="details-grid">
        <div class="details-item">
            <span>Total Doctors</span>
            <strong>@Model.TotalDoctors</strong>
        </div>

        <div class="details-item">
            <span>Active Doctors</span>
            <strong>@Model.ActiveDoctors</strong>
        </div>

        <div class="details-item">
            <span>Doctors With Appointments</span>
            <strong>@Model.DoctorsWithAppointments</strong>
        </div>

        <div class="details-item">
            <span>Doctors On Leave</span>
            <strong>@Model.DoctorsOnLeave</strong>
        </div>
    </div>
</div>

<div class="dashboard-grid">
    <div class="dashboard-card">
        <span class="card-label">Total Appointments</span>
        <h2>@Model.TotalAppointments</h2>
        <p>In selected period</p>
    </div>

    <div class="dashboard-card">
        <span class="card-label">Completed</span>
        <h2>@Model.CompletedAppointments</h2>
        <p>@Model.CompletionRate% completion rate</p>
    </div>

    <div class="dashboard-card warning-card">
        <span class="card-label">Cancelled</span>
        <h2>@Model.CancelledAppointments</h2>
        <p>@Model.CancellationRate% cancellation rate</p>
    </div>

    <div class="dashboard-card danger-card">
        <span class="card-label">Missed</span>
        <h2>@Model.MissedAppointments</h2>
        <p>@Model.MissedRate% missed rate</p>
    </div>
</div>

<div class="section-card">
    <div class="section-header">
        <h2>Appointment Status Summary</h2>
    </div>

    <div class="status-grid">
        <div class="status-box">
            <span>Requested</span>
            <strong>@Model.RequestedAppointments</strong>
        </div>

        <div class="status-box">
            <span>Confirmed</span>
            <strong>@Model.ConfirmedAppointments</strong>
        </div>

        <div class="status-box">
            <span>Checked In</span>
            <strong>@Model.CheckedInAppointments</strong>
        </div>

        <div class="status-box">
            <span>In Progress</span>
            <strong>@Model.InProgressAppointments</strong>
        </div>

        <div class="status-box">
            <span>Completed</span>
            <strong>@Model.CompletedAppointments</strong>
        </div>

        <div class="status-box">
            <span>Cancelled</span>
            <strong>@Model.CancelledAppointments</strong>
        </div>

        <div class="status-box">
            <span>Missed</span>
            <strong>@Model.MissedAppointments</strong>
        </div>
    </div>
</div>

<div class="section-card">
    <div class="section-header">
        <h2>Doctor Workload Report</h2>
        <span class="muted-text">@Model.DoctorReports.Count doctors</span>
    </div>

    @if (Model.HasDoctorReports)
    {
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Doctor</th>
                    <th>Email</th>
                    <th>License</th>
                    <th>Total</th>
                    <th>Completed</th>
                    <th>Cancelled</th>
                    <th>Missed</th>
                    <th>Remaining</th>
                    <th>Completion Rate</th>
                    <th>Workload</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.DoctorReports)
                    {
                <tr>
                    <td>Dr. @item.DoctorName</td>
                    <td>@item.DoctorEmail</td>
                    <td>@item.LicenseNumber</td>
                    <td>@item.TotalAppointments</td>
                    <td>@item.CompletedAppointments</td>
                    <td>@item.CancelledAppointments</td>
                    <td>@item.MissedAppointments</td>
                    <td>@item.RemainingAppointments</td>
                    <td>@item.CompletionRate%</td>
                    <td>
                        <span class="status-pill">@item.WorkloadLevel</span>
                    </td>
                </tr>
                    }
            </tbody>
        </table>
    </div>
    }
    else
    {
    <p class="empty-text">No report data is available for the selected date range.</p>
    }
</div>