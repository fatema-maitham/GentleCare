@model MVCApp.ViewModels.ClinicManager.EditClinicManagerProfileViewModel

@{
    ViewData["Title"] = "Edit Manager Profile";

    var profileImage = string.IsNullOrWhiteSpace(Model.CurrentProfilePicture)
        ? Url.Content("~/images/default-profile.png")
        : Url.Content("~/images/managers/" + Model.CurrentProfilePicture);
}

<div class="profile-page">
    <div class="profile-card">
        <div class="profile-header">
            <div class="profile-image-wrapper">
                <img src="@profileImage" class="profile-img" alt="Profile picture" />

                <label for="ProfilePictureFile" class="camera-btn" title="Change profile picture">
                    <i class="bi bi-camera-fill"></i>
                </label>
            </div>

            <div>
                <h2>Edit Profile</h2>
                <p>Update clinic manager account details</p>
            </div>
        </div>

        <form asp-controller="ClinicManager"
              asp-action="EditProfile"
              method="post"
              enctype="multipart/form-data"
              class="profile-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="ProfilePictureFile"
                   id="ProfilePictureFile"
                   type="file"
                   class="d-none"
                   accept=".jpg,.jpeg,.png,.webp" />

            <span asp-validation-for="ProfilePictureFile" class="text-danger"></span>

            <div class="form-group">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="profile-actions">
                <button type="submit" class="btn-main">
                    Save Changes
                </button>

                <a asp-controller="ClinicManager" asp-action="Profile" class="btn-light">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    .profile-page {
        max-width: 760px;
        margin: 40px auto;
        padding: 20px;
    }

    .profile-card {
        background: #fff;
        border: 1px solid #d9e2e4;
        border-radius: 18px;
        padding: 28px;
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-bottom: 22px;
        border-bottom: 1px solid #e5e7eb;
    }

    .profile-image-wrapper {
        position: relative;
        width: 96px;
        height: 96px;
        flex-shrink: 0;
    }

    .profile-img {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #d9e2e4;
    }

    .camera-btn {
        position: absolute;
        right: -2px;
        bottom: 2px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #00688C;
        color: #fff;
        border: 3px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s ease;
        font-size: 15px;
    }

        .camera-btn:hover {
            background: #06485F;
        }

    .profile-header h2 {
        margin: 0;
        color: #12262F;
        font-weight: 900;
    }

    .profile-header p {
        margin: 6px 0 0;
        color: #00688C;
        font-weight: 700;
    }

    .profile-form {
        margin-top: 24px;
        display: grid;
        gap: 18px;
    }

    .form-group label {
        display: block;
        margin-bottom: 7px;
        color: #12262F;
        font-weight: 800;
    }

    .form-control {
        width: 100%;
        border: 1px solid #93acb4;
        border-radius: 12px;
        padding: 12px 14px;
        font-weight: 600;
    }

        .form-control:focus {
            outline: none;
            border-color: #00688C;
            box-shadow: 0 0 0 3px rgba(0, 104, 140, 0.12);
        }

    .text-danger {
        color: #b42318;
        font-size: 13px;
        font-weight: 700;
    }

    .profile-actions {
        display: flex;
        gap: 12px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .btn-main,
    .btn-light {
        border: none;
        text-decoration: none;
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 800;
        cursor: pointer;
    }

    .btn-main {
        background: #00688C;
        color: #fff;
    }

    .btn-light {
        background: #f1efed;
        color: #12262F;
        border: 1px solid #d9e2e4;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}