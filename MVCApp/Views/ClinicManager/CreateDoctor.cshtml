@model MVCApp.ViewModels.ClinicManager.DoctorCreateViewModel

@{
    ViewData["Title"] = "Create Doctor";
}

<div class="page-header">
    <div>
        <h1>Create Doctor</h1>
        <p>Add a new doctor account and profile.</p>
    </div>

    <a asp-controller="ClinicManager"
       asp-action="Doctors"
       class="secondary-btn">
        Back to Doctors
    </a>
</div>

@if (TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="section-card">
    <form asp-controller="ClinicManager" asp-action="CreateDoctor" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LicenseNumber"></label>
                <input asp-for="LicenseNumber" />
                <span asp-validation-for="LicenseNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Bio"></label>
            <textarea asp-for="Bio" rows="4"></textarea>
            <span asp-validation-for="Bio" class="text-danger"></span>
        </div>

        <div class="form-group checkbox-row">
            <input asp-for="IsActive" />
            <label asp-for="IsActive"></label>
            <span asp-validation-for="IsActive" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="SelectedSpecializationIds"></label>

            @if (Model.SpecializationOptions.Any())
            {
            <div class="checkbox-list">
                @foreach (var specialization in Model.SpecializationOptions)
                    {
                <label class="checkbox-item">
                    <input type="checkbox"
                           name="SelectedSpecializationIds"
                           value="@specialization.Value"
                           checked="@(Model.SelectedSpecializationIds.Contains(int.Parse(specialization.Value)))" />
                    <span>@specialization.Text</span>
                </label>
                    }
            </div>
            }
            else
            {
            <p class="empty-text">No specializations are available.</p>
            }

            <span asp-validation-for="SelectedSpecializationIds" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="primary-btn">Create Doctor</button>

            <a asp-controller="ClinicManager"
               asp-action="Doctors"
               class="secondary-btn">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}