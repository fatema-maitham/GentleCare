@model MVCApp.ViewModels.ClinicManager.DoctorCreateViewModel

@{
    ViewData["Title"] = "Create Doctor";
}

<div class="manager-page">

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}


    <div class="manager-card">
        <form asp-controller="ClinicManager" asp-action="CreateDoctor" method="post" class="manager-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" placeholder="Full name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" placeholder="Email address" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber"></label>
                    <input asp-for="PhoneNumber" placeholder="Phone number" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LicenseNumber"></label>
                    <input asp-for="LicenseNumber" placeholder="License number" />
                    <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" placeholder="Confirm password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="form-group full">
                    <label asp-for="Bio"></label>
                    <textarea asp-for="Bio" placeholder="Short doctor bio"></textarea>
                    <span asp-validation-for="Bio" class="text-danger"></span>
                </div>

                <div class="form-group full">
                    <label>Specializations</label>
                    @if (Model.SpecializationOptions.Any())
                    {
                        <div class="check-list">
                            @foreach (var specialization in Model.SpecializationOptions)
                            {
                                <label class="check-item">
                                    <input type="checkbox"
                                           name="SelectedSpecializationIds"
                                           value="@specialization.Value"
                                           checked="@Model.SelectedSpecializationIds.Contains(int.Parse(specialization.Value))" />
                                    <span>@specialization.Text</span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-box">No specializations are available.</div>
                    }
                    <span asp-validation-for="SelectedSpecializationIds" class="text-danger"></span>
                </div>

                <div class="form-group full">
                    <label class="check-item">
                        <input asp-for="IsActive" />
                        <span>Active doctor account</span>
                    </label>
                </div>
            </div>

            <div class="actions">
                <button type="submit" class="btn-main">Create Doctor</button>
                <a asp-controller="ClinicManager" asp-action="Doctors" class="btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
