@model MVCApp.ViewModels.Receptionist.ReceptionistDashboardViewModel

@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="row g-4">
    <div class="col-12">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h2 class="fw-bold mb-1">Receptionist Dashboard</h2>
                <p class="text-muted mb-0">Manage bookings and monitor today's clinic appointments.</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <a asp-controller="Receptionist" asp-action="BookAppointment" class="btn btn-primary">Book Appointment</a>
                <a asp-controller="Receptionist" asp-action="Appointments" class="btn btn-outline-primary">Manage Appointments</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="text-muted small">Today's Total</div>
                <div class="display-6 fw-bold">@Model.TodayTotalAppointments</div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="text-muted small">Confirmed</div>
                <div class="display-6 fw-bold">@Model.TodayConfirmedCount</div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="text-muted small">Checked In</div>
                <div class="display-6 fw-bold">@Model.TodayCheckedInCount</div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="text-muted small">In Progress</div>
                <div class="display-6 fw-bold">@Model.TodayInProgressCount</div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">Today's Appointments</h4>

                @if (Model.TodayAppointments == null || !Model.TodayAppointments.Any())
                {
                    <div class="alert alert-info mb-0">No appointments for today.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Patient</th>
                                    <th>Doctor</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TodayAppointments)
                                {
                                    <tr>
                                        <td>@item.AppointmentId</td>
                                        <td>@item.PatientName</td>
                                        <td>@item.DoctorName</td>
                                        <td>@item.StartTime - @item.EndTime</td>
                                        <td>@item.Status</td>
                                        <td>
                                            <a asp-controller="Receptionist" asp-action="UpdateStatus" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-primary">
                                                Update Status
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>