@model MVCApp.ViewModels.Receptionist.ReceptionistDashboardViewModel

@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="receptionist-page">
    <div class="receptionist-dashboard-page">
        <div class="manager-card">
            <div class="card-head">
                <div>
                    <h2>Today's Clinic Overview</h2>
                    <span class="muted">Monitor appointments and patient check-ins for today.</span>
                </div>
            </div>
        </div>

        <div class="dashboard-stats">
            <div class="dashboard-stat">
                <strong>@Model.TodayTotalAppointments</strong>
                <span>Today's Total</span>
            </div>

            <div class="dashboard-stat">
                <strong>@Model.TodayConfirmedCount</strong>
                <span>Confirmed</span>
            </div>

            <div class="dashboard-stat">
                <strong>@Model.TodayCheckedInCount</strong>
                <span>Checked In</span>
            </div>

            <div class="dashboard-stat">
                <strong>@Model.TodayInProgressCount</strong>
                <span>In Progress</span>
            </div>

            <div class="dashboard-stat">
                <strong>@Model.TodayCompletedCount</strong>
                <span>Completed</span>
            </div>
        </div>

        <div class="manager-card">
            <div class="card-head">
                <h2>Today's Appointments</h2>
            </div>

            @if (Model.TodayAppointments == null || !Model.TodayAppointments.Any())
            {
                <div class="empty-box">
                    No appointments for today
                </div>
            }
            else
            {
                <div class="appointments-list">
                    @foreach (var item in Model.TodayAppointments)
                    {
                        <div class="receptionist-appointment-item">
                            <div class="appointment-main">
                                <span class="appointment-date">@item.StartTime - @item.EndTime</span>
                                <h3>@item.PatientName</h3>
                                <p class="appointment-meta-text">Dr. @item.DoctorName</p>
                            </div>

                            <div class="appointment-actions">
                                <span class="status-pill status-@item.Status.ToLower()">@item.Status</span>

                                <a asp-controller="Receptionist"
                                   asp-action="UpdateStatus"
                                   asp-route-id="@item.AppointmentId"
                                   class="btn-light">
                                    Update Status
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>