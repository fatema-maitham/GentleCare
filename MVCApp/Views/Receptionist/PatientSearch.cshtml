@model MVCApp.ViewModels.Receptionist.ReceptionistPatientSearchViewModel

@{
    ViewData["Title"] = "Patient Search";
}

<section class="patient-search-page">
    <div class="patient-search-card">

        <div class="page-header-custom">
            <h1>Patient Search</h1>
            <p>Find patients by name, CPR number, reference number, or email.</p>
        </div>

        <form method="get" asp-controller="Receptionist" asp-action="PatientSearch" class="search-box">
            <div class="search-grid">
                <div class="form-group">
                    <label>Search Patient</label>
                    <input asp-for="SearchText"
                           class="form-control"
                           placeholder="Enter patient name, CPR, reference, or email..." />
                </div>

                <div class="search-action">
                    <button type="submit" class="gc-btn-primary">Search</button>
                </div>
            </div>
        </form>

        @if (Model.Patients == null || !Model.Patients.Any())
        {
            <div class="empty-box">
                <h3>No patients found</h3>
                <p>Try searching by patient name, CPR number, reference number, or email.</p>
            </div>
        }
        else
        {
            <div class="patients-list">
                @foreach (var patient in Model.Patients)
                {
                    <div class="patient-item">
                        <div>
                            <h2>@patient.FullName</h2>
                            <p>@patient.Email</p>

                            <div class="patient-details">
                                <span>CPR: @patient.CPRNumber</span>
                                <span>Reference: @patient.ReferenceNumber</span>
                                <span>Date of Birth: @patient.DateOfBirth</span>
                                <span>Phone: @patient.PhoneNumber</span>
                            </div>
                        </div>

                        <a asp-controller="Receptionist"
                           asp-action="BookAppointment"
                           asp-route-patientId="@patient.PatientId"
                           class="gc-btn-light">
                            Book Appointment
                        </a>
                    </div>
                }
            </div>
        }

    </div>
</section>

<style>
    .patient-search-page {
        max-width: 1050px;
        margin: 0 auto;
        padding: 32px 10px 70px;
    }

    .patient-search-card {
        background: white;
        border-radius: 32px;
        padding: 42px;
        box-shadow: 0 18px 45px rgba(99,127,163,0.12);
    }

    .page-header-custom {
        margin-bottom: 26px;
    }

        .page-header-custom h1 {
            margin: 0;
            font-size: 38px;
            font-weight: 900;
            color: #182333;
        }

        .page-header-custom p {
            color: #6b7a87;
            margin: 10px 0 0;
            font-size: 16px;
        }

    .search-box {
        background: #f5f8fa;
        border-radius: 26px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .search-grid {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 16px;
        align-items: end;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #182333;
        font-weight: 900;
    }

    .form-control {
        width: 100%;
        min-height: 52px;
        border: 1px solid #dce5e8;
        border-radius: 16px;
        padding: 12px 14px;
        background: white;
        color: #182333;
        outline: none;
    }

        .form-control:focus {
            border-color: #637fa3;
            box-shadow: 0 0 0 4px rgba(99,127,163,0.15);
        }

    .patients-list {
        display: grid;
        gap: 14px;
    }

    .patient-item {
        background: #f5f8fa;
        border-radius: 22px;
        padding: 22px;
        border: 1px solid #e5edf2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

        .patient-item h2 {
            margin: 0 0 8px;
            color: #182333;
            font-size: 22px;
            font-weight: 900;
        }

        .patient-item p {
            margin: 0 0 12px;
            color: #526273;
            font-weight: 700;
        }

    .patient-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(180px, 1fr));
        gap: 8px 18px;
    }

        .patient-details span {
            color: #526273;
            font-weight: 700;
        }

    .gc-btn-primary,
    .gc-btn-light {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 999px;
        padding: 12px 22px;
        font-weight: 900;
        text-decoration: none;
        transition: 0.2s ease;
        border: 0;
        cursor: pointer;
        white-space: nowrap;
    }

    .gc-btn-primary {
        background: #637fa3;
        color: white;
    }

        .gc-btn-primary:hover {
            transform: translateY(-2px);
            color: white;
            background: #71999f;
        }

    .gc-btn-light {
        background: white;
        color: #637fa3;
        border: 1px solid #dce5e8;
    }

        .gc-btn-light:hover {
            transform: translateY(-2px);
            color: #182333;
        }

    .empty-box {
        background: #f5f8fa;
        border-radius: 22px;
        padding: 24px;
    }

        .empty-box h3 {
            margin: 0 0 8px;
            color: #182333;
            font-weight: 900;
        }

        .empty-box p {
            margin: 0;
            color: #6b7a87;
        }

    @@media (max-width: 800px) {
        .patient-search-card {
            padding: 30px 22px;
        }

        .search-grid,
        .patient-item {
            display: block;
        }

        .search-action {
            margin-top: 16px;
        }

        .patient-details {
            grid-template-columns: 1fr;
        }

        .gc-btn-primary,
        .gc-btn-light {
            width: 100%;
            margin-top: 16px;
        }

        .page-header-custom h1 {
            font-size: 32px;
        }
    }
</style>