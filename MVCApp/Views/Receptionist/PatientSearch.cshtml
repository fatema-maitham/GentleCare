@model MVCApp.ViewModels.Receptionist.ReceptionistPatientSearchViewModel

@{
    ViewData["Title"] = "Patient Search";
}

<div class="receptionist-page">
    <div class="receptionist-patient-search-page">
        <div class="manager-card">
            <div class="card-head">
                <div>
                    <h2>Patient Search</h2>
                    <span class="muted">Find patients by name, CPR number, reference number, or email.</span>
                </div>
            </div>

            <form method="get" asp-controller="Receptionist" asp-action="PatientSearch" class="receptionist-search-form">
                <div class="form-group">
                    <label>Search Patient</label>
                    <input asp-for="SearchText"
                           placeholder="Enter patient name, CPR, reference, or email..." />
                </div>

                <div class="search-actions">
                    <button type="submit" class="btn-main">Search</button>
                </div>
            </form>
        </div>

        @if (Model.Patients == null || !Model.Patients.Any())
        {
            <div class="empty-box">
                No patients found
            </div>
        }
        else
        {
            <div class="manager-card">
                <div class="card-head">
                    <h2>Search Results</h2>
                </div>

                <div class="patients-list">
                    @foreach (var patient in Model.Patients)
                    {
                        <div class="patient-item">
                            <div class="patient-main">
                                <h3>@patient.FullName</h3>
                                <p class="patient-email">@patient.Email</p>

                                <div class="patient-details">
                                    <span>CPR: @patient.CPRNumber</span>
                                    <span>Reference: @patient.ReferenceNumber</span>
                                    <span>Date of Birth: @patient.DateOfBirth</span>
                                    <span>Phone: @patient.PhoneNumber</span>
                                </div>
                            </div>

                            <a asp-controller="Receptionist"
                               asp-action="BookAppointment"
                               asp-route-patientId="@patient.PatientId"
                               class="btn-light">
                                Book Appointment
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>