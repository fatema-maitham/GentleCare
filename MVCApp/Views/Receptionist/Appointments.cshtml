@model MVCApp.ViewModels.Receptionist.ReceptionistAppointmentsPageViewModel

@{
    ViewData["Title"] = "Manage Appointments";
}

<div class="row g-4">
    <div class="col-12">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h2 class="fw-bold mb-1">Manage Appointments</h2>
                <p class="text-muted mb-0">Search, review, and update appointment records.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="Receptionist" asp-action="BookAppointment" class="btn btn-primary">Book New Appointment</a>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form method="get" asp-action="Appointments" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Search</label>
                        <input asp-for="SearchText" class="form-control" placeholder="Patient name, CPR, reference, doctor..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Date</label>
                        <input asp-for="SelectedDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Status</label>
                        <select name="selectedStatus" class="form-select">
                            <option value="">All Statuses</option>
                            @foreach (var status in Model.StatusOptions)
                            {
                                if (ViewBag.SelectedStatus != null && ViewBag.SelectedStatus.ToString() == status.Value)
                                {
                                    <option value="@status.Value" selected>@status.Text</option>
                                }
                                else
                                {
                                    <option value="@status.Value">@status.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                @if (Model.Appointments == null || !Model.Appointments.Any())
                {
                    <div class="alert alert-info mb-0">No appointments found.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Patient</th>
                                    <th>CPR</th>
                                    <th>Reference</th>
                                    <th>Doctor</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                    <th>Notes</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Appointments)
                                {
                                    var displayStatus = item.Status switch
                                    {
                                        "CheckedIn" => "Checked In",
                                        "InProgress" => "In Progress",
                                        _ => item.Status
                                    };

                                    var badgeClass = item.Status switch
                                    {
                                        "Requested" => "bg-secondary",
                                        "Confirmed" => "bg-primary",
                                        "CheckedIn" => "bg-info text-dark",
                                        "InProgress" => "bg-warning text-dark",
                                        "Completed" => "bg-success",
                                        "Cancelled" => "bg-danger",
                                        "Missed" => "bg-dark",
                                        _ => "bg-secondary"
                                    };

                                    <tr>
                                        <td>@item.AppointmentId</td>
                                        <td>@item.PatientName</td>
                                        <td>@item.CPRNumber</td>
                                        <td>@item.ReferenceNumber</td>
                                        <td>@item.DoctorName</td>
                                        <td>@item.AppointmentDate.ToString("dd MMM yyyy")</td>
                                        <td>@item.StartTime - @item.EndTime</td>
                                        <td><span class="badge @badgeClass">@displayStatus</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)</td>
                                        <td>
                                            <a asp-controller="Receptionist" asp-action="UpdateStatus" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-primary">
                                                Update Status
                                            </a>
                                        </td>
                                    </tr>

                                    @if (!string.IsNullOrWhiteSpace(item.CancellationReason))
                                    {
                                        <tr>
                                            <td colspan="10" class="text-danger small">
                                                Cancellation Reason: @item.CancellationReason
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>