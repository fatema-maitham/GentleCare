@model MVCApp.ViewModels.Receptionist.ReceptionistAppointmentsPageViewModel

@{
    ViewData["Title"] = "Appointments";
}

<div class="receptionist-page">
    <div class="receptionist-all-appointments-page">
        <div class="manager-card">
            <div class="card-head">
                <div>
                    <h2>Appointments</h2>
                    <span class="muted">Search, review, and update clinic appointment records.</span>
                </div>
            </div>
        </div>

        <div class="manager-card">
            <div class="card-head">
                <h2>Search and Filter</h2>
            </div>

            <form method="get" asp-controller="Receptionist" asp-action="Appointments" class="receptionist-filter-form">
                <div class="form-group">
                    <label>Search</label>
                    <input asp-for="SearchText"
                           placeholder="Patient name, CPR, reference, doctor..." />
                </div>

                <div class="form-group">
                    <label>Date</label>
                    <input asp-for="SelectedDate" type="date" />
                </div>

                <div class="form-group">
                    <label>Status</label>
                    <select name="selectedStatus">
                        <option value="">All Statuses</option>
                        @foreach (var status in Model.StatusOptions)
                        {
                            if (ViewBag.SelectedStatus != null && ViewBag.SelectedStatus.ToString() == status.Value)
                            {
                                <option value="@status.Value" selected>@status.Text</option>
                            }
                            else
                            {
                                <option value="@status.Value">@status.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn-main">Filter</button>
                </div>
            </form>
        </div>

        @if (Model.Appointments == null || !Model.Appointments.Any())
        {
            <div class="empty-box">
                No appointments found
            </div>
        }
        else
        {
            <div class="manager-card">
                <div class="card-head">
                    <h2>Appointment Records</h2>
                </div>

                <div class="appointments-list">
                    @foreach (var item in Model.Appointments)
                    {
                        var displayStatus = item.Status switch
                        {
                            "CheckedIn" => "Checked In",
                            "InProgress" => "In Progress",
                            _ => item.Status
                        };

                        <div class="receptionist-appointment-item">
                            <div class="appointment-main">
                                <span class="appointment-date">@item.AppointmentDate.ToString("dd MMM yyyy")</span>
                                <h3>@item.PatientName</h3>
                                <p class="appointment-meta-text">
                                    CPR: @item.CPRNumber | Reference: @item.ReferenceNumber
                                </p>
                                <p class="appointment-meta-text">
                                    Dr. @item.DoctorName • @item.StartTime - @item.EndTime
                                </p>

                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <p class="notes">Notes: @item.Notes</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.CancellationReason))
                                {
                                    <p class="cancel-reason">Cancellation Reason: @item.CancellationReason</p>
                                }
                            </div>

                            <div class="appointment-actions">
                                <span class="status-pill status-@item.Status.ToLower()">@displayStatus</span>

                                <a asp-controller="Receptionist"
                                   asp-action="UpdateStatus"
                                   asp-route-id="@item.AppointmentId"
                                   class="btn-light">
                                    Update Status
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>