@model MVCApp.ViewModels.Receptionist.ReceptionistAppointmentsPageViewModel

@{
    ViewData["Title"] = "Appointments";
}

<section class="appointments-page">
    <div class="appointments-card">

        <div class="page-header-custom">
            <h1>Appointments</h1>
            <p>Search, review, and update clinic appointment records.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="success-message">@TempData["Success"]</div>
        }

        <form method="get" asp-controller="Receptionist" asp-action="Appointments" class="filter-box">
            <div class="filter-grid">
                <div class="form-group">
                    <label>Search</label>
                    <input asp-for="SearchText"
                           class="form-control"
                           placeholder="Patient name, CPR, reference, doctor..." />
                </div>

                <div class="form-group">
                    <label>Date</label>
                    <input asp-for="SelectedDate" type="date" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Status</label>
                    <select name="selectedStatus" class="form-control">
                        <option value="">All Statuses</option>
                        @foreach (var status in Model.StatusOptions)
                        {
                            if (ViewBag.SelectedStatus != null && ViewBag.SelectedStatus.ToString() == status.Value)
                            {
                                <option value="@status.Value" selected>@status.Text</option>
                            }
                            else
                            {
                                <option value="@status.Value">@status.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="filter-action">
                    <button type="submit" class="gc-btn-primary">Filter</button>
                </div>
            </div>
        </form>

        @if (Model.Appointments == null || !Model.Appointments.Any())
        {
            <div class="empty-box">
                <h3>No appointments found</h3>
                <p>Appointments will appear here when they match your search or filter.</p>
            </div>
        }
        else
        {
            <div class="appointments-list">
                @foreach (var item in Model.Appointments)
                {
                    var displayStatus = item.Status switch
                    {
                        "CheckedIn" => "Checked In",
                        "InProgress" => "In Progress",
                        _ => item.Status
                    };

                    <div class="appointment-item">
                        <div class="appointment-main">
                            <span class="appointment-date">@item.AppointmentDate.ToString("dd MMM yyyy")</span>
                            <h2>@item.PatientName</h2>
                            <p>
                                CPR: @item.CPRNumber |
                                Reference: @item.ReferenceNumber
                            </p>
                            <p>
                                Dr. @item.DoctorName • @item.StartTime - @item.EndTime
                            </p>

                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <p class="notes">Notes: @item.Notes</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.CancellationReason))
                            {
                                <p class="cancel-reason">Cancellation Reason: @item.CancellationReason</p>
                            }
                        </div>

                        <div class="appointment-actions">
                            <span class="status-pill status-@item.Status.ToLower()">@displayStatus</span>

                            <a asp-controller="Receptionist"
                               asp-action="UpdateStatus"
                               asp-route-id="@item.AppointmentId"
                               class="gc-btn-light small">
                                Update Status
                            </a>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>

<style>
    .appointments-page {
        max-width: 1120px;
        margin: 0 auto;
        padding: 32px 10px 70px;
    }

    .appointments-card {
        background: white;
        border-radius: 32px;
        padding: 42px;
        box-shadow: 0 18px 45px rgba(99,127,163,0.12);
    }

    .page-header-custom {
        margin-bottom: 26px;
    }

        .page-header-custom h1 {
            margin: 0;
            font-size: 38px;
            font-weight: 900;
            color: #182333;
        }

        .page-header-custom p {
            color: #6b7a87;
            margin: 10px 0 0;
            font-size: 16px;
        }

    .filter-box {
        background: #f5f8fa;
        border-radius: 26px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto;
        gap: 16px;
        align-items: end;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #182333;
        font-weight: 900;
    }

    .form-control {
        width: 100%;
        min-height: 52px;
        border: 1px solid #dce5e8;
        border-radius: 16px;
        padding: 12px 14px;
        background: white;
        color: #182333;
        outline: none;
    }

        .form-control:focus {
            border-color: #637fa3;
            box-shadow: 0 0 0 4px rgba(99,127,163,0.15);
        }

    .appointments-list {
        display: grid;
        gap: 14px;
    }

    .appointment-item {
        background: #f5f8fa;
        border-radius: 22px;
        padding: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        border: 1px solid #e5edf2;
    }

    .appointment-date {
        color: #637fa3;
        font-weight: 900;
    }

    .appointment-main h2 {
        margin: 8px 0 8px;
        color: #182333;
        font-size: 22px;
        font-weight: 900;
    }

    .appointment-main p {
        margin: 6px 0;
        color: #526273;
        font-weight: 700;
        line-height: 1.5;
    }

    .notes {
        color: #637fa3 !important;
    }

    .cancel-reason {
        color: #991b1b !important;
    }

    .appointment-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .status-pill {
        display: inline-block;
        border-radius: 999px;
        padding: 7px 13px;
        font-size: 13px;
        font-weight: 900;
        white-space: nowrap;
        background: #e9edf2;
        color: #4b5563;
    }

    .status-requested {
        background: #fff7ed;
        color: #c2410c;
    }

    .status-confirmed {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-checkedin {
        background: #cffafe;
        color: #0e7490;
    }

    .status-inprogress {
        background: #fef3c7;
        color: #92400e;
    }

    .status-completed {
        background: #dcfce7;
        color: #166534;
    }

    .status-cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

    .status-missed {
        background: #e5e7eb;
        color: #111827;
    }

    .gc-btn-primary,
    .gc-btn-light {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 999px;
        padding: 12px 22px;
        font-weight: 900;
        text-decoration: none;
        transition: 0.2s ease;
        border: 0;
        cursor: pointer;
        white-space: nowrap;
    }

    .gc-btn-primary {
        background: #637fa3;
        color: white;
    }

        .gc-btn-primary:hover {
            transform: translateY(-2px);
            color: white;
            background: #71999f;
        }

    .gc-btn-light {
        background: white;
        color: #637fa3;
        border: 1px solid #dce5e8;
    }

        .gc-btn-light.small {
            padding: 9px 15px;
            font-size: 14px;
        }

        .gc-btn-light:hover {
            transform: translateY(-2px);
            color: #182333;
        }

    .success-message {
        background: #e8f7ef;
        color: #1d6b42;
        border-radius: 18px;
        padding: 14px 18px;
        font-weight: 900;
        margin-bottom: 18px;
    }

    .empty-box {
        background: #f5f8fa;
        border-radius: 22px;
        padding: 24px;
    }

        .empty-box h3 {
            margin: 0 0 8px;
            color: #182333;
            font-weight: 900;
        }

        .empty-box p {
            margin: 0;
            color: #6b7a87;
        }

    @@media (max-width: 900px) {
        .filter-grid {
            grid-template-columns: 1fr;
        }

        .appointment-item {
            display: block;
        }

        .appointment-actions {
            align-items: flex-start;
            margin-top: 16px;
        }
    }

    @@media (max-width: 700px) {
        .appointments-card {
            padding: 30px 22px;
        }

        .page-header-custom h1 {
            font-size: 32px;
        }

        .gc-btn-primary {
            width: 100%;
        }
    }
</style>