@model MVCApp.ViewModels.Receptionist.ReceptionistUpdateAppointmentStatusViewModel

@{
    ViewData["Title"] = "Update Appointment Status";
}

<section class="status-page">
    <div class="status-card">

        <div class="status-header">
            <div>
                <h1>Update Status</h1>
            </div>

            <a asp-controller="Receptionist"
               asp-action="Appointments"
               class="gc-btn-light">
                Back to Appointments
            </a>
        </div>

        <div class="details-grid">
            <div class="detail-box">
                <span>Patient</span>
                <strong>@Model.PatientName</strong>
            </div>

            <div class="detail-box">
                <span>Doctor</span>
                <strong>Dr. @Model.DoctorName</strong>
            </div>

            <div class="detail-box">
                <span>Date</span>
                <strong>@Model.AppointmentDate.ToString("dd MMM yyyy")</strong>
            </div>

            <div class="detail-box">
                <span>Time</span>
                <strong>@Model.StartTime - @Model.EndTime</strong>
            </div>

            <div class="detail-box wide">
                <span>Current Status</span>
                <strong>@Model.CurrentStatus</strong>
            </div>
        </div>

        @if (Model.AllowedStatuses == null || !Model.AllowedStatuses.Any())
        {
            <div class="empty-box">
                <h3>No further status updates available</h3>
                <p>This appointment has reached its final workflow stage.</p>
            </div>
        }
        else
        {
            <form asp-controller="Receptionist"
                  asp-action="UpdateStatus"
                  method="post"
                  class="status-form">

                @Html.AntiForgeryToken()

                <input asp-for="AppointmentId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-group">
                    <label asp-for="NewStatus"></label>
                    <select asp-for="NewStatus"
                            asp-items="Model.AllowedStatuses"
                            class="form-control">
                        <option value="">Select new status</option>
                    </select>
                    <span asp-validation-for="NewStatus" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CancellationReason"></label>
                    <textarea asp-for="CancellationReason"
                              class="form-control textarea"
                              placeholder="Required only if the appointment is cancelled"></textarea>
                    <span asp-validation-for="CancellationReason" class="field-error"></span>
                </div>

                <div class="actions">
                    <button type="submit" class="gc-btn-primary">
                        Update Status
                    </button>
                </div>
            </form>
        }

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .status-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 32px 10px 70px;
    }

    .status-card {
        background: white;
        border-radius: 32px;
        padding: 42px;
        box-shadow: 0 18px 45px rgba(99,127,163,0.12);
    }

    .status-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 28px;
    }

    .eyebrow {
        margin: 0 0 8px;
        color: #637fa3;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .status-header h1 {
        margin: 0;
        color: #182333;
        font-size: 40px;
        font-weight: 900;
        line-height: 1.05;
    }

    .status-header p {
        margin: 10px 0 0;
        color: #6b7a87;
        font-size: 16px;
        line-height: 1.6;
        max-width: 560px;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    .detail-box {
        background: #f5f8fa;
        border-radius: 20px;
        padding: 18px;
    }

        .detail-box.wide {
            grid-column: 1 / -1;
        }

        .detail-box span {
            display: block;
            color: #6b7a87;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .detail-box strong {
            display: block;
            color: #182333;
            font-size: 17px;
            font-weight: 900;
        }

    .status-form {
        background: #f5f8fa;
        border-radius: 24px;
        padding: 24px;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #182333;
            font-weight: 900;
        }

    .form-control {
        width: 100%;
        min-height: 52px;
        border: 1px solid #dce5e8;
        border-radius: 16px;
        padding: 12px 14px;
        background: white;
        color: #182333;
        outline: none;
    }

        .form-control:focus {
            border-color: #637fa3;
            box-shadow: 0 0 0 4px rgba(99,127,163,0.15);
        }

    .textarea {
        min-height: 110px;
        resize: vertical;
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 18px;
    }

    .gc-btn-primary,
    .gc-btn-light {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 999px;
        font-weight: 900;
        text-decoration: none;
        transition: 0.2s ease;
        white-space: nowrap;
    }

    .gc-btn-primary {
        border: 0;
        cursor: pointer;
        background: #637fa3;
        color: white;
        padding: 12px 24px;
    }

    .gc-btn-light {
        background: #f5f8fa;
        color: #637fa3;
        border: 1px solid #dce5e8;
        padding: 12px 20px;
    }

    .gc-btn-primary:hover {
        background: #71999f;
        color: white;
        transform: translateY(-2px);
    }

    .gc-btn-light:hover {
        color: #182333;
        transform: translateY(-2px);
    }

    .validation-summary,
    .field-error {
        color: #b42318;
        font-weight: 800;
    }

    .validation-summary {
        margin-bottom: 14px;
    }

    .empty-box {
        background: #f5f8fa;
        border-radius: 22px;
        padding: 24px;
    }

        .empty-box h3 {
            margin: 0 0 8px;
            color: #182333;
            font-weight: 900;
        }

        .empty-box p {
            margin: 0;
            color: #6b7a87;
        }

    @@media (max-width: 700px) {
        .status-card {
            padding: 30px 22px;
        }

        .status-header,
        .details-grid {
            display: block;
        }

        .gc-btn-light {
            margin-top: 18px;
        }

        .detail-box {
            margin-bottom: 14px;
        }

        .status-header h1 {
            font-size: 34px;
        }

        .actions {
            justify-content: stretch;
        }

        .gc-btn-primary {
            width: 100%;
        }
    }
</style>