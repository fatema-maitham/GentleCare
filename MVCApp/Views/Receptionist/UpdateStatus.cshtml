@model MVCApp.ViewModels.Receptionist.ReceptionistUpdateAppointmentStatusViewModel

@{
    ViewData["Title"] = "Update Appointment Status";
}

<div class="receptionist-page">
    <div class="receptionist-status-page">
        <div class="manager-top">
            <a asp-controller="Receptionist"
               asp-action="Appointments"
               class="btn-light">
                Back to Appointments
            </a>
        </div>

        <div class="manager-card">
            <div class="card-head">
                <h2>Update Status</h2>
            </div>

            <div class="info-grid">
                <div class="info-box">
                    <span>Patient</span>
                    <strong>@Model.PatientName</strong>
                </div>

                <div class="info-box">
                    <span>Doctor</span>
                    <strong>Dr. @Model.DoctorName</strong>
                </div>

                <div class="info-box">
                    <span>Date</span>
                    <strong>@Model.AppointmentDate.ToString("dd MMM yyyy")</strong>
                </div>

                <div class="info-box">
                    <span>Time</span>
                    <strong>@Model.StartTime - @Model.EndTime</strong>
                </div>

                <div class="info-box">
                    <span>Current Status</span>
                    <strong>@Model.CurrentStatus</strong>
                </div>
            </div>
        </div>

        @if (Model.AllowedStatuses == null || !Model.AllowedStatuses.Any())
        {
            <div class="empty-box">
                No further status updates available
            </div>
        }
        else
        {
            <div class="manager-card">
                <form asp-controller="Receptionist"
                      asp-action="UpdateStatus"
                      method="post"
                      class="receptionist-status-form">

                    @Html.AntiForgeryToken()

                    <input asp-for="AppointmentId" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="form-group">
                        <label asp-for="NewStatus"></label>
                        <select asp-for="NewStatus"
                                asp-items="Model.AllowedStatuses">
                            <option value="">Select new status</option>
                        </select>
                        <span asp-validation-for="NewStatus" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CancellationReason"></label>
                        <textarea asp-for="CancellationReason"
                                  placeholder="Required only if the appointment is cancelled"></textarea>
                        <span asp-validation-for="CancellationReason" class="text-danger"></span>
                    </div>

                    <div class="actions">
                        <button type="submit" class="btn-main">
                            Update Status
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}