@model MVCApp.ViewModels.Receptionist.ReceptionistLiveQueueViewModel

@{
    ViewData["Title"] = "Live Queue";
}

<div class="receptionist-page">
    <div class="receptionist-queue-page">
        <div class="manager-card">
            <div class="card-head">
                <div>
                    <h2>Live Queue</h2>
                    <span class="muted">Monitor today's patient flow from arrival to doctor consultation.</span>
                </div>
            </div>
        </div>

        <div class="dashboard-stats">
            <div class="dashboard-stat">
                <strong>@Model.ConfirmedCount</strong>
                <span>Confirmed</span>
            </div>

            <div class="dashboard-stat">
                <strong>@Model.CheckedInCount</strong>
                <span>Checked In</span>
            </div>

            <div class="dashboard-stat">
                <strong>@Model.InProgressCount</strong>
                <span>In Progress</span>
            </div>

            <div class="dashboard-stat">
                <strong>@Model.CompletedCount</strong>
                <span>Completed</span>
            </div>
        </div>

        <div class="manager-card">
            <div class="card-head">
                <h2>Queue List</h2>
            </div>

            @if (Model.QueueItems == null || !Model.QueueItems.Any())
            {
                <div class="empty-box">
                    No active queue for today
                </div>
            }
            else
            {
                <div class="queue-list">
                    @foreach (var item in Model.QueueItems)
                    {
                        var displayStatus = item.Status switch
                        {
                            "CheckedIn" => "Checked In",
                            "InProgress" => "In Progress",
                            _ => item.Status
                        };

                        <div class="queue-item">
                            <div class="queue-main">
                                <span class="appointment-date">@item.StartTime - @item.EndTime</span>
                                <h3>@item.PatientName</h3>
                                <p class="appointment-meta-text">CPR: @item.CPRNumber</p>
                                <p class="appointment-meta-text">Dr. @item.DoctorName</p>

                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <p class="notes">Notes: @item.Notes</p>
                                }
                            </div>

                            <div class="queue-actions">
                                <span class="status-pill status-@item.Status.ToLower()">@displayStatus</span>

                                @if (item.Status == "Confirmed")
                                {
                                    <form asp-controller="Receptionist" asp-action="UpdateQueueStatus" method="post" class="queue-action-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@item.AppointmentId" />
                                        <input type="hidden" name="newStatus" value="Missed" />
                                        <button type="submit" class="btn-light">Mark Missed</button>
                                    </form>

                                    <form asp-controller="Receptionist" asp-action="UpdateQueueStatus" method="post" class="queue-action-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@item.AppointmentId" />
                                        <input type="hidden" name="newStatus" value="CheckedIn" />
                                        <button type="submit" class="btn-main">Check In</button>
                                    </form>
                                }

                                @if (item.Status == "CheckedIn")
                                {
                                    <form asp-controller="Receptionist" asp-action="UpdateQueueStatus" method="post" class="queue-action-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@item.AppointmentId" />
                                        <input type="hidden" name="newStatus" value="InProgress" />
                                        <button type="submit" class="btn-main">Start Visit</button>
                                    </form>
                                }

                                @if (item.Status == "Completed")
                                {
                                    <span class="helper-text">Visit completed.</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/appointment")
            .withAutomaticReconnect()
            .build();

        connection.on("QueueUpdated", function () {
            window.location.reload();
        });

        connection.start()
            .then(function () {
                return connection.invoke("JoinGroup", "ReceptionistQueue");
            })
            .catch(function (err) {
                console.error("SignalR connection error:", err.toString());
            });
    </script>
}