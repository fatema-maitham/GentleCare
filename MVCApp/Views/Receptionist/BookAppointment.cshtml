@model MVCApp.ViewModels.Receptionist.ReceptionistBookAppointmentViewModel

@{
    ViewData["Title"] = "Book Appointment";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
                    <div>
                        <h2 class="fw-bold mb-1">Book Appointment</h2>
                        <p class="text-muted mb-0">Select a patient, doctor, date, and available time slot.</p>
                    </div>
                    <a asp-controller="Receptionist" asp-action="Appointments" class="btn btn-outline-secondary mt-3 mt-md-0">
                        Back to Appointments
                    </a>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                <form asp-action="BookAppointment" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="PatientId" class="form-label fw-semibold"></label>
                            <select asp-for="PatientId" asp-items="Model.Patients" class="form-select">
                                <option value="">Select patient</option>
                            </select>
                            <span asp-validation-for="PatientId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SpecializationId" class="form-label fw-semibold"></label>
                            <select asp-for="SpecializationId" asp-items="Model.Specializations" class="form-select">
                                <option value="">Select specialization</option>
                            </select>
                            <span asp-validation-for="SpecializationId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DoctorId" class="form-label fw-semibold"></label>
                            <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-select">
                                <option value="">Select doctor</option>
                            </select>
                            <span asp-validation-for="DoctorId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AppointmentDate" class="form-label fw-semibold"></label>
                            <input asp-for="AppointmentDate" type="date" class="form-control" />
                            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <button type="submit" name="command" value="load" class="btn btn-outline-primary">
                                Show Available Slots
                            </button>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SelectedStartTime" class="form-label fw-semibold"></label>
                            <select asp-for="SelectedStartTime" asp-items="Model.AvailableSlots" class="form-select">
                                <option value="">Select available slot</option>
                            </select>
                            <span asp-validation-for="SelectedStartTime" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Notes" class="form-label fw-semibold"></label>
                            <input asp-for="Notes" class="form-control" placeholder="Optional notes" />
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <button type="submit" name="command" value="save" class="btn btn-primary">
                                Book Appointment
                            </button>
                        </div>
                    </div>
                </form>

                @if (Model.DoctorId.HasValue && Model.AppointmentDate.HasValue && !Model.AvailableSlots.Any())
                {
                    <div class="alert alert-warning mt-4 mb-0">
                        No available slots were found for the selected doctor and date.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}