@model MVCApp.ViewModels.Receptionist.ReceptionistBookAppointmentViewModel

@{
    ViewData["Title"] = "Book Appointment";
}

<div class="receptionist-page">
    <div class="receptionist-book-page">
        <div class="manager-card">
            <div class="card-head">
                <div>
                    <h2>Book Appointment</h2>
                    <span class="muted">Schedule an appointment for a patient.</span>
                </div>
            </div>
        </div>

        <div class="manager-card">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <form asp-controller="Receptionist" asp-action="BookAppointment" method="get" class="receptionist-filter-form" id="availabilityForm">
                <div class="form-group">
                    <label asp-for="PatientId"></label>
                    <select asp-for="PatientId" asp-items="Model.Patients" class="auto-submit">
                        <option value="">Select patient</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="SpecializationId"></label>
                    <select asp-for="SpecializationId" asp-items="Model.Specializations" class="auto-submit">
                        <option value="">Select specialization</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="DoctorId"></label>
                    <select asp-for="DoctorId" asp-items="Model.Doctors" class="auto-submit">
                        <option value="">Select doctor</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="AppointmentDate"></label>
                    <input asp-for="AppointmentDate" type="date" class="auto-submit" />
                </div>
            </form>
        </div>

        <div class="manager-card">
            <div class="card-head">
                <h2>Select Slot and Confirm</h2>
            </div>

            <form asp-controller="Receptionist" asp-action="BookAppointment" method="post" class="receptionist-booking-form">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="PatientId" />
                <input type="hidden" asp-for="SpecializationId" />
                <input type="hidden" asp-for="DoctorId" />
                <input type="hidden" asp-for="AppointmentDate" />

                <div class="form-group">
                    <label asp-for="SelectedStartTime"></label>
                    <select asp-for="SelectedStartTime" asp-items="Model.AvailableSlots">
                        <option value="">Select available slot</option>
                    </select>
                    <span asp-validation-for="SelectedStartTime" class="text-danger"></span>

                    @if (Model.DoctorId.HasValue && Model.AppointmentDate.HasValue && !Model.AvailableSlots.Any())
                    {
                        <p class="helper-error">No available slots were found for the selected doctor and date.</p>
                    }
                </div>

                <div class="form-group">
                    <label asp-for="Notes"></label>
                    <textarea asp-for="Notes" placeholder="Optional notes for the appointment"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="actions">
                    <button type="submit" class="btn-main">
                        Book Appointment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("availabilityForm");
            const patient = document.getElementById("PatientId");
            const specialization = document.getElementById("SpecializationId");
            const doctor = document.getElementById("DoctorId");
            const date = document.getElementById("AppointmentDate");

            function submitForm() {
                form.submit();
            }

            patient.addEventListener("change", submitForm);

            specialization.addEventListener("change", function () {
                doctor.value = "";
                submitForm();
            });

            doctor.addEventListener("change", submitForm);
            date.addEventListener("change", submitForm);
        });
    </script>
}