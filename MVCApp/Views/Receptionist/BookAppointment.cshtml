@model MVCApp.ViewModels.Receptionist.ReceptionistBookAppointmentViewModel

@{
    ViewData["Title"] = "Book Appointment";
}

<section class="book-page">
    <div class="book-card">

        <div class="book-header">
            <h1>Book Appointment</h1>
            <p>Schedule an appointment for a patient.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <form asp-controller="Receptionist" asp-action="BookAppointment" method="get" class="filter-box" id="availabilityForm">
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="PatientId"></label>
                    <select asp-for="PatientId" asp-items="Model.Patients" class="form-control auto-submit">
                        <option value="">Select patient</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="SpecializationId"></label>
                    <select asp-for="SpecializationId" asp-items="Model.Specializations" class="form-control auto-submit">
                        <option value="">Select specialization</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="DoctorId"></label>
                    <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-control auto-submit">
                        <option value="">Select doctor</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="AppointmentDate"></label>
                    <input asp-for="AppointmentDate" type="date" class="form-control auto-submit" />
                </div>
            </div>
        </form>

        <form asp-controller="Receptionist" asp-action="BookAppointment" method="post" class="booking-form">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="SpecializationId" />
            <input type="hidden" asp-for="DoctorId" />
            <input type="hidden" asp-for="AppointmentDate" />

            <div class="form-group">
                <label asp-for="SelectedStartTime"></label>
                <select asp-for="SelectedStartTime" asp-items="Model.AvailableSlots" class="form-control">
                    <option value="">Select available slot</option>
                </select>
                <span asp-validation-for="SelectedStartTime" class="field-error"></span>

                @if (Model.DoctorId.HasValue && Model.AppointmentDate.HasValue && !Model.AvailableSlots.Any())
                {
                    <p class="helper-error">No available slots were found for the selected doctor and date.</p>
                }
            </div>

            <div class="form-group">
                <label asp-for="Notes"></label>
                <textarea asp-for="Notes" class="form-control textarea" placeholder="Optional notes for the appointment"></textarea>
                <span asp-validation-for="Notes" class="field-error"></span>
            </div>

            <div class="actions">
                <button type="submit" class="gc-btn-primary">
                    Book Appointment
                </button>
            </div>
        </form>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("availabilityForm");
            const patient = document.getElementById("PatientId");
            const specialization = document.getElementById("SpecializationId");
            const doctor = document.getElementById("DoctorId");
            const date = document.getElementById("AppointmentDate");

            function submitForm() {
                form.submit();
            }

            patient.addEventListener("change", submitForm);

            specialization.addEventListener("change", function () {
                doctor.value = "";
                submitForm();
            });

            doctor.addEventListener("change", submitForm);
            date.addEventListener("change", submitForm);
        });
    </script>
}

<style>
    .book-page {
        max-width: 980px;
        margin: 0 auto;
        padding: 32px 10px 70px;
    }

    .book-card {
        background: white;
        border-radius: 32px;
        padding: 42px;
        box-shadow: 0 18px 45px rgba(99,127,163,0.12);
    }

    .book-header {
        margin-bottom: 26px;
    }

        .book-header h1 {
            margin: 0;
            font-size: 38px;
            font-weight: 900;
            color: #182333;
        }

        .book-header p {
            color: #6b7a87;
            margin: 10px 0 0;
            font-size: 16px;
        }

    .filter-box,
    .booking-form {
        background: #f5f8fa;
        border-radius: 26px;
        padding: 24px;
        margin-top: 20px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    label {
        display: block;
        margin-bottom: 8px;
        color: #182333;
        font-weight: 900;
    }

    .form-control {
        width: 100%;
        min-height: 52px;
        border: 1px solid #dce5e8;
        border-radius: 16px;
        padding: 12px 14px;
        background: white;
        color: #182333;
        outline: none;
    }

        .form-control:focus {
            border-color: #637fa3;
            box-shadow: 0 0 0 4px rgba(99,127,163,0.15);
        }

    .textarea {
        min-height: 110px;
        resize: vertical;
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .gc-btn-primary {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 999px;
        padding: 12px 24px;
        font-weight: 900;
        text-decoration: none;
        transition: 0.2s ease;
        border: 0;
        cursor: pointer;
        background: #637fa3;
        color: white;
    }

        .gc-btn-primary:hover {
            transform: translateY(-2px);
            color: white;
            background: #71999f;
        }

    .validation-summary,
    .field-error,
    .helper-error {
        color: #b42318;
        font-weight: 800;
    }

    .helper-error {
        margin-top: 10px;
        margin-bottom: 0;
    }

    @@media (max-width: 800px) {
        .book-card {
            padding: 30px 22px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .book-header h1 {
            font-size: 32px;
        }

        .actions {
            justify-content: stretch;
        }

        .gc-btn-primary {
            width: 100%;
        }
    }
</style>