@model MVCApp.ViewModels.Public.PublicAppointmentLookupViewModel

@{
    ViewData["Title"] = "Public Lookup";
}

<section class="lookup-page">

    <div class="lookup-card">
        <div class="lookup-header">
            <h1>Public Lookup</h1>
        </div>

        <form asp-controller="Public" asp-action="Lookup" method="post" class="lookup-form">
            @Html.AntiForgeryToken()

            <div class="lookup-field">
                <label asp-for="CPRNumber">CPR Number</label>
                <input asp-for="CPRNumber" placeholder="Enter CPR number" />
            </div>

            <div class="lookup-field">
                <label asp-for="ReferenceNumber">Patient Reference Number</label>
                <input asp-for="ReferenceNumber" placeholder="Enter reference number" />
            </div>

            <button type="submit" class="lookup-main-btn">Lookup</button>

            <div class="lookup-links">
                <a asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="Register">Register</a>
            </div>
        </form>

        @if (Model.HasSearched && !string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="lookup-alert">
                @Model.ErrorMessage
            </div>
        }
    </div>

    @if (Model.HasSearched && Model.UpcomingAppointments.Any())
    {
        <div class="lookup-results">
            <h2>Upcoming Appointments</h2>

            @foreach (var item in Model.UpcomingAppointments)
            {
                <div class="appointment-card">
                    <div class="appointment-top">
                        <div>
                            <h3>Dr. @item.DoctorName</h3>
                        </div>

                        <span class="status-badge">@item.StatusName</span>
                    </div>

                    <div class="appointment-grid">
                        <div class="info-box">
                            <span class="info-label">Date</span>
                            <strong>@item.AppointmentDate.ToString("dd MMM yyyy")</strong>
                        </div>

                        <div class="info-box">
                            <span class="info-label">Time</span>
                            <strong>@item.StartTime - @item.EndTime</strong>
                        </div>

                        <div class="info-box">
                            <span class="info-label">Appointment ID</span>
                            <strong>#@item.AppointmentId</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                    {
                        <div class="notes-box">
                            <span>Notes</span>
                            <p>@item.Notes</p>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (Model.HasSearched && Model.RecentVisits.Any())
    {
        <div class="lookup-results">
            <h2>Recent Visit Summary</h2>

            @foreach (var visit in Model.RecentVisits)
            {
                <div class="appointment-card">
                    <div class="appointment-top">
                        <div>
                            <span class="small-label">Doctor</span>
                            <h3>Dr. @visit.DoctorName</h3>
                            <p>@visit.VisitDate.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(visit.Diagnosis))
                    {
                        <div class="notes-box">
                            <span>Diagnosis</span>
                            <p>@visit.Diagnosis</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(visit.Treatment))
                    {
                        <div class="notes-box">
                            <span>Treatment</span>
                            <p>@visit.Treatment</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(visit.DoctorNotes))
                    {
                        <div class="notes-box">
                            <span>Doctor Notes</span>
                            <p>@visit.DoctorNotes</p>
                        </div>
                    }
                </div>
            }
        </div>
    }

</section>
