@{
    ViewData["Title"] = "Public Lookup";
}

<style>
    .lookup-page {
        max-width: 760px;
        margin: 0 auto;
        padding: 55px 0 70px;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .lookup-top {
        margin-bottom: 28px;
    }

        .lookup-top h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 900;
            color: #12262F;
        }

        .lookup-top p {
            margin: 7px 0 0;
            color: #687A80;
            font-weight: 600;
            line-height: 1.6;
        }

    .lookup-form {
        display: grid;
        gap: 24px;
    }

    .lookup-field {
        display: grid;
        grid-template-columns: 210px 1fr;
        gap: 18px;
        align-items: start;
    }

        .lookup-field label {
            padding-top: 13px;
            color: #12262F;
            font-weight: 900;
        }

        .lookup-field input {
            width: 100%;
            height: 50px;
            border: 1px solid #D6DDDE;
            border-radius: 14px;
            padding: 0 15px;
            outline: none;
            background: #ffffff;
            color: #12262F;
            font-weight: 650;
        }

            .lookup-field input:focus {
                border-color: #00779B;
                box-shadow: 0 0 0 3px rgba(0, 119, 155, 0.14);
            }

    .lookup-actions {
        display: flex;
        justify-content: center;
        margin-top: 4px;
    }

    .lookup-main-btn {
        width: 414px;
        max-width: 100%;
        height: 50px;
        border: none;
        border-radius: 14px;
        background: #075168;
        color: #ffffff;
        font-weight: 900;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .lookup-main-btn:hover {
            background: #00779B;
            transform: translateY(-2px);
        }

    .lookup-links {
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-top: 18px;
        padding-left: 0;
    }

        .lookup-links a {
            color: #075168;
            font-weight: 850;
            text-decoration: none;
        }

            .lookup-links a:hover {
                text-decoration: underline;
            }

    @@media (max-width: 700px) {
        .lookup-page {
            padding: 35px 0 55px;
        }

        .lookup-field {
            grid-template-columns: 1fr;
            gap: 7px;
        }

            .lookup-field label {
                padding-top: 0;
            }

        .lookup-main-btn {
            width: 100%;
        }

        .lookup-links {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

<div class="lookup-page">
    <div class="lookup-top">
        <h1>Public Appointment Lookup</h1>
        <p>
            Patients can check appointment details without login using their CPR number
            and patient reference number.
        </p>
    </div>

    <form method="get" action="#" class="lookup-form">

        <div class="lookup-field">
            <label for="cprNumber">CPR Number</label>
            <input id="cprNumber"
                   name="cprNumber"
                   type="text"
                   placeholder="Enter CPR number" />
        </div>

        <div class="lookup-field">
            <label for="referenceNumber">Patient Reference Number</label>
            <input id="referenceNumber"
                   name="referenceNumber"
                   type="text"
                   placeholder="Enter reference number" />
        </div>

        <div class="lookup-actions">
            <button type="submit" class="lookup-main-btn">
                Lookup
            </button>
        </div>

        <div class="lookup-links">
            <a asp-controller="Account" asp-action="Login">Login</a>
            <a asp-controller="Account" asp-action="Register">Register</a>
        </div>

    </form>
</div>