@{
    ViewData["Title"] = "Public Lookup";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm" style="border-radius: 22px;">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <h2 class="fw-bold mb-2">Public Appointment Lookup</h2>
                    <p class="text-muted mb-0">
                        Patients can check appointment details without login using their CPR number and patient reference number.
                    </p>
                </div>

                <form method="get" action="#">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">CPR Number</label>
                        <input type="text" class="form-control form-control-lg" placeholder="Enter CPR Number" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Patient Reference Number</label>
                        <input type="text" class="form-control form-control-lg" placeholder="Enter Reference Number" />
                    </div>

                    <div class="d-grid d-sm-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg px-4">Lookup</button>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg px-4">Login</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-success btn-lg px-4">Register</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>