@model MVCApp.ViewModels.Public.PublicAppointmentLookupViewModel

@{
    ViewData["Title"] = "Public Lookup";
}

<section class="lookup-page">

    <div class="lookup-card">
        <div class="lookup-header">
            <h1>Public Lookup</h1>
            <p>Check appointments and recent visits using CPR and reference number.</p>
        </div>

        <form asp-controller="Public" asp-action="Lookup" method="post" class="lookup-form">
            @Html.AntiForgeryToken()

            <div class="lookup-field">
                <label asp-for="CPRNumber">CPR Number</label>
                <input asp-for="CPRNumber" type="text" placeholder="Enter CPR number" />
            </div>

            <div class="lookup-field">
                <label asp-for="ReferenceNumber">Patient Reference Number</label>
                <input asp-for="ReferenceNumber" type="text" placeholder="Enter reference number" />
            </div>

            <button type="submit" class="lookup-main-btn">
                Lookup
            </button>

            <div class="lookup-links">
                <a asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="Register">Register</a>
            </div>
        </form>

        @if (Model.HasSearched && !string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="lookup-alert">
                @Model.ErrorMessage
            </div>
        }
    </div>

    @if (Model.HasSearched && Model.UpcomingAppointments.Any())
    {
        <div class="lookup-results">
            <h2>Upcoming Appointments</h2>

            @foreach (var item in Model.UpcomingAppointments)
            {
                <div class="result-card">
                    <div class="result-top">
                        <div>
                            <h3>@item.DoctorName</h3>
                            <p>@item.SpecializationName</p>
                        </div>

                        <span class="status-badge">@item.StatusName</span>
                    </div>

                    <div class="result-info">
                        <span>@item.AppointmentDate.ToString("dd MMM yyyy")</span>
                        <span>@item.StartTime.ToString("hh\\:mm") - @item.EndTime.ToString("hh\\:mm")</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                    {
                        <p class="result-notes">@item.Notes</p>
                    }
                </div>
            }
        </div>
    }

    @if (Model.HasSearched && Model.RecentVisits.Any())
    {
        <div class="lookup-results">
            <h2>Recent Visit Summary</h2>

            @foreach (var visit in Model.RecentVisits)
            {
                <div class="result-card">
                    <div class="result-top">
                        <div>
                            <h3>@visit.DoctorName</h3>
                            <p>@visit.VisitDate.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(visit.Diagnosis))
                    {
                        <p><strong>Diagnosis:</strong> @visit.Diagnosis</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(visit.Treatment))
                    {
                        <p><strong>Treatment:</strong> @visit.Treatment</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(visit.DoctorNotes))
                    {
                        <p><strong>Notes:</strong> @visit.DoctorNotes</p>
                    }
                </div>
            }
        </div>
    }

</section>

<style>
    body {
        background: #f1efed;
    }

    .lookup-page {
        min-height: calc(100vh - 90px);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px 18px;
        gap: 26px;
    }

    .lookup-card {
        width: 100%;
        max-width: 620px;
        background: #ffffff;
        border: 1px solid #d6ddde;
        border-radius: 24px;
        overflow: hidden;
    }

    .lookup-header {
        padding: 24px 28px;
        border-bottom: 1px solid #e9eeee;
    }

        .lookup-header h1 {
            margin: 0;
            color: #075168;
            font-size: 30px;
            font-weight: 900;
        }

        .lookup-header p {
            margin: 8px 0 0;
            color: #66777d;
            font-weight: 600;
            line-height: 1.6;
        }

    .lookup-form {
        padding: 28px;
        display: grid;
        gap: 18px;
    }

    .lookup-field {
        display: grid;
        gap: 8px;
    }

        .lookup-field label {
            color: #12262f;
            font-weight: 900;
        }

        .lookup-field input {
            width: 100%;
            height: 50px;
            border: 1px solid #d6ddde;
            border-radius: 14px;
            padding: 0 15px;
            color: #12262f;
            font-weight: 700;
            outline: none;
        }

            .lookup-field input:focus {
                border-color: #075168;
                box-shadow: 0 0 0 3px rgba(7, 81, 104, 0.13);
            }

    .lookup-main-btn {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 14px;
        background: #075168;
        color: #ffffff;
        font-weight: 900;
        font-size: 16px;
        cursor: pointer;
    }

        .lookup-main-btn:hover {
            background: #00779b;
        }

    .lookup-links {
        display: flex;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

        .lookup-links a {
            color: #075168;
            font-weight: 900;
            text-decoration: none;
        }

            .lookup-links a:hover {
                text-decoration: underline;
            }

    .lookup-alert {
        margin: 0 28px 28px;
        padding: 14px 16px;
        border-radius: 14px;
        background: #fff3cd;
        color: #664d03;
        font-weight: 800;
    }

    .lookup-results {
        width: 100%;
        max-width: 820px;
    }

        .lookup-results h2 {
            margin: 0 0 14px;
            color: #075168;
            font-size: 24px;
            font-weight: 900;
        }

    .result-card {
        background: #ffffff;
        border: 1px solid #d6ddde;
        border-radius: 20px;
        padding: 22px;
        margin-bottom: 14px;
    }

    .result-top {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: flex-start;
    }

    .result-card h3 {
        margin: 0;
        color: #12262f;
        font-size: 20px;
        font-weight: 900;
    }

    .result-card p {
        margin: 7px 0;
        color: #52676e;
        font-weight: 600;
    }

    .status-badge {
        padding: 7px 12px;
        border-radius: 999px;
        background: #d9e2e4;
        color: #075168;
        font-size: 13px;
        font-weight: 900;
        white-space: nowrap;
    }

    .result-info {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
    }

        .result-info span {
            background: #f1efed;
            color: #12262f;
            padding: 8px 12px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 800;
        }

    .result-notes {
        margin-top: 14px !important;
    }

    @@media (max-width: 600px) {
        .lookup-card {
            border-radius: 20px;
        }

        .lookup-header,
        .lookup-form {
            padding: 22px;
        }

        .lookup-alert {
            margin: 0 22px 22px;
        }

        .result-top {
            flex-direction: column;
        }
    }
</style>