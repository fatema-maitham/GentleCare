@{
    ViewData["Title"] = "Public Lookup";
}

<section class="lookup-page">

    <div class="lookup-card">
        <div class="lookup-header">
            <h1>Public Lookup</h1>
        </div>

        <form method="get" action="#" class="lookup-form">

            <div class="lookup-field">
                <label for="cprNumber">CPR Number</label>
                <input id="cprNumber"
                       name="cprNumber"
                       type="text"
                       placeholder="Enter CPR number" />
            </div>

            <div class="lookup-field">
                <label for="referenceNumber">Patient Reference Number</label>
                <input id="referenceNumber"
                       name="referenceNumber"
                       type="text"
                       placeholder="Enter reference number" />
            </div>

            <button type="submit" class="lookup-main-btn">
                Lookup
            </button>

            <div class="lookup-links">
                <a asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="Register">Register</a>
            </div>

        </form>
    </div>

</section>

<style>
    body {
        background: #f1efed;
    }

    .lookup-page {
        min-height: calc(100vh - 90px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 18px;
    }

    .lookup-card {
        width: 100%;
        max-width: 620px;
        background: #ffffff;
        border: 1px solid #d6ddde;
        border-radius: 24px;
        overflow: hidden;
    }

    .lookup-header {
        padding: 24px 28px;
        border-bottom: 1px solid #e9eeee;
    }

        .lookup-header h1 {
            margin: 0;
            color: #075168;
            font-size: 30px;
            font-weight: 900;
        }

    .lookup-form {
        padding: 28px;
        display: grid;
        gap: 18px;
    }

    .lookup-field {
        display: grid;
        gap: 8px;
    }

        .lookup-field label {
            color: #12262f;
            font-weight: 900;
        }

        .lookup-field input {
            width: 100%;
            height: 50px;
            border: 1px solid #d6ddde;
            border-radius: 14px;
            padding: 0 15px;
            color: #12262f;
            font-weight: 700;
            outline: none;
        }

            .lookup-field input:focus {
                border-color: #075168;
                box-shadow: 0 0 0 3px rgba(7, 81, 104, 0.13);
            }

    .lookup-main-btn {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 14px;
        background: #075168;
        color: #ffffff;
        font-weight: 900;
        font-size: 16px;
    }

        .lookup-main-btn:hover {
            background: #00779b;
        }

    .lookup-links {
        display: flex;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

        .lookup-links a {
            color: #075168;
            font-weight: 900;
            text-decoration: none;
        }

            .lookup-links a:hover {
                text-decoration: underline;
            }

    @@media (max-width: 600px) {
        .lookup-card

    {
        border-radius: 20px;
    }

    .lookup-header,
    .lookup-form {
        padding: 22px;
    }

    }
</style>