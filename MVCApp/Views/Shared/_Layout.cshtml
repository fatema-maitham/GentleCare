@{
    var pageTitle = ViewData["Title"] as string ?? "GentleCare";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - GentleCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --gc-blue: #0088FF;
            --gc-dark: #0A2E72;
            --gc-bg: #EEF6FF;
            --gc-text: #111827;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--gc-bg);
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            color: var(--gc-text);
        }

        .gc-navbar {
            background: linear-gradient(90deg, #0088FF 0%, #0077DF 52%, #0A2E72 100%);
            min-height: 76px;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 8px 24px rgba(10, 46, 114, 0.16);
        }

        .gc-navbar-inner {
            max-width: 1180px;
            margin: 0 auto;
            min-height: 76px;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .gc-brand {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: #ffffff;
            flex-shrink: 0;
        }

            .gc-brand img {
                height: 58px;
                width: auto;
                max-width: 245px;
                object-fit: contain;
                display: block;
            }

        .gc-logo-fallback {
            display: none;
            align-items: center;
            gap: 10px;
            color: #ffffff;
            font-weight: 900;
            font-size: 25px;
            letter-spacing: -0.5px;
        }

            .gc-logo-fallback span:first-child {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: #ffffff;
                color: var(--gc-blue);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
            }

        .main-wrapper {
            max-width: 1180px;
            margin: 30px auto 0;
            padding: 0 22px 55px;
        }

        .app-footer {
            max-width: 1180px;
            margin: 0 auto;
            padding: 18px 22px 26px;
            color: #475569;
            font-size: 13px;
        }

        @@media (max-width: 950px) {
            .gc-navbar {
                position: relative;
            }

            .gc-navbar-inner {
                flex-direction: column;
                align-items: flex-start;
                padding-top: 14px;
                padding-bottom: 14px;
                gap: 12px;
            }

            .gc-brand img {
                height: 50px;
            }
        }
    </style>
</head>

<body>
    <header class="gc-navbar">
        <div class="gc-navbar-inner">

            <a asp-controller="Dashboard" asp-action="Index" class="gc-brand">
                <img src="@Url.Content("~/images/logo.png")"
                     alt="GentleCare Logo"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                <div class="gc-logo-fallback">
                    <span>♡</span>
                    <span>GentleCare</span>
                </div>
            </a>

            <partial name="_Navbar" />

        </div>
    </header>

    <div class="main-wrapper">
        <main role="main">
            <partial name="_AlertMessages" />
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        &copy; @DateTime.Now.Year - GentleCare MVC Application
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>