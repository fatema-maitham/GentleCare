@{
    var pageTitle = ViewData["Title"] as string ?? "GentleCare";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --main: #637fa3;
            --accent: #71999f;
            --bg: #f5f8fa;
            --card: #ffffff;
            --text: #182333;
            --muted: #6b7a87;
            --border: #dce5e8;
            --soft: #f8fbfc;
            --shadow: 0 8px 20px rgba(99, 127, 163, 0.10);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
            background: var(--bg);
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            color: var(--text);
        }

        a {
            text-decoration: none;
        }

        /* =========================
           navbar
           ========================= */

        .main-navbar {
            background: var(--main);
            min-height: 72px;
            box-shadow: 0 6px 18px rgba(99, 127, 163, 0.18);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .main-navbar-inner {
            max-width: 1180px;
            margin: 0 auto;
            min-height: 72px;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 28px;
        }

        .text-logo {
            color: #ffffff;
            display: flex;
            align-items: center;
        }

        .text-logo-name {
            color: #ffffff;
            font-size: 29px;
            font-weight: 900;
            letter-spacing: -1px;
        }

        .nav-links,
        .navbar-links,
        .custom-navbar-links {
            display: flex;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
        }

            .nav-links a,
            .navbar-links a,
            .custom-navbar-links a,
            .main-navbar a:not(.text-logo) {
                color: #ffffff;
                font-size: 14px;
                font-weight: 800;
                opacity: 0.9;
            }

                .nav-links a:hover,
                .navbar-links a:hover,
                .custom-navbar-links a:hover,
                .main-navbar a:not(.text-logo):hover {
                    color: #ffffff;
                    opacity: 1;
                }

        .logout-btn,
        .logout-link,
        a[href*="Logout"] {
            background: #ffffff;
            color: var(--main) !important;
            padding: 9px 16px;
            border-radius: 999px;
            font-weight: 900 !important;
            opacity: 1 !important;
        }

        /* =========================
           layout
           ========================= */

        .layout-main {
            max-width: 1180px;
            margin: 28px auto 0;
            padding: 0 22px 56px;
        }

        .layout-footer {
            max-width: 1180px;
            margin: 0 auto;
            padding: 18px 22px 28px;
            color: var(--muted);
            font-size: 13px;
        }

        /* =========================
           common page styles
           ========================= */

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
        }

            .page-header h1 {
                margin: 0;
                font-size: 31px;
                font-weight: 900;
                color: var(--text);
            }

            .page-header p {
                margin: 6px 0 0;
                color: var(--muted);
            }

        .header-actions,
        .form-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .primary-btn,
        .secondary-btn,
        .cm-main-btn {
            display: inline-block;
            border: none;
            border-radius: 999px;
            padding: 10px 18px;
            font-weight: 900;
            cursor: pointer;
        }

        .primary-btn,
        .cm-main-btn {
            background: var(--main);
            color: #ffffff;
        }

            .primary-btn:hover,
            .cm-main-btn:hover {
                background: var(--accent);
                color: #ffffff;
            }

        .secondary-btn {
            background: #e9f0f2;
            color: var(--main);
        }

            .secondary-btn:hover {
                background: #dfe9ec;
                color: var(--main);
            }

        .btn-link,
        .table-link {
            color: var(--main);
            font-weight: 800;
            margin-right: 8px;
        }

            .btn-link:hover,
            .table-link:hover {
                color: var(--accent);
                text-decoration: underline;
            }

        .danger-button {
            border: none;
            background: transparent;
            color: var(--main);
            cursor: pointer;
            padding: 0;
            font: inherit;
            font-weight: 800;
        }

        .section-card,
        .dashboard-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 22px;
            box-shadow: var(--shadow);
            margin-bottom: 24px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
        }

            .section-header h2 {
                margin: 0;
                font-size: 22px;
                font-weight: 900;
                color: var(--text);
            }

        .details-grid,
        .form-grid,
        .status-grid,
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 14px;
        }

        .details-item,
        .status-box {
            background: var(--soft);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 15px;
        }

            .details-item span,
            .status-box span {
                display: block;
                color: var(--muted);
                font-size: 14px;
                font-weight: 800;
            }

            .details-item strong,
            .status-box strong {
                display: block;
                margin-top: 5px;
                font-size: 21px;
                font-weight: 900;
                color: var(--text);
            }

        /* =========================
           dashboard clean design
           ========================= */

        .cm-dashboard {
            max-width: 1180px;
            margin: 0 auto;
        }

        .cm-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            margin-bottom: 22px;
        }

            .cm-top h1 {
                margin: 0;
                font-size: 30px;
                font-weight: 900;
                color: var(--text);
            }

            .cm-top p {
                margin: 6px 0 0;
                color: var(--muted);
                font-size: 14px;
            }

        .cm-card-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 14px;
            margin-bottom: 20px;
        }

        .cm-card {
            background: #ffffff;
            border: 1px solid var(--border);
            border-top: 5px solid var(--main);
            border-radius: 18px;
            padding: 18px;
            min-height: 102px;
            box-shadow: var(--shadow);
        }

            .cm-card.alt {
                border-top-color: var(--accent);
            }

            .cm-card span {
                display: block;
                color: var(--muted);
                font-size: 13px;
                font-weight: 900;
                margin-bottom: 12px;
            }

            .cm-card strong {
                display: block;
                font-size: 36px;
                font-weight: 900;
                line-height: 1;
                color: var(--text);
            }

        .cm-main-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.45fr) 340px;
            gap: 18px;
            align-items: start;
        }

        .cm-left,
        .cm-right {
            display: grid;
            gap: 18px;
        }

        .cm-panel {
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 20px;
            box-shadow: var(--shadow);
        }

        .cm-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            gap: 12px;
        }

            .cm-panel-header h2 {
                margin: 0;
                font-size: 19px;
                font-weight: 900;
                color: var(--text);
            }

            .cm-panel-header a,
            .cm-table a,
            .cm-list-item a {
                color: var(--main);
                font-size: 13px;
                font-weight: 900;
            }

                .cm-panel-header a:hover,
                .cm-table a:hover,
                .cm-list-item a:hover {
                    color: var(--accent);
                    text-decoration: underline;
                }

        .cm-status {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .cm-status-box {
            background: var(--soft);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 14px;
        }

            .cm-status-box span {
                display: block;
                color: var(--muted);
                font-size: 12px;
                font-weight: 900;
                margin-bottom: 7px;
            }

            .cm-status-box strong {
                display: block;
                color: var(--text);
                font-size: 24px;
                font-weight: 900;
            }

        .cm-calendar {
            text-align: center;
        }

        .cm-calendar-box {
            background: var(--main);
            color: #ffffff;
            border-radius: 18px;
            padding: 22px;
            margin-bottom: 14px;
        }

            .cm-calendar-box span {
                display: block;
                font-size: 14px;
                font-weight: 800;
                opacity: 0.95;
            }

            .cm-calendar-box strong {
                display: block;
                font-size: 58px;
                font-weight: 900;
                line-height: 1;
                margin: 8px 0;
            }

            .cm-calendar-box p {
                margin: 0;
                font-weight: 700;
            }

        .cm-calendar-mini {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

            .cm-calendar-mini div {
                background: var(--soft);
                border: 1px solid var(--border);
                border-radius: 13px;
                padding: 12px 8px;
            }

            .cm-calendar-mini span {
                display: block;
                color: var(--muted);
                font-size: 11px;
                font-weight: 900;
                margin-bottom: 5px;
            }

            .cm-calendar-mini strong {
                color: var(--text);
                font-size: 21px;
                font-weight: 900;
            }

        .cm-table-wrap {
            overflow-x: auto;
        }

        .cm-table,
        .data-table,
        .clean-table {
            width: 100%;
            border-collapse: collapse;
        }

            .cm-table th,
            .cm-table td,
            .data-table th,
            .data-table td,
            .clean-table th,
            .clean-table td {
                padding: 13px 12px;
                border-bottom: 1px solid var(--border);
                text-align: left;
                vertical-align: middle;
                font-size: 13px;
            }

            .cm-table th,
            .data-table th,
            .clean-table th {
                background: var(--soft);
                font-weight: 900;
                color: var(--text);
            }

        .cm-pill,
        .status-pill,
        .clean-pill {
            display: inline-block;
            border-radius: 999px;
            padding: 6px 11px;
            background: rgba(113, 153, 159, 0.16);
            color: var(--main);
            font-size: 12px;
            font-weight: 900;
        }

        .cm-list {
            display: grid;
            gap: 10px;
        }

        .cm-list-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            background: var(--soft);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 13px;
        }

            .cm-list-item h3 {
                margin: 0;
                font-size: 15px;
                font-weight: 900;
            }

            .cm-list-item p {
                margin: 4px 0 0;
                color: var(--muted);
                font-size: 12px;
            }

        .cm-empty,
        .empty-text,
        .muted-text {
            color: var(--muted);
            margin: 0;
        }

        /* =========================
           forms
           ========================= */

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 14px;
        }

            .form-group label {
                font-weight: 900;
                color: var(--text);
            }

            .form-group input,
            .form-group select,
            .form-group textarea {
                width: 100%;
                padding: 11px 12px;
                border-radius: 12px;
                border: 1px solid #cbd5e1;
                outline: none;
                background: #ffffff;
            }

                .form-group input:focus,
                .form-group select:focus,
                .form-group textarea:focus {
                    border-color: var(--accent);
                    box-shadow: 0 0 0 3px rgba(113, 153, 159, 0.16);
                }

        .filter-form {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 14px;
            align-items: end;
        }

        .checkbox-row {
            flex-direction: row;
            align-items: center;
        }

        .checkbox-list {
            display: grid;
            gap: 10px;
        }

        .checkbox-item {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            background: var(--soft);
            border: 1px solid var(--border);
            padding: 12px;
            border-radius: 12px;
        }

            .checkbox-item small {
                display: block;
                color: var(--muted);
                margin-top: 3px;
            }

        .alert {
            padding: 12px 14px;
            border-radius: 12px;
            margin-bottom: 16px;
            font-weight: 800;
        }

        .alert-success {
            background: rgba(113, 153, 159, 0.16);
            color: var(--main);
        }

        .alert-danger {
            background: rgba(99, 127, 163, 0.14);
            color: var(--main);
        }

        .text-danger {
            color: var(--main) !important;
            font-size: 13px;
            font-weight: 700;
        }

        /* =========================
           other pages
           ========================= */

        .doctor-grid,
        .quick-actions,
        .workload-list,
        .leave-list {
            display: grid;
            gap: 16px;
        }

        .doctor-card,
        .workload-item,
        .leave-item,
        .action-card {
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 20px;
            box-shadow: var(--shadow);
        }

        .doctor-card-header,
        .workload-item,
        .leave-item {
            display: flex;
            justify-content: space-between;
            gap: 12px;
        }

            .doctor-card-header h3,
            .workload-item h3,
            .leave-item h3 {
                margin: 0;
                font-weight: 900;
            }

            .doctor-card-header p,
            .workload-item p,
            .leave-item p {
                margin: 5px 0 0;
                color: var(--muted);
            }

        .doctor-info p {
            margin: 6px 0;
        }

        .doctor-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin: 14px 0;
        }

            .doctor-stats div {
                background: var(--soft);
                border-radius: 12px;
                padding: 12px;
                text-align: center;
                border: 1px solid var(--border);
            }

            .doctor-stats strong {
                display: block;
                font-size: 22px;
            }

            .doctor-stats span {
                color: var(--muted);
                font-size: 13px;
            }

        .doctor-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            border-top: 1px solid var(--border);
            padding-top: 14px;
        }

        .doctor-status-row {
            margin-bottom: 12px;
        }

        .status-active,
        .status-inactive,
        .leave-badge,
        .tag-pill {
            background: rgba(113, 153, 159, 0.16);
            color: var(--main);
            border-radius: 999px;
            padding: 6px 11px;
            font-size: 13px;
            font-weight: 900;
            display: inline-block;
        }

        .tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .profile-note {
            margin-top: 14px;
            background: var(--soft);
            border: 1px solid var(--border);
            padding: 14px;
            border-radius: 12px;
        }

            .profile-note span {
                display: block;
                font-weight: 900;
                color: var(--muted);
                margin-bottom: 5px;
            }

            .profile-note p {
                margin: 0;
            }

        hr {
            border: none;
            border-top: 1px solid var(--border);
            margin: 22px 0;
            opacity: 1;
        }

        @@media (max-width: 1050px) {
            .cm-card-row {
                grid-template-columns: repeat(3, 1fr);
            }

            .cm-main-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 960px) {
            .main-navbar {
                position: relative;
            }

            .main-navbar-inner {
                flex-direction: column;
                align-items: flex-start;
                padding-top: 14px;
                padding-bottom: 14px;
                gap: 12px;
            }

            .text-logo-name {
                font-size: 26px;
            }

            .page-header,
            .section-header,
            .cm-top,
            .cm-panel-header,
            .doctor-card-header,
            .workload-item,
            .leave-item {
                flex-direction: column;
                align-items: flex-start;
            }

                .page-header h1,
                .cm-top h1 {
                    font-size: 26px;
                }
        }

        @@media (max-width: 650px) {
            .cm-card-row {
                grid-template-columns: 1fr;
            }

            .cm-status {
                grid-template-columns: 1fr 1fr;
            }

            .cm-calendar-mini {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <header class="main-navbar">
        <div class="main-navbar-inner">

            <a asp-controller="ClinicManager" asp-action="Dashboard" class="text-logo">
                <span class="text-logo-name">GentleCare</span>
            </a>

            <partial name="_Navbar" />

        </div>
    </header>

    <div class="layout-main">
        <main role="main">
            <partial name="_AlertMessages" />
            @RenderBody()
        </main>
    </div>

    <footer class="layout-footer">
        &copy; @DateTime.Now.Year - GentleCare MVC Application
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>