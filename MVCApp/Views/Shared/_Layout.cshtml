@{
    var pageTitle = ViewData["Title"] as string ?? "GentleCare";

    var homeController = "Public";
    var homeAction = "Lookup";

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Patient"))
        {
            homeController = "Patient";
            homeAction = "Dashboard";
        }
        else if (User.IsInRole("Receptionist"))
        {
            homeController = "Receptionist";
            homeAction = "Index";
        }
        else if (User.IsInRole("Doctor"))
        {
            homeController = "Doctor";
            homeAction = "Dashboard";
        }
        else if (User.IsInRole("ClinicManager"))
        {
            homeController = "ClinicManager";
            homeAction = "Dashboard";
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
</head>

<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- Authenticated User - Sidebar Layout -->
        <div id="wrapper">
            <!-- ── Sidebar ──────────────────────────────────────────────────── -->
            <nav id="sidebar">
                <div class="sidebar-header">
                    <i class="bi bi-heart-pulse-fill sidebar-icon"></i>
                    <div class="sidebar-title">GentleCare</div>
                    <small class="sidebar-subtitle">Healthcare System</small>
                </div>

                <ul class="nav flex-column">
                    @if (User.IsInRole("Patient"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                               asp-controller="Patient" asp-action="Dashboard">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" && ViewContext.RouteData.Values["action"]?.ToString() == "BookAppointment" ? "active" : "")"
                               asp-controller="Patient" asp-action="BookAppointment">
                                <i class="bi bi-calendar-plus"></i> Book Appointment
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" && ViewContext.RouteData.Values["action"]?.ToString() == "Appointments" ? "active" : "")"
                               asp-controller="Patient" asp-action="Appointments">
                                <i class="bi bi-calendar-check"></i> Appointments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" && ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active" : "")"
                               asp-controller="Patient" asp-action="History">
                                <i class="bi bi-clock-history"></i> History
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" && ViewContext.RouteData.Values["action"]?.ToString() == "Notifications" ? "active" : "")"
                               asp-controller="Patient" asp-action="Notifications">
                                <i class="bi bi-bell"></i> Notifications
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" && ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")"
                               asp-controller="Patient" asp-action="Profile">
                                <i class="bi bi-person-circle"></i> Profile
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Doctor"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctor" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                               asp-controller="Doctor" asp-action="Dashboard">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DoctorAppointment" && ViewContext.RouteData.Values["action"]?.ToString() == "Appointments" ? "active" : "")"
                               asp-controller="DoctorAppointment" asp-action="Appointments">
                                <i class="bi bi-calendar-check"></i> Appointments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctor" && ViewContext.RouteData.Values["action"]?.ToString() == "Schedule" ? "active" : "")"
                               asp-controller="Doctor" asp-action="Schedule">
                                <i class="bi bi-calendar2-week"></i> Schedule
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Prescription" && ViewContext.RouteData.Values["action"]?.ToString() == "Prescriptions" ? "active" : "")"
                               asp-controller="Prescription" asp-action="Prescriptions">
                                <i class="bi bi-capsule"></i> Prescriptions
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctor" && ViewContext.RouteData.Values["action"]?.ToString() == "Notifications" ? "active" : "")"
                               asp-controller="Doctor" asp-action="Notifications">
                                <i class="bi bi-bell"></i> Notifications
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doctor" && ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")"
                               asp-controller="Doctor" asp-action="Profile">
                                <i class="bi bi-person-circle"></i> Profile
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Receptionist"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Receptionist" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Receptionist" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Receptionist" && ViewContext.RouteData.Values["action"]?.ToString() == "BookAppointment" ? "active" : "")"
                               asp-controller="Receptionist" asp-action="BookAppointment">
                                <i class="bi bi-calendar-plus"></i> Book Appointment
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Receptionist" && ViewContext.RouteData.Values["action"]?.ToString() == "Appointments" ? "active" : "")"
                               asp-controller="Receptionist" asp-action="Appointments">
                                <i class="bi bi-calendar-check"></i> Appointments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Receptionist" && ViewContext.RouteData.Values["action"]?.ToString() == "PatientSearch" ? "active" : "")"
                               asp-controller="Receptionist" asp-action="PatientSearch">
                                <i class="bi bi-search"></i> Patient Search
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Receptionist" && ViewContext.RouteData.Values["action"]?.ToString() == "LiveQueue" ? "active" : "")"
                               asp-controller="Receptionist" asp-action="LiveQueue">
                                <i class="bi bi-queue-front"></i> Live Queue
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("ClinicManager"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClinicManager" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                               asp-controller="ClinicManager" asp-action="Dashboard">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClinicManager" && ViewContext.RouteData.Values["action"]?.ToString() == "Doctors" ? "active" : "")"
                               asp-controller="ClinicManager" asp-action="Doctors">
                                <i class="bi bi-person-badge"></i> Doctors
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClinicManager" && ViewContext.RouteData.Values["action"]?.ToString() == "Appointments" ? "active" : "")"
                               asp-controller="ClinicManager" asp-action="Appointments">
                                <i class="bi bi-calendar-check"></i> Appointments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClinicManager" && ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")"
                               asp-controller="ClinicManager" asp-action="Reports">
                                <i class="bi bi-bar-chart"></i> Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClinicManager" && ViewContext.RouteData.Values["action"]?.ToString() == "UserAccounts" ? "active" : "")"
                               asp-controller="ClinicManager" asp-action="UserAccounts">
                                <i class="bi bi-people"></i> Accounts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClinicManager" && ViewContext.RouteData.Values["action"]?.ToString() == "CreateAnnouncement" ? "active" : "")"
                               asp-controller="ClinicManager" asp-action="CreateAnnouncement">
                                <i class="bi bi-megaphone"></i> Announcements
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClinicManager" && ViewContext.RouteData.Values["action"]?.ToString() == "Notifications" ? "active" : "")"
                               asp-controller="ClinicManager" asp-action="Notifications">
                                <i class="bi bi-bell"></i> Notifications
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClinicManager" && ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")"
                               asp-controller="ClinicManager" asp-action="Profile">
                                <i class="bi bi-person-circle"></i> Profile
                            </a>
                        </li>
                    }
                </ul>

                <div class="sidebar-footer">
                    <small class="user-info"><i class="bi bi-person-circle me-1"></i>@User.Identity?.Name</small>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout">
                            <i class="bi bi-box-arrow-left me-1"></i> Logout
                        </button>
                    </form>
                </div>
            </nav>

            <!-- ── Main Content ─────────────────────────────────────────────── -->
            <div class="main-content">
                <div class="content-area">
                    <partial name="_AlertMessages" />
                    @RenderBody()
                </div>
                <footer class="layout-footer">
                    &copy; @DateTime.Now.Year - GentleCare
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Unauthenticated User - Simple Layout -->
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>