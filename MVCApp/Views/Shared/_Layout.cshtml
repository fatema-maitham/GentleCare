@{
    var pageTitle = ViewData["Title"] as string ?? "GentleCare";

    var homeController = "Public";
    var homeAction = "Lookup";

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Patient"))
        {
            homeController = "Patient";
            homeAction = "Dashboard";
        }
        else if (User.IsInRole("Receptionist"))
        {
            homeController = "Receptionist";
            homeAction = "Index";
        }
        else if (User.IsInRole("Doctor"))
        {
            homeController = "Doctor";
            homeAction = "Dashboard";
        }
        else if (User.IsInRole("ClinicManager"))
        {
            homeController = "ClinicManager";
            homeAction = "Dashboard";
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - GentleCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --main: #637fa3;
            --accent: #71999f;
            --bg: #f5f8fa;
            --card: #ffffff;
            --text: #182333;
            --muted: #6b7a87;
            --border: #dce5e8;
            --soft: #f8fbfc;
            --shadow: 0 8px 20px rgba(99, 127, 163, 0.10);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
            background: var(--bg);
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            color: var(--text);
        }

        a {
            text-decoration: none;
        }

        .main-navbar {
            background: var(--main);
            min-height: 72px;
            box-shadow: 0 6px 18px rgba(99, 127, 163, 0.18);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .main-navbar-inner {
            max-width: 1180px;
            margin: 0 auto;
            min-height: 72px;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 28px;
        }

        .text-logo {
            color: #ffffff;
            display: flex;
            align-items: center;
        }

        .text-logo-name {
            color: #ffffff;
            font-size: 29px;
            font-weight: 900;
            letter-spacing: -1px;
        }

        .nav-links,
        .navbar-links,
        .custom-navbar-links {
            display: flex;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
        }

            .nav-links a,
            .navbar-links a,
            .custom-navbar-links a,
            .main-navbar a:not(.text-logo) {
                color: #ffffff;
                font-size: 14px;
                font-weight: 800;
                opacity: 0.9;
            }

                .nav-links a:hover,
                .navbar-links a:hover,
                .custom-navbar-links a:hover,
                .main-navbar a:not(.text-logo):hover {
                    color: #ffffff;
                    opacity: 1;
                }

        .logout-btn,
        .logout-link,
        a[href*="Logout"] {
            background: #ffffff;
            color: var(--main) !important;
            padding: 9px 16px;
            border-radius: 999px;
            font-weight: 900 !important;
            opacity: 1 !important;
        }

        .layout-main {
            max-width: 1180px;
            margin: 28px auto 0;
            padding: 0 22px 56px;
        }

        .layout-footer {
            max-width: 1180px;
            margin: 0 auto;
            padding: 18px 22px 28px;
            color: var(--muted);
            font-size: 13px;
            text-align: center;
        }

        .alert {
            padding: 12px 14px;
            border-radius: 12px;
            margin-bottom: 16px;
            font-weight: 800;
        }

        .alert-success {
            background: rgba(113, 153, 159, 0.16);
            color: var(--main);
        }

        .alert-danger {
            background: rgba(99, 127, 163, 0.14);
            color: var(--main);
        }

        .text-danger {
            color: #b42318 !important;
            font-size: 13px;
            font-weight: 700;
        }

        @@media (max-width: 960px) {
            .main-navbar {
                position: relative;
            }

            .main-navbar-inner {
                flex-direction: column;
                align-items: flex-start;
                padding-top: 14px;
                padding-bottom: 14px;
                gap: 12px;
            }

            .text-logo-name {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>
    <header class="main-navbar">
        <div class="main-navbar-inner">

            <a asp-controller="@homeController" asp-action="@homeAction" class="text-logo">
                <span class="text-logo-name">GentleCare</span>
            </a>

            <partial name="_Navbar" />

        </div>
    </header>

    <div class="layout-main">
        <main role="main">
            <partial name="_AlertMessages" />
            @RenderBody()
        </main>
    </div>

    <footer class="layout-footer">
        &copy; @DateTime.Now.Year - GentleCare MVC Application
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>