@{
    var pageTitle = ViewData["Title"] as string ?? "GentleCare";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - GentleCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            margin: 0;
            background: #eef4ff;
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            color: #111827;
        }

        .gentlecare-navbar {
            background: linear-gradient(90deg, #0b2a6f, #0b4fb3, #008cf0);
            box-shadow: 0 8px 24px rgba(11, 42, 111, 0.20);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .gentlecare-nav-inner {
            max-width: 1180px;
            margin: 0 auto;
            min-height: 72px;
            padding: 0 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
        }

        .gentlecare-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #ffffff;
            flex-shrink: 0;
        }

        .gentlecare-logo-mark {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: #ffffff;
            color: #0b4fb3;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            font-weight: 900;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
            transition: transform 0.25s ease;
        }

        .gentlecare-brand:hover .gentlecare-logo-mark {
            transform: rotate(-6deg) scale(1.06);
        }

        .gentlecare-brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.05;
        }

            .gentlecare-brand-text strong {
                color: #ffffff;
                font-size: 25px;
                font-weight: 900;
                letter-spacing: -0.5px;
            }

            .gentlecare-brand-text span {
                color: #dbeafe;
                font-size: 12px;
                font-weight: 600;
                margin-top: 4px;
            }

        .main-wrapper {
            max-width: 1180px;
            margin: 28px auto 0;
            padding: 0 22px 55px;
        }

        .app-footer {
            max-width: 1180px;
            margin: 0 auto;
            padding: 18px 22px 26px;
            color: #475569;
            font-size: 13px;
        }

        @@media (max-width: 900px) {
            .gentlecare-nav-inner {
                flex-direction: column;
                align-items: flex-start;
                padding-top: 14px;
                padding-bottom: 14px;
            }
        }
    </style>
</head>

<body>
    <header class="gentlecare-navbar">
        <div class="gentlecare-nav-inner">
            <a asp-controller="Dashboard" asp-action="Index" class="gentlecare-brand">
                <div class="gentlecare-logo-mark">♡</div>

                <div class="gentlecare-brand-text">
                    <strong>GentleCare</strong>
                    <span>Clinic Appointment System</span>
                </div>
            </a>

            <partial name="_Navbar" />
        </div>
    </header>

    <div class="main-wrapper">
        <main role="main">
            <partial name="_AlertMessages" />
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        &copy; @DateTime.Now.Year - GentleCare MVC Application
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>