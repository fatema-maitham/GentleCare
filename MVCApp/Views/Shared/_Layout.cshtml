@{
    var pageTitle = ViewData["Title"] as string ?? "GentleCare";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - GentleCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            margin: 0;
            background: #eef4ff;
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            color: #111827;
        }

        .app-header {
            background: #eef4ff;
            padding-top: 22px;
        }

        .app-brand-area {
            max-width: 1120px;
            margin: 0 auto;
            padding: 0 20px 14px;
        }

        .app-brand {
            margin: 0;
            color: #0b2a6f;
            font-size: 34px;
            font-weight: 800;
            letter-spacing: -0.8px;
        }

        .app-subtitle {
            margin: 4px 0 0;
            color: #475569;
            font-size: 14px;
            font-weight: 500;
        }

        .custom-navbar {
            background: #0b2a6f;
            box-shadow: 0 8px 22px rgba(11, 42, 111, 0.18);
        }

            .custom-navbar .nav-inner {
                max-width: 1120px;
                margin: 0 auto;
                padding: 0 20px;
                min-height: 58px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                flex-wrap: wrap;
            }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

            .nav-links a,
            .nav-link-button {
                color: #dbeafe;
                text-decoration: none;
                padding: 9px 12px;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 700;
                transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
            }

                .nav-links a:hover,
                .nav-link-button:hover {
                    background: rgba(255, 255, 255, 0.14);
                    color: #ffffff;
                    transform: translateY(-2px);
                }

                .nav-links a.active {
                    background: #ffffff;
                    color: #0b2a6f;
                }

        .logout-form {
            display: inline;
            margin: 0;
            padding: 0;
        }

        .nav-link-button {
            background: transparent;
            border: none;
            cursor: pointer;
            font-family: inherit;
        }

        .nav-user {
            color: #e6efff;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

        .main-wrapper {
            max-width: 1120px;
            margin: 26px auto 0;
            padding: 0 20px 55px;
        }

        .page-card {
            min-height: 560px;
        }

        .app-footer {
            max-width: 1120px;
            margin: 0 auto;
            padding: 18px 20px 24px;
            color: #475569;
            font-size: 13px;
        }

        @@media (max-width: 768px) {
            .custom-navbar .nav-inner {
                align-items: flex-start;
                padding-top: 12px;
                padding-bottom: 12px;
            }

            .nav-user {
                width: 100%;
            }

            .app-brand {
                font-size: 29px;
            }
        }
    </style>
</head>

<body>
    <header class="app-header">
        <div class="app-brand-area">
            <h1 class="app-brand">GentleCare</h1>
            <p class="app-subtitle">Healthcare Clinic Appointment &amp; Resource System</p>
        </div>

        <partial name="_Navbar" />
    </header>

    <div class="main-wrapper">
        <main role="main" class="page-card">
            <partial name="_AlertMessages" />
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        &copy; @DateTime.Now.Year - GentleCare MVC Application
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>