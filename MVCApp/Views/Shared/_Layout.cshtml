@{
    var pageTitle = ViewData["Title"] as string ?? "GentleCare";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - GentleCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --gc-blue: #0088FF;
            --gc-bg: #EEF6FF;
            --gc-text: #111827;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
            background: var(--gc-bg);
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            color: var(--gc-text);
        }

        .main-navbar {
            background: #0088FF !important;
            background-image: none !important;
            min-height: 76px;
            box-shadow: 0 6px 18px rgba(0, 136, 255, 0.18);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .main-navbar-inner {
            max-width: 1180px;
            margin: 0 auto;
            min-height: 76px;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 28px;
        }

        .text-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #ffffff;
            flex-shrink: 0;
        }

        .text-logo-mark {
            width: 38px;
            height: 38px;
            border: 2px solid #ffffff;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
            font-weight: 900;
            line-height: 1;
        }

        .text-logo-name {
            font-size: 27px;
            font-weight: 900;
            letter-spacing: -0.7px;
            color: #ffffff;
        }

        .layout-main {
            max-width: 1180px;
            margin: 30px auto 0;
            padding: 0 22px 56px;
        }

        .layout-footer {
            max-width: 1180px;
            margin: 0 auto;
            padding: 18px 22px 28px;
            color: #475569;
            font-size: 13px;
        }

        @@media (max-width: 960px) {
            .main-navbar {
                position: relative;
            }

            .main-navbar-inner {
                flex-direction: column;
                align-items: flex-start;
                padding-top: 14px;
                padding-bottom: 14px;
                gap: 12px;
            }

            .text-logo-name {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>
    <header class="main-navbar">
        <div class="main-navbar-inner">

            <a asp-controller="Dashboard" asp-action="Index" class="text-logo">
                <span class="text-logo-mark">♡</span>
                <span class="text-logo-name">GentleCare</span>
            </a>

            <partial name="_Navbar" />

        </div>
    </header>

    <div class="layout-main">
        <main role="main">
            <partial name="_AlertMessages" />
            @RenderBody()
        </main>
    </div>

    <footer class="layout-footer">
        &copy; @DateTime.Now.Year - GentleCare MVC Application
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>