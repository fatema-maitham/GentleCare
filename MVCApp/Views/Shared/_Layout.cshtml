@{
    var pageTitle = ViewData["Title"] as string ?? "GentleCare";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - GentleCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --gc-primary: #637fa3;
            --gc-secondary: #71999f;
            --gc-bg: #f3f7f8;
            --gc-card: #ffffff;
            --gc-text: #172433;
            --gc-muted: #667782;
            --gc-border: #d9e4e8;
            --gc-soft: #f7fafb;
            --gc-soft-primary: rgba(99, 127, 163, 0.12);
            --gc-soft-secondary: rgba(113, 153, 159, 0.14);
            --gc-shadow: 0 10px 24px rgba(99, 127, 163, 0.12);
            --gc-shadow-strong: 0 22px 42px rgba(99, 127, 163, 0.32);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
            background: var(--gc-bg);
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            color: var(--gc-text);
        }

        a {
            text-decoration: none;
        }

        /* =========================
           navbar
           ========================= */

        .main-navbar {
            background: linear-gradient(135deg, var(--gc-primary), var(--gc-secondary)) !important;
            min-height: 74px;
            box-shadow: 0 8px 22px rgba(99, 127, 163, 0.22);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .main-navbar-inner {
            max-width: 1180px;
            margin: 0 auto;
            min-height: 74px;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 28px;
        }

        .text-logo {
            color: #ffffff;
            flex-shrink: 0;
            display: flex;
            align-items: center;
        }

        .text-logo-name {
            font-size: 30px;
            font-weight: 900;
            letter-spacing: -1.1px;
            color: #ffffff;
            line-height: 1;
        }

        .nav-links,
        .navbar-links,
        .custom-navbar-links {
            display: flex;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
        }

            .nav-links a,
            .navbar-links a,
            .custom-navbar-links a,
            .main-navbar a:not(.text-logo) {
                color: #ffffff;
                font-size: 14px;
                font-weight: 800;
                text-decoration: none;
                position: relative;
                opacity: 0.92;
            }

                .nav-links a:hover,
                .navbar-links a:hover,
                .custom-navbar-links a:hover,
                .main-navbar a:not(.text-logo):hover {
                    opacity: 1;
                    color: #ffffff;
                }

                .nav-links a::after,
                .navbar-links a::after,
                .custom-navbar-links a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: -7px;
                    width: 0;
                    height: 3px;
                    background: #ffffff;
                    border-radius: 999px;
                    transition: width 0.2s ease;
                }

                .nav-links a:hover::after,
                .navbar-links a:hover::after,
                .custom-navbar-links a:hover::after {
                    width: 100%;
                }

        .logout-btn,
        .logout-link,
        a[href*="Logout"] {
            background: #ffffff;
            color: var(--gc-primary) !important;
            padding: 9px 16px;
            border-radius: 999px;
            font-weight: 900 !important;
            opacity: 1 !important;
            box-shadow: 0 8px 18px rgba(255, 255, 255, 0.18);
        }

            .logout-btn:hover,
            .logout-link:hover,
            a[href*="Logout"]:hover {
                background: #f7fafb;
                color: var(--gc-secondary) !important;
            }

        /* =========================
           layout
           ========================= */

        .layout-main {
            max-width: 1180px;
            margin: 28px auto 0;
            padding: 0 22px 56px;
        }

        .layout-footer {
            max-width: 1180px;
            margin: 0 auto;
            padding: 18px 22px 28px;
            color: var(--gc-muted);
            font-size: 13px;
        }

        /* =========================
           page header
           ========================= */

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
        }

            .page-header h1 {
                margin: 0;
                font-size: 32px;
                font-weight: 900;
                color: var(--gc-text);
                letter-spacing: -0.4px;
            }

            .page-header p {
                margin: 6px 0 0;
                color: var(--gc-muted);
            }

        .header-actions,
        .form-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        /* =========================
           buttons and links
           ========================= */

        .primary-btn,
        .secondary-btn,
        .cm-main-btn {
            display: inline-block;
            border: none;
            border-radius: 999px;
            padding: 10px 18px;
            text-decoration: none;
            font-weight: 900;
            cursor: pointer;
            transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
        }

        .primary-btn,
        .cm-main-btn {
            background: var(--gc-primary);
            color: #ffffff;
            box-shadow: 0 8px 18px rgba(99, 127, 163, 0.24);
        }

            .primary-btn:hover,
            .cm-main-btn:hover {
                background: var(--gc-secondary);
                color: #ffffff;
                transform: translateY(-2px);
            }

        .secondary-btn {
            background: var(--gc-soft-secondary);
            color: var(--gc-primary);
        }

            .secondary-btn:hover {
                background: var(--gc-soft-primary);
                color: var(--gc-secondary);
                transform: translateY(-2px);
            }

        .btn-link,
        .table-link,
        .clean-link {
            color: var(--gc-primary);
            font-weight: 800;
            text-decoration: none;
            margin-right: 8px;
        }

            .btn-link:hover,
            .table-link:hover,
            .clean-link:hover {
                color: var(--gc-secondary);
                text-decoration: underline;
            }

        .danger-button {
            border: none;
            background: transparent;
            color: var(--gc-primary);
            cursor: pointer;
            padding: 0;
            font: inherit;
            font-weight: 800;
        }

            .danger-button:hover {
                color: var(--gc-secondary);
            }

        /* =========================
           general cards and sections
           ========================= */

        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 16px;
            margin-bottom: 22px;
        }

        .dashboard-card,
        .section-card {
            background: var(--gc-card);
            border: 1px solid var(--gc-border);
            border-radius: 18px;
            padding: 22px;
            box-shadow: var(--gc-shadow);
        }

            .dashboard-card h2 {
                margin: 6px 0;
                font-size: 34px;
                font-weight: 900;
                color: var(--gc-text);
            }

            .dashboard-card p {
                margin: 0;
                color: var(--gc-muted);
            }

        .card-label {
            display: block;
            font-size: 14px;
            font-weight: 800;
            color: var(--gc-muted);
        }

        .warning-card,
        .danger-card {
            border-left: 6px solid var(--gc-secondary);
        }

        .section-card {
            margin-bottom: 24px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
        }

            .section-header h2 {
                margin: 0;
                font-size: 24px;
                font-weight: 900;
                color: var(--gc-text);
            }

        .status-grid,
        .details-grid,
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 14px;
        }

        .status-box,
        .details-item {
            background: var(--gc-soft);
            border: 1px solid var(--gc-border);
            border-radius: 14px;
            padding: 15px;
        }

            .status-box span,
            .details-item span {
                display: block;
                color: var(--gc-muted);
                font-size: 14px;
                font-weight: 800;
            }

            .status-box strong,
            .details-item strong {
                display: block;
                margin-top: 5px;
                font-size: 21px;
                font-weight: 900;
                color: var(--gc-text);
            }

        /* =========================
           clinic manager dashboard
           ========================= */

        .cm-dashboard {
            max-width: 1180px;
            margin: 0 auto;
        }

        .cm-page-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 20px;
        }

            .cm-page-title h1 {
                margin: 0;
                font-size: 28px;
                font-weight: 900;
                letter-spacing: -0.5px;
                color: var(--gc-text);
            }

            .cm-page-title p {
                margin: 6px 0 0;
                color: var(--gc-muted);
                font-size: 14px;
            }

        .cm-stats-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 14px;
            margin-bottom: 18px;
        }

        /* professional animated cards - no circle */
        .cm-stat-card {
            min-height: 105px;
            border-radius: 20px;
            padding: 18px 18px;
            color: #ffffff;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, var(--gc-primary), var(--gc-secondary));
            box-shadow: 0 12px 26px rgba(99, 127, 163, 0.22);
            transition: transform 0.28s ease, box-shadow 0.28s ease, filter 0.28s ease;
        }

            .cm-stat-card::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient( 120deg, rgba(255, 255, 255, 0.28), transparent 38%, transparent 62%, rgba(255, 255, 255, 0.18) );
                transform: translateX(-120%);
                transition: transform 0.55s ease;
            }

            .cm-stat-card:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: var(--gc-shadow-strong);
                filter: brightness(1.04);
            }

                .cm-stat-card:hover::before {
                    transform: translateX(120%);
                }

            .cm-stat-card div {
                position: relative;
                z-index: 2;
            }

            .cm-stat-card span {
                display: block;
                font-size: 13px;
                font-weight: 800;
                opacity: 0.95;
                margin-bottom: 10px;
                letter-spacing: 0.2px;
            }

            .cm-stat-card h2 {
                margin: 0;
                font-size: 38px;
                font-weight: 900;
                line-height: 1;
                letter-spacing: -0.8px;
            }

            .cm-stat-card:hover h2 {
                animation: cardNumberPop 0.35s ease;
            }

        @@keyframes cardNumberPop {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.12);
            }

            100% {
                transform: scale(1);
            }
        }

        .card-blue {
            background: linear-gradient(135deg, #637fa3, #71999f);
        }

        .card-green {
            background: linear-gradient(135deg, #71999f, #637fa3);
        }

        .card-purple {
            background: linear-gradient(135deg, #637fa3, #71999f);
        }

        .card-orange {
            background: linear-gradient(135deg, #71999f, #637fa3);
        }

        .card-red {
            background: linear-gradient(135deg, #637fa3, #71999f);
        }

        .cm-dashboard-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.75fr);
            gap: 18px;
            align-items: start;
        }

        .cm-left-area,
        .cm-right-area {
            display: grid;
            gap: 18px;
        }

        .cm-panel {
            background: white;
            border: 1px solid var(--gc-border);
            border-radius: 18px;
            padding: 18px;
            box-shadow: var(--gc-shadow);
        }

        .cm-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

            .cm-panel-header h2 {
                margin: 0;
                font-size: 19px;
                font-weight: 900;
                color: var(--gc-text);
            }

            .cm-panel-header a,
            .cm-table a,
            .cm-workload-item a {
                color: var(--gc-primary);
                font-weight: 900;
                text-decoration: none;
                font-size: 13px;
            }

                .cm-panel-header a:hover,
                .cm-table a:hover,
                .cm-workload-item a:hover {
                    color: var(--gc-secondary);
                    text-decoration: underline;
                }

        .cm-status-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

            .cm-status-grid div {
                background: var(--gc-soft);
                border: 1px solid var(--gc-border);
                border-radius: 14px;
                padding: 14px;
                transition: transform 0.18s ease, border-color 0.18s ease;
            }

                .cm-status-grid div:hover {
                    transform: translateY(-3px);
                    border-color: var(--gc-secondary);
                }

            .cm-status-grid span {
                display: block;
                color: var(--gc-muted);
                font-size: 12px;
                font-weight: 900;
                margin-bottom: 6px;
            }

            .cm-status-grid strong {
                display: block;
                color: var(--gc-text);
                font-size: 24px;
                font-weight: 900;
            }

        .cm-table-wrap {
            overflow-x: auto;
        }

        .cm-table {
            width: 100%;
            border-collapse: collapse;
        }

            .cm-table th,
            .cm-table td {
                padding: 12px 10px;
                border-bottom: 1px solid var(--gc-border);
                font-size: 13px;
                vertical-align: middle;
            }

            .cm-table th {
                color: var(--gc-text);
                font-weight: 900;
                background: var(--gc-soft);
            }

        .cm-pill,
        .status-pill,
        .clean-pill {
            display: inline-block;
            border-radius: 999px;
            padding: 6px 11px;
            background: var(--gc-soft-secondary);
            color: var(--gc-primary);
            font-size: 13px;
            font-weight: 900;
        }

        .cm-calendar-card {
            text-align: center;
        }

        .cm-calendar-date {
            background: linear-gradient(135deg, var(--gc-primary), var(--gc-secondary));
            color: white;
            border-radius: 18px;
            padding: 22px;
            margin-bottom: 14px;
            box-shadow: 0 12px 26px rgba(99, 127, 163, 0.20);
        }

            .cm-calendar-date span {
                display: block;
                font-weight: 800;
                font-size: 14px;
                opacity: 0.95;
            }

            .cm-calendar-date strong {
                display: block;
                font-size: 56px;
                font-weight: 900;
                line-height: 1;
                margin: 8px 0;
            }

            .cm-calendar-date p {
                margin: 0;
                font-weight: 700;
                opacity: 0.95;
            }

        .cm-calendar-info {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

            .cm-calendar-info div {
                background: var(--gc-soft);
                border: 1px solid var(--gc-border);
                border-radius: 14px;
                padding: 12px;
            }

            .cm-calendar-info span {
                display: block;
                color: var(--gc-muted);
                font-size: 11px;
                font-weight: 900;
                margin-bottom: 4px;
            }

            .cm-calendar-info strong {
                font-size: 22px;
                font-weight: 900;
            }

        .cm-workload-list {
            display: grid;
            gap: 10px;
        }

        .cm-workload-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            background: var(--gc-soft);
            border: 1px solid var(--gc-border);
            border-radius: 14px;
            padding: 13px;
            transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
        }

            .cm-workload-item:hover {
                transform: translateY(-3px);
                border-color: var(--gc-secondary);
                box-shadow: 0 10px 20px rgba(99, 127, 163, 0.12);
            }

            .cm-workload-item h3 {
                margin: 0;
                font-size: 15px;
                font-weight: 900;
            }

            .cm-workload-item p {
                margin: 4px 0 0;
                color: var(--gc-muted);
                font-size: 12px;
            }

        .cm-empty {
            margin: 0;
            color: var(--gc-muted);
            font-weight: 700;
            font-size: 14px;
        }

        /* =========================
           tables
           ========================= */

        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        .data-table,
        .clean-table {
            width: 100%;
            border-collapse: collapse;
        }

            .data-table th,
            .data-table td,
            .clean-table th,
            .clean-table td {
                padding: 13px 12px;
                border-bottom: 1px solid var(--gc-border);
                text-align: left;
                vertical-align: middle;
            }

            .data-table th,
            .clean-table th {
                background: var(--gc-soft);
                font-weight: 900;
                color: var(--gc-text);
            }

        .status-active {
            background: rgba(113, 153, 159, 0.18);
            color: var(--gc-primary);
        }

        .status-inactive {
            background: rgba(99, 127, 163, 0.12);
            color: var(--gc-primary);
        }

        /* =========================
           forms
           ========================= */

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 14px;
        }

            .form-group label {
                font-weight: 900;
                color: var(--gc-text);
            }

            .form-group input,
            .form-group select,
            .form-group textarea {
                width: 100%;
                padding: 11px 12px;
                border-radius: 12px;
                border: 1px solid #cbd5e1;
                outline: none;
                background: #ffffff;
            }

                .form-group input:focus,
                .form-group select:focus,
                .form-group textarea:focus {
                    border-color: var(--gc-secondary);
                    box-shadow: 0 0 0 3px rgba(113, 153, 159, 0.18);
                }

        .filter-form {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 14px;
            align-items: end;
        }

        .checkbox-row {
            flex-direction: row;
            align-items: center;
        }

        .checkbox-list {
            display: grid;
            gap: 10px;
        }

        .checkbox-item {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            background: var(--gc-soft);
            border: 1px solid var(--gc-border);
            padding: 12px;
            border-radius: 12px;
        }

            .checkbox-item small {
                display: block;
                color: var(--gc-muted);
                margin-top: 3px;
            }

        /* =========================
           text / alerts
           ========================= */

        .empty-text,
        .muted-text {
            color: var(--gc-muted);
        }

        .alert {
            padding: 12px 14px;
            border-radius: 12px;
            margin-bottom: 16px;
            font-weight: 800;
        }

        .alert-success {
            background: rgba(113, 153, 159, 0.18);
            color: var(--gc-primary);
        }

        .alert-danger {
            background: rgba(99, 127, 163, 0.12);
            color: var(--gc-primary);
        }

        .text-danger {
            color: var(--gc-primary) !important;
            font-size: 13px;
            font-weight: 700;
        }

        /* =========================
           doctor cards / lists
           ========================= */

        .doctor-grid,
        .quick-actions,
        .workload-list,
        .leave-list {
            display: grid;
            gap: 16px;
        }

        .doctor-card,
        .workload-item,
        .leave-item,
        .action-card {
            background: #ffffff;
            border: 1px solid var(--gc-border);
            border-radius: 18px;
            padding: 20px;
            box-shadow: var(--gc-shadow);
            transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
        }

            .doctor-card:hover,
            .workload-item:hover,
            .leave-item:hover,
            .action-card:hover {
                transform: translateY(-3px);
                border-color: var(--gc-secondary);
                box-shadow: 0 14px 28px rgba(99, 127, 163, 0.16);
            }

        .doctor-card-header,
        .workload-item,
        .leave-item {
            display: flex;
            justify-content: space-between;
            gap: 12px;
        }

            .doctor-card-header h3,
            .workload-item h3,
            .leave-item h3 {
                margin: 0;
                font-weight: 900;
            }

            .doctor-card-header p,
            .workload-item p,
            .leave-item p {
                margin: 5px 0 0;
                color: var(--gc-muted);
            }

        .doctor-info p {
            margin: 6px 0;
        }

        .doctor-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin: 14px 0;
        }

            .doctor-stats div {
                background: var(--gc-soft);
                border-radius: 12px;
                padding: 12px;
                text-align: center;
                border: 1px solid var(--gc-border);
            }

            .doctor-stats strong {
                display: block;
                font-size: 22px;
            }

            .doctor-stats span {
                color: var(--gc-muted);
                font-size: 13px;
            }

        .doctor-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            border-top: 1px solid var(--gc-border);
            padding-top: 14px;
        }

        .doctor-status-row {
            margin-bottom: 12px;
        }

        .leave-badge {
            display: inline-block;
            border-radius: 999px;
            padding: 6px 11px;
            font-size: 13px;
            font-weight: 900;
        }

            .leave-badge.warning,
            .leave-badge.available {
                background: var(--gc-soft-secondary);
                color: var(--gc-primary);
            }

        .tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .tag-pill {
            background: var(--gc-soft-secondary);
            color: var(--gc-primary);
            padding: 8px 13px;
            border-radius: 999px;
            font-weight: 900;
        }

        .profile-note {
            margin-top: 14px;
            background: var(--gc-soft);
            border: 1px solid var(--gc-border);
            padding: 14px;
            border-radius: 12px;
        }

            .profile-note span {
                display: block;
                font-weight: 900;
                color: var(--gc-muted);
                margin-bottom: 5px;
            }

            .profile-note p {
                margin: 0;
            }

        hr {
            border: none;
            border-top: 1px solid var(--gc-border);
            margin: 22px 0;
            opacity: 1;
        }

        /* =========================
           responsive
           ========================= */

        @@media (max-width: 1050px) {
            .cm-stats-row {
                grid-template-columns: repeat(3, 1fr);
            }

            .cm-dashboard-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 960px) {
            .main-navbar {
                position: relative;
            }

            .main-navbar-inner {
                flex-direction: column;
                align-items: flex-start;
                padding-top: 14px;
                padding-bottom: 14px;
                gap: 12px;
            }

            .text-logo-name {
                font-size: 26px;
            }

            .page-header,
            .section-header,
            .cm-page-title,
            .cm-panel-header,
            .doctor-card-header,
            .workload-item,
            .leave-item {
                flex-direction: column;
                align-items: flex-start;
            }

                .page-header h1 {
                    font-size: 26px;
                }
        }

        @@media (max-width: 650px) {
            .cm-stats-row {
                grid-template-columns: 1fr;
            }

            .cm-status-grid {
                grid-template-columns: 1fr 1fr;
            }

            .cm-calendar-info {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <header class="main-navbar">
        <div class="main-navbar-inner">

            <a asp-controller="ClinicManager" asp-action="Dashboard" class="text-logo">
                <span class="text-logo-name">GentleCare</span>
            </a>

            <partial name="_Navbar" />

        </div>
    </header>

    <div class="layout-main">
        <main role="main">
            <partial name="_AlertMessages" />
            @RenderBody()
        </main>
    </div>

    <footer class="layout-footer">
        &copy; @DateTime.Now.Year - GentleCare MVC Application
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>