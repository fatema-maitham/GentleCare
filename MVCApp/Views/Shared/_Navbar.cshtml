@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string IsActive(string controller, string action)
    {
        return currentController == controller && currentAction == action ? "active" : "";
    }
}

<nav class="custom-navbar">
    <div class="nav-inner">

        <div class="nav-links">
            @if (User?.Identity != null && User.Identity.IsAuthenticated)
            {
                if (User.IsInRole("Patient"))
                {
            <a asp-controller="Patient" asp-action="Dashboard" class="@IsActive("Patient", "Dashboard")">Patient Dashboard</a>
            <a asp-controller="Appointment" asp-action="Book" class="@IsActive("Appointment", "Book")">Book Appointment</a>
            <a asp-controller="Appointment" asp-action="List" class="@IsActive("Appointment", "List")">My Appointments</a>
            <a asp-controller="Patient" asp-action="History" class="@IsActive("Patient", "History")">History</a>
            <a asp-controller="Patient" asp-action="Profile" class="@IsActive("Patient", "Profile")">Profile</a>
                }

                if (User.IsInRole("Doctor"))
                {
            <a asp-controller="Doctor" asp-action="Dashboard" class="@IsActive("Doctor", "Dashboard")">Doctor Dashboard</a>
            <a asp-controller="Doctor" asp-action="Appointments" class="@IsActive("Doctor", "Appointments")">My Appointments</a>
            <a asp-controller="Doctor" asp-action="Schedule" class="@IsActive("Doctor", "Schedule")">Schedule</a>
            <a asp-controller="Doctor" asp-action="Prescriptions" class="@IsActive("Doctor", "Prescriptions")">Prescriptions</a>
            <a asp-controller="Doctor" asp-action="Notifications" class="@IsActive("Doctor", "Notifications")">Notifications</a>
            <a asp-controller="Doctor" asp-action="Profile" class="@IsActive("Doctor", "Profile")">Doctor Profile</a>
                }

                if (User.IsInRole("Receptionist"))
                {
            <a asp-controller="Receptionist" asp-action="Index" class="@IsActive("Receptionist", "Index")">Receptionist Dashboard</a>
            <a asp-controller="Receptionist" asp-action="BookAppointment" class="@IsActive("Receptionist", "BookAppointment")">Book Appointment</a>
            <a asp-controller="Receptionist" asp-action="Appointments" class="@IsActive("Receptionist", "Appointments")">Appointments</a>
                }

                if (User.IsInRole("ClinicManager"))
                {
            <a asp-controller="ClinicManager" asp-action="Dashboard" class="@IsActive("ClinicManager", "Dashboard")">Manager Dashboard</a>
            <a asp-controller="ClinicManager" asp-action="Doctors" class="@IsActive("ClinicManager", "Doctors")">Manage Doctors</a>
            <a asp-controller="ClinicManager" asp-action="Appointments" class="@IsActive("ClinicManager", "Appointments")">Appointments</a>
            <a asp-controller="ClinicManager" asp-action="ManageSpecializations" class="@IsActive("ClinicManager", "ManageSpecializations")">Specializations</a>
                }

            <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link-button">Logout</button>
            </form>
            }
            else
            {
            <a asp-controller="Public" asp-action="Lookup" class="@IsActive("Public", "Lookup")">Public Lookup</a>
            <a asp-controller="Account" asp-action="Login" class="@IsActive("Account", "Login")">Login</a>
            <a asp-controller="Account" asp-action="Register" class="@IsActive("Account", "Register")">Register</a>
            }
        </div>

        <div class="nav-user">
            @if (User?.Identity != null && User.Identity.IsAuthenticated)
            {
            <span>Hello, @User.Identity.Name</span>
            }
            else
            {
            <span>Guest User</span>
            }
        </div>

    </div>
</nav>