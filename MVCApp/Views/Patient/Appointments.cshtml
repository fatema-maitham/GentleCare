@model List<MVCApp.ViewModels.Patient.PatientAppointmentsViewModel>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="patient-page">
    <div class="patient-appointments-page">
        <div class="manager-card">
            <div class="card-head">
                <h2>My Appointments</h2>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="manager-alert manager-alert-success">@TempData["SuccessMessage"]</div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="manager-alert manager-alert-danger">@TempData["ErrorMessage"]</div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="empty-box">
                No appointments found
            </div>
        }
        else
        {
            <div class="appointment-list">
                @foreach (var item in Model)
                {
                    var displayStatus = item.Status switch
                    {
                        "CheckedIn" => "Checked In",
                        "InProgress" => "In Progress",
                        _ => item.Status
                    };

                    var statusClass = item.Status switch
                    {
                        "Requested" => "status-requested",
                        "Confirmed" => "status-confirmed",
                        "CheckedIn" => "status-checked",
                        "InProgress" => "status-progress",
                        "Completed" => "status-completed",
                        "Cancelled" => "status-cancelled",
                        "Missed" => "status-missed",
                        _ => "status-default"
                    };

                    <div class="patient-appointment-card">
                        <div class="appointment-top">
                            <div>
                                <span class="appointment-date">@item.AppointmentDate.ToString("dd MMM yyyy")</span>
                                <h3>Dr. @item.DoctorName</h3>
                            </div>
                            <span class="status-pill @statusClass">@displayStatus</span>
                        </div>

                        <div class="appointment-meta">
                            <div class="meta-item">
                                <span>Start Time</span>
                                <strong>@item.StartTime</strong>
                            </div>

                            <div class="meta-item">
                                <span>End Time</span>
                                <strong>@item.EndTime</strong>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Notes) && item.Notes.Trim() != ".")
                        {
                            <div class="notes-box">
                                <span>Notes</span>
                                <p>@item.Notes</p>
                            </div>
                        }

                        @if (item.CanCancel)
                        {
                            <div class="appointment-actions">
                                <form asp-controller="Patient"
                                      asp-action="CancelAppointment"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="appointmentId"
                                           value="@item.AppointmentId" />

                                    <button type="submit" class="btn-danger">
                                        Cancel
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>