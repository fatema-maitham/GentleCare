@model List<MVCApp.ViewModels.Patient.PatientNotificationViewModel>

@{
    ViewData["Title"] = "Notifications";
}

<div class="patient-page">
    <div class="patient-notifications-page">
        <div class="manager-card">
            <div class="card-head">
                <div>
                    <h2>Notifications</h2>
                    <span class="muted">View your appointment and clinic updates.</span>
                </div>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-box">
                No notifications yet
            </div>
        }
        else
        {
            <div class="patient-notification-list">
                @foreach (var item in Model)
                {
                    <div class="patient-notification-item @(item.IsRead ? "read" : "unread")">
                        <div class="notification-content">
                            <h3>@item.Title</h3>
                            <p>@item.Message</p>
                            <span class="notification-time">@item.CreatedAt.ToString("dd MMM yyyy - HH:mm")</span>
                        </div>

                        @if (!item.IsRead)
                        {
                            <span class="unread-pill">New</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>