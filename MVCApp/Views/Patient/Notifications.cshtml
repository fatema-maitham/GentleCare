@model List<MVCApp.ViewModels.Patient.PatientNotificationViewModel>

@{
    ViewData["Title"] = "Notifications";
}

<section class="notifications-page">
    <div class="notifications-card">

        <div class="page-header-custom">
            <h1>Notifications</h1>
            <p>View your appointment and clinic updates.</p>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-box">
                <h3>No notifications yet</h3>
                <p>Your clinic updates will appear here.</p>
            </div>
        }
        else
        {
            <div class="notification-list">
                @foreach (var item in Model)
                {
                    <div class="notification-item @(item.IsRead ? "read" : "unread")">
                        <div>
                            <h2>@item.Title</h2>
                            <p>@item.Message</p>
                            <span>@item.CreatedAt.ToString("dd MMM yyyy - HH:mm")</span>
                        </div>

                        @if (!item.IsRead)
                        {
                            <strong class="unread-pill">New</strong>
                        }
                    </div>
                }
            </div>
        }

    </div>
</section>

<style>
    .notifications-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 32px 10px 70px;
    }

    .notifications-card {
        background: white;
        border-radius: 32px;
        padding: 42px;
        box-shadow: 0 18px 45px rgba(99,127,163,0.12);
    }

    .page-header-custom {
        margin-bottom: 26px;
    }

        .page-header-custom h1 {
            margin: 0;
            font-size: 38px;
            font-weight: 900;
            color: #182333;
        }

        .page-header-custom p {
            color: #6b7a87;
            margin: 10px 0 0;
            font-size: 16px;
        }

    .notification-list {
        display: grid;
        gap: 14px;
    }

    .notification-item {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        background: #f5f8fa;
        border-radius: 22px;
        padding: 20px;
        border: 1px solid #e5edf2;
    }

        .notification-item.unread {
            background: #eef6f8;
            border-color: #cfe0e5;
        }

        .notification-item h2 {
            margin: 0 0 8px;
            font-size: 20px;
            font-weight: 900;
            color: #182333;
        }

        .notification-item p {
            margin: 0 0 10px;
            color: #526273;
            line-height: 1.5;
        }

        .notification-item span {
            color: #6b7a87;
            font-weight: 700;
            font-size: 14px;
        }

    .unread-pill {
        align-self: flex-start;
        background: #ffe0a3;
        color: #74500f;
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 13px;
        white-space: nowrap;
    }

    .empty-box {
        background: #f5f8fa;
        border-radius: 22px;
        padding: 24px;
    }

        .empty-box h3 {
            margin: 0 0 8px;
            font-weight: 900;
            color: #182333;
        }

        .empty-box p {
            margin: 0;
            color: #6b7a87;
        }

    @@media (max-width: 700px) {
        .notifications-card {
            padding: 30px 22px;
        }

        .notification-item {
            display: block;
        }

        .unread-pill {
            display: inline-block;
            margin-top: 12px;
        }
    }
</style>