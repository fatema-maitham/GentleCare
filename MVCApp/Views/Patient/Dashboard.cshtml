@model MVCApp.ViewModels.Patient.PatientDashboardViewModel

@{
    ViewData["Title"] = "Patient Dashboard";
}

<div class="patient-page">
    <div class="patient-dashboard-page">
        <div class="manager-card">
            <div class="card-head">
                <div>
                    <h2>Welcome back, @Model.FullName</h2>
                    <span class="muted">Here is a quick overview of your appointments and visit history.</span>
                </div>
            </div>
        </div>

        <div class="dashboard-stats">
            <div class="dashboard-stat">
                <strong>@Model.TotalAppointmentsCount</strong>
                <span>Total Appointments</span>
            </div>

            <div class="dashboard-stat">
                <strong>@Model.UpcomingAppointmentsCount</strong>
                <span>Upcoming</span>
            </div>

            <div class="dashboard-stat">
                <strong>@Model.CompletedVisitsCount</strong>
                <span>Completed Visits</span>
            </div>

            <div class="dashboard-stat">
                <strong>@Model.UnreadNotificationsCount</strong>
                <span>Notifications</span>
            </div>
        </div>

        <div class="patient-panel-grid">
            <div class="manager-card">
                <div class="card-head">
                    <div>
                        <h2>Next Appointment</h2>
                    </div>
                    <a asp-controller="Patient" asp-action="Appointments" class="btn-light">View all</a>
                </div>

                @if (Model.NextAppointment == null)
                {
                    <div class="empty-box">
                        No upcoming appointment scheduled yet.
                        <a asp-controller="Patient" asp-action="BookAppointment" class="btn-main" style="display: inline-block; margin-top: 12px; padding: 10px 14px; font-size: 13px;">
                            Book Now
                        </a>
                    </div>
                }
                else
                {
                    <div class="info-box">
                        <span>@Model.NextAppointment.AppointmentDate.ToString("dd MMM yyyy")</span>
                        <h3>Dr. @Model.NextAppointment.DoctorName</h3>
                        <p style="color: var(--gc-text); font-weight: 650; margin: 6px 0 0;">@Model.NextAppointment.StartTime - @Model.NextAppointment.EndTime</p>
                    </div>
                }
            </div>

            <div class="manager-card">
                <div class="card-head">
                    <div>
                        <h2>Latest Visit</h2>
                    </div>
                    <a asp-controller="Patient" asp-action="History" class="btn-light">View all</a>
                </div>

                @if (Model.LatestVisit == null)
                {
                    <div class="empty-box">
                        No completed visits yet. Your visit records will appear here.
                    </div>
                }
                else
                {
                    <div class="info-box">
                        <span>@Model.LatestVisit.AppointmentDate.ToString("dd MMM yyyy")</span>
                        <h3>Dr. @Model.LatestVisit.DoctorName</h3>
                        <p><strong>Diagnosis:</strong> @Model.LatestVisit.Diagnosis</p>
                        <p><strong>Treatment:</strong> @(string.IsNullOrWhiteSpace(Model.LatestVisit.Treatment) ? "Not provided" : Model.LatestVisit.Treatment)</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>