@model MVCApp.ViewModels.Patient.PatientEditProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";

    var profileImage = string.IsNullOrWhiteSpace(Model.CurrentProfilePicture)
        ? "/images/default-patient.png"
        : Model.CurrentProfilePicture;
}

<section class="edit-profile-page">
    <div class="edit-card">

        <div class="edit-header">
            <div>
                <h1>Edit Profile</h1>
                <p>Update your profile photo and contact information.</p>
            </div>

            <a asp-controller="Patient"
               asp-action="Profile"
               class="gc-btn-light">
                Back to Profile
            </a>
        </div>

        <form asp-controller="Patient"
              asp-action="EditProfile"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="photo-section">

                <div class="profile-top">

                    <div class="avatar-upload">

                        <img src="@profileImage"
                             class="edit-avatar"
                             alt="Patient profile image" />

                        <label asp-for="ProfileImageFile" class="upload-icon">
                            📷
                        </label>

                        <input asp-for="ProfileImageFile"
                               type="file"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="hidden-file-input" />
                    </div>

                    <div class="profile-basic-info">
                        <h2>@Model.FullName</h2>
                        <p>@Model.Email</p>
                    </div>

                </div>

            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" />
                    <span asp-validation-for="FullName"></span>
                </div>

                <div class="form-group readonly-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" readonly />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="form-group readonly-field">
                    <label asp-for="CPRNumber"></label>
                    <input asp-for="CPRNumber" readonly />
                </div>

                <div class="form-group readonly-field">
                    <label asp-for="ReferenceNumber"></label>
                    <input asp-for="ReferenceNumber" readonly />
                </div>

                <div class="form-group readonly-field">
                    <label asp-for="DateOfBirth"></label>
                    <input asp-for="DateOfBirth"
                           type="date"
                           readonly />
                </div>

                <div class="form-group">
                    <label asp-for="BloodType"></label>
                    <input asp-for="BloodType"
                           placeholder="Example: O+" />
                    <span asp-validation-for="BloodType"></span>
                </div>

                <div class="form-group wide">
                    <label asp-for="Address"></label>
                    <input asp-for="Address"
                           placeholder="Enter your address" />
                    <span asp-validation-for="Address"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EmergencyContactName"></label>
                    <input asp-for="EmergencyContactName"
                           placeholder="Emergency contact name" />
                    <span asp-validation-for="EmergencyContactName"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EmergencyContactPhone"></label>
                    <input asp-for="EmergencyContactPhone"
                           placeholder="Emergency contact phone" />
                    <span asp-validation-for="EmergencyContactPhone"></span>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="gc-btn-primary">
                    Save Changes
                </button>

                <a asp-controller="Patient"
                   asp-action="Profile"
                   class="gc-btn-outline">
                    Cancel
                </a>
            </div>

        </form>

    </div>
</section>

<style>

    .edit-profile-page {
        max-width: 980px;
        margin: 0 auto;
        padding: 32px 10px 70px;
    }

    .edit-card {
        background: white;
        border-radius: 32px;
        padding: 42px;
        box-shadow: 0 18px 45px rgba(99,127,163,0.12);
    }

    .edit-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 28px;
    }

        .edit-header h1 {
            margin: 0;
            font-size: 38px;
            font-weight: 900;
            color: #182333;
        }

        .edit-header p {
            color: #6b7a87;
            margin: 10px 0 0;
            font-size: 16px;
        }

    .photo-section {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        background: #f5f8fa;
        border-radius: 24px;
        padding: 26px;
        margin-bottom: 28px;
    }

    .profile-top {
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .avatar-upload {
        position: relative;
        width: 120px;
        height: 120px;
        min-width: 120px;
        overflow: hidden !important;
    }

    .edit-avatar {
        width: 120px !important;
        height: 120px !important;
        min-width: 120px !important;
        max-width: 120px !important;
        min-height: 120px !important;
        max-height: 120px !important;
        border-radius: 50% !important;
        object-fit: cover !important;
        display: block !important;
        overflow: hidden !important;
    }

    .upload-icon {
        position: absolute;
        right: 2px;
        bottom: 2px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #637fa3;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 16px;
        transition: 0.2s ease;
    }

        .upload-icon:hover {
            transform: translateY(-2px);
            background: #4f6b8f;
        }

    .hidden-file-input {
        display: none;
    }

    .profile-basic-info h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 900;
        color: #182333;
    }

    .profile-basic-info p {
        margin: 4px 0 0;
        color: #637fa3;
        font-size: 20px;
        font-weight: 700;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-top: 28px;
    }

    .form-group {
        display: grid;
        gap: 8px;
    }

        .form-group.wide {
            grid-column: 1 / -1;
        }

        .form-group label {
            color: #526273;
            font-weight: 800;
            font-size: 15px;
        }

        .form-group input {
            width: 100%;
            border: 1px solid #dce5e8;
            border-radius: 16px;
            padding: 14px 16px;
            font-size: 15px;
            color: #182333;
            outline: none;
            background: white;
        }

            .form-group input:focus {
                border-color: #637fa3;
                box-shadow: 0 0 0 3px rgba(99,127,163,0.12);
            }

    .readonly-field input {
        background: #f5f8fa;
        color: #6b7a87;
        cursor: not-allowed;
    }

    .form-group span,
    .validation-summary {
        color: #b91c1c;
        font-weight: 700;
        font-size: 14px;
    }

    .validation-summary {
        margin-bottom: 18px;
    }

    .form-actions {
        margin-top: 28px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .gc-btn-primary,
    .gc-btn-outline,
    .gc-btn-light {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 999px;
        padding: 12px 22px;
        font-weight: 900;
        text-decoration: none;
        transition: 0.2s ease;
        border: none;
        cursor: pointer;
        font-size: 15px;
    }

    .gc-btn-primary {
        background: #637fa3;
        color: white;
    }

    .gc-btn-outline,
    .gc-btn-light {
        background: white;
        color: #637fa3;
        border: 1px solid #dce5e8;
    }

    .gc-btn-light {
        background: #f5f8fa;
    }

        .gc-btn-primary:hover,
        .gc-btn-outline:hover,
        .gc-btn-light:hover {
            transform: translateY(-3px);
            color: #182333;
        }

    @@media (max-width: 800px) {

        .edit-profile-page {
            padding: 30px 18px 60px;
        }

        .edit-card {
            padding: 30px 22px;
        }

        .edit-header {
            display: block;
        }

        .gc-btn-light {
            margin-top: 18px;
        }

        .profile-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .edit-header h1 {
            font-size: 34px;
        }
    }

</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}