@model MVCApp.ViewModels.Patient.PatientProfileViewModel

@{
    ViewData["Title"] = "Patient Profile";

    var profileImage = string.IsNullOrWhiteSpace(Model.ProfilePicture)
        ? "/images/default-patient.png"
        : Model.ProfilePicture;
}

<section class="patient-profile-page">
    <div class="profile-card">

        <div class="profile-header">
            <div class="profile-top">
                <img src="@profileImage"
                     class="patient-avatar"
                     alt="Patient profile image" />

                <div>
                    <h1>Patient Profile</h1>
                    <p>@Model.Email</p>
                </div>
            </div>

            <a asp-controller="Patient" asp-action="EditProfile" class="gc-btn-light">
                Edit Profile
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-message">@TempData["SuccessMessage"]</div>
        }

        <div class="profile-grid">
            <div class="info-card">
                <h2>Account Information</h2>

                <div class="info-row">
                    <span>Full Name</span>
                    <strong>@Model.FullName</strong>
                </div>

                <div class="info-row">
                    <span>Email</span>
                    <strong>@Model.Email</strong>
                </div>

                <div class="info-row">
                    <span>CPR Number</span>
                    <strong>@Model.CPRNumber</strong>
                </div>

                <div class="info-row">
                    <span>Reference Number</span>
                    <strong>@Model.ReferenceNumber</strong>
                </div>
            </div>

            <div class="info-card">
                <h2>Medical & Contact Details</h2>

                <div class="info-row">
                    <span>Date of Birth</span>
                    <strong>@Model.DateOfBirth.ToString("dd MMM yyyy")</strong>
                </div>

                <div class="info-row">
                    <span>Blood Type</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.BloodType) ? "Not provided" : Model.BloodType)</strong>
                </div>

                <div class="info-row">
                    <span>Address</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.Address) ? "Not provided" : Model.Address)</strong>
                </div>

                <div class="info-row">
                    <span>Emergency Contact Name</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.EmergencyContactName) ? "Not provided" : Model.EmergencyContactName)</strong>
                </div>

                <div class="info-row">
                    <span>Emergency Contact Phone</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.EmergencyContactPhone) ? "Not provided" : Model.EmergencyContactPhone)</strong>
                </div>
            </div>
        </div>

    </div>
</section>

<style>
    .patient-profile-page {
        max-width: 980px;
        margin: 0 auto;
        padding: 32px 10px 70px;
    }

    .profile-card {
        background: white;
        border-radius: 32px;
        padding: 42px;
        box-shadow: 0 18px 45px rgba(99,127,163,0.12);
    }

    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 22px;
        margin-bottom: 28px;
        background: #f5f8fa;
        border-radius: 26px;
        padding: 24px;
    }

    .profile-top {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .patient-avatar {
        width: 96px !important;
        height: 96px !important;
        min-width: 96px !important;
        max-width: 96px !important;
        min-height: 96px !important;
        max-height: 96px !important;
        border-radius: 50%;
        object-fit: cover;
        display: block;
        background: #eef2f7;
    }

    .profile-header h1 {
        margin: 0;
        font-size: 36px;
        font-weight: 900;
        color: #182333;
    }

    .profile-header p {
        color: #637fa3;
        margin: 6px 0 0;
        font-size: 17px;
        font-weight: 700;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }

    .info-card {
        background: #f5f8fa;
        border-radius: 24px;
        padding: 26px;
    }

        .info-card h2 {
            font-size: 22px;
            font-weight: 900;
            margin: 0 0 20px;
            color: #182333;
        }

    .info-row {
        margin-bottom: 18px;
    }

        .info-row span {
            display: block;
            color: #6b7a87;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .info-row strong {
            display: block;
            color: #182333;
            font-size: 16px;
        }

    .gc-btn-light {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 999px;
        padding: 12px 20px;
        font-weight: 900;
        text-decoration: none;
        transition: 0.2s ease;
        background: white;
        color: #637fa3;
        border: 1px solid #dce5e8;
        white-space: nowrap;
    }

        .gc-btn-light:hover {
            transform: translateY(-3px);
            color: #182333;
        }

    .success-message {
        background: #e8f7ef;
        color: #1d6b42;
        font-weight: 900;
        border-radius: 18px;
        padding: 16px 18px;
        margin-bottom: 20px;
    }

    @@media (max-width: 800px) {
        .patient-profile-page {
            padding: 30px 18px 60px;
        }

        .profile-card {
            padding: 30px 22px;
        }

        .profile-header,
        .profile-grid {
            display: block;
        }

        .profile-top {
            display: block;
        }

        .patient-avatar {
            margin-bottom: 14px;
        }

        .profile-header .gc-btn-light {
            margin-top: 18px;
        }

        .info-card {
            margin-top: 18px;
        }

        .profile-header h1 {
            font-size: 34px;
        }
    }
</style>