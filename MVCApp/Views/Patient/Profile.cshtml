@{
    ViewData["Title"] = "Patient Profile";

    var profileImage = string.IsNullOrWhiteSpace(Model.ProfilePicture)
        ? "/images/default-patient.png"
        : Model.ProfilePicture;
}

<div class="patient-page">
    <div class="patient-profile-page">
        <div class="manager-card">
            <div class="patient-profile-header">
                <div class="patient-profile-top">
                    <img src="@profileImage"
                         class="patient-profile-avatar"
                         alt="Patient profile image" />

                    <div>
                        <h2>@Model.FullName</h2>
                        <p>@Model.Email</p>
                    </div>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="manager-alert manager-alert-success">@TempData["SuccessMessage"]</div>
            }

            <div class="patient-profile-grid">
                <div class="manager-card">
                    <div class="card-head">
                        <h2>Account Information</h2>
                    </div>

                    <div class="patient-info-list">
                        <div class="patient-info-row">
                            <span>Full Name</span>
                            <span class="patient-info-value">@Model.FullName</span>
                        </div>

                        <div class="patient-info-row">
                            <span>Email</span>
                            <span class="patient-info-value">@Model.Email</span>
                        </div>

                        <div class="patient-info-row">
                            <span>CPR Number</span>
                            <span class="patient-info-value">@Model.CPRNumber</span>
                        </div>

                        <div class="patient-info-row">
                            <span>Reference Number</span>
                            <span class="patient-info-value">@Model.ReferenceNumber</span>
                        </div>
                    </div>
                </div>

                <div class="manager-card">
                    <div class="card-head">
                        <h2>Medical & Contact Details</h2>
                    </div>

                    <div class="patient-info-list">
                        <div class="patient-info-row">
                            <span>Date of Birth</span>
                            <span class="patient-info-value">@Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                        </div>

                        <div class="patient-info-row">
                            <span>Blood Type</span>
                            <span class="patient-info-value">@(string.IsNullOrWhiteSpace(Model.BloodType) ? "Not provided" : Model.BloodType)</span>
                        </div>

                        <div class="patient-info-row">
                            <span>Address</span>
                            <span class="patient-info-value">@(string.IsNullOrWhiteSpace(Model.Address) ? "Not provided" : Model.Address)</span>
                        </div>

                        <div class="patient-info-row">
                            <span>Emergency Contact Name</span>
                            <span class="patient-info-value">@(string.IsNullOrWhiteSpace(Model.EmergencyContactName) ? "Not provided" : Model.EmergencyContactName)</span>
                        </div>

                        <div class="patient-info-row">
                            <span>Emergency Contact Phone</span>
                            <span class="patient-info-value">@(string.IsNullOrWhiteSpace(Model.EmergencyContactPhone) ? "Not provided" : Model.EmergencyContactPhone)</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="patient-profile-actions">
                <a asp-controller="Patient" asp-action="EditProfile" class="btn-main">
                    Edit Profile
                </a>
            </div>
        </div>
    </div>
</div>