@model MVCApp.ViewModels.Patient.PatientProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm" style="border-radius: 22px;">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
                    <div>
                        <h2 class="fw-bold mb-1">Patient Profile</h2>
                        <p class="text-muted mb-0">Your personal and medical information.</p>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 bg-light h-100">
                            <h5 class="fw-bold mb-3">Account Information</h5>

                            <div class="mb-3">
                                <label class="form-label text-muted">Full Name</label>
                                <div class="fw-semibold">@Model.FullName</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted">Email</label>
                                <div class="fw-semibold">@Model.Email</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted">CPR Number</label>
                                <div class="fw-semibold">@Model.CPRNumber</div>
                            </div>

                            <div class="mb-0">
                                <label class="form-label text-muted">Reference Number</label>
                                <div class="fw-semibold">@Model.ReferenceNumber</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 rounded-4 bg-light h-100">
                            <h5 class="fw-bold mb-3">Medical & Contact Details</h5>

                            <div class="mb-3">
                                <label class="form-label text-muted">Date of Birth</label>
                                <div class="fw-semibold">@Model.DateOfBirth.ToString("dd MMM yyyy")</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted">Blood Type</label>
                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.BloodType) ? "Not provided" : Model.BloodType)
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted">Address</label>
                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.Address) ? "Not provided" : Model.Address)
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted">Emergency Contact Name</label>
                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.EmergencyContactName) ? "Not provided" : Model.EmergencyContactName)
                                </div>
                            </div>

                            <div class="mb-0">
                                <label class="form-label text-muted">Emergency Contact Phone</label>
                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.EmergencyContactPhone) ? "Not provided" : Model.EmergencyContactPhone)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex flex-wrap gap-2">
                    <a asp-controller="Patient" asp-action="Appointments" class="btn btn-primary">View Appointments</a>
                    <a asp-controller="Patient" asp-action="History" class="btn btn-outline-primary">View Medical History</a>
                </div>
            </div>
        </div>
    </div>
</div>