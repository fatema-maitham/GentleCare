@model List<MVCApp.ViewModels.Patient.PatientHistoryViewModel>

@{
    ViewData["Title"] = "Medical History";
}

<div class="patient-page">
    <div class="patient-history-page">
        <div class="manager-card">
            <div class="card-head">
                <div>
                    <h2>Medical History</h2>
                    <span class="muted">View your completed appointment records.</span>
                </div>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-box">
                No history records yet
            </div>
        }
        else
        {
            <div class="patient-history-list">
                @foreach (var item in Model)
                {
                    <div class="patient-history-card">
                        <div class="history-top">
                            <div>
                                <span class="history-date">@item.AppointmentDate.ToString("dd MMM yyyy")</span>
                                <h3>Dr. @item.DoctorName</h3>
                            </div>

                            <span class="history-id-pill">Appointment #@item.AppointmentId</span>
                        </div>

                        <div class="history-record-grid">
                            <div class="history-record-box">
                                <span>Diagnosis</span>
                                <p>@(string.IsNullOrWhiteSpace(item.Diagnosis) ? "Not provided" : item.Diagnosis)</p>
                            </div>

                            <div class="history-record-box">
                                <span>Treatment</span>
                                <p>@(string.IsNullOrWhiteSpace(item.Treatment) ? "Not provided" : item.Treatment)</p>
                            </div>

                            <div class="history-record-box wide">
                                <span>Doctor Notes</span>
                                <p>@(string.IsNullOrWhiteSpace(item.DoctorNotes) ? "Not provided" : item.DoctorNotes)</p>
                            </div>
                        </div>

                        @if (item.Prescriptions != null && item.Prescriptions.Any())
                        {
                            <div class="history-prescription-section">
                                <h4>Prescriptions</h4>

                                <div class="history-prescription-grid">
                                    @foreach (var prescription in item.Prescriptions)
                                    {
                                        <div class="history-prescription-card">
                                            <h5>@prescription.MedicationName</h5>
                                            <p><strong>Dosage:</strong> @prescription.Dosage</p>
                                            <p><strong>Frequency:</strong> @prescription.Frequency</p>
                                            <p><strong>Duration:</strong> @prescription.DurationDays days</p>
                                            <p>
                                                <strong>Instructions:</strong>
                                                @(string.IsNullOrWhiteSpace(prescription.Instructions) ? "—" : prescription.Instructions)
                                            </p>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>