@model MVCApp.ViewModels.ClinicManager.ClinicManagerDashboardViewModel

@{
    ViewData["Title"] = "Clinic Manager Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Clinic Manager Dashboard</h2>
            <p class="text-muted mb-0">Overview of clinic operations</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="ClinicManager" asp-action="Doctors" class="btn btn-primary">Manage Doctors</a>
            <a asp-controller="ClinicManager" asp-action="Appointments" class="btn btn-outline-primary">View Appointments</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Doctors</h6>
                    <h3 class="mb-0">@Model.TotalDoctors</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Patients</h6>
                    <h3 class="mb-0">@Model.TotalPatients</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Appointments Today</h6>
                    <h3 class="mb-0">@Model.AppointmentsToday</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Requested Appointments</h6>
                    <h3 class="mb-0">@Model.RequestedAppointments</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100 border-start border-warning border-4">
                <div class="card-body">
                    <h6 class="text-muted">Doctors On Leave Today</h6>
                    <h3 class="mb-0">@Model.DoctorsOnLeaveToday</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Quick Actions</h5>
        </div>
        <div class="card-body d-flex flex-wrap gap-2">
            <a asp-controller="ClinicManager" asp-action="Doctors" class="btn btn-outline-primary">Doctors</a>
            <a asp-controller="ClinicManager" asp-action="CreateDoctor" class="btn btn-outline-success">Create Doctor</a>
            <a asp-controller="ClinicManager" asp-action="Appointments" class="btn btn-outline-dark">Appointments</a>
        </div>
    </div>
</div>
