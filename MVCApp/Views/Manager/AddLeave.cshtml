@model MVCApp.ViewModels.ClinicManager.UpsertDoctorLeaveViewModel

@{
    ViewData["Title"] = "Add Leave";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Add Leave</h2>
            <p class="text-muted mb-0">Doctor ID: @Model.DoctorId</p>
        </div>
        <a asp-controller="ClinicManager" asp-action="ManageLeaves" asp-route-doctorId="@Model.DoctorId" class="btn btn-outline-secondary">Back to Leaves</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <input asp-for="DoctorId" type="hidden" />
                <input asp-for="DoctorLeaveId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="LeaveStartDate" class="form-label"></label>
                        <input asp-for="LeaveStartDate" class="form-control" type="date" />
                        <span asp-validation-for="LeaveStartDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeaveEndDate" class="form-label"></label>
                        <input asp-for="LeaveEndDate" class="form-control" type="date" />
                        <span asp-validation-for="LeaveEndDate" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="LeaveReason" class="form-label"></label>
                        <textarea asp-for="LeaveReason" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="LeaveReason" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-controller="ClinicManager" asp-action="ManageLeaves" asp-route-doctorId="@Model.DoctorId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
