@model MVCApp.ViewModels.Doctor.EditDoctorProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";

    var profileImage = string.IsNullOrWhiteSpace(Model.CurrentProfilePicture)
        ? Url.Content("~/images/doctors/default-doctor.png")
        : Url.Content("~/images/doctors/" + System.IO.Path.GetFileName(Model.CurrentProfilePicture) + "?v=" + DateTime.Now.Ticks);
}

<div class="doctor-page">
    <div class="doctor-edit-page">
        <div class="manager-top">
            <a asp-controller="Doctor"
               asp-action="Profile"
               class="btn-light">
                Back to Profile
            </a>
        </div>

        <div class="manager-card">
            <div class="doctor-profile-hero">
                <div class="doctor-avatar-wrap">
                    <img src="@profileImage"
                         id="doctorImagePreview"
                         class="doctor-avatar-img"
                         alt="Doctor profile picture" />

                    <label for="ProfilePictureFile" class="doctor-camera-btn" title="Change picture">
                        <i class="bi bi-camera-fill"></i>
                    </label>
                </div>

                <span asp-validation-for="ProfilePictureFile" class="text-danger small d-block text-center"></span>
            </div>

            <form asp-controller="Doctor"
                  asp-action="EditProfile"
                  method="post"
                  enctype="multipart/form-data"
                  class="manager-form">
                @Html.AntiForgeryToken()

                <input asp-for="DoctorId" type="hidden" />
                <input asp-for="CurrentProfilePicture" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="doctor-form-grid">
                    <div class="form-group">
                        <label asp-for="FullName"></label>
                        <input asp-for="FullName" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-group full">
                        <label asp-for="LicenseNumber"></label>
                        <input asp-for="LicenseNumber" />
                        <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                    </div>

                    <div class="form-group full">
                        <label asp-for="Bio"></label>
                        <textarea asp-for="Bio" rows="4"></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>
                </div>

                <input asp-for="ProfilePictureFile"
                       id="ProfilePictureFile"
                       type="file"
                       class="d-none"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                <div class="doctor-edit-actions">
                    <a asp-controller="Doctor" asp-action="Profile" class="btn-light">
                        Cancel
                    </a>

                    <button type="submit" class="btn-main">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const input = document.getElementById("ProfilePictureFile");
        const preview = document.getElementById("doctorImagePreview");

        if (input && preview) {
            input.addEventListener("change", function () {
                const file = this.files && this.files[0];

                if (!file) return;

                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                };

                reader.readAsDataURL(file);
            });
        }
    </script>
}