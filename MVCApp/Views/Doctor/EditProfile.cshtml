@model MVCApp.ViewModels.Doctor.EditDoctorProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="edit-profile-page">
    <div class="edit-profile-card">

        <div class="edit-profile-header">
            <div>
                <h1>Edit Profile</h1>
                <p>Update your doctor information and profile picture.</p>
            </div>

            <a asp-controller="Doctor" asp-action="Profile" class="back-btn">
                Back to Profile
            </a>
        </div>

        <form asp-controller="Doctor"
              asp-action="EditProfile"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input asp-for="DoctorId" type="hidden" />
            <input asp-for="CurrentProfilePicture" type="hidden" />

            <div class="avatar-section">
                <div class="edit-photo-wrap">
                    <img src="@(string.IsNullOrWhiteSpace(Model.CurrentProfilePicture)
                                                 ? "/images/doctors/default-doctor.png"
                                                 : Model.CurrentProfilePicture)"
                         class="edit-photo"
                         alt="Doctor profile picture" />

                    <label for="ProfilePictureFile" class="edit-camera-btn">
                        <i class="bi bi-camera-fill"></i>
                    </label>
                </div>

                <input asp-for="ProfilePictureFile"
                       id="ProfilePictureFile"
                       type="file"
                       class="d-none"
                       accept=".jpg,.jpeg,.png,.webp" />

                <span asp-validation-for="ProfilePictureFile" class="text-danger small"></span>

                <p class="text-muted small mt-2 mb-0">
                    Click the camera icon to upload a new picture.
                </p>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-group full">
                    <label asp-for="LicenseNumber"></label>
                    <input asp-for="LicenseNumber" class="form-control" />
                    <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                </div>

                <div class="form-group full">
                    <label asp-for="Bio"></label>
                    <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-controller="Doctor" asp-action="Profile" class="cancel-btn">
                    Cancel
                </a>

                <button type="submit" class="save-btn">
                    Save Changes
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}