@model MVCApp.ViewModels.Doctor.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold">Doctor Dashboard</h2>
        <p class="text-muted mb-0">
            Welcome, Dr. @Model.DoctorFullName. Here is your appointment summary for today.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    <!-- Main dashboard summary cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Today's Appointments</h6>
                    <h2 class="fw-bold">@Model.TotalAppointmentsToday</h2>
                    <p class="mb-0 text-muted">Total assigned today</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Remaining Today</h6>
                    <h2 class="fw-bold">@Model.RemainingAppointmentsToday</h2>
                    <p class="mb-0 text-muted">Not completed yet</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Upcoming</h6>
                    <h2 class="fw-bold">@Model.UpcomingAppointmentsCount</h2>
                    <p class="mb-0 text-muted">Future active appointments</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Unread Notifications</h6>
                    <h2 class="fw-bold">@Model.UnreadNotificationsCount</h2>
                    <p class="mb-0 text-muted">Require attention</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Appointment workflow summary for today -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Confirmed</h6>
                    <h3 class="fw-bold">@Model.ConfirmedAppointmentsToday</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Checked In</h6>
                    <h3 class="fw-bold">@Model.CheckedInAppointmentsToday</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">In Progress</h6>
                    <h3 class="fw-bold">@Model.InProgressAppointmentsToday</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Completed</h6>
                    <h3 class="fw-bold">@Model.CompletedAppointmentsToday</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick doctor actions -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Quick Actions</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <a asp-controller="Doctor"
                       asp-action="Appointments"
                       class="btn btn-primary w-100">
                        View Appointments
                    </a>
                </div>

                <div class="col-md-3">
                    <a asp-controller="Doctor"
                       asp-action="Schedule"
                       class="btn btn-outline-primary w-100">
                        View Schedule
                    </a>
                </div>

                <div class="col-md-3">
                    <a asp-controller="Doctor"
                       asp-action="Notifications"
                       class="btn btn-outline-primary w-100">
                        View Notifications
                    </a>
                </div>

                <div class="col-md-3">
                    <a asp-controller="Doctor"
                       asp-action="Profile"
                       class="btn btn-outline-primary w-100">
                        My Profile
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Small profile metric -->
    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h5 class="fw-bold">Patients Seen</h5>
            <p class="mb-0">
                You have completed appointments with
                <strong>@Model.TotalPatientsSeen</strong>
                unique patient(s).
            </p>
        </div>
    </div>
</div>