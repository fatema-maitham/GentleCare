@model MVCApp.ViewModels.Doctor.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="doctor-dashboard">

    <div class="page-title-row mb-4">
        <div>
            <h2 class="fw-bold mb-1">Doctor Dashboard</h2>
            <p class="text-muted mb-0">
                Welcome, Dr. @Model.DoctorFullName. Here is your appointment summary for today.
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="dashboard-stat-card">
                <span class="stat-label">Today's Appointments</span>
                <span class="stat-number">@Model.TotalAppointmentsToday</span>
                <span class="stat-help">Total assigned today</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-stat-card">
                <span class="stat-label">Remaining Today</span>
                <span class="stat-number">@Model.RemainingAppointmentsToday</span>
                <span class="stat-help">Not completed yet</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-stat-card">
                <span class="stat-label">Upcoming</span>
                <span class="stat-number">@Model.UpcomingAppointmentsCount</span>
                <span class="stat-help">Future active appointments</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-stat-card">
                <span class="stat-label">Unread Notifications</span>
                <span class="stat-number">@Model.UnreadNotificationsCount</span>
                <span class="stat-help">Require attention</span>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">Today's Workflow</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="workflow-box">
                        <span class="workflow-label">Confirmed</span>
                        <strong>@Model.ConfirmedAppointmentsToday</strong>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="workflow-box">
                        <span class="workflow-label">Checked In</span>
                        <strong>@Model.CheckedInAppointmentsToday</strong>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="workflow-box">
                        <span class="workflow-label">In Progress</span>
                        <strong>@Model.InProgressAppointmentsToday</strong>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="workflow-box">
                        <span class="workflow-label">Completed</span>
                        <strong>@Model.CompletedAppointmentsToday</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="fw-bold mb-2">Patients Seen</h5>
            <p class="mb-0 text-muted">
                You have completed appointments with
                <strong class="text-dark">@Model.TotalPatientsSeen</strong>
                unique patient(s).
            </p>
        </div>
    </div>

</div>