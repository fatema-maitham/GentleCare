@model MVCApp.ViewModels.Doctor.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<style>
    :root {
        --gc-blue: #0A4D8F;
        --gc-blue-dark: #083B70;
        --gc-nav: #6E88AA;
        --gc-green: #5FAF8F;
        --gc-green-dark: #4C9A7C;
        --gc-green-soft: #E8F5EF;
        --gc-text: #10233F;
        --gc-muted: #66758A;
        --gc-border: #DCE6F2;
        --gc-page: #F4F8FC;
        --gc-white: #FFFFFF;
    }

    body {
        background: var(--gc-page) !important;
        font-family: "Inter", "Segoe UI", Arial, sans-serif !important;
    }

    .doctor-dashboard-page {
        max-width: 1140px;
        margin: 0 auto;
        padding: 10px 0 42px;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

    .dashboard-stat {
        background: var(--gc-white);
        border: 1px solid var(--gc-border);
        border-radius: 18px;
        padding: 22px;
        min-height: 118px;
        box-shadow: 0 10px 26px rgba(10, 77, 143, 0.07);
        position: relative;
        overflow: hidden;
        transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
    }

        .dashboard-stat::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 5px;
            background: var(--gc-green);
        }

        .dashboard-stat:hover {
            transform: translateY(-5px);
            border-color: #B7D9C8;
            box-shadow: 0 16px 34px rgba(10, 77, 143, 0.12);
        }

    .dashboard-number {
        display: block;
        font-size: 40px;
        font-weight: 900;
        line-height: 1;
        color: var(--gc-blue);
        margin-bottom: 12px;
        letter-spacing: -1px;
    }

    .dashboard-stat-title {
        margin: 0;
        font-size: 15px;
        font-weight: 900;
        color: var(--gc-text);
        line-height: 1.35;
    }

    .dashboard-main-grid {
        display: grid;
        grid-template-columns: 410px 1fr;
        gap: 22px;
    }

    .dashboard-card {
        background: var(--gc-white);
        border: 1px solid var(--gc-border);
        border-radius: 20px;
        box-shadow: 0 10px 26px rgba(10, 77, 143, 0.07);
        overflow: hidden;
    }

    .dashboard-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #E8EEF6;
        background: var(--gc-white);
    }

        .dashboard-card-header h4 {
            margin: 0;
            font-size: 19px;
            font-weight: 900;
            color: var(--gc-blue);
            letter-spacing: -0.2px;
        }

        .dashboard-card-header p {
            margin: 6px 0 0;
            font-size: 13px;
            color: var(--gc-muted);
        }

    .calendar-wrap {
        padding-bottom: 18px;
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 22px 12px;
    }

    .calendar-nav {
        text-decoration: none;
        color: var(--gc-blue);
        font-size: 28px;
        font-weight: 900;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }

        .calendar-nav:hover {
            background: var(--gc-green-soft);
            color: var(--gc-green-dark);
            transform: translateY(-1px);
        }

    .calendar-month {
        text-align: center;
    }

        .calendar-month h2 {
            margin: 0;
            font-size: 32px;
            font-weight: 900;
            color: var(--gc-text);
            letter-spacing: 1px;
            line-height: 1;
        }

        .calendar-month small {
            display: block;
            margin-top: 6px;
            font-size: 14px;
            font-weight: 700;
            color: var(--gc-muted);
        }

    .calendar-weekdays,
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 7px;
        padding: 0 20px;
    }

    .calendar-weekdays {
        margin-top: 8px;
        margin-bottom: 8px;
    }

        .calendar-weekdays div {
            text-align: center;
            font-size: 12px;
            font-weight: 900;
            color: var(--gc-text);
            padding: 6px 0;
        }

    .calendar-grid {
        padding-bottom: 18px;
    }

    .calendar-day {
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: var(--gc-text);
        font-size: 14px;
        font-weight: 800;
        border-radius: 12px;
        position: relative;
        transition: background-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }

        .calendar-day:hover {
            background: #F1F8F5;
            color: var(--gc-green-dark);
            transform: translateY(-1px);
        }

        .calendar-day.other-month {
            opacity: 0.32;
        }

    .calendar-day-number {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .calendar-day.selected .calendar-day-number {
        background: var(--gc-blue);
        color: var(--gc-white);
        box-shadow: 0 8px 18px rgba(10, 77, 143, 0.24);
    }

    .calendar-dot {
        position: absolute;
        bottom: 4px;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--gc-green);
    }

    .appointments-list {
        display: flex;
        flex-direction: column;
    }

    .appointment-row {
        display: grid;
        grid-template-columns: 130px 1fr 130px;
        gap: 18px;
        align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid #EDF2F8;
        transition: background-color 0.18s ease;
    }

        .appointment-row:hover {
            background: #FBFDFC;
        }

        .appointment-row:last-child {
            border-bottom: none;
        }

    .appointment-time {
        font-size: 15px;
        font-weight: 900;
        color: var(--gc-blue);
        white-space: nowrap;
    }

    .appointment-main {
        min-width: 0;
    }

    .appointment-top {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

    .appointment-name {
        font-size: 16px;
        font-weight: 900;
        color: var(--gc-text);
    }

    .appointment-status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        background: var(--gc-green-soft);
        color: #2F6E58;
        border: 1px solid #B7D9C8;
        font-size: 12px;
        font-weight: 900;
    }

    .appointment-ref {
        font-size: 13px;
        color: var(--gc-muted);
        margin-bottom: 4px;
    }

    .appointment-note {
        margin: 0;
        font-size: 14px;
        line-height: 1.45;
        color: #41526A;
    }

    .appointment-action {
        text-align: right;
    }

    .appointment-btn {
        display: inline-block;
        text-decoration: none;
        background: var(--gc-green);
        color: var(--gc-white);
        padding: 10px 15px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 900;
        border: none;
        box-shadow: 0 8px 18px rgba(95, 175, 143, 0.22);
        transition: background-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
    }

        .appointment-btn:hover {
            background: var(--gc-green-dark);
            color: var(--gc-white);
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(95, 175, 143, 0.28);
        }

    .empty-day-message {
        margin: 18px 22px 22px;
        padding: 14px 16px;
        border-radius: 12px;
        background: #F7FBFF;
        border: 1px solid #DCE9F7;
        color: var(--gc-muted);
        font-size: 14px;
    }

    @@media (max-width: 980px) {
        .dashboard-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-main-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 760px) {
        .appointment-row {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .appointment-action {
            text-align: left;
        }
    }

    @@media (max-width: 600px) {
        .dashboard-stats {
            grid-template-columns: 1fr;
        }

        .calendar-month h2 {
            font-size: 28px;
        }

        .dashboard-number {
            font-size: 38px;
        }
    }
</style>

<div class="doctor-dashboard-page">

    <div class="dashboard-stats">
        <div class="dashboard-stat">
            <strong class="dashboard-number" data-target="@Model.TotalAppointmentsForSelectedDate">0</strong>
            <p class="dashboard-stat-title">Selected Day Appointments</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number" data-target="@Model.UpcomingAppointmentsCount">0</strong>
            <p class="dashboard-stat-title">Upcoming Appointments</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number" data-target="@Model.UnreadNotificationsCount">0</strong>
            <p class="dashboard-stat-title">Unread Notifications</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number" data-target="@Model.TotalPatientsSeen">0</strong>
            <p class="dashboard-stat-title">Patients Seen</p>
        </div>
    </div>

    <div class="dashboard-main-grid">

        <div class="dashboard-card calendar-wrap">
            <div class="calendar-header">
                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@Model.PreviousMonthDate.ToString("yyyy-MM-dd")"
                   class="calendar-nav">‹</a>

                <div class="calendar-month">
                    <h2>@Model.CalendarMonthLabel</h2>
                    <small>@Model.CalendarYear</small>
                </div>

                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@Model.NextMonthDate.ToString("yyyy-MM-dd")"
                   class="calendar-nav">›</a>
            </div>

            <div class="calendar-weekdays">
                <div>S</div>
                <div>M</div>
                <div>T</div>
                <div>W</div>
                <div>T</div>
                <div>F</div>
                <div>S</div>
            </div>

            <div class="calendar-grid">
                @foreach (var day in Model.CalendarDays)
                {
                    <a asp-controller="Doctor"
                       asp-action="Dashboard"
                       asp-route-selectedDate="@day.Date.ToString("yyyy-MM-dd")"
                       class="calendar-day @(day.IsCurrentMonth ? "" : "other-month") @(day.IsSelected ? "selected" : "")">

                        <span class="calendar-day-number">@day.DayNumber</span>

                        @if (day.HasAppointments)
                        {
                            <span class="calendar-dot"></span>
                        }
                    </a>
                }
            </div>
        </div>

        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <h4>Appointments for Selected Day</h4>
                <p>@Model.SelectedDate.ToString("dddd, dd MMM yyyy")</p>
            </div>

            <div class="appointments-list">
                @if (Model.HasSelectedDayAppointments)
                {
                    foreach (var appointment in Model.SelectedDayAppointments)
                    {
                        <div class="appointment-row">
                            <div class="appointment-time">
                                @appointment.TimeDisplay
                            </div>

                            <div class="appointment-main">
                                <div class="appointment-top">
                                    <span class="appointment-name">@appointment.PatientFullName</span>
                                    <span class="appointment-status">@appointment.StatusName</span>
                                </div>

                                <div class="appointment-ref">
                                    Ref: @appointment.PatientReferenceNumber
                                </div>

                                @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                                {
                                    <p class="appointment-note">@appointment.Notes</p>
                                }
                            </div>

                            <div class="appointment-action">
                                <a asp-controller="DoctorAppointment"
                                   asp-action="AppointmentDetails"
                                   asp-route-id="@appointment.AppointmentId"
                                   class="appointment-btn">
                                    View Details
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-day-message">
                        No appointments are scheduled for this day.
                    </div>
                }
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const counters = document.querySelectorAll(".dashboard-number");

            counters.forEach(counter => {
                const target = parseInt(counter.getAttribute("data-target")) || 0;
                const duration = 900;
                const startTime = performance.now();

                function updateCounter(currentTime) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const currentValue = Math.floor(eased * target);

                    counter.textContent = currentValue.toLocaleString();

                    if (progress < 1) {
                        requestAnimationFrame(updateCounter);
                    } else {
                        counter.textContent = target.toLocaleString();
                    }
                }

                requestAnimationFrame(updateCounter);
            });
        });
    </script>
}
