@model MVCApp.ViewModels.Doctor.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<style>
    body {
        background: #eef4ff !important;
    }

    .doctor-dashboard-page {
        max-width: 1120px;
        margin: 35px auto;
        padding: 0 20px 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .dashboard-header {
        background: #0b2a6f;
        color: white;
        padding: 24px 28px;
        border-radius: 8px;
        box-shadow: 0 6px 18px rgba(11, 42, 111, 0.18);
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

        .dashboard-header small {
            display: block;
            color: #cfe0ff;
            font-weight: 700;
            letter-spacing: 0.8px;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .dashboard-header h2 {
            margin: 0;
            font-size: 30px;
            font-weight: 800;
            color: white;
        }

        .dashboard-header p {
            margin: 6px 0 0;
            color: #e6efff;
        }

    .selected-day-box {
        background: white;
        color: #0b2a6f;
        padding: 10px 16px;
        border-radius: 6px;
        font-weight: 800;
        white-space: nowrap;
    }

    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

    .dashboard-stat {
        background: white;
        border-radius: 8px;
        border: 1px solid #d7e0ec;
        padding: 18px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        border-top: 4px solid #0b2a6f;
    }

        .dashboard-stat span {
            display: block;
            color: #475569;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .dashboard-stat strong {
            display: block;
            color: #111827;
            font-size: 30px;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 8px;
        }

        .dashboard-stat p {
            margin: 0;
            color: #64748b;
            font-size: 14px;
        }

    .dashboard-main-grid {
        display: grid;
        grid-template-columns: 430px 1fr;
        gap: 22px;
        margin-bottom: 22px;
    }

    .dashboard-card {
        background: white;
        border-radius: 8px;
        border: 1px solid #d7e0ec;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .dashboard-card-header {
        background: #f8fbff;
        border-bottom: 1px solid #d7e0ec;
        padding: 16px 18px;
    }

        .dashboard-card-header h4 {
            margin: 0;
            color: #111827;
            font-size: 19px;
            font-weight: 800;
        }

        .dashboard-card-header p {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 14px;
        }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 18px 10px;
    }

    .calendar-nav {
        color: #0b2a6f;
        text-decoration: none;
        font-size: 22px;
        font-weight: 800;
        padding: 4px 8px;
    }

        .calendar-nav:hover {
            color: #123b93;
        }

    .calendar-month {
        text-align: center;
    }

        .calendar-month h3 {
            margin: 0;
            color: #111827;
            font-size: 30px;
            font-weight: 300;
            letter-spacing: 2px;
        }

        .calendar-month small {
            color: #64748b;
            font-weight: 700;
            letter-spacing: 1px;
        }

    .calendar-weekdays,
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        padding: 0 18px 18px;
    }

        .calendar-weekdays div {
            text-align: center;
            color: #111827;
            font-size: 13px;
            font-weight: 800;
            padding-bottom: 6px;
        }

    .calendar-day {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 44px;
        text-decoration: none;
        color: #111827;
        position: relative;
        font-weight: 600;
    }

        .calendar-day:hover {
            color: #0b2a6f;
        }

    .calendar-day-number {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .calendar-day.other-month {
        opacity: 0.28;
    }

    .calendar-day.selected .calendar-day-number {
        background: #0b2a6f;
        color: white;
        font-weight: 800;
    }

    .calendar-dot {
        position: absolute;
        bottom: 6px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #0b2a6f;
    }

    .day-panel-body {
        padding: 18px;
    }

    .appointment-day-item {
        border: 1px solid #e2e8f0;
        border-left: 4px solid #0b2a6f;
        padding: 14px;
        margin-bottom: 12px;
        background: #f8fbff;
    }

        .appointment-day-item:last-child {
            margin-bottom: 0;
        }

    .appointment-time {
        color: #0b2a6f;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .appointment-patient {
        font-size: 16px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 4px;
    }

    .appointment-ref {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .appointment-status {
        display: inline-block;
        background: #eef4ff;
        color: #0b2a6f;
        border-left: 4px solid #0b2a6f;
        padding: 6px 10px;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .appointment-notes {
        color: #475569;
        font-size: 14px;
        margin-bottom: 12px;
    }

    .appointment-details-btn {
        display: inline-block;
        background: #0b2a6f;
        color: white;
        text-decoration: none;
        padding: 8px 12px;
        border-radius: 6px;
        font-weight: 700;
    }

        .appointment-details-btn:hover {
            background: #123b93;
            color: white;
        }

    .empty-day-message {
        color: #64748b;
        font-size: 15px;
    }

    .workflow-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .workflow-item {
        padding: 18px;
        border-right: 1px solid #edf2f7;
    }

        .workflow-item:last-child {
            border-right: none;
        }

        .workflow-item span {
            display: block;
            color: #475569;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .workflow-item strong {
            color: #111827;
            font-size: 26px;
            font-weight: 800;
        }

    @@media (max-width: 950px) {
        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .selected-day-box {
            width: 100%;
            text-align: center;
        }

        .dashboard-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-main-grid {
            grid-template-columns: 1fr;
        }

        .workflow-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .workflow-item {
            border-bottom: 1px solid #edf2f7;
        }
    }

    @@media (max-width: 600px) {
        .dashboard-stats {
            grid-template-columns: 1fr;
        }

        .workflow-grid {
            grid-template-columns: 1fr;
        }

        .workflow-item {
            border-right: none;
            border-bottom: 1px solid #edf2f7;
        }

            .workflow-item:last-child {
                border-bottom: none;
            }
    }
</style>

<div class="doctor-dashboard-page">

    <div class="dashboard-header">
        <div>
            <small>Doctor Dashboard</small>
            <h2>Welcome, Dr. @Model.DoctorFullName</h2>
            <p>Select a day from the calendar to view patients and appointment times.</p>
        </div>

        <div class="selected-day-box">
            @Model.SelectedDate.ToString("dd MMM yyyy")
        </div>
    </div>

    <div class="dashboard-stats">

        <div class="dashboard-stat">
            <span>Selected Day Appointments</span>
            <strong>@Model.TotalAppointmentsForSelectedDate</strong>
            <p>Total appointments on selected day</p>
        </div>

        <div class="dashboard-stat">
            <span>Upcoming</span>
            <strong>@Model.UpcomingAppointmentsCount</strong>
            <p>Future active appointments</p>
        </div>

        <div class="dashboard-stat">
            <span>Unread Notifications</span>
            <strong>@Model.UnreadNotificationsCount</strong>
            <p>Require attention</p>
        </div>

        <div class="dashboard-stat">
            <span>Patients Seen</span>
            <strong>@Model.TotalPatientsSeen</strong>
            <p>Unique completed patient visits</p>
        </div>

    </div>

    <div class="dashboard-main-grid">

        <div class="dashboard-card">
            <div class="calendar-header">
                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@Model.PreviousMonthDate.ToString("yyyy-MM-dd")"
                   class="calendar-nav">
                    ‹
                </a>

                <div class="calendar-month">
                    <h3>@Model.CalendarMonthLabel</h3>
                    <small>@Model.CalendarYear</small>
                </div>

                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@Model.NextMonthDate.ToString("yyyy-MM-dd")"
                   class="calendar-nav">
                    ›
                </a>
            </div>

            <div class="calendar-weekdays">
                <div>S</div>
                <div>M</div>
                <div>T</div>
                <div>W</div>
                <div>T</div>
                <div>F</div>
                <div>S</div>
            </div>

            <div class="calendar-grid">
                @foreach (var day in Model.CalendarDays)
                {
                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@day.Date.ToString("yyyy-MM-dd")"
                   class="calendar-day @(day.IsCurrentMonth ? "" : "other-month") @(day.IsSelected ? "selected" : "")">

                    <span class="calendar-day-number">@day.DayNumber</span>

                    @if (day.HasAppointments)
                        {
                    <span class="calendar-dot"></span>
                        }
                </a>
                }
            </div>
        </div>

        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <h4>Appointments for Selected Day</h4>
                <p>@Model.SelectedDate.ToString("dddd, dd MMM yyyy")</p>
            </div>

            <div class="day-panel-body">
                @if (Model.HasSelectedDayAppointments)
                {
                    foreach (var appointment in Model.SelectedDayAppointments)
                    {
                <div class="appointment-day-item">
                    <div class="appointment-time">@appointment.TimeDisplay</div>

                    <div class="appointment-patient">@appointment.PatientFullName</div>

                    <div class="appointment-ref">
                        Reference No.: @appointment.PatientReferenceNumber
                    </div>

                    <div class="appointment-status">@appointment.StatusName</div>

                    if (!string.IsNullOrWhiteSpace(appointment.Notes))
                    {
                    <div class="appointment-notes">@appointment.Notes</div>
                    }

                    <a asp-controller="Doctor"
                       asp-action="AppointmentDetails"
                       asp-route-id="@appointment.AppointmentId"
                       class="appointment-details-btn">
                        View Details
                    </a>
                </div>
                    }
                }
                else
                {
                <div class="empty-day-message">
                    No appointments are scheduled for this day.
                </div>
                }
            </div>
        </div>

    </div>

    <div class="dashboard-card">
        <div class="dashboard-card-header">
            <h4>Selected Day Workflow</h4>
            <p>Status breakdown for the chosen date</p>
        </div>

        <div class="workflow-grid">
            <div class="workflow-item">
                <span>Confirmed</span>
                <strong>@Model.ConfirmedAppointmentsForSelectedDate</strong>
            </div>

            <div class="workflow-item">
                <span>Checked In</span>
                <strong>@Model.CheckedInAppointmentsForSelectedDate</strong>
            </div>

            <div class="workflow-item">
                <span>In Progress</span>
                <strong>@Model.InProgressAppointmentsForSelectedDate</strong>
            </div>

            <div class="workflow-item">
                <span>Completed</span>
                <strong>@Model.CompletedAppointmentsForSelectedDate</strong>
            </div>
        </div>
    </div>

</div>