@model MVCApp.ViewModels.Doctor.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<style>
    body {
        background: #eef6ff !important;
        font-family: "Inter", "Segoe UI", Arial, sans-serif !important;
    }

    .doctor-dashboard-page {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 0 45px;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

    .dashboard-stat {
        background: #ffffff;
        border: 1px solid #d9e8fb;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 8px 20px rgba(0, 136, 255, 0.08);
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

        .dashboard-stat:hover {
            border-color: #0088FF;
            transform: translateY(-3px);
        }

        .dashboard-stat span {
            display: block;
            color: #475569;
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .dashboard-stat strong {
            display: block;
            color: #0088FF;
            font-size: 34px;
            font-weight: 900;
            line-height: 1;
            margin-bottom: 8px;
        }

        .dashboard-stat p {
            margin: 0;
            color: #64748b;
            font-size: 13px;
            line-height: 1.45;
        }

    .dashboard-main-grid {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 22px;
    }

    .dashboard-card {
        background: #ffffff;
        border: 1px solid #d9e8fb;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 8px 22px rgba(0, 136, 255, 0.08);
    }

    .dashboard-card-header {
        padding: 16px 18px;
        background: #f8fbff;
        border-bottom: 1px solid #d9e8fb;
    }

        .dashboard-card-header h4 {
            margin: 0;
            color: #111827;
            font-size: 19px;
            font-weight: 900;
        }

        .dashboard-card-header p {
            margin: 5px 0 0;
            color: #64748b;
            font-size: 13px;
        }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 18px 10px;
    }

    .calendar-nav {
        color: #0088FF;
        text-decoration: none;
        font-size: 24px;
        font-weight: 900;
        padding: 4px 9px;
        border-radius: 8px;
        transition: background-color 0.18s ease;
    }

        .calendar-nav:hover {
            background: #eef6ff;
        }

    .calendar-month {
        text-align: center;
    }

        .calendar-month h3 {
            margin: 0;
            color: #111827;
            font-size: 31px;
            font-weight: 700;
            letter-spacing: 2px;
            line-height: 1.1;
        }

        .calendar-month small {
            color: #64748b;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1px;
        }

    .calendar-weekdays,
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        padding: 0 18px 18px;
    }

        .calendar-weekdays div {
            text-align: center;
            color: #111827;
            font-size: 12px;
            font-weight: 900;
            padding-bottom: 6px;
        }

    .calendar-day {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 44px;
        text-decoration: none;
        color: #111827;
        position: relative;
        font-size: 13px;
        font-weight: 800;
        border-radius: 10px;
    }

        .calendar-day:hover {
            background: #eef6ff;
        }

    .calendar-day-number {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .calendar-day.other-month {
        opacity: 0.25;
    }

    .calendar-day.selected .calendar-day-number {
        background: #0088FF;
        color: white;
    }

    .calendar-dot {
        position: absolute;
        bottom: 5px;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #0088FF;
    }

    .day-panel-body {
        padding: 0;
    }

    .appointment-row {
        display: grid;
        grid-template-columns: 115px 1fr auto;
        gap: 16px;
        align-items: center;
        padding: 18px;
        border-bottom: 1px solid #edf4ff;
    }

        .appointment-row:last-child {
            border-bottom: none;
        }

    .appointment-time {
        color: #0088FF;
        font-size: 15px;
        font-weight: 900;
        white-space: nowrap;
    }

    .appointment-main {
        min-width: 0;
    }

    .appointment-patient-line {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 5px;
    }

    .appointment-patient {
        color: #111827;
        font-size: 16px;
        font-weight: 900;
    }

    .appointment-status {
        display: inline-block;
        background: #eef6ff;
        color: #0088FF;
        padding: 4px 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 900;
    }

    .appointment-ref {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .appointment-notes {
        color: #475569;
        font-size: 13px;
        line-height: 1.45;
        margin: 0;
    }

    .appointment-details-btn {
        display: inline-block;
        text-decoration: none;
        background: #0088FF;
        color: #ffffff;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 900;
        white-space: nowrap;
        transition: background-color 0.18s ease;
    }

        .appointment-details-btn:hover {
            background: #0077e0;
            color: #ffffff;
        }

    .empty-day-message {
        background: #f8fbff;
        border: 1px solid #d9e8fb;
        color: #64748b;
        border-radius: 10px;
        padding: 14px;
        font-size: 14px;
        margin: 18px;
    }

    @@media (max-width: 950px) {
        .dashboard-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-main-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .appointment-row {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .appointment-details-btn {
            width: fit-content;
        }
    }

    @@media (max-width: 600px) {
        .dashboard-stats {
            grid-template-columns: 1fr;
        }

        .calendar-month h3 {
            font-size: 26px;
        }
    }
</style>

<div class="doctor-dashboard-page">

    <div class="dashboard-stats">
        <div class="dashboard-stat">
            <span>Selected Day Appointments</span>
            <strong>@Model.TotalAppointmentsForSelectedDate</strong>
            <p>Total appointments on selected day</p>
        </div>

        <div class="dashboard-stat">
            <span>Upcoming</span>
            <strong>@Model.UpcomingAppointmentsCount</strong>
            <p>Future active appointments</p>
        </div>

        <div class="dashboard-stat">
            <span>Unread Notifications</span>
            <strong>@Model.UnreadNotificationsCount</strong>
            <p>Require attention</p>
        </div>

        <div class="dashboard-stat">
            <span>Patients Seen</span>
            <strong>@Model.TotalPatientsSeen</strong>
            <p>Unique completed patient visits</p>
        </div>
    </div>

    <div class="dashboard-main-grid">

        <div class="dashboard-card">
            <div class="calendar-header">
                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@Model.PreviousMonthDate.ToString("yyyy-MM-dd")"
                   class="calendar-nav">‹</a>

                <div class="calendar-month">
                    <h3>@Model.CalendarMonthLabel</h3>
                    <small>@Model.CalendarYear</small>
                </div>

                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@Model.NextMonthDate.ToString("yyyy-MM-dd")"
                   class="calendar-nav">›</a>
            </div>

            <div class="calendar-weekdays">
                <div>S</div>
                <div>M</div>
                <div>T</div>
                <div>W</div>
                <div>T</div>
                <div>F</div>
                <div>S</div>
            </div>

            <div class="calendar-grid">
                @foreach (var day in Model.CalendarDays)
                {
                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@day.Date.ToString("yyyy-MM-dd")"
                   class="calendar-day @(day.IsCurrentMonth ? "" : "other-month") @(day.IsSelected ? "selected" : "")">

                    <span class="calendar-day-number">@day.DayNumber</span>

                    @if (day.HasAppointments)
                        {
                    <span class="calendar-dot"></span>
                        }
                </a>
                }
            </div>
        </div>

        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <h4>Appointments for Selected Day</h4>
                <p>@Model.SelectedDate.ToString("dddd, dd MMM yyyy")</p>
            </div>

            <div class="day-panel-body">
                @if (Model.HasSelectedDayAppointments)
                {
                    foreach (var appointment in Model.SelectedDayAppointments)
                    {
                <div class="appointment-row">
                    <div class="appointment-time">
                        @appointment.TimeDisplay
                    </div>

                    <div class="appointment-main">
                        <div class="appointment-patient-line">
                            <span class="appointment-patient">@appointment.PatientFullName</span>
                            <span class="appointment-status">@appointment.StatusName</span>
                        </div>

                        <div class="appointment-ref">
                            Reference No.: @appointment.PatientReferenceNumber
                        </div>

                        @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                                {
                        <p class="appointment-notes">@appointment.Notes</p>
                                }
                    </div>

                    <a asp-controller="Doctor"
                       asp-action="AppointmentDetails"
                       asp-route-id="@appointment.AppointmentId"
                       class="appointment-details-btn">
                        View Details
                    </a>
                </div>
                    }
                }
                else
                {
                <div class="empty-day-message">
                    No appointments are scheduled for this day.
                </div>
                }
            </div>
        </div>

    </div>

</div>