@model MVCApp.ViewModels.Doctor.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<style>
    body {
        background: #eef4fb !important;
        font-family: "Inter", "Segoe UI", Arial, sans-serif !important;
    }

    .doctor-dashboard-page {
        max-width: 1140px;
        margin: 0 auto;
        padding: 8px 0 40px;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .dashboard-stat {
        background: #ffffff;
        border: 1px solid #d7e3f2;
        border-radius: 18px;
        padding: 22px 24px;
        box-shadow: 0 8px 24px rgba(4, 66, 140, 0.06);
        position: relative;
        overflow: hidden;
    }

        .dashboard-stat::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: #faa634;
        }

    .dashboard-number {
        display: block;
        font-size: 44px;
        font-weight: 900;
        line-height: 1;
        color: #04428c;
        margin-bottom: 10px;
        letter-spacing: -1px;
    }

    .dashboard-stat-title {
        font-size: 16px;
        font-weight: 800;
        color: #12233d;
        margin: 0 0 4px 0;
    }

    .dashboard-stat-text {
        font-size: 13px;
        color: #607089;
        margin: 0;
        line-height: 1.4;
    }

    .dashboard-main-grid {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 22px;
    }

    .dashboard-card {
        background: #ffffff;
        border: 1px solid #d7e3f2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(4, 66, 140, 0.06);
        overflow: hidden;
    }

    .dashboard-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #e6eef8;
        background: #fbfdff;
    }

        .dashboard-card-header h3,
        .dashboard-card-header h4 {
            margin: 0;
            font-size: 18px;
            font-weight: 900;
            color: #04428c;
        }

        .dashboard-card-header p {
            margin: 5px 0 0;
            font-size: 13px;
            color: #6b7b92;
        }

    .calendar-wrap {
        padding-bottom: 16px;
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 22px 10px;
    }

    .calendar-nav {
        text-decoration: none;
        color: #04428c;
        font-size: 28px;
        font-weight: 900;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .calendar-nav:hover {
            background: #f2f7fd;
        }

    .calendar-month {
        text-align: center;
    }

        .calendar-month h2 {
            margin: 0;
            font-size: 34px;
            font-weight: 900;
            color: #12233d;
            letter-spacing: 1px;
            line-height: 1;
        }

        .calendar-month small {
            display: block;
            margin-top: 6px;
            font-size: 14px;
            font-weight: 700;
            color: #72839a;
        }

    .calendar-weekdays,
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 7px;
        padding: 0 20px;
    }

    .calendar-weekdays {
        margin-top: 8px;
        margin-bottom: 8px;
    }

        .calendar-weekdays div {
            text-align: center;
            font-size: 12px;
            font-weight: 800;
            color: #12233d;
            padding: 6px 0;
        }

    .calendar-grid {
        padding-bottom: 18px;
    }

    .calendar-day {
        min-height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: #12233d;
        font-size: 14px;
        font-weight: 800;
        border-radius: 12px;
        position: relative;
    }

        .calendar-day:hover {
            background: #f3f8fe;
        }

        .calendar-day.other-month {
            opacity: 0.28;
        }

    .calendar-day-number {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .calendar-day.selected .calendar-day-number {
        background: #04428c;
        color: #ffffff;
    }

    .calendar-dot {
        position: absolute;
        bottom: 4px;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #faa634;
    }

    .appointments-list {
        display: flex;
        flex-direction: column;
    }

    .appointment-row {
        display: grid;
        grid-template-columns: 140px 1fr 130px;
        gap: 18px;
        align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid #edf2f8;
    }

        .appointment-row:last-child {
            border-bottom: none;
        }

    .appointment-time {
        font-size: 15px;
        font-weight: 900;
        color: #04428c;
        white-space: nowrap;
    }

    .appointment-main {
        min-width: 0;
    }

    .appointment-top {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

    .appointment-name {
        font-size: 16px;
        font-weight: 900;
        color: #12233d;
    }

    .appointment-status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        background: #fff3df;
        color: #a56600;
        font-size: 12px;
        font-weight: 900;
    }

    .appointment-ref {
        font-size: 13px;
        color: #6f8098;
        margin-bottom: 4px;
    }

    .appointment-note {
        margin: 0;
        font-size: 14px;
        line-height: 1.45;
        color: #41526a;
    }

    .appointment-action {
        text-align: right;
    }

    .appointment-btn {
        display: inline-block;
        text-decoration: none;
        background: #04428c;
        color: #ffffff;
        padding: 10px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 800;
        border: none;
    }

        .appointment-btn:hover {
            background: #03356f;
            color: #ffffff;
        }

    .empty-day-message {
        margin: 18px 22px 22px;
        padding: 14px 16px;
        border-radius: 12px;
        background: #f7fbff;
        border: 1px solid #dce9f7;
        color: #607089;
        font-size: 14px;
    }

    @@media (max-width: 980px) {
        .dashboard-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-main-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 760px) {
        .appointment-row {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .appointment-action {
            text-align: left;
        }
    }

    @@media (max-width: 600px) {
        .dashboard-stats {
            grid-template-columns: 1fr;
        }

        .calendar-month h2 {
            font-size: 28px;
        }

        .dashboard-number {
            font-size: 38px;
        }
    }
</style>

<div class="doctor-dashboard-page">

    <div class="dashboard-stats">
        <div class="dashboard-stat">
            <strong class="dashboard-number" data-target="@Model.TotalAppointmentsForSelectedDate">0</strong>
            <div class="dashboard-stat-title">Selected Day Appointments</div>
            <p class="dashboard-stat-text">Appointments on the selected date</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number" data-target="10">0</strong>
            <div class="dashboard-stat-title">Upcoming Appointments</div>
            <p class="dashboard-stat-text">Future active appointments</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number" data-target="@Model.UnreadNotificationsCount">0</strong>
            <div class="dashboard-stat-title">Unread Notifications</div>
            <p class="dashboard-stat-text">Notifications that need attention</p>
        </div>

        <div class="dashboard-stat">
            <strong class="dashboard-number" data-target="300">0</strong>
            <div class="dashboard-stat-title">Patients Seen</div>
            <p class="dashboard-stat-text">Completed patient visits</p>
        </div>
    </div>

    <div class="dashboard-main-grid">

        <div class="dashboard-card calendar-wrap">
            <div class="calendar-header">
                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@Model.PreviousMonthDate.ToString("yyyy-MM-dd")"
                   class="calendar-nav">‹</a>

                <div class="calendar-month">
                    <h2>@Model.CalendarMonthLabel</h2>
                    <small>@Model.CalendarYear</small>
                </div>

                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@Model.NextMonthDate.ToString("yyyy-MM-dd")"
                   class="calendar-nav">›</a>
            </div>

            <div class="calendar-weekdays">
                <div>S</div>
                <div>M</div>
                <div>T</div>
                <div>W</div>
                <div>T</div>
                <div>F</div>
                <div>S</div>
            </div>

            <div class="calendar-grid">
                @foreach (var day in Model.CalendarDays)
                {
                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@day.Date.ToString("yyyy-MM-dd")"
                   class="calendar-day @(day.IsCurrentMonth ? "" : "other-month") @(day.IsSelected ? "selected" : "")">

                    <span class="calendar-day-number">@day.DayNumber</span>

                    @if (day.HasAppointments)
                        {
                    <span class="calendar-dot"></span>
                        }
                </a>
                }
            </div>
        </div>

        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <h4>Appointments for Selected Day</h4>
                <p>@Model.SelectedDate.ToString("dddd, dd MMM yyyy")</p>
            </div>

            <div class="appointments-list">
                @if (Model.HasSelectedDayAppointments)
                {
                    foreach (var appointment in Model.SelectedDayAppointments)
                    {
                <div class="appointment-row">
                    <div class="appointment-time">
                        @appointment.TimeDisplay
                    </div>

                    <div class="appointment-main">
                        <div class="appointment-top">
                            <span class="appointment-name">@appointment.PatientFullName</span>
                            <span class="appointment-status">@appointment.StatusName</span>
                        </div>

                        <div class="appointment-ref">
                            Ref: @appointment.PatientReferenceNumber
                        </div>

                        @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                                {
                        <p class="appointment-note">@appointment.Notes</p>
                                }
                    </div>

                    <div class="appointment-action">
                        <a asp-controller="Doctor"
                           asp-action="AppointmentDetails"
                           asp-route-id="@appointment.AppointmentId"
                           class="appointment-btn">
                            View Details
                        </a>
                    </div>
                </div>
                    }
                }
                else
                {
                <div class="empty-day-message">
                    No appointments are scheduled for this day.
                </div>
                }
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const counters = document.querySelectorAll(".dashboard-number");

            counters.forEach(counter => {
                const target = parseInt(counter.getAttribute("data-target")) || 0;
                const duration = 1000;
                const startTime = performance.now();

                function updateCounter(currentTime) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const currentValue = Math.floor(eased * target);

                    counter.textContent = currentValue.toLocaleString();

                    if (progress < 1) {
                        requestAnimationFrame(updateCounter);
                    } else {
                        counter.textContent = target.toLocaleString();
                    }
                }

                requestAnimationFrame(updateCounter);
            });
        });
    </script>
}