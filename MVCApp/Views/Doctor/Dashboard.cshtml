@model MVCApp.ViewModels.Doctor.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Doctor Dashboard</h2>
            <p class="text-muted mb-0">Welcome, Dr. @Model.DoctorFullName</p>
        </div>
        <div>
            <a asp-controller="Doctor" asp-action="Appointments" class="btn btn-primary">
                View My Appointments
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Appointments Today</h6>
                    <h3 class="mb-0">@Model.TotalAppointmentsToday</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Upcoming Appointments</h6>
                    <h3 class="mb-0">@Model.UpcomingAppointmentsCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Unread Notifications</h6>
                    <h3 class="mb-0">@Model.UnreadNotificationsCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Patients Seen</h6>
                    <h3 class="mb-0">@Model.TotalPatientsSeen</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card border-start border-primary border-4 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Confirmed</h6>
                    <h4 class="mb-0">@Model.ConfirmedAppointmentsToday</h4>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-start border-info border-4 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Checked In</h6>
                    <h4 class="mb-0">@Model.CheckedInAppointmentsToday</h4>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-start border-warning border-4 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">In Progress</h6>
                    <h4 class="mb-0">@Model.InProgressAppointmentsToday</h4>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-start border-success border-4 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Completed</h6>
                    <h4 class="mb-0">@Model.CompletedAppointmentsToday</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Quick Actions</h5>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Doctor" asp-action="Appointments" class="btn btn-outline-primary">
                    My Appointments
                </a>

                <a asp-controller="Doctor" asp-action="Notifications" class="btn btn-outline-secondary">
                    Notifications
                </a>

                <a asp-controller="Doctor" asp-action="Profile" class="btn btn-outline-dark">
                    My Profile
                </a>

                <a asp-controller="Doctor" asp-action="Schedule" class="btn btn-outline-success">
                    My Schedule
                </a>
            </div>
        </div>
    </div>
</div>