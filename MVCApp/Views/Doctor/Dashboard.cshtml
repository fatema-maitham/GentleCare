@model MVCApp.ViewModels.Doctor.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

    body {
        background: #eef4ff !important;
        font-family: "Inter", "Segoe UI", Arial, sans-serif !important;
    }

    .doctor-dashboard-page {
        max-width: 1120px;
        margin: 35px auto;
        padding: 0 20px 45px;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .dashboard-header {
        background: linear-gradient(135deg, #0b2a6f, #123b93);
        color: white;
        padding: 26px 30px;
        border-radius: 12px;
        box-shadow: 0 14px 30px rgba(11, 42, 111, 0.22);
        margin-bottom: 22px;
        animation: fadeUp 0.45s ease both;
    }

        .dashboard-header small {
            display: block;
            color: #cfe0ff;
            font-weight: 800;
            letter-spacing: 0.9px;
            margin-bottom: 8px;
            text-transform: uppercase;
            font-size: 12px;
        }

        .dashboard-header h2 {
            margin: 0;
            font-size: 31px;
            font-weight: 800;
            color: white;
            line-height: 1.2;
        }

    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

    .dashboard-stat {
        background: rgba(255, 255, 255, 0.96);
        border-radius: 12px;
        border: 1px solid #d7e0ec;
        padding: 18px;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.07);
        border-top: 4px solid #0b2a6f;
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        animation: fadeUp 0.5s ease both;
    }

        .dashboard-stat:nth-child(1) {
            animation-delay: 0.05s;
        }

        .dashboard-stat:nth-child(2) {
            animation-delay: 0.1s;
        }

        .dashboard-stat:nth-child(3) {
            animation-delay: 0.15s;
        }

        .dashboard-stat:nth-child(4) {
            animation-delay: 0.2s;
        }

        .dashboard-stat:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 28px rgba(15, 23, 42, 0.13);
        }

        .dashboard-stat span {
            display: block;
            color: #475569;
            font-weight: 700;
            margin-bottom: 10px;
            font-size: 13px;
        }

        .dashboard-stat strong {
            display: block;
            color: #111827;
            font-size: 32px;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 8px;
        }

        .dashboard-stat p {
            margin: 0;
            color: #64748b;
            font-size: 13px;
            line-height: 1.45;
        }

    .dashboard-main-grid {
        display: grid;
        grid-template-columns: 430px 1fr;
        gap: 22px;
        margin-bottom: 22px;
    }

    .dashboard-card {
        background: rgba(255, 255, 255, 0.97);
        border-radius: 12px;
        border: 1px solid #d7e0ec;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
        overflow: hidden;
        animation: fadeUp 0.55s ease both;
    }

        .dashboard-card:hover {
            box-shadow: 0 14px 30px rgba(15, 23, 42, 0.1);
        }

    .dashboard-card-header {
        background: #f8fbff;
        border-bottom: 1px solid #d7e0ec;
        padding: 16px 18px;
    }

        .dashboard-card-header h4 {
            margin: 0;
            color: #111827;
            font-size: 19px;
            font-weight: 800;
            line-height: 1.2;
        }

        .dashboard-card-header p {
            margin: 5px 0 0;
            color: #64748b;
            font-size: 13px;
        }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 18px 10px;
    }

    .calendar-nav {
        color: #0b2a6f;
        text-decoration: none;
        font-size: 24px;
        font-weight: 800;
        padding: 4px 9px;
        border-radius: 8px;
        transition: background 0.18s ease, transform 0.18s ease;
    }

        .calendar-nav:hover {
            background: #eef4ff;
            color: #123b93;
            transform: translateY(-1px);
        }

    .calendar-month {
        text-align: center;
    }

        .calendar-month h3 {
            margin: 0;
            color: #111827;
            font-size: 31px;
            font-weight: 500;
            letter-spacing: 2px;
            line-height: 1.1;
        }

        .calendar-month small {
            color: #64748b;
            font-weight: 700;
            letter-spacing: 1px;
            font-size: 13px;
        }

    .calendar-weekdays,
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        padding: 0 18px 18px;
    }

        .calendar-weekdays div {
            text-align: center;
            color: #111827;
            font-size: 12px;
            font-weight: 800;
            padding-bottom: 6px;
        }

    .calendar-day {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 44px;
        text-decoration: none;
        color: #111827;
        position: relative;
        font-weight: 700;
        font-size: 13px;
        border-radius: 10px;
        transition: background 0.18s ease, transform 0.18s ease;
    }

        .calendar-day:hover {
            background: #eef4ff;
            color: #0b2a6f;
            transform: translateY(-1px);
        }

    .calendar-day-number {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .calendar-day.other-month {
        opacity: 0.28;
    }

    .calendar-day.selected .calendar-day-number {
        background: #0b2a6f;
        color: white;
        font-weight: 800;
        box-shadow: 0 6px 14px rgba(11, 42, 111, 0.25);
    }

    .calendar-dot {
        position: absolute;
        bottom: 5px;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #0b2a6f;
    }

    .day-panel-body {
        padding: 18px;
    }

    .appointment-day-item {
        border: 1px solid #dbe4f0;
        border-left: 4px solid #0b2a6f;
        padding: 14px;
        margin-bottom: 12px;
        background: #f8fbff;
        border-radius: 8px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        animation: fadeUp 0.35s ease both;
    }

        .appointment-day-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(15, 23, 42, 0.09);
        }

        .appointment-day-item:last-child {
            margin-bottom: 0;
        }

    .appointment-time {
        color: #0b2a6f;
        font-weight: 800;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .appointment-patient {
        font-size: 16px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 4px;
    }

    .appointment-ref {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 9px;
    }

    .appointment-status {
        display: inline-block;
        background: #eef4ff;
        color: #0b2a6f;
        border-left: 4px solid #0b2a6f;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .appointment-notes {
        color: #475569;
        font-size: 13px;
        margin-bottom: 12px;
        line-height: 1.45;
    }

    .appointment-details-btn {
        display: inline-block;
        background: #0b2a6f;
        color: white;
        text-decoration: none;
        padding: 8px 12px;
        border-radius: 6px;
        font-weight: 800;
        font-size: 13px;
        transition: background 0.18s ease, transform 0.18s ease;
    }

        .appointment-details-btn:hover {
            background: #123b93;
            color: white;
            transform: translateY(-1px);
        }

    .empty-day-message {
        color: #64748b;
        font-size: 14px;
        background: #f8fbff;
        border: 1px solid #dbe4f0;
        padding: 14px;
        border-radius: 8px;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 950px) {
        .dashboard-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-main-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .dashboard-header h2 {
            font-size: 25px;
        }

        .dashboard-stats {
            grid-template-columns: 1fr;
        }

        .calendar-month h3 {
            font-size: 26px;
        }
    }
</style>

<div class="doctor-dashboard-page">

    <div class="dashboard-header">
        <small>Doctor Dashboard</small>
        <h2>Welcome, Dr. @Model.DoctorFullName</h2>
    </div>

    <div class="dashboard-stats">

        <div class="dashboard-stat">
            <span>Selected Day Appointments</span>
            <strong>@Model.TotalAppointmentsForSelectedDate</strong>
            <p>Total appointments on selected day</p>
        </div>

        <div class="dashboard-stat">
            <span>Upcoming</span>
            <strong>@Model.UpcomingAppointmentsCount</strong>
            <p>Future active appointments</p>
        </div>

        <div class="dashboard-stat">
            <span>Unread Notifications</span>
            <strong>@Model.UnreadNotificationsCount</strong>
            <p>Require attention</p>
        </div>

        <div class="dashboard-stat">
            <span>Patients Seen</span>
            <strong>@Model.TotalPatientsSeen</strong>
            <p>Unique completed patient visits</p>
        </div>

    </div>

    <div class="dashboard-main-grid">

        <div class="dashboard-card">
            <div class="calendar-header">
                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@Model.PreviousMonthDate.ToString("yyyy-MM-dd")"
                   class="calendar-nav">
                    ‹
                </a>

                <div class="calendar-month">
                    <h3>@Model.CalendarMonthLabel</h3>
                    <small>@Model.CalendarYear</small>
                </div>

                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@Model.NextMonthDate.ToString("yyyy-MM-dd")"
                   class="calendar-nav">
                    ›
                </a>
            </div>

            <div class="calendar-weekdays">
                <div>S</div>
                <div>M</div>
                <div>T</div>
                <div>W</div>
                <div>T</div>
                <div>F</div>
                <div>S</div>
            </div>

            <div class="calendar-grid">
                @foreach (var day in Model.CalendarDays)
                {
                <a asp-controller="Doctor"
                   asp-action="Dashboard"
                   asp-route-selectedDate="@day.Date.ToString("yyyy-MM-dd")"
                   class="calendar-day @(day.IsCurrentMonth ? "" : "other-month") @(day.IsSelected ? "selected" : "")">

                    <span class="calendar-day-number">@day.DayNumber</span>

                    @if (day.HasAppointments)
                        {
                    <span class="calendar-dot"></span>
                        }
                </a>
                }
            </div>
        </div>

        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <h4>Appointments for Selected Day</h4>
                <p>@Model.SelectedDate.ToString("dddd, dd MMM yyyy")</p>
            </div>

            <div class="day-panel-body">
                @if (Model.HasSelectedDayAppointments)
                {
                    foreach (var appointment in Model.SelectedDayAppointments)
                    {
                <div class="appointment-day-item">
                    <div class="appointment-time">@appointment.TimeDisplay</div>

                    <div class="appointment-patient">@appointment.PatientFullName</div>

                    <div class="appointment-ref">
                        Reference No.: @appointment.PatientReferenceNumber
                    </div>

                    <div class="appointment-status">@appointment.StatusName</div>

                    @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                            {
                    <div class="appointment-notes">@appointment.Notes</div>
                            }

                    <a asp-controller="Doctor"
                       asp-action="AppointmentDetails"
                       asp-route-id="@appointment.AppointmentId"
                       class="appointment-details-btn">
                        View Details
                    </a>
                </div>
                    }
                }
                else
                {
                <div class="empty-day-message">
                    No appointments are scheduled for this day.
                </div>
                }
            </div>
        </div>

    </div>

</div>