@model MVCApp.ViewModels.Doctor.DoctorAppointmentDetailsViewModel

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="doctor-page">
    <div class="doctor-appointment-details-page">
        <div class="manager-top">
            @if (Model.CanUpdateStatus)
            {
                <a asp-controller="DoctorAppointment"
                   asp-action="UpdateStatus"
                   asp-route-id="@Model.AppointmentId"
                   class="btn-main">
                    Update Status
                </a>
            }

            @if (Model.CanCreateVisitRecord)
            {
                <a asp-controller="VisitRecord"
                   asp-action="CreateVisitRecord"
                   asp-route-appointmentId="@Model.AppointmentId"
                   class="btn-light">
                    Create Visit Record
                </a>
            }

            @if (Model.CanEditVisitRecord)
            {
                <a asp-controller="VisitRecord"
                   asp-action="EditVisitRecord"
                   asp-route-appointmentId="@Model.AppointmentId"
                   class="btn-light">
                    Edit Visit Record
                </a>
            }

            @if (Model.CanCreateFollowUpRequest)
            {
                <a asp-controller="Doctor"
                   asp-action="FollowUpRequest"
                   asp-route-id="@Model.AppointmentId"
                   class="btn-light">
                    Create Follow-Up Request
                </a>
            }

            <a asp-controller="DoctorAppointment"
               asp-action="Appointments"
               class="btn-light">
                Appointments
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="manager-alert manager-alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="manager-alert manager-alert-danger">@TempData["Error"]</div>
        }

        <div class="manager-card">
            <div class="card-head">
                <h2>Appointment #@Model.AppointmentId</h2>
                <span class="status-pill">@Model.StatusName</span>
            </div>

            <div class="info-grid">
                <div class="info-box">
                    <span>Date</span>
                    <strong>@Model.AppointmentDateDisplay</strong>
                </div>

                <div class="info-box">
                    <span>Time</span>
                    <strong>@Model.TimeDisplay</strong>
                </div>

                <div class="info-box">
                    <span>Status</span>
                    <strong>@Model.StatusName</strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="info-box full">
                        <span>Notes</span>
                        <strong>@Model.Notes</strong>
                    </div>
                }

                @if (Model.HasCancellationReason)
                {
                    <div class="info-box full">
                        <span>Cancellation Reason</span>
                        <strong>@Model.CancellationReason</strong>
                    </div>
                }
            </div>
        </div>

        <div class="manager-card">
            <div class="card-head">
                <h2>Patient</h2>
            </div>

            <div class="info-grid">
                <div class="info-box">
                    <span>Name</span>
                    <strong>@Model.PatientFullName</strong>
                </div>

                <div class="info-box">
                    <span>Reference No.</span>
                    <strong>@Model.PatientReferenceNumber</strong>
                </div>

                <div class="info-box">
                    <span>CPR</span>
                    <strong>@Model.PatientCprNumber</strong>
                </div>
            </div>
        </div>

        <div class="manager-card">
            <div class="card-head">
                <h2>Visit Record</h2>
                @if (Model.HasVisitRecord)
                {
                    <span class="status-pill">Available</span>
                }
            </div>

            @if (Model.HasVisitRecord)
            {
                <div class="info-grid">
                    <div class="info-box">
                        <span>Diagnosis</span>
                        <strong>@Model.Diagnosis</strong>
                    </div>

                    <div class="info-box">
                        <span>Treatment</span>
                        <strong>@Model.Treatment</strong>
                    </div>

                    <div class="info-box">
                        <span>Doctor Notes</span>
                        <strong>@Model.DoctorNotes</strong>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-box">No visit record has been created for this appointment yet.</div>
            }
        </div>
    </div>
</div>