@model MVCApp.ViewModels.Doctor.DoctorAppointmentDetailsViewModel

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="container mt-4">

    <!-- Page header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Appointment Details</h2>
            <p class="text-muted mb-0">
                Review appointment information, patient details, visit record, and prescriptions.
            </p>
        </div>

        <a asp-controller="Doctor"
           asp-action="Appointments"
           class="btn btn-outline-secondary">
            Back to Appointments
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    <div class="row g-4">

        <!-- Appointment information -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="fw-bold mb-0">Appointment Information</h5>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">@Model.AppointmentDateDisplay</dd>

                        <dt class="col-sm-4">Time</dt>
                        <dd class="col-sm-8">@Model.TimeDisplay</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.StatusName</span>
                        </dd>

                        <dt class="col-sm-4">Notes</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrWhiteSpace(Model.Notes))
                            {
                            @Model.Notes
                            }
                            else
                            {
                            <span class="text-muted">No notes recorded.</span>
                            }
                        </dd>

                        @if (Model.HasCancellationReason)
                        {
                        <dt class="col-sm-4">Cancellation Reason</dt>
                        <dd class="col-sm-8">@Model.CancellationReason</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <!-- Patient information -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="fw-bold mb-0">Patient Information</h5>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Patient Name</dt>
                        <dd class="col-sm-8">@Model.PatientFullName</dd>

                        <dt class="col-sm-4">CPR Number</dt>
                        <dd class="col-sm-8">@Model.PatientCprNumber</dd>

                        <dt class="col-sm-4">Reference No.</dt>
                        <dd class="col-sm-8">@Model.PatientReferenceNumber</dd>
                    </dl>

                    <div class="mt-3">
                        <a asp-controller="Doctor"
                           asp-action="PatientHistory"
                           asp-route-patientId="@Model.PatientId"
                           class="btn btn-outline-secondary">
                            View Patient History
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Appointment actions -->
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">Appointment Actions</h5>
        </div>

        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">

                @if (Model.CanUpdateStatus)
                {
                <a asp-controller="Doctor"
                   asp-action="UpdateStatus"
                   asp-route-id="@Model.AppointmentId"
                   class="btn btn-primary">
                    Update Status
                </a>
                }

                @if (Model.CanCreateVisitRecord)
                {
                <a asp-controller="Doctor"
                   asp-action="CreateVisitRecord"
                   asp-route-appointmentId="@Model.AppointmentId"
                   class="btn btn-success">
                    Create Visit Record
                </a>
                }

                @if (Model.CanEditVisitRecord)
                {
                <a asp-controller="Doctor"
                   asp-action="EditVisitRecord"
                   asp-route-appointmentId="@Model.AppointmentId"
                   class="btn btn-outline-success">
                    Edit Visit Record
                </a>
                }

                @if (!Model.CanUpdateStatus && !Model.CanCreateVisitRecord && !Model.CanEditVisitRecord)
                {
                <span class="text-muted">No actions are available for this appointment.</span>
                }
            </div>
        </div>
    </div>

    <!-- Visit record -->
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">Visit Record</h5>
        </div>

        <div class="card-body">
            @if (Model.HasVisitRecord)
            {
            <dl class="row mb-0">
                <dt class="col-sm-3">Doctor Notes</dt>
                <dd class="col-sm-9">@Model.DoctorNotes</dd>

                <dt class="col-sm-3">Diagnosis</dt>
                <dd class="col-sm-9">@Model.Diagnosis</dd>

                <dt class="col-sm-3">Treatment</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.Treatment))
                        {
                    @Model.Treatment
                        }
                        else
                        {
                    <span class="text-muted">No treatment recorded.</span>
                        }
                </dd>
            </dl>
            }
            else
            {
            <div class="alert alert-info mb-0">
                No visit record has been created for this appointment yet.
            </div>
            }
        </div>
    </div>

    <!-- Prescriptions -->
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">Prescriptions</h5>
        </div>

        <div class="card-body">
            @if (Model.HasPrescriptions)
            {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Medication</th>
                            <th>Dosage</th>
                            <th>Frequency</th>
                            <th>Duration</th>
                            <th>Instructions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var prescription in Model.Prescriptions)
                            {
                        <tr>
                            <td>@prescription.MedicationName</td>
                            <td>@prescription.Dosage</td>
                            <td>@prescription.Frequency</td>
                            <td>@prescription.DurationDisplay</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(prescription.Instructions))
                                        {
                                @prescription.Instructions
                                        }
                                        else
                                        {
                                <span class="text-muted">No instructions</span>
                                        }
                            </td>
                        </tr>
                            }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info mb-0">
                No prescriptions recorded for this appointment.
            </div>
            }
        </div>
    </div>
</div>