@model MVCApp.ViewModels.Doctor.DoctorAppointmentDetailsViewModel

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">Appointment Details</h2>
            <p class="text-muted mb-0">
                @Model.AppointmentDate.ToString("dd MMM yyyy")
                |
                @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Doctor" asp-action="Appointments" class="btn btn-outline-secondary">
                Back to Appointments
            </a>

            @if (Model.CanUpdateStatus)
            {
                <a asp-controller="Doctor"
                   asp-action="UpdateStatus"
                   asp-route-id="@Model.AppointmentId"
                   class="btn btn-warning">
                    Update Status
                </a>
            }

            @if (Model.CanCreateVisitRecord)
            {
                <a asp-controller="Doctor"
                   asp-action="CreateVisitRecord"
                   asp-route-appointmentId="@Model.AppointmentId"
                   class="btn btn-success">
                    Create Visit Record
                </a>
            }

            @if (Model.CanEditVisitRecord)
            {
                <a asp-controller="Doctor"
                   asp-action="EditVisitRecord"
                   asp-route-appointmentId="@Model.AppointmentId"
                   class="btn btn-primary">
                    Edit Visit Record
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Appointment Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Appointment ID</dt>
                        <dd class="col-sm-8">@Model.AppointmentId</dd>

                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">@Model.AppointmentDate.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-4">Time</dt>
                        <dd class="col-sm-8">
                            @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.StatusName</span>
                        </dd>

                        <dt class="col-sm-4">Notes</dt>
                        <dd class="col-sm-8">
                            @if (string.IsNullOrWhiteSpace(Model.Notes))
                            {
                                <span class="text-muted">No notes</span>
                            }
                            else
                            {
                                @Model.Notes
                            }
                        </dd>

                        <dt class="col-sm-4">Cancellation Reason</dt>
                        <dd class="col-sm-8">
                            @if (string.IsNullOrWhiteSpace(Model.CancellationReason))
                            {
                                <span class="text-muted">Not cancelled</span>
                            }
                            else
                            {
                                @Model.CancellationReason
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Patient Information</h5>
                    <a asp-controller="Doctor"
                       asp-action="PatientHistory"
                       asp-route-patientId="@Model.PatientId"
                       class="btn btn-sm btn-outline-info">
                        View History
                    </a>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Patient Name</dt>
                        <dd class="col-sm-8">@Model.PatientFullName</dd>

                        <dt class="col-sm-4">Reference No.</dt>
                        <dd class="col-sm-8">@Model.PatientReferenceNumber</dd>

                        <dt class="col-sm-4">CPR Number</dt>
                        <dd class="col-sm-8">@Model.PatientCprNumber</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Visit Record</h5>

                    @if (Model.HasVisitRecord && Model.CanEditVisitRecord)
                    {
                        <a asp-controller="Doctor"
                           asp-action="EditVisitRecord"
                           asp-route-appointmentId="@Model.AppointmentId"
                           class="btn btn-sm btn-outline-primary">
                            Edit Visit Record
                        </a>
                    }
                </div>

                <div class="card-body">
                    @if (!Model.HasVisitRecord)
                    {
                        <div class="text-muted">
                            No visit record has been created for this appointment yet.
                        </div>
                    }
                    else
                    {
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <h6>Doctor Notes</h6>
                                @if (string.IsNullOrWhiteSpace(Model.DoctorNotes))
                                {
                                    <p class="text-muted mb-0">No doctor notes.</p>
                                }
                                else
                                {
                                    <p class="mb-0">@Model.DoctorNotes</p>
                                }
                            </div>

                            <div class="col-md-4">
                                <h6>Diagnosis</h6>
                                @if (string.IsNullOrWhiteSpace(Model.Diagnosis))
                                {
                                    <p class="text-muted mb-0">No diagnosis.</p>
                                }
                                else
                                {
                                    <p class="mb-0">@Model.Diagnosis</p>
                                }
                            </div>

                            <div class="col-md-4">
                                <h6>Treatment</h6>
                                @if (string.IsNullOrWhiteSpace(Model.Treatment))
                                {
                                    <p class="text-muted mb-0">No treatment.</p>
                                }
                                else
                                {
                                    <p class="mb-0">@Model.Treatment</p>
                                }
                            </div>
                        </div>

                        <hr />

                        <h6 class="mb-3">Prescriptions</h6>

                        @if (Model.Prescriptions == null || !Model.Prescriptions.Any())
                        {
                            <p class="text-muted mb-0">No prescriptions added.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Medication</th>
                                            <th>Dosage</th>
                                            <th>Frequency</th>
                                            <th>Duration</th>
                                            <th>Instructions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var prescription in Model.Prescriptions)
                                        {
                                            <tr>
                                                <td>@prescription.MedicationName</td>
                                                <td>@prescription.Dosage</td>
                                                <td>@prescription.Frequency</td>
                                                <td>@prescription.DurationDays day(s)</td>
                                                <td>
                                                    @if (string.IsNullOrWhiteSpace(prescription.Instructions))
                                                    {
                                                        <span class="text-muted">No instructions</span>
                                                    }
                                                    else
                                                    {
                                                        @prescription.Instructions
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>