@model MVCApp.ViewModels.Doctor.EditVisitRecordViewModel

@{
    ViewData["Title"] = "Edit Visit Record";
}

<div class="doctor-page">
    <div class="doctor-visit-page">
        <div class="manager-top">
            <a asp-controller="DoctorAppointment"
               asp-action="AppointmentDetails"
               asp-route-id="@Model.AppointmentId"
               class="btn-light">
                Back to Appointment
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="manager-alert manager-alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="manager-alert manager-alert-danger">@TempData["Error"]</div>
        }

        <form asp-controller="VisitRecord"
              asp-action="EditVisitRecord"
              method="post"
              class="manager-form">
            @Html.AntiForgeryToken()

            <input asp-for="AppointmentId" type="hidden" />
            <input asp-for="PatientId" type="hidden" />
            <input asp-for="PatientFullName" type="hidden" />
            <input asp-for="AppointmentDate" type="hidden" />
            <input asp-for="StartTime" type="hidden" />
            <input asp-for="EndTime" type="hidden" />

            <div class="manager-card">
                <div class="card-head">
                    <h2>Appointment Summary</h2>
                </div>

                <div class="info-grid">
                    <div class="info-box">
                        <span>Patient</span>
                        <strong>@Model.PatientFullName</strong>
                    </div>

                    <div class="info-box">
                        <span>Appointment Date</span>
                        <strong>@Model.AppointmentDateDisplay</strong>
                    </div>

                    <div class="info-box">
                        <span>Appointment Time</span>
                        <strong>@Model.TimeDisplay</strong>
                    </div>
                </div>
            </div>

            <div class="manager-card">
                <div class="card-head">
                    <h2>Medical Visit Details</h2>
                </div>

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="form-grid">
                    <div class="form-group full">
                        <label asp-for="DoctorNotes"></label>
                        <textarea asp-for="DoctorNotes" placeholder="Update the consultation notes"></textarea>
                        <span asp-validation-for="DoctorNotes" class="text-danger"></span>
                    </div>

                    <div class="form-group full">
                        <label asp-for="Diagnosis"></label>
                        <textarea asp-for="Diagnosis" placeholder="Update the diagnosis"></textarea>
                        <span asp-validation-for="Diagnosis" class="text-danger"></span>
                    </div>

                    <div class="form-group full">
                        <label asp-for="Treatment"></label>
                        <textarea asp-for="Treatment" placeholder="Update the treatment plan if needed"></textarea>
                        <span asp-validation-for="Treatment" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="manager-card">
                <div class="card-head">
                    <h2>Prescriptions</h2>
                </div>

                <div class="muted">
                    Update the prescription details if medication was changed. Leave a row empty if there is no prescription.
                </div>

                @for (var i = 0; i < Model.Prescriptions.Count; i++)
                {
                    <div class="prescription-card">
                        <h3>Prescription @(i + 1)</h3>

                        <div class="form-grid">
                            <div class="form-group">
                                <label asp-for="Prescriptions[i].MedicationName"></label>
                                <input asp-for="Prescriptions[i].MedicationName" placeholder="Example: Paracetamol" />
                                <span asp-validation-for="Prescriptions[i].MedicationName" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Prescriptions[i].Dosage"></label>
                                <input asp-for="Prescriptions[i].Dosage" placeholder="Example: 500mg" />
                                <span asp-validation-for="Prescriptions[i].Dosage" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Prescriptions[i].Frequency"></label>
                                <input asp-for="Prescriptions[i].Frequency" placeholder="Example: Twice daily" />
                                <span asp-validation-for="Prescriptions[i].Frequency" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Prescriptions[i].DurationDays"></label>
                                <input asp-for="Prescriptions[i].DurationDays" type="number" min="0" />
                                <span asp-validation-for="Prescriptions[i].DurationDays" class="text-danger"></span>
                            </div>

                            <div class="form-group full">
                                <label asp-for="Prescriptions[i].Instructions"></label>
                                <textarea asp-for="Prescriptions[i].Instructions" placeholder="Example: Take after food"></textarea>
                                <span asp-validation-for="Prescriptions[i].Instructions" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                }

                @if (!Model.Prescriptions.Any())
                {
                    <div class="empty-box">
                        No prescription row is available. You can still save the visit record without prescriptions.
                    </div>
                }

                <div class="actions">
                    <a asp-controller="DoctorAppointment"
                       asp-action="AppointmentDetails"
                       asp-route-id="@Model.AppointmentId"
                       class="btn-light">
                        Cancel
                    </a>

                    <button type="submit" class="btn-main">
                        Save Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}