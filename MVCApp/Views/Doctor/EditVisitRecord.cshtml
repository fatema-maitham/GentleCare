@model MVCApp.ViewModels.Doctor.EditVisitRecordViewModel

@{
    ViewData["Title"] = "Edit Visit Record";
}

<div class="container mt-4">

    <!-- Page header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Edit Visit Record</h2>
            <p class="text-muted mb-0">
                Update the consultation notes, diagnosis, treatment, and prescriptions.
            </p>
        </div>

        <a asp-controller="DoctorAppointment"
           asp-action="AppointmentDetails"
           asp-route-id="@Model.AppointmentId"
           class="btn btn-outline-secondary">
            Back to Appointment
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    <!-- Appointment and patient summary -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">Appointment Summary</h5>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Patient</dt>
                <dd class="col-sm-9">@Model.PatientFullName</dd>

                <dt class="col-sm-3">Appointment Date</dt>
                <dd class="col-sm-9">@Model.AppointmentDateDisplay</dd>

                <dt class="col-sm-3">Appointment Time</dt>
                <dd class="col-sm-9">@Model.TimeDisplay</dd>
            </dl>
        </div>
    </div>

    <!-- Edit visit record form -->
    <form asp-controller="VisitRecord"
          asp-action="EditVisitRecord"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="AppointmentId" type="hidden" />
        <input asp-for="PatientId" type="hidden" />
        <input asp-for="PatientFullName" type="hidden" />
        <input asp-for="AppointmentDate" type="hidden" />
        <input asp-for="StartTime" type="hidden" />
        <input asp-for="EndTime" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white">
                <h5 class="fw-bold mb-0">Medical Visit Details</h5>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="DoctorNotes" class="form-label"></label>
                    <textarea asp-for="DoctorNotes"
                              class="form-control"
                              rows="4"
                              placeholder="Update the consultation notes"></textarea>
                    <span asp-validation-for="DoctorNotes" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Diagnosis" class="form-label"></label>
                    <textarea asp-for="Diagnosis"
                              class="form-control"
                              rows="3"
                              placeholder="Update the diagnosis"></textarea>
                    <span asp-validation-for="Diagnosis" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Treatment" class="form-label"></label>
                    <textarea asp-for="Treatment"
                              class="form-control"
                              rows="3"
                              placeholder="Update the treatment plan if needed"></textarea>
                    <span asp-validation-for="Treatment" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Prescription section -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white">
                <h5 class="fw-bold mb-0">Prescriptions</h5>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    Update the prescription details if medication was changed. Leave the row empty if there is no prescription.
                </p>

                @for (var i = 0; i < Model.Prescriptions.Count; i++)
                {
                <div class="border rounded p-3 mb-3">
                    <h6 class="fw-bold mb-3">Prescription @(i + 1)</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Prescriptions[i].MedicationName" class="form-label"></label>
                            <input asp-for="Prescriptions[i].MedicationName"
                                   class="form-control"
                                   placeholder="Example: Paracetamol" />
                            <span asp-validation-for="Prescriptions[i].MedicationName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Prescriptions[i].Dosage" class="form-label"></label>
                            <input asp-for="Prescriptions[i].Dosage"
                                   class="form-control"
                                   placeholder="Example: 500mg" />
                            <span asp-validation-for="Prescriptions[i].Dosage" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Prescriptions[i].Frequency" class="form-label"></label>
                            <input asp-for="Prescriptions[i].Frequency"
                                   class="form-control"
                                   placeholder="Example: Twice daily" />
                            <span asp-validation-for="Prescriptions[i].Frequency" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Prescriptions[i].DurationDays" class="form-label"></label>
                            <input asp-for="Prescriptions[i].DurationDays"
                                   class="form-control"
                                   type="number"
                                   min="0" />
                            <span asp-validation-for="Prescriptions[i].DurationDays" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Prescriptions[i].Instructions" class="form-label"></label>
                            <textarea asp-for="Prescriptions[i].Instructions"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Example: Take after food"></textarea>
                            <span asp-validation-for="Prescriptions[i].Instructions" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                }

                @if (!Model.Prescriptions.Any())
                {
                <div class="alert alert-info mb-0">
                    No prescription row is available. You can still save the visit record without prescriptions.
                </div>
                }
            </div>
        </div>

        <!-- Form actions -->
        <div class="d-flex justify-content-end gap-2 mb-4">
            <a asp-controller="DoctorAppointment"
               asp-action="AppointmentDetails"
               asp-route-id="@Model.AppointmentId"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit" class="btn btn-success">
                Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}