@model List<MVCApp.ViewModels.Doctor.DoctorPrescriptionViewModel>

@{
    ViewData["Title"] = "My Prescriptions";
}

<div class="doctor-page">
    <div class="doctor-prescriptions-page">
        <div class="manager-card dashboard-hero">
            <div class="card-head">
                <div>
                    <h2>My Prescriptions</h2>
                    <span class="muted">Prescription records for your patients</span>
                </div>
            </div>
        </div>

        <div class="doctor-stats-grid one-card">
            <div class="doctor-stat-card">
                <strong>@Model.Count</strong>
                <span>Total Prescriptions</span>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="manager-alert manager-alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="manager-alert manager-alert-danger">@TempData["Error"]</div>
        }

        <div class="manager-card">
            <div class="card-head">
                <h2>Prescription Records</h2>
            </div>

            @if (Model.Any())
            {
                <div class="table-wrap">
                    <table class="prescription-table">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>Reference No.</th>
                                <th>Appointment Date</th>
                                <th>Medication</th>
                                <th>Dosage</th>
                                <th>Frequency</th>
                                <th>Duration</th>
                                <th>Instructions</th>
                                <th class="action-col">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var prescription in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@prescription.PatientFullName</td>
                                    <td>@prescription.PatientReferenceNumber</td>
                                    <td>@prescription.AppointmentDateDisplay</td>
                                    <td>@prescription.MedicationName</td>
                                    <td>@prescription.Dosage</td>
                                    <td>@prescription.Frequency</td>
                                    <td>@prescription.DurationDisplay</td>
                                    <td>
                                        @if (prescription.HasInstructions)
                                        {
                                            @prescription.Instructions
                                        }
                                        else
                                        {
                                            <span class="muted-text">No instructions</span>
                                        }
                                    </td>
                                    <td class="action-col">
                                        <a asp-controller="DoctorAppointment"
                                           asp-action="AppointmentDetails"
                                           asp-route-id="@prescription.AppointmentId"
                                           class="table-btn table-btn-main">
                                            Appointment
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    No prescriptions have been recorded yet.
                </div>
            }
        </div>
    </div>
</div>