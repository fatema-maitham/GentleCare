@model MVCApp.ViewModels.Doctor.UpdateAppointmentStatusViewModel

@{
    ViewData["Title"] = "Update Appointment Status";

    string StatusClass(string status) => status?.ToLower().Replace(" ", "") switch
    {
        "requested" => "status-requested",
        "confirmed" => "status-confirmed",
        "inprogress" => "status-inprogress",
        "checkedin" => "status-checkedin",
        "completed" => "status-completed",
        "cancelled" => "status-cancelled",
        "missed" => "status-missed",
        _ => "status-default"
    };
}

<div class="doctor-page">
    <div class="doctor-status-page">
        <div class="manager-top">
            <a asp-controller="DoctorAppointment"
               asp-action="AppointmentDetails"
               asp-route-id="@Model.AppointmentId"
               class="btn-light">
                Back to Details
            </a>
        </div>

        <div class="manager-card">
            <div class="card-head">
                <h2>Status Update Form</h2>
                <span class="status-pill @StatusClass(Model.CurrentStatusDisplay)">@Model.CurrentStatusDisplay</span>
            </div>

            <form asp-controller="DoctorAppointment"
                  asp-action="UpdateStatus"
                  method="post"
                  class="manager-form">
                @Html.AntiForgeryToken()

                <input asp-for="AppointmentId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="form-grid">
                    <div class="form-group full">
                        <label>Current Status</label>
                        <input value="@Model.CurrentStatusDisplay" class="form-control" readonly />
                    </div>

                    <div class="form-group full">
                        <label asp-for="NewStatusName">New Status</label>
                        <select asp-for="NewStatusName" asp-items="Model.AvailableStatuses" class="form-control">
                            <option value="">Select new status</option>
                        </select>
                        <span asp-validation-for="NewStatusName" class="text-danger"></span>
                    </div>

                    <div class="form-group full">
                        <label asp-for="StatusNote">Status Note</label>
                        <textarea asp-for="StatusNote"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Optional note about this status update"></textarea>
                        <span asp-validation-for="StatusNote" class="text-danger"></span>
                    </div>
                </div>

                <div class="actions">
                    <a asp-controller="DoctorAppointment"
                       asp-action="AppointmentDetails"
                       asp-route-id="@Model.AppointmentId"
                       class="btn-light">
                        Cancel
                    </a>

                    <button type="submit" class="btn-main">Save Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}