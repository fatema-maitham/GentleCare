@model MVCApp.ViewModels.Doctor.UpdateAppointmentStatusViewModel

@{
    ViewData["Title"] = "Update Appointment Status";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">Update Appointment Status</h2>
                    <p class="text-muted mb-0">Appointment ID: @Model.AppointmentId</p>
                </div>

                <a asp-controller="Doctor"
                   asp-action="AppointmentDetails"
                   asp-route-id="@Model.AppointmentId"
                   class="btn btn-outline-secondary">
                    Back to Details
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Change Status</h5>
                </div>

                <div class="card-body">
                    <form asp-controller="Doctor" asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()

                        <input asp-for="AppointmentId" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentStatusName" class="form-label"></label>
                            <input asp-for="CurrentStatusName" class="form-control" readonly />
                        </div>

                        <div class="mb-4">
                            <label asp-for="NewStatusName" class="form-label"></label>
                            <select asp-for="NewStatusName"
                                    asp-items="Model.AvailableStatuses"
                                    class="form-select">
                                <option value="">-- Select New Status --</option>
                            </select>
                            <span asp-validation-for="NewStatusName" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                Save Status
                            </button>

                            <a asp-controller="Doctor"
                               asp-action="AppointmentDetails"
                               asp-route-id="@Model.AppointmentId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}