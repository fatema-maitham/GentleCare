@model MVCApp.ViewModels.Doctor.UpdateAppointmentStatusViewModel

@{
    ViewData["Title"] = "Update Appointment Status";
}

<div class="doctor-status-page">
    <a asp-controller="DoctorAppointment"
       asp-action="AppointmentDetails"
       asp-route-id="@Model.AppointmentId"
       class="back-link">
        Back to Details
    </a>

    <div class="status-card">
        <div class="status-card-header">
            <h2>Status Update Form</h2>
        </div>

        <form action="/Doctor/UpdateStatus" method="post" class="status-form">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="AppointmentId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label>Current Status</label>
                <input value="@Model.CurrentStatusDisplay" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="NewStatusName">New Status</label>
                <select asp-for="NewStatusName" asp-items="Model.AvailableStatuses" class="form-control">
                    <option value="">Select new status</option>
                </select>
                <span asp-validation-for="NewStatusName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StatusNote">Status Note</label>
                <textarea asp-for="StatusNote"
                          class="form-control"
                          rows="4"
                          placeholder="Optional note about this status update"></textarea>
                <span asp-validation-for="StatusNote" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <a asp-controller="DoctorAppointment"
                   asp-action="AppointmentDetails"
                   asp-route-id="@Model.AppointmentId"
                   class="btn-cancel">
                    Cancel
                </a>

                <button type="submit" class="btn-save">Save Status</button>
            </div>
        </form>
    </div>
</div>

<style>
    .doctor-status-page {
        max-width: 520px;
        margin: 70px auto;
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 22px;
        padding: 12px 18px;
        border-radius: 14px;
        background: #EAF7FA;
        color: #06485F;
        font-weight: 800;
        text-decoration: none;
        border: 1px solid #CDE7EC;
    }

    .status-card {
        background: #FFFFFF;
        border: 1px solid #D6E0E3;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 12px 28px rgba(6, 72, 95, 0.08);
    }

    .status-card-header {
        padding: 22px 26px;
        border-bottom: 1px solid #E5ECEE;
    }

        .status-card-header h2 {
            margin: 0;
            color: #06485F;
            font-size: 24px;
            font-weight: 900;
        }

    .status-form {
        padding: 26px;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 900;
            color: #12262F;
        }

    .form-control {
        width: 100%;
        border: 1px solid #CAD8DC;
        border-radius: 14px;
        padding: 13px 14px;
        font-weight: 700;
        color: #12262F;
        background: #FFFFFF;
    }

        .form-control:focus {
            outline: none;
            border-color: #00688C;
            box-shadow: 0 0 0 3px rgba(0, 104, 140, 0.12);
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 26px;
    }

    .btn-cancel,
    .btn-save {
        border: none;
        border-radius: 14px;
        padding: 12px 18px;
        font-weight: 900;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-cancel {
        background: #EAF7FA;
        color: #06485F;
        border: 1px solid #CDE7EC;
    }

    .btn-save {
        background: #06485F;
        color: #FFFFFF;
    }

    .text-danger {
        color: #B42318;
        font-weight: 700;
        font-size: 13px;
    }
</style>