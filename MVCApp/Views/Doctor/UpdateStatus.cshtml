@model MVCApp.ViewModels.Doctor.UpdateAppointmentStatusViewModel

@{
    ViewData["Title"] = "Update Appointment Status";
}

<div class="update-status-page">

    <div class="update-header">
        <a asp-controller="DoctorAppointment"
           asp-action="AppointmentDetails"
           asp-route-id="@Model.AppointmentId"
           class="back-btn">
            Back to Details
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="status-card">
        <div class="status-card-header">
            <h4>Status Update Form</h4>
        </div>

        <div class="status-card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-controller="DoctorAppointment"
                  asp-action="UpdateStatus"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="AppointmentId" type="hidden" />

                <div class="form-group">
                    <label asp-for="CurrentStatusName">Current Status</label>
                    <input asp-for="CurrentStatusName" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="NewStatusName"></label>
                    <select asp-for="NewStatusName" asp-items="Model.AvailableStatuses">
                        <option value="">Select new status</option>
                    </select>
                    <span asp-validation-for="NewStatusName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="StatusNote"></label>
                    <textarea asp-for="StatusNote"
                              rows="3"
                              placeholder="Optional note about this status update"></textarea>
                    <span asp-validation-for="StatusNote" class="text-danger"></span>
                </div>

                @if (!Model.HasAvailableStatuses)
                {
                    <div class="empty-box">
                        No next status is available for this appointment.
                    </div>
                }

                <div class="form-actions">
                    <a asp-controller="DoctorAppointment"
                       asp-action="AppointmentDetails"
                       asp-route-id="@Model.AppointmentId"
                       class="cancel-btn">
                        Cancel
                    </a>

                    <button type="submit"
                            class="save-btn"
                            disabled="@(!Model.HasAvailableStatuses)">
                        Save Status
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<style>
    .update-status-page {
        max-width: 760px;
        margin: 0 auto;
        padding: 30px 20px 50px;
    }

    .update-header {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 24px;
    }

    .status-card {
        background: #ffffff;
        border: 1px solid #D6DDDE;
        border-radius: 24px;
        overflow: hidden;
    }

    .status-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #E9EEEE;
    }

        .status-card-header h4 {
            margin: 0;
            color: #075168;
            font-weight: 900;
        }

    .status-card-body {
        padding: 24px;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #12262F;
            font-weight: 850;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            border: 1px solid #D6DDDE;
            border-radius: 14px;
            padding: 12px 14px;
            font-weight: 600;
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
    }

    .back-btn,
    .cancel-btn {
        border-radius: 14px;
        padding: 10px 17px;
        border: 1px solid #C9DBDF;
        background: #E7F1F3;
        color: #075168;
        font-weight: 900;
        text-decoration: none;
    }

    .save-btn {
        border: none;
        border-radius: 14px;
        padding: 10px 18px;
        background: #075168;
        color: white;
        font-weight: 900;
    }

        .save-btn:disabled {
            background: #9aa9ad;
        }

    .empty-box
    {
        padding: 16px;
        border-radius: 16px;
        background: #E7F1F3;
        color: #075168;
        font-weight: 800;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}