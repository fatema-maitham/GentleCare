@model MVCApp.ViewModels.Doctor.DoctorPatientHistoryViewModel

@{
    ViewData["Title"] = "Patient History";
}

<div class="container mt-4">

    <!-- Page header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Patient History</h2>
            <p class="text-muted mb-0">
                View previous visit records for this patient.
            </p>
        </div>

        <a asp-controller="Doctor"
           asp-action="Appointments"
           class="btn btn-outline-secondary">
            Back to Appointments
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    <!-- Patient information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">Patient Information</h5>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Patient Name</dt>
                <dd class="col-sm-9">@Model.PatientFullName</dd>

                <dt class="col-sm-3">CPR Number</dt>
                <dd class="col-sm-9">@Model.CPRNumber</dd>

                <dt class="col-sm-3">Reference Number</dt>
                <dd class="col-sm-9">@Model.ReferenceNumber</dd>

                <dt class="col-sm-3">Date of Birth</dt>
                <dd class="col-sm-9">@Model.DateOfBirthDisplay</dd>

                <dt class="col-sm-3">Blood Type</dt>
                <dd class="col-sm-9">@Model.BloodTypeDisplay</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.Address))
                    {
                    <span>@Model.Address</span>
                    }
                    else
                    {
                    <span class="text-muted">Not recorded</span>
                    }
                </dd>

                <dt class="col-sm-3">Emergency Contact</dt>
                <dd class="col-sm-9">
                    @{
                        var hasEmergencyName = !string.IsNullOrWhiteSpace(Model.EmergencyContactName);
                        var hasEmergencyPhone = !string.IsNullOrWhiteSpace(Model.EmergencyContactPhone);
                    }

                    @if (hasEmergencyName || hasEmergencyPhone)
                    {
                        if (hasEmergencyName)
                        {
                    <span>@Model.EmergencyContactName</span>
                        }

                        if (hasEmergencyName && hasEmergencyPhone)
                        {
                    <span> - </span>
                        }

                        if (hasEmergencyPhone)
                        {
                    <span>@Model.EmergencyContactPhone</span>
                        }
                    }
                    else
                    {
                    <span class="text-muted">Not recorded</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <!-- Visit history summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Visits</h6>
                    <h3 class="fw-bold">@Model.TotalVisits</h3>
                    <p class="mb-0 text-muted">Completed visit records</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Visit records -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">Visit Records</h5>
        </div>

        <div class="card-body">
            @if (Model.HasVisits)
            {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Diagnosis</th>
                            <th>Treatment</th>
                            <th>Prescriptions</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var visit in Model.Visits)
                            {
                        <tr>
                            <td>@visit.AppointmentDateDisplay</td>
                            <td>@visit.TimeDisplay</td>

                            <td>
                                <span class="badge bg-secondary">
                                    @visit.StatusName
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(visit.Diagnosis))
                                        {
                                <span>@visit.Diagnosis</span>
                                        }
                                        else
                                        {
                                <span class="text-muted">No diagnosis</span>
                                        }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(visit.Treatment))
                                        {
                                <span>@visit.Treatment</span>
                                        }
                                        else
                                        {
                                <span class="text-muted">No treatment</span>
                                        }
                            </td>

                            <td>
                                @if (visit.HasPrescriptions)
                                        {
                                <span class="badge bg-info text-dark">
                                    @visit.PrescriptionCount prescription(s)
                                </span>
                                        }
                                        else
                                        {
                                <span class="text-muted">None</span>
                                        }
                            </td>

                            <td class="text-end">
                                <a asp-controller="Doctor"
                                   asp-action="AppointmentDetails"
                                   asp-route-id="@visit.AppointmentId"
                                   class="btn btn-sm btn-outline-dark">
                                    Details
                                </a>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="7" class="bg-light">
                                <strong>Doctor Notes:</strong>

                                @if (!string.IsNullOrWhiteSpace(visit.DoctorNotes))
                                        {
                                <span>@visit.DoctorNotes</span>
                                        }
                                        else
                                        {
                                <span class="text-muted">No notes recorded.</span>
                                        }
                            </td>
                        </tr>
                            }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info mb-0">
                No visit records were found for this patient.
            </div>
            }
        </div>
    </div>
</div>