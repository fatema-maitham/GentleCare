@model MVCApp.ViewModels.Doctor.DoctorPatientHistoryViewModel

@{
    ViewData["Title"] = "Patient History";
}

<div class="patient-history-page">

    <div class="history-header">
        <a asp-controller="DoctorAppointment"
           asp-action="Appointments"
           class="history-btn">
            Back to Appointments
        </a>
    </div>

    <div class="history-card">
        <div class="history-card-header">
            <h4>Patient Information</h4>
        </div>

        <div class="history-card-body">
            <div class="info-list">
                <div class="info-row">
                    <div class="info-label">Patient Name</div>
                    <div class="info-value">@Model.PatientFullName</div>
                </div>

                <div class="info-row">
                    <div class="info-label">CPR Number</div>
                    <div class="info-value">@Model.CPRNumber</div>
                </div>

                <div class="info-row">
                    <div class="info-label">Reference Number</div>
                    <div class="info-value">@Model.ReferenceNumber</div>
                </div>

                <div class="info-row">
                    <div class="info-label">Date of Birth</div>
                    <div class="info-value">@Model.DateOfBirthDisplay</div>
                </div>

                <div class="info-row">
                    <div class="info-label">Blood Type</div>
                    <div class="info-value">@Model.BloodTypeDisplay</div>
                </div>

                <div class="info-row">
                    <div class="info-label">Address</div>
                    <div class="info-value">
                        @(string.IsNullOrWhiteSpace(Model.Address) ? "Not recorded" : Model.Address)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="history-summary-card">
        <span>Total Visits</span>
        <strong>@Model.TotalVisits</strong>
    </div>

    <div class="history-card">
        <div class="history-card-header">
            <h4>Visit Records</h4>
        </div>

        <div class="history-card-body">
            @if (Model.HasVisits)
            {
                <div class="history-table-wrap">
                    <table class="history-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Diagnosis</th>
                                <th>Treatment</th>
                                <th>Prescriptions</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var visit in Model.Visits)
                            {
                                <tr>
                                    <td>@visit.AppointmentDateDisplay</td>
                                    <td>@visit.TimeDisplay</td>

                                    <td>
                                        <span class="status-badge">@visit.StatusName</span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(visit.Diagnosis) ? "No diagnosis" : visit.Diagnosis)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(visit.Treatment) ? "No treatment" : visit.Treatment)
                                    </td>

                                    <td>
                                        @if (visit.HasPrescriptions)
                                        {
                                            <span class="prescription-badge">
                                                @visit.PrescriptionCount prescription(s)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="muted-text">None</span>
                                        }
                                </td>

                                <td>
                                    <a asp-controller="DoctorAppointment"
                                       asp-action="AppointmentDetails"
                                       asp-route-id="@visit.AppointmentId"
                                       class="details-btn">
                                        Details
                                    </a>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="7" class="doctor-notes-row">
                                    <div class="doctor-notes-box">
                                        <strong>Doctor Notes:</strong>
                                        <span>
                                            @(string.IsNullOrWhiteSpace(visit.DoctorNotes)
                                                                                    ? "No notes recorded."
                                                                                    : visit.DoctorNotes)
                                    </span>
                                </div>
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    No visit records were found for this patient.
                </div>
            }
        </div>
    </div>

</div>

<style>
    .patient-history-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 30px 20px 50px;
    }

    .history-header {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 24px;
    }

    .history-card {
        background: #ffffff;
        border: 1px solid #d6ddde;
        border-radius: 24px;
        overflow: hidden;
        margin-bottom: 24px;
    }

    .history-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e9eeee;
    }

        .history-card-header h4 {
            margin: 0;
            color: #075168;
            font-size: 24px;
            font-weight: 900;
        }

    .history-card-body {
        padding: 24px;
    }

    .info-list {
        display: grid;
        gap: 14px;
    }

    .info-row {
        display: grid;
        grid-template-columns: 190px 1fr;
        gap: 18px;
        padding-bottom: 14px;
        border-bottom: 1px solid #edf1f2;
    }

    .info-label {
        color: #687a80;
        font-weight: 850;
    }

    .info-value {
        color: #001d2a;
        font-weight: 800;
    }

    .history-summary-card {
        background: #ffffff;
        border: 1px solid #d6ddde;
        border-radius: 22px;
        padding: 26px;
        text-align: center;
        margin-bottom: 24px;
    }

        .history-summary-card span {
            display: block;
            color: #687a80;
            font-weight: 900;
            margin-bottom: 8px;
        }

        .history-summary-card strong {
            display: block;
            color: #075168;
            font-size: 36px;
            font-weight: 900;
            line-height: 1;
        }

    .history-table-wrap {
        overflow-x: auto;
    }

    .history-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .history-table th {
            background: #f8fafa;
            color: #001d2a;
            padding: 16px 22px;
            font-weight: 900;
            border-bottom: 1px solid #d6ddde;
            text-align: left;
        }

        .history-table td {
            padding: 18px 22px;
            border-bottom: 1px solid #edf1f2;
            color: #001d2a;
            font-weight: 700;
            vertical-align: middle;
        }

    .status-badge,
    .prescription-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: fit-content;
        white-space: nowrap;
        border-radius: 999px;
        background: #e7f1f3;
        color: #075168;
        border: 1px solid #c9dbdf;
        padding: 7px 13px;
        font-size: 13px;
        font-weight: 900;
    }

    .details-btn,
    .history-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        padding: 10px 18px;
        border: 1px solid #c9dbdf;
        background: #e7f1f3;
        color: #075168;
        font-weight: 900;
        text-decoration: none;
        white-space: nowrap;
    }

        .details-btn:hover,
        .history-btn:hover {
            background: #075168;
            color: #ffffff;
        }

    .doctor-notes-row {
        padding: 0 !important;
        background: #f8fafa;
    }

    .doctor-notes-box {
        padding: 18px 22px;
        color: #001d2a;
        font-weight: 700;
    }

        .doctor-notes-box strong {
            color: #001d2a;
            font-weight: 900;
            margin-right: 5px;
        }

    .muted-text {
        color: #687a80;
        font-weight: 700;
    }

    .empty-box {
        padding: 18px;
        border-radius: 16px;
        background: #e7f1f3;
        color: #075168;
        font-weight: 800;
    }

    @media (max-width: 900px) {
        .info-row

    {
        grid-template-columns: 1fr;
    }

    .history-table {
        table-layout: auto;
    }

    }
</style>