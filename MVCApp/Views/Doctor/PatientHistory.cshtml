@model MVCApp.ViewModels.Doctor.DoctorPatientHistoryViewModel

@{
    ViewData["Title"] = "Patient History";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">Patient History</h2>
            <p class="text-muted mb-0">@Model.PatientFullName</p>
        </div>

        <a asp-controller="Doctor" asp-action="Appointments" class="btn btn-outline-secondary">
            Back to Appointments
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Patient Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Full Name</dt>
                        <dd class="col-sm-7">@Model.PatientFullName</dd>

                        <dt class="col-sm-5">CPR Number</dt>
                        <dd class="col-sm-7">@Model.CPRNumber</dd>

                        <dt class="col-sm-5">Reference No.</dt>
                        <dd class="col-sm-7">@Model.ReferenceNumber</dd>

                        <dt class="col-sm-5">Date of Birth</dt>
                        <dd class="col-sm-7">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-5">Blood Type</dt>
                        <dd class="col-sm-7">
                            @if (string.IsNullOrWhiteSpace(Model.BloodType))
                            {
                                <span class="text-muted">Not provided</span>
                            }
                            else
                            {
                                @Model.BloodType
                            }
                        </dd>

                        <dt class="col-sm-5">Address</dt>
                        <dd class="col-sm-7">
                            @if (string.IsNullOrWhiteSpace(Model.Address))
                            {
                                <span class="text-muted">Not provided</span>
                            }
                            else
                            {
                                @Model.Address
                            }
                        </dd>

                        <dt class="col-sm-5">Emergency Contact</dt>
                        <dd class="col-sm-7">
                            @if (string.IsNullOrWhiteSpace(Model.EmergencyContactName))
                            {
                                <span class="text-muted">Not provided</span>
                            }
                            else
                            {
                                @Model.EmergencyContactName
                            }
                        </dd>

                        <dt class="col-sm-5">Emergency Phone</dt>
                        <dd class="col-sm-7">
                            @if (string.IsNullOrWhiteSpace(Model.EmergencyContactPhone))
                            {
                                <span class="text-muted">Not provided</span>
                            }
                            else
                            {
                                @Model.EmergencyContactPhone
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Visit Summary</h5>
                    <span class="badge bg-primary">@Model.Visits.Count Visit(s)</span>
                </div>
                <div class="card-body">
                    @if (Model.Visits == null || !Model.Visits.Any())
                    {
                        <p class="text-muted mb-0">No visit history found for this patient.</p>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var visit in Model.Visits)
                            {
                                <div class="col-12">
                                    <div class="border rounded p-3">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                                            <div>
                                                <h6 class="mb-1">Appointment #@visit.AppointmentId</h6>
                                                <div class="text-muted small">
                                                    @visit.AppointmentDate.ToString("dd MMM yyyy")
                                                    |
                                                    @visit.StartTime.ToString(@"hh\:mm") - @visit.EndTime.ToString(@"hh\:mm")
                                                </div>
                                            </div>

                                            <span class="badge bg-secondary">@visit.StatusName</span>
                                        </div>

                                        <div class="row g-3 mt-1">
                                            <div class="col-md-4">
                                                <strong>Doctor Notes</strong>
                                                <p class="mb-0 mt-1">@visit.DoctorNotes</p>
                                            </div>

                                            <div class="col-md-4">
                                                <strong>Diagnosis</strong>
                                                <p class="mb-0 mt-1">@visit.Diagnosis</p>
                                            </div>

                                            <div class="col-md-4">
                                                <strong>Treatment</strong>
                                                <p class="mb-1 mt-1">
                                                    @if (string.IsNullOrWhiteSpace(visit.Treatment))
                                                    {
                                                        <span class="text-muted">No treatment recorded</span>
                                                    }
                                                    else
                                                    {
                                                        @visit.Treatment
                                                    }
                                                </p>
                                                <div class="small text-muted">
                                                    Prescriptions: @visit.PrescriptionCount
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-3">
                                            <a asp-controller="Doctor"
                                               asp-action="AppointmentDetails"
                                               asp-route-id="@visit.AppointmentId"
                                               class="btn btn-sm btn-outline-primary">
                                                View Appointment Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>