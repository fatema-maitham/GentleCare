@model MVCApp.ViewModels.Doctor.DoctorScheduleViewModel

@{
    ViewData["Title"] = "My Schedule";
}

<div class="container mt-4">

    <!-- Page header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Schedule</h2>
            <p class="text-muted mb-0">
                View your weekly working hours and approved leave periods, Dr. @Model.DoctorFullName.
            </p>
        </div>

        <a asp-controller="Doctor"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    <!-- Schedule summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Working Days</h6>
                    <h3 class="fw-bold">@Model.WorkingDaysCount</h3>
                    <p class="mb-0 text-muted">Configured weekly days</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Schedule Rows</h6>
                    <h3 class="fw-bold">@Model.Schedules.Count</h3>
                    <p class="mb-0 text-muted">Availability records</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Leave Periods</h6>
                    <h3 class="fw-bold">@Model.Leaves.Count</h3>
                    <p class="mb-0 text-muted">Approved leave records</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Weekly schedule -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">Weekly Working Schedule</h5>
        </div>

        <div class="card-body">
            @if (Model.HasSchedules)
            {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Day</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Slot Duration</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var schedule in Model.Schedules)
                            {
                        <tr>
                            <td class="fw-semibold">@schedule.DayOfWeek</td>
                            <td>@schedule.StartTime.ToString("HH\\:mm")</td>
                            <td>@schedule.EndTime.ToString("HH\\:mm")</td>
                            <td>@schedule.SlotDurationMinutes minutes</td>
                        </tr>
                            }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info mb-0">
                No weekly schedule has been configured for you yet.
            </div>
            }
        </div>
    </div>

    <!-- Leave periods -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">Leave Periods</h5>
        </div>

        <div class="card-body">
            @if (Model.HasLeaves)
            {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Reason</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var leave in Model.Leaves)
                            {
                        <tr>
                            <td>@leave.StartDate.ToString("dd MMM yyyy")</td>
                            <td>@leave.EndDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(leave.Reason))
                                        {
                                @leave.Reason
                                        }
                                        else
                                        {
                                <span class="text-muted">No reason recorded</span>
                                        }
                            </td>
                        </tr>
                            }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info mb-0">
                No leave periods are recorded for you.
            </div>
            }
        </div>
    </div>
</div>