@model MVCApp.ViewModels.Doctor.DoctorScheduleViewModel

@{
    ViewData["Title"] = "My Schedule";
}

@functions {
    private string GetLeaveText(object leave, params string[] propertyNames)
    {
        var type = leave.GetType();

        foreach (var propName in propertyNames)
        {
            var prop = type.GetProperty(propName);
            if (prop == null)
            {
                continue;
            }

            var value = prop.GetValue(leave)?.ToString();

            if (!string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        return "N/A";
    }

    private DateTime? GetLeaveDate(object leave, params string[] propertyNames)
    {
        var type = leave.GetType();

        foreach (var propName in propertyNames)
        {
            var prop = type.GetProperty(propName);
            if (prop == null)
            {
                continue;
            }

            var value = prop.GetValue(leave);

            if (value is DateTime dateValue)
            {
                return dateValue;
            }
        }

        return null;
    }
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">My Schedule</h2>
            <p class="text-muted mb-0">Doctor: @Model.DoctorFullName</p>
        </div>

        <a asp-controller="Doctor" asp-action="Dashboard" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Working Schedule</h5>
                    <span class="badge bg-primary">@Model.Schedules.Count</span>
                </div>

                <div class="card-body p-0">
                    @if (Model.Schedules == null || !Model.Schedules.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            No schedule found.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Day</th>
                                        <th>Start Time</th>
                                        <th>End Time</th>
                                        <th>Slot Duration</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Schedules)
                                    {
                                        <tr>
                                            <td>@item.DayOfWeek</td>
                                            <td>@item.StartTime.ToString(@"hh\:mm")</td>
                                            <td>@item.EndTime.ToString(@"hh\:mm")</td>
                                            <td>@item.SlotDurationMinutes minute(s)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Leave Periods</h5>
                    <span class="badge bg-secondary">@Model.Leaves.Count</span>
                </div>

                <div class="card-body">
                    @if (Model.Leaves == null || !Model.Leaves.Any())
                    {
                        <p class="text-muted mb-0">No leave periods found.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var leave in Model.Leaves)
                            {
                                var fromDate = GetLeaveDate(leave, "LeaveStartDate", "StartDate", "FromDate", "LeaveDate", "DateFrom");
                                var toDate = GetLeaveDate(leave, "LeaveEndDate", "EndDate", "ToDate", "DateTo");
                                var reason = GetLeaveText(leave, "LeaveReason", "Reason", "Description", "Notes");

                                <div class="border rounded p-3">
                                    <div class="mb-2">
                                        <strong>From:</strong>
                                        @if (fromDate.HasValue)
                                        {
                                            @fromDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </div>

                                    <div class="mb-2">
                                        <strong>To:</strong>
                                        @if (toDate.HasValue)
                                        {
                                            @toDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </div>

                                    <div class="mb-0">
                                        <strong>Reason:</strong>
                                        @if (string.IsNullOrWhiteSpace(reason) || reason == "N/A")
                                        {
                                            <span class="text-muted">No reason provided</span>
                                        }
                                        else
                                        {
                                            @reason
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>