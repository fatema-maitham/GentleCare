@model MVCApp.ViewModels.Doctor.DoctorScheduleViewModel

@{
    ViewData["Title"] = "My Schedule";

    string FormatDuration(int minutes)
    {
        if (minutes <= 0) return "Not set";

        var hours = minutes / 60;
        var mins = minutes % 60;

        if (hours > 0 && mins > 0)
        {
            return $"{hours} hr {mins} min";
        }

        if (hours > 0)
        {
            return hours == 1 ? "1 hr" : $"{hours} hrs";
        }

        return $"{mins} min";
    }

    string FormatTimeOnly(TimeOnly time)
    {
        return time.ToString("hh:mm tt");
    }

    int GetTotalMinutes(TimeOnly start, TimeOnly end)
    {
        if (end <= start)
        {
            return 0;
        }

        return (int)(end - start).TotalMinutes;
    }
}

<div class="doctor-page">
    <div class="doctor-schedule-page">
        <div class="manager-card dashboard-hero">
            <div class="card-head">
                <div>
                    <h2>My Schedule</h2>
                    <span class="muted">Dr. @Model.DoctorFullName</span>
                </div>
            </div>
        </div>

        <div class="schedule-summary">
            <div class="doctor-stat-card">
                <strong>@Model.WorkingDaysCount</strong>
                <span>Working Days</span>
            </div>

            <div class="doctor-stat-card">
                <strong>@Model.Schedules.Count</strong>
                <span>Schedule Rows</span>
            </div>

            <div class="doctor-stat-card">
                <strong>@Model.Leaves.Count</strong>
                <span>Leave Periods</span>
            </div>
        </div>

        <div class="manager-card">
            <div class="card-head">
                <h2>Weekly Working Schedule</h2>
            </div>

            @if (Model.HasSchedules)
            {
                <div class="table-wrap">
                    <table class="schedule-table">
                        <thead>
                            <tr>
                                <th>Day</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Shift Duration</th>
                                <th>Slot Duration</th>
                                <th>Available Slots</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var schedule in Model.Schedules)
                            {
                                var totalMinutes = GetTotalMinutes(schedule.StartTime, schedule.EndTime);
                                var slotCount = schedule.SlotDurationMinutes > 0 && totalMinutes > 0
                                    ? totalMinutes / schedule.SlotDurationMinutes
                                    : 0;

                                <tr>
                                    <td class="fw-bold">@schedule.DayOfWeek</td>
                                    <td>@FormatTimeOnly(schedule.StartTime)</td>
                                    <td>@FormatTimeOnly(schedule.EndTime)</td>
                                    <td>@FormatDuration(totalMinutes)</td>
                                    <td>@FormatDuration(schedule.SlotDurationMinutes)</td>
                                    <td>@slotCount slots</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    No weekly schedule has been configured for you yet.
                </div>
            }
        </div>

        <div class="manager-card">
            <div class="card-head">
                <h2>Leave Periods</h2>
            </div>

            @if (Model.HasLeaves)
            {
                <div class="table-wrap">
                    <table class="schedule-table">
                        <thead>
                            <tr>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Leave Duration</th>
                                <th>Reason</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var leave in Model.Leaves)
                            {
                                var leaveDays = (leave.EndDate.Date - leave.StartDate.Date).Days + 1;

                                <tr>
                                    <td>@leave.StartDate.ToString("dd MMM yyyy")</td>
                                    <td>@leave.EndDate.ToString("dd MMM yyyy")</td>
                                    <td>@leaveDays day@(leaveDays == 1 ? "" : "s")</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(leave.Reason) ? "No reason recorded" : leave.Reason)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    No leave periods are recorded for you.
                </div>
            }
        </div>
    </div>
</div>
