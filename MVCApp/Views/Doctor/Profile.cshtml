@model MVCApp.ViewModels.Doctor.DoctorProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">My Profile</h2>
            <p class="text-muted mb-0">Doctor information</p>
        </div>

        <a asp-controller="Doctor" asp-action="Dashboard" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Profile Details</h5>
        </div>

        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Doctor ID</dt>
                        <dd class="col-sm-8">@Model.DoctorId</dd>

                        <dt class="col-sm-4">Full Name</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">License No.</dt>
                        <dd class="col-sm-8">@Model.LicenseNumber</dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <h6>Bio</h6>
                    @if (string.IsNullOrWhiteSpace(Model.Bio))
                    {
                        <p class="text-muted">No bio available.</p>
                    }
                    else
                    {
                        <p>@Model.Bio</p>
                    }

                    <h6 class="mt-4">Specializations</h6>
                    @if (Model.Specializations == null || !Model.Specializations.Any())
                    {
                        <p class="text-muted mb-0">No specializations assigned.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var specialization in Model.Specializations)
                            {
                                <span class="badge bg-primary">@specialization</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>