@model MVCApp.ViewModels.Doctor.DoctorProfileViewModel

@{
    ViewData["Title"] = "Doctor Profile";

    var profileImage = string.IsNullOrWhiteSpace(Model.ProfilePicture)
        ? Url.Content("~/images/doctors/default-doctor.png")
        : Url.Content("~/images/doctors/" + System.IO.Path.GetFileName(Model.ProfilePicture) + "?v=" + DateTime.Now.Ticks);
}

<div class="doctor-page">
    <div class="doctor-profile-page">
        <div class="manager-card">
            <div class="doctor-profile-hero">
                <div class="doctor-avatar-wrap">
                    <img src="@profileImage"
                         alt="Doctor profile picture"
                         class="doctor-avatar-img"
                         onerror="this.onerror=null; this.src='@Url.Content("~/images/doctors/default-doctor.png")';" />
                </div>

                <div class="doctor-name-block">
                    <h2>@Model.FullName</h2>
                    <span class="doctor-badge">Doctor Account</span>
                </div>
            </div>

            <div class="doctor-info-list">
                <div class="doctor-info-row">
                    <div class="doctor-label">Full Name</div>
                    <div class="doctor-value">@Model.FullName</div>
                </div>

                <div class="doctor-info-row">
                    <div class="doctor-label">Email</div>
                    <div class="doctor-value">@Model.Email</div>
                </div>

                <div class="doctor-info-row">
                    <div class="doctor-label">License Number</div>
                    <div class="doctor-value">@Model.LicenseNumber</div>
                </div>

                <div class="doctor-info-row">
                    <div class="doctor-label">Specializations</div>
                    <div class="doctor-value">
                        @(Model.HasSpecializations
                            ? string.Join(", ", Model.Specializations)
                            : "No specializations assigned yet.")
                    </div>
                </div>

                <div class="doctor-info-row">
                    <div class="doctor-label">Bio</div>
                    <div class="doctor-value">
                        @(string.IsNullOrWhiteSpace(Model.Bio) ? "No bio added yet." : Model.Bio)
                    </div>
                </div>
            </div>

            <div class="doctor-profile-actions">
                <a asp-controller="Doctor"
                   asp-action="EditProfile"
                   class="btn-main">
                    Edit Profile
                </a>
            </div>
        </div>
    </div>
</div>