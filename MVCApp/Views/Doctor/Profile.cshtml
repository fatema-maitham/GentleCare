@model MVCApp.ViewModels.Doctor.DoctorProfileViewModel

@{
    ViewData["Title"] = "Doctor Profile";

    var profileImage = string.IsNullOrWhiteSpace(Model.ProfilePicture)
        ? Url.Content("~/images/doctors/default-doctor.png")
        : Url.Content("~/" + Model.ProfilePicture.TrimStart('/'));
}

<style>
    .doctor-profile-page {
        max-width: 760px;
        margin: 28px auto 55px;
        padding: 0 18px;
    }

    .doctor-profile-card {
        background: #ffffff;
        border: 1px solid #d6ddde;
        border-radius: 24px;
        padding: 34px;
        box-shadow: 0 10px 24px rgba(7, 81, 104, 0.08);
    }

    .doctor-profile-header {
        text-align: center;
        margin-bottom: 28px;
    }

        .doctor-profile-header h1 {
            margin: 0;
            color: #075168;
            font-size: 32px;
            font-weight: 900;
        }

        .doctor-profile-header p {
            margin: 8px 0 0;
            color: #687a80;
            font-weight: 600;
        }

    .doctor-avatar-area {
        display: flex;
        justify-content: center;
        margin-bottom: 18px;
    }

    .doctor-avatar-img {
        width: 135px;
        height: 135px;
        border-radius: 50%;
        object-fit: cover;
        object-position: center;
        background: #ffffff;
        border: 5px solid #e7f1f3;
        display: block;
    }

    .doctor-name-block {
        text-align: center;
        margin-bottom: 30px;
    }

        .doctor-name-block h2 {
            margin: 0;
            color: #12262f;
            font-size: 28px;
            font-weight: 900;
        }

        .doctor-name-block span {
            display: inline-block;
            margin-top: 8px;
            background: #e7f1f3;
            color: #075168;
            padding: 8px 16px;
            border-radius: 999px;
            font-weight: 850;
            font-size: 14px;
        }

    .doctor-info-list {
        display: grid;
        gap: 14px;
    }

    .doctor-info-row {
        display: grid;
        grid-template-columns: 190px 1fr;
        gap: 18px;
        align-items: center;
        border: 1px solid #edf2f3;
        background: #fbfdfd;
        border-radius: 16px;
        padding: 16px 18px;
    }

    .doctor-label {
        color: #687a80;
        font-weight: 850;
    }

    .doctor-value {
        color: #12262f;
        font-weight: 750;
        word-break: break-word;
    }

    .doctor-profile-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
    }

    .doctor-btn {
        border: none;
        border-radius: 14px;
        padding: 12px 20px;
        font-weight: 900;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .doctor-btn-primary {
        background: #075168;
        color: #ffffff;
    }

        .doctor-btn-primary:hover {
            background: #00779b;
            color: #ffffff;
            transform: translateY(-2px);
        }

    .doctor-btn-secondary {
        background: #e7f1f3;
        color: #075168;
    }

        .doctor-btn-secondary:hover {
            background: #dce8ea;
            color: #075168;
            transform: translateY(-2px);
        }

    @@media (max-width: 700px) {
        .doctor-profile-card {
            padding: 24px;
        }

        .doctor-info-row {
            grid-template-columns: 1fr;
            gap: 6px;
        }

        .doctor-profile-actions {
            flex-direction: column;
        }

        .doctor-btn {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="doctor-profile-page">
    <section class="doctor-profile-card">

        <div class="doctor-profile-header">
            <h1>Doctor Profile</h1>
            <p>View your personal and medical profile information.</p>
        </div>

        <div class="doctor-avatar-area">
            <img src="@profileImage"
                 alt=""
                 class="doctor-avatar-img"
                 onerror="this.src='@Url.Content("~/images/doctors/default-doctor.png")';" />
        </div>

        <div class="doctor-name-block">
            <h2>@Model.FullName</h2>
            <span>Doctor Account</span>
        </div>

        <div class="doctor-info-list">

            <div class="doctor-info-row">
                <div class="doctor-label">Full Name</div>
                <div class="doctor-value">@Model.FullName</div>
            </div>

            <div class="doctor-info-row">
                <div class="doctor-label">Email</div>
                <div class="doctor-value">@Model.Email</div>
            </div>

            <div class="doctor-info-row">
                <div class="doctor-label">License Number</div>
                <div class="doctor-value">@Model.LicenseNumber</div>
            </div>

            <div class="doctor-info-row">
                <div class="doctor-label">Specializations</div>
                <div class="doctor-value">
                    @(Model.HasSpecializations
                                        ? string.Join(", ", Model.Specializations)
                                        : "No specializations assigned yet.")
                </div>
            </div>

            <div class="doctor-info-row">
                <div class="doctor-label">Bio</div>
                <div class="doctor-value">
                    @(string.IsNullOrWhiteSpace(Model.Bio) ? "No bio added yet." : Model.Bio)
                </div>
            </div>

        </div>

        <div class="doctor-profile-actions">
            <a asp-controller="Doctor" asp-action="EditProfile" class="doctor-btn doctor-btn-primary">
                Edit Profile
            </a>

            <a asp-controller="Doctor" asp-action="Dashboard" class="doctor-btn doctor-btn-secondary">
                Back to Dashboard
            </a>
        </div>

    </section>
</div>