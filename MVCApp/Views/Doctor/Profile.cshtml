@model MVCApp.ViewModels.Doctor.DoctorProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <h2 class="mb-4">My Doctor Profile</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h4>@Model.FullName</h4>
            <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
            <p class="mb-1"><strong>License Number:</strong> @Model.LicenseNumber</p>
            <p class="mb-0"><strong>Bio:</strong> @(string.IsNullOrWhiteSpace(Model.Bio) ? "No bio added." : Model.Bio)</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">Specializations</div>
                <div class="card-body">
                    @if (Model.Specializations.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var item in Model.Specializations)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="mb-0">No specializations assigned.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">Schedules</div>
                <div class="card-body">
                    @if (Model.Schedules.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var item in Model.Schedules)
                            {
                                <li>@item.DayOfWeek - @item.StartTime to @item.EndTime (@item.SlotDurationMinutes min)</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="mb-0">No schedule found.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Leave Periods</div>
        <div class="card-body">
            @if (Model.Leaves.Any())
            {
                <ul class="mb-0">
                    @foreach (var leave in Model.Leaves)
                    {
                        <li>
                            @leave.StartDate.ToString("yyyy-MM-dd") to @leave.EndDate.ToString("yyyy-MM-dd")
                            @if (!string.IsNullOrWhiteSpace(leave.Reason))
                            {
                                <span>- @leave.Reason</span>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="mb-0">No leave periods recorded.</p>
            }
        </div>
    </div>
</div>
