@model MVCApp.ViewModels.Doctor.DoctorAppointmentListViewModel

@{
    ViewData["Title"] = "My Appointments";
    var selectedDateValue = Model.SelectedDate?.ToString("yyyy-MM-dd");
}

<div class="appointments-page">

    <div class="appointments-title-row">
        <span class="result-pill">
            @Model.TotalAppointments result(s)
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="filter-card">
        <div class="card-clean-header">
            <h4>Search and Filter</h4>
        </div>

        <div class="filter-body">
            <form asp-controller="DoctorAppointment"
                  asp-action="Appointments"
                  method="get"
                  class="filter-grid">

                <div class="filter-field">
                    <label>Search</label>
                    <input name="searchTerm"
                           value="@Model.SearchTerm"
                           placeholder="Patient name, CPR, reference, or notes" />
                </div>

                <div class="filter-field">
                    <label>Status</label>
                    <select name="status">
                        <option value="">All statuses</option>

                        @foreach (var statusOption in Model.StatusOptions)
                        {
                            if (statusOption.Value == Model.SelectedStatus)
                            {
                                <option value="@statusOption.Value" selected>@statusOption.Text</option>
                            }
                            else
                            {
                                <option value="@statusOption.Value">@statusOption.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label>Date</label>
                    <input name="date" type="date" value="@selectedDateValue" />
                </div>

                <div class="filter-actions">
                    <button type="submit" class="gc-btn gc-btn-primary">Apply</button>

                    <a asp-controller="DoctorAppointment"
                       asp-action="Appointments"
                       class="gc-btn gc-btn-light">
                        Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="appointments-card">
        <div class="card-clean-header">
            <h4>Appointments</h4>
        </div>

        @if (Model.HasAppointments)
        {
            <div class="appointments-table-wrap">
                <table class="appointments-table">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Reference No.</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Notes</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var appointment in Model.Appointments)
                        {
                            <tr>
                                <td class="patient-name">@appointment.PatientFullName</td>
                                <td>@appointment.PatientReferenceNumber</td>
                                <td>@appointment.AppointmentDateDisplay</td>
                                <td>@appointment.TimeDisplay</td>
                                <td><span class="status-badge">@appointment.StatusName</span></td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                                    {
                                        @appointment.Notes
                                    }
                                    else
                                    {
                                        <span class="notes-muted">No notes</span>
                                    }
                                </td>

                                <td>
                                    <div class="table-actions">
                                        <a asp-controller="DoctorAppointment"
                                           asp-action="AppointmentDetails"
                                           asp-route-id="@appointment.AppointmentId"
                                           class="table-btn table-btn-main">
                                            Details
                                        </a>

                                        @if (appointment.CanUpdateStatus)
                                        {
                                            <a asp-controller="DoctorAppointment"
                                               asp-action="UpdateStatus"
                                               asp-route-id="@appointment.AppointmentId"
                                               class="table-btn">
                                                Update Status
                                            </a>
                                        }

                                        <a asp-controller="DoctorAppointment"
                                           asp-action="PatientHistory"
                                           asp-route-patientId="@appointment.PatientId"
                                           class="table-btn">
                                            History
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">No appointments found.</div>
        }
    </div>
</div>

<style>
    .appointments-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 30px 20px 50px;
    }

    .appointments-title-row {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 22px;
    }

    .result-pill {
        background: #E7F1F3;
        color: #075168;
        border: 1px solid #C9DBDF;
        border-radius: 999px;
        padding: 9px 15px;
        font-size: 13px;
        font-weight: 900;
    }

    .filter-card,
    .appointments-card {
        background: #ffffff;
        border: 1px solid #D6DDDE;
        border-radius: 24px;
        margin-bottom: 24px;
        overflow: hidden;
    }

    .card-clean-header {
        padding: 20px 24px;
        border-bottom: 1px solid #E9EEEE;
    }

        .card-clean-header h4 {
            margin: 0;
            font-size: 20px;
            font-weight: 900;
            color: #075168;
        }

    .filter-body {
        padding: 24px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr auto;
        gap: 16px;
        align-items: end;
    }

    .filter-field label {
        display: block;
        margin-bottom: 8px;
        font-weight: 850;
        color: #12262F;
    }

    .filter-field input,
    .filter-field select {
        width: 100%;
        height: 46px;
        border: 1px solid #D6DDDE;
        border-radius: 14px;
        padding: 0 14px;
    }

    .filter-actions {
        display: flex;
        gap: 10px;
    }

    .gc-btn {
        height: 46px;
        border-radius: 14px;
        padding: 0 18px;
        font-weight: 900;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
    }

    .gc-btn-primary {
        background: #075168;
        color: #ffffff;
    }

    .gc-btn-light {
        background: #E7F1F3;
        color: #075168;
        border: 1px solid #C9DBDF;
    }

    .appointments-table-wrap {
        overflow-x: auto;
    }

    .appointments-table {
        width: 100%;
        border-collapse: collapse;
    }

        .appointments-table th {
            background: #F8FAFA;
            color: #12262F;
            font-size: 13px;
            font-weight: 900;
            padding: 15px 18px;
            border-bottom: 1px solid #D6DDDE;
            text-align: left;
        }

        .appointments-table td {
            padding: 17px 18px;
            border-bottom: 1px solid #EDF1F2;
            color: #12262F;
            font-size: 14px;
            font-weight: 600;
        }

    .patient-name {
        font-weight: 900;
    }

    .status-badge {
        padding: 6px 11px;
        border-radius: 999px;
        background: #E7F1F3;
        color: #075168;
        border: 1px solid #C9DBDF;
        font-size: 12px;
        font-weight: 900;
    }

    .notes-muted {
        color: #687A80;
    }

    .table-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
    }

    .table-btn {
        padding: 8px 12px;
        border-radius: 12px;
        border: 1px solid #D6DDDE;
        background: #ffffff;
        color: #075168;
        font-size: 12px;
        font-weight: 900;
        text-decoration: none;
    }

    .table-btn-main {
        background: #075168;
        color: #ffffff;
        border-color: #075168;
    }

    .empty-box {
        margin: 24px;
        padding: 18px;
        border-radius: 16px;
        background: #E7F1F3;
        color: #075168;
        font-weight: 800;
    }

    @@media (max-width: 900px) {
        .filter-grid {
            grid-template-columns: 1fr;
        }
    }
</style>