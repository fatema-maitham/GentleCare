@model MVCApp.ViewModels.Doctor.DoctorAppointmentListViewModel

@{
    ViewData["Title"] = "My Appointments";
    var selectedDateValue = Model.SelectedDate?.ToString("yyyy-MM-dd");
}

<div class="container mt-4">


    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">Search and Filter Appointments</h5>
        </div>

        <div class="card-body">
            <form asp-controller="Doctor"
                  asp-action="Appointments"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label for="searchTerm" class="form-label">Search</label>
                    <input id="searchTerm"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="form-control"
                           placeholder="Patient name, CPR, reference, or notes" />
                </div>

                <div class="col-md-3">
                    <label for="status" class="form-label">Status</label>
                    <select id="status"
                            name="status"
                            class="form-select">
                        <option value="">All statuses</option>

                        @foreach (var statusOption in Model.StatusOptions)
                        {
                            if (statusOption.Value == Model.SelectedStatus)
                            {
                        <option value="@statusOption.Value" selected>
                            @statusOption.Text
                        </option>
                            }
                            else
                            {
                        <option value="@statusOption.Value">
                            @statusOption.Text
                        </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="date" class="form-label">Date</label>
                    <input id="date"
                           name="date"
                           type="date"
                           value="@selectedDateValue"
                           class="form-control" />
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        Apply
                    </button>

                    <a asp-controller="Doctor"
                       asp-action="Appointments"
                       class="btn btn-outline-secondary flex-fill">
                        Clear
                    </a>
                </div>
            </form>

            @if (Model.HasActiveFilters)
            {
            <div class="mt-3 small text-muted">
                Active filters:
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                <span class="badge bg-light text-dark border">Search: @Model.SearchTerm</span>
                    }

                @if (!string.IsNullOrWhiteSpace(Model.SelectedStatus))
                    {
                <span class="badge bg-light text-dark border">Status: @Model.SelectedStatus</span>
                    }

                @if (Model.SelectedDate.HasValue)
                    {
                <span class="badge bg-light text-dark border">
                    Date: @Model.SelectedDate.Value.ToString("dd MMM yyyy")
                </span>
                    }
            </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Appointments</h5>
            <span class="badge bg-primary">
                @Model.TotalAppointments result(s)
            </span>
        </div>

        <div class="card-body">

            @if (Model.HasAppointments)
            {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Patient</th>
                            <th>Reference No.</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Notes</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var appointment in Model.Appointments)
                            {
                        <tr>
                            <td>
                                <div class="fw-semibold">@appointment.PatientFullName</div>
                            </td>

                            <td>
                                <span class="text-muted">
                                    @appointment.PatientReferenceNumber
                                </span>
                            </td>

                            <td>@appointment.AppointmentDateDisplay</td>

                            <td>@appointment.TimeDisplay</td>

                            <td>
                                <span class="badge bg-secondary">
                                    @appointment.StatusName
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                                        {
                                <span>@appointment.Notes</span>
                                        }
                                        else
                                        {
                                <span class="text-muted">No notes</span>
                                        }
                            </td>

                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-controller="Doctor"
                                       asp-action="AppointmentDetails"
                                       asp-route-id="@appointment.AppointmentId"
                                       class="btn btn-sm btn-outline-dark">
                                        Details
                                    </a>

                                    @if (appointment.CanUpdateStatus)
                                            {
                                    <a asp-controller="Doctor"
                                       asp-action="UpdateStatus"
                                       asp-route-id="@appointment.AppointmentId"
                                       class="btn btn-sm btn-outline-primary">
                                        Update Status
                                    </a>
                                            }

                                    <a asp-controller="Doctor"
                                       asp-action="PatientHistory"
                                       asp-route-patientId="@appointment.PatientId"
                                       class="btn btn-sm btn-outline-secondary">
                                        History
                                    </a>
                                </div>
                            </td>
                        </tr>
                            }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info mb-0">
                No appointments found for the selected search or filters.
            </div>
            }

        </div>
    </div>
</div>