@model MVCApp.ViewModels.Doctor.DoctorAppointmentListViewModel

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">

    <!-- Page header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Appointments</h2>
            <p class="text-muted mb-0">
                View and manage appointments assigned to Dr. @Model.DoctorFullName.
            </p>
        </div>

        <a asp-controller="Doctor"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    <!-- Filters help the doctor quickly find appointments by status or date -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">Filter Appointments</h5>
        </div>

        <div class="card-body">
            <form asp-controller="Doctor"
                  asp-action="Appointments"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label asp-for="SelectedStatus" class="form-label">Status</label>
                    <select asp-for="SelectedStatus"
                            asp-items="Model.StatusOptions"
                            class="form-select">
                        <option value="">All statuses</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="SelectedDate" class="form-label">Date</label>
                    <input asp-for="SelectedDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        Apply Filter
                    </button>

                    <a asp-controller="Doctor"
                       asp-action="Appointments"
                       class="btn btn-outline-secondary flex-fill">
                        Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Appointment list -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Appointments</h5>
            <span class="badge bg-primary">
                @Model.TotalAppointments result(s)
            </span>
        </div>

        <div class="card-body">

            @if (Model.HasAppointments)
            {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Patient</th>
                            <th>Reference No.</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Notes</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var appointment in Model.Appointments)
                            {
                        <tr>
                            <td>
                                <div class="fw-semibold">@appointment.PatientFullName</div>
                            </td>

                            <td>
                                <span class="text-muted">
                                    @appointment.PatientReferenceNumber
                                </span>
                            </td>

                            <td>@appointment.AppointmentDateDisplay</td>

                            <td>@appointment.TimeDisplay</td>

                            <td>
                                <span class="badge bg-secondary">
                                    @appointment.StatusName
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                                        {
                                <span>@appointment.Notes</span>
                                        }
                                        else
                                        {
                                <span class="text-muted">No notes</span>
                                        }
                            </td>

                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-controller="Doctor"
                                       asp-action="AppointmentDetails"
                                       asp-route-id="@appointment.AppointmentId"
                                       class="btn btn-sm btn-outline-dark">
                                        Details
                                    </a>

                                    @if (appointment.CanUpdateStatus)
                                            {
                                    <a asp-controller="Doctor"
                                       asp-action="UpdateStatus"
                                       asp-route-id="@appointment.AppointmentId"
                                       class="btn btn-sm btn-outline-primary">
                                        Update Status
                                    </a>
                                            }

                                    <a asp-controller="Doctor"
                                       asp-action="PatientHistory"
                                       asp-route-patientId="@appointment.PatientId"
                                       class="btn btn-sm btn-outline-secondary">
                                        History
                                    </a>
                                </div>
                            </td>
                        </tr>
                            }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="alert alert-info mb-0">
                No appointments found for the selected filters.
            </div>
            }

        </div>
    </div>
</div>