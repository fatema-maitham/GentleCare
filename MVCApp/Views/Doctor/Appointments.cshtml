@model MVCApp.ViewModels.Doctor.DoctorAppointmentsViewModel

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">My Appointments</h2>
            <p class="text-muted mb-0">Doctor: @Model.DoctorFullName</p>
        </div>

        <div>
            <a asp-controller="Doctor" asp-action="Dashboard" class="btn btn-outline-secondary">
                Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Filter Appointments</h5>
        </div>
        <div class="card-body">
            <form asp-controller="Doctor" asp-action="Appointments" method="get" class="row g-3">
                <div class="col-md-4">
                    <label asp-for="SelectedStatus" class="form-label">Status</label>
                    <select asp-for="SelectedStatus" asp-items="Model.StatusOptions" class="form-select">
                        <option value="">All Statuses</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="SelectedDate" class="form-label">Date</label>
                    <input asp-for="SelectedDate" type="date" class="form-control" />
                </div>

                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        Apply Filter
                    </button>

                    <a asp-controller="Doctor" asp-action="Appointments" class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Appointments List</h5>
            <span class="badge bg-primary">@Model.Appointments.Count</span>
        </div>

        <div class="card-body p-0">
            @if (Model.Appointments == null || !Model.Appointments.Any())
            {
                <div class="p-4 text-center text-muted">
                    No appointments found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Reference No.</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Appointments)
                            {
                                <tr>
                                    <td>@item.AppointmentDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                                    <td>@item.PatientFullName</td>
                                    <td>@item.PatientReferenceNumber</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.StatusName</span>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <span class="text-muted">No notes</span>
                                        }
                                        else
                                        {
                                            @item.Notes
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end flex-wrap gap-2">
                                            <a asp-controller="Doctor"
                                               asp-action="AppointmentDetails"
                                               asp-route-id="@item.AppointmentId"
                                               class="btn btn-sm btn-outline-primary">
                                                Details
                                            </a>

                                            <a asp-controller="Doctor"
                                               asp-action="UpdateStatus"
                                               asp-route-id="@item.AppointmentId"
                                               class="btn btn-sm btn-outline-warning">
                                                Update Status
                                            </a>

                                            <a asp-controller="Doctor"
                                               asp-action="PatientHistory"
                                               asp-route-patientId="@item.PatientId"
                                               class="btn btn-sm btn-outline-info">
                                                Patient History
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>