@model MVCApp.ViewModels.Doctor.DoctorNotificationsViewModel

@{
    ViewData["Title"] = "My Notifications";
}

@functions {
    private string GetNotificationText(object notification)
    {
        var type = notification.GetType();

        var possibleProps = new[]
        {
            "Message",
            "Title",
            "Content",
            "Text",
            "Description"
        };

        foreach (var propName in possibleProps)
        {
            var prop = type.GetProperty(propName);
            if (prop != null)
            {
                var value = prop.GetValue(notification)?.ToString();
                if (!string.IsNullOrWhiteSpace(value))
                {
                    return value;
                }
            }
        }

        return "Notification";
    }

    private string GetNotificationTypeName(object notification)
    {
        var type = notification.GetType();

        var notificationTypeProp = type.GetProperty("NotificationType");
        if (notificationTypeProp != null)
        {
            var notificationTypeValue = notificationTypeProp.GetValue(notification);
            if (notificationTypeValue != null)
            {
                var nameProp = notificationTypeValue.GetType().GetProperty("Name");
                if (nameProp != null)
                {
                    var name = nameProp.GetValue(notificationTypeValue)?.ToString();
                    if (!string.IsNullOrWhiteSpace(name))
                    {
                        return name;
                    }
                }
            }
        }

        var typeIdProp = type.GetProperty("NotificationTypeId");
        if (typeIdProp != null)
        {
            var typeIdValue = typeIdProp.GetValue(notification)?.ToString();
            if (!string.IsNullOrWhiteSpace(typeIdValue))
            {
                return "Type " + typeIdValue;
            }
        }

        return "General";
    }

    private DateTime? GetNotificationCreatedAt(object notification)
    {
        var type = notification.GetType();
        var prop = type.GetProperty("CreatedAt");

        if (prop == null)
        {
            return null;
        }

        var value = prop.GetValue(notification);
        if (value is DateTime dateTime)
        {
            return dateTime;
        }

        return null;
    }
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="mb-1">My Notifications</h2>
            <p class="text-muted mb-0">
                Unread notifications: @Model.UnreadCount
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Doctor" asp-action="Dashboard" class="btn btn-outline-secondary">
                Back to Dashboard
            </a>

            @if (Model.Notifications != null && Model.Notifications.Any(n => !n.IsRead))
            {
                <form asp-controller="Doctor" asp-action="MarkAllNotificationsAsRead" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">
                        Mark All as Read
                    </button>
                </form>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Notifications</h5>
            <span class="badge bg-primary">@Model.Notifications.Count</span>
        </div>

        <div class="card-body">
            @if (Model.Notifications == null || !Model.Notifications.Any())
            {
                <div class="text-center text-muted py-4">
                    No notifications found.
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Notifications)
                    {
                        var createdAt = GetNotificationCreatedAt(item);
                        var notificationText = GetNotificationText(item);
                        var notificationType = GetNotificationTypeName(item);

                        <div class="border rounded p-3 @(item.IsRead ? "bg-light" : "border-primary")">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                <div class="flex-grow-1">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                        <span class="badge @(item.IsRead ? "bg-secondary" : "bg-success")">
                                            @(item.IsRead ? "Read" : "Unread")
                                        </span>

                                        <span class="badge bg-info text-dark">
                                            @notificationType
                                        </span>
                                    </div>

                                    <p class="mb-2">@notificationText</p>

                                    <small class="text-muted">
                                        @if (createdAt.HasValue)
                                        {
                                            @createdAt.Value.ToString("dd MMM yyyy hh:mm tt")
                                        }
                                        else
                                        {
                                            <span>No date available</span>
                                        }
                                    </small>
                                </div>

                                @if (!item.IsRead)
                                {
                                    <form asp-controller="Doctor"
                                          asp-action="MarkNotificationAsRead"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            Mark as Read
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>