@model MVCApp.ViewModels.Doctor.DoctorNotificationsViewModel

@{
    ViewData["Title"] = "My Notifications";
}

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    }

    <!-- Notification summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Notifications</h6>
                    <h3 class="fw-bold">@Model.TotalNotifications</h3>
                    <p class="mb-0 text-muted">All received notifications</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Unread</h6>
                    <h3 class="fw-bold">@Model.UnreadCount</h3>
                    <p class="mb-0 text-muted">Notifications not read yet</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center justify-content-center">
                    @if (Model.HasUnreadNotifications)
                    {
                    <form asp-controller="Doctor"
                          asp-action="MarkAllNotificationsAsRead"
                          method="post"
                          class="w-100">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-primary w-100">
                            Mark All as Read
                        </button>
                    </form>
                    }
                    else
                    {
                    <span class="text-muted">No unread notifications</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Notifications list -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="fw-bold mb-0">Notification List</h5>
        </div>

        <div class="card-body">
            @if (Model.HasNotifications)
            {
            <div class="list-group list-group-flush">
                @foreach (var notification in Model.Notifications)
                    {
                <div class="list-group-item px-0">
                    <div class="d-flex justify-content-between align-items-start gap-3">

                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h6 class="fw-bold mb-0">@notification.Title</h6>

                                @if (notification.IsRead)
                                        {
                                <span class="badge bg-secondary">Read</span>
                                        }
                                        else
                                        {
                                <span class="badge bg-primary">Unread</span>
                                        }
                            </div>

                            <p class="mb-1">@notification.Message</p>

                            <small class="text-muted">
                                Created at: @notification.CreatedAtDisplay
                            </small>

                            @if (notification.HasRelatedEntity)
                                    {
                            <div class="mt-2">
                                <small class="text-muted">
                                    Related to: @notification.RelatedEntityType
                                </small>
                            </div>
                                    }
                        </div>

                        <div class="text-end">
                            @if (!notification.IsRead)
                                    {
                            <form asp-controller="Doctor"
                                  asp-action="MarkNotificationAsRead"
                                  asp-route-id="@notification.NotificationId"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    Mark Read
                                </button>
                            </form>
                                    }
                        </div>

                    </div>
                </div>
                    }
            </div>
            }
            else
            {
            <div class="alert alert-info mb-0">
                You do not have any notifications yet.
            </div>
            }
        </div>
    </div>
</div>